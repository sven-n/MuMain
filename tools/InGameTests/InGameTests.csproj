<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A window program on Windows: no empty console window opens with it. Program.AttachToParentConsole
         gives the command line its console back; elsewhere this is the same as Exe. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MuMain.Tools.InGameTests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup>
    <!-- `dotnet publish -r <rid>` (the build does it for ENABLE_IN_GAME_TESTS): one file to put next to Main,
         on the .NET runtime that building the client needs anyway. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The window (Gui/); the command line runs without opening it. -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test server; TestServer writes it out when it recreates the server, so the tester stays one file. -->
    <EmbeddedResource Include="docker-compose.yml" LogicalName="docker-compose.yml" />
  </ItemGroup>

</Project>
