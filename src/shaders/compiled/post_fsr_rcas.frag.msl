#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct RcasUniforms
{
    float sharpness;
    float maxX;
    float maxY;
    float padding;
};

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
{
    float2 input_uv [[user(locn0)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant RcasUniforms& _48 [[buffer(0)]], texture2d<float> source [[texture(0)]], sampler sourceSampler [[sampler(0)]], float4 gl_FragCoord [[position]])
{
    main0_out out = {};
    int2 _278 = int2(gl_FragCoord.xy);
    float3 _386 = source.read(uint2(int3(clamp(_278 + int2(0, -1), int2(0), int2(int(_48.maxX), int(_48.maxY))), 0).xy), 0).xyz;
    float3 _411 = source.read(uint2(int3(clamp(_278 + int2(-1, 0), int2(0), int2(int(_48.maxX), int(_48.maxY))), 0).xy), 0).xyz;
    float3 _291 = source.sample(sourceSampler, in.input_uv, level(0.0)).xyz;
    float3 _436 = source.read(uint2(int3(clamp(_278 + int2(1, 0), int2(0), int2(int(_48.maxX), int(_48.maxY))), 0).xy), 0).xyz;
    float3 _461 = source.read(uint2(int3(clamp(_278 + int2(0, 1), int2(0), int2(int(_48.maxX), int(_48.maxY))), 0).xy), 0).xyz;
    float3 _303 = fast::min(fast::min(_386, fast::min(_411, _436)), _461);
    float3 _309 = fast::max(fast::max(_386, fast::max(_411, _436)), _461);
    float3 _329 = fast::max(-(fast::min(_303, _291) / (_309 * 4.0)), (float3(1.0) - fast::max(_309, _291)) / ((_303 * 4.0) - float3(4.0)));
    float _341 = fast::max(-0.1875, fast::min(fast::max(_329.x, fast::max(_329.y, _329.z)), 0.0)) * _48.sharpness;
    out._entryPointOutput = float4((((((_386 + _411) + _436) + _461) * _341) + _291) / float3((4.0 * _341) + 1.0), 1.0);
    return out;
}

