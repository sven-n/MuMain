#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct RcasUniforms
{
    float sharpness;
    float maxX;
    float maxY;
    float padding;
};

struct main0_out
{
    float4 _entryPointOutput [[color(0)]];
};

struct main0_in
