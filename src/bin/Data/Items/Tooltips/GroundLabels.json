  "standard": [
    {"when": ["setItem"], "style": "setItem"},
    {"when": ["tag:divineArchangelWeapon"], "style": "divineArchangel"},
    {"when": ["socketItem"], "style": "socketItem"},
    {"when": ["excellentFlags", "!upperTierWings"], "style": "excellent"},
    {"when": ["level>=7"], "style": "level7up"},
    {"when": ["skillLuckOrOption"], "style": "withOptions"},
    {"when": ["level=0"], "style": "level0"},
    {"when": ["level<=2"], "style": "level1to2"},
    {"when": ["level<=4"], "style": "level3to4"},
    {"style": "level5to6"}
  ]
}
