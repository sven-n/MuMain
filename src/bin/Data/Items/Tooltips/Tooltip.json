  "layouts": [
    {
      "name": "default",
      "lines": [
        {"section": "name"},
        {"text": "@oneHandedDamage", "when": ["hasDamage", "!tag:noDamageLine", "!skillBook", "!twoHanded"], "colors": [{"when": ["damageHarmonyBonus"], "color": "yellow"}, {"when": ["excellent"], "color": "blue"}]},
        {"text": "@twoHandedDamage", "when": ["hasDamage", "!tag:noDamageLine", "!skillBook", "twoHanded"], "colors": [{"when": ["damageHarmonyBonus"], "color": "yellow"}, {"when": ["excellent"], "color": "blue"}]},
        {"text": "@wizardryDamage", "when": ["hasDamage", "!tag:noDamageLine", "skillBook"], "colors": [{"when": ["damageHarmonyBonus"], "color": "yellow"}, {"when": ["excellent"], "color": "blue"}]},
        {"text": "@defense", "when": ["defense"], "colors": [{"when": ["defenseHarmonyBonus"], "color": "yellow"}, {"when": ["armour", "excellent"], "color": "blue"}]},
        {"text": "@magicDefense", "when": ["magicDefense"]},
        {"text": "@blockRate", "when": ["blockRate"], "colors": [{"when": ["excellent"], "color": "blue"}]},
        {"text": "@attackSpeed", "when": ["attackSpeed"]},
        {"text": "@walkSpeed", "when": ["walkSpeed"]},
        {"section": "description"},
        {"text": "@iceResistance", "when": ["iceResistance"]},
        {"text": "@poisonResistance", "when": ["poisonResistance"]},
        {"text": "@lightningResistance", "when": ["lightningResistance"]},
        {"text": "@fireResistance", "when": ["fireResistance"]},
        {"text": "@earthResistance", "when": ["earthResistance"]},
        {"text": "@windResistance", "when": ["windResistance"]},
        {"text": "@waterResistance", "when": ["waterResistance"]},
        {"text": "@requiredLevel", "when": ["requiredLevel", "!tag:noLevelRequirement"], "colors": [{"when": ["missingLevel"], "color": "red"}]},
        {"text": "@lacking", "values": {"missing": "missingLevel"}, "when": ["requiredLevel", "!tag:noLevelRequirement", "missingLevel"], "color": "red"},
        {"text": "@requiredStrength", "when": ["requiredStrength", "!tag:luckyItem"], "colors": [{"when": ["missingStrength"], "color": "red"}, {"when": ["strengthReduced"], "color": "yellow"}]},
        {"text": "@lacking", "values": {"missing": "missingStrength"}, "when": ["requiredStrength", "!tag:luckyItem", "missingStrength"], "color": "red"},
        {"text": "@requiredDexterity", "when": ["requiredDexterity", "!tag:luckyItem"], "colors": [{"when": ["missingDexterity"], "color": "red"}, {"when": ["dexterityReduced"], "color": "yellow"}]},
        {"text": "@lacking", "values": {"missing": "missingDexterity"}, "when": ["requiredDexterity", "!tag:luckyItem", "missingDexterity"], "color": "red"},
        {"text": "@requiredVitality", "when": ["requiredVitality", "!tag:luckyItem"], "colors": [{"when": ["missingVitality"], "color": "red"}]},
        {"text": "@lacking", "values": {"missing": "missingVitality"}, "when": ["requiredVitality", "!tag:luckyItem", "missingVitality"], "color": "red"},
        {"text": "@requiredEnergy", "when": ["requiredEnergy", "!tag:luckyItem"], "colors": [{"when": ["missingEnergy"], "color": "red"}]},
        {"text": "@lacking", "values": {"missing": "missingEnergy"}, "when": ["requiredEnergy", "!tag:luckyItem", "missingEnergy"], "color": "red"},
        {"text": "@requiredLeadership", "when": ["requiredLeadership", "!tag:luckyItem"], "colors": [{"when": ["missingLeadership"], "color": "red"}]},
        {"text": "@lacking", "values": {"missing": "missingLeadership"}, "when": ["requiredLeadership", "!tag:luckyItem", "missingLeadership"], "color": "red"},
        {"section": "classes"},
        {"text": "", "when": ["wizardryWeapon"]},
        {"text": "@wizardryDamageIncrease", "when": ["wizardryWeapon", "!tag:summonerBook"], "color": "blue", "bold": true},
        {"text": "@curseDamageIncrease", "when": ["wizardryWeapon", "tag:summonerBook"], "color": "blue", "bold": true},
        {"text": "", "when": ["tag:sceptre"]},
        {"text": "@petAttackIncrease", "when": ["tag:sceptre"], "color": "blue", "bold": true},
        {"section": "options"}
      ]
    }
  ]
}
