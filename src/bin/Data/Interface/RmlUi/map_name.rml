<rml>
<head>
	<title>Map name (CUIMapName)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="map_name.rcss"/>
</head>
<body data-model="map_name">
	<!-- Shared decoration, plain localized text and the optional Gens warning fade together.
	     This HUD stays behind game windows and lets pointer input pass through. -->
	<div id="banner" class="center-x" data-style-opacity="alpha">
		<img id="strife" class="center-x" data-if="strife" data-attr-src="strife_source" rect="0 0 166 28"/>
		<div id="ornament_top"/>
		<div id="name"><span id="name_text">{{map_name}}</span></div>
		<div id="ornament_bottom"/>
	</div>
</body>
</rml>
