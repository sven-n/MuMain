<rml>
<head>
	<title>Map name (CUIMapName)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="map_name.rcss"/>
</head>
<body data-model="map_name">
	<!-- The map name image and optional Gens strife banner fade together. The theme owns their
	     size and position; the background context keeps them behind other windows. -->
	<div id="banner" class="center-x" data-style-opacity="alpha">
		<img id="strife" data-if="strife" data-attr-src="strife_source"/>
		<img id="name" data-attr-src="image_source"/>
	</div>
</body>
</rml>
