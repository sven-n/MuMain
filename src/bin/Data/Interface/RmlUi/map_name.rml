<rml>
<head>
	<title>Map name (CUIMapName)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="map_name.rcss"/>
</head>
<body data-model="map_name">
	<!-- The original map-name image rebuilt from its pieces: the swirls shared by every map, the
	     map's own icon between them and the localized name above, fading with the optional Gens
	     warning. This HUD stays behind game windows and lets pointer input pass through. -->
	<div id="banner" class="center-x" data-style-opacity="alpha">
		<img id="strife" data-if="strife" data-attr-src="strife_source" rect="0 0 166 28"/>
		<img id="swirl_left" class="ornament" src="/Data/Interface/MapNameOrnament/SwirlLeft.tga"/>
		<img id="swirl_right" class="ornament" src="/Data/Interface/MapNameOrnament/SwirlRight.tga"/>
		<img id="icon" class="ornament" data-if="icon" data-attr-src="icon_source" data-attr-style="icon_style"/>
		<div id="name_room"/>
		<div id="name"><span id="name_text">{{map_name}}</span></div>
		<div id="name_shine">{{map_name}}</div>
	</div>
</body>
</rml>
