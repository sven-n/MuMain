<rml>
<head>
	<title>Character Select Bar</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="char_sel_main.rcss"/>
</head>
<body data-model="char_sel_main">
	<!-- #panel spans the full screen as a pure positioning container (pointer-events:none);
	     deco/info-bar anchor via base.rcss's anchor-* classes. .btn-icon-item only shows a caption
	     in modern theme -- in legacy it stays unstyled/non-positioned so it doesn't interfere with
	     each button's own #btn_create-style absolute positioning.

	     Labels use DejaVu Sans Unicode glyphs (base.rcss's .btn-icon-label) except Create's "+",
	     which is plain ASCII since DejaVu lacks the reference's fullwidth U+FF0B glyph. -->
	<div id="panel">
		<div id="deco" class="deco anchor-bottom-right"></div>
		<div id="info_bar" class="info-bar stretch-x"></div>
		<div id="btn_create_item" class="btn-icon-item">
			<div id="btn_create" class="btn-icon" data-class-disabled="create_disabled" data-event-click="charsel_create_click"><span class="btn-icon-label">+</span></div>
			<span class="btn-icon-caption">Create</span>
		</div>
		<div id="btn_menu_item" class="btn-icon-item">
			<div id="btn_menu" class="btn-icon btn-icon-primary" data-event-click="charsel_menu_click"><span class="btn-icon-label">≡</span></div>
			<span class="btn-icon-caption">Menu</span>
		</div>
		<div id="btn_connect_item" class="btn-icon-item">
			<div id="btn_connect" class="btn-icon" data-class-disabled="connect_disabled" data-event-click="charsel_connect_click"><span class="btn-icon-label">⇄</span></div>
			<span class="btn-icon-caption">Connect</span>
		</div>
		<div id="btn_delete_item" class="btn-icon-item">
			<div id="btn_delete" class="btn-icon" data-class-disabled="delete_disabled" data-event-click="charsel_delete_click"><span class="btn-icon-label">✕</span></div>
			<span class="btn-icon-caption">Delete</span>
		</div>
	</div>
	<!-- Rarely shown (account has an item-blocked character); fixed, centered, independent of #panel. -->
	<div id="account_block_message" data-class-hidden="account_block_hidden">
		<div class="line-row"><span class="line">{{account_block_line1}}</span></div>
		<div class="line-row"><span class="line">{{account_block_line2}}</span></div>
	</div>
</body>
</rml>
