/* Classic theme for CNewUIPetInfoWindow, the Dark Lord's pet window. 0.97 has no Dark Lord; this is
   the Season 1 client's window (00421e40) over legacy's (whose comments explain the rest): on the
   0.97 frame, two win_button tabs 49 wide every 45 from x 15, the selected one at y 63 (49x20),
   the other at y 67 (49x16) darkened to 0.6; Trading_line (190x10) at y 80 and 380; a frame of
   lines (0.9, 0.9, 0.6) from (12, 90) to (178, 380); no S6 group boxes. The window's otherwise
   hidden frame pieces carry the lines. Without a pet, the red message in the middle of the frame. */

/* Legacy theme for CPetInfoWindow -- #panel/frame sprites/exit button/group-box
   corner-and-fill shape are shared with character_info/my_quest_info/party_info via
   docked_panel_frame.rcss (linked in pet_info.rml before this file) -- only window-specific content
   lives here now. Coordinates below are plain reference px, matching that shared convention. */
.frame-top { decorator: image(docked-bg-top-a); }

/* CRadioGroupButton's own tab sprite -- 2 stacked 56x22 frames (idle then selected); verify frame
   order live, swap the y-offsets below if it renders backwards. */
@spritesheet petinfo-tab-idle-sheet   { src: "../../../newui_guild_tab04.tga"; petinfo-tab-idle:   0px 0px  56px 22px; }
@spritesheet petinfo-tab-active-sheet { src: "../../../newui_guild_tab04.tga"; petinfo-tab-active: 0px 22px 56px 22px; }

@spritesheet petinfo-lifebar-back-sheet { src: "../../../newui_pet_lifebar01.jpg"; petinfo-lifebar-back: 0px 0px 151px 12px; }
@spritesheet petinfo-lifebar-fill-sheet { src: "../../../newui_pet_lifebar02.jpg"; petinfo-lifebar-fill: 0px 0px 1px 8px; }

@spritesheet petinfo-skillbox-sheet { src: "../../../newui_skillbox.jpg"; petinfo-skillbox: 0px 0px 32px 38px; }
/* newui_command.jpg command-icon sheet (CSkillList::IMAGE_COMMAND) -- 4 fixed 19x27 icons at the
   same u-offsets RenderDarkSpiritInfo() used (1/21/41/61), y=0. */
@spritesheet petinfo-skillicon-0-sheet { src: "../../../newui_command.jpg"; petinfo-skillicon-0: 1px 0px 19px 27px; }
@spritesheet petinfo-skillicon-1-sheet { src: "../../../newui_command.jpg"; petinfo-skillicon-1: 21px 0px 19px 27px; }
@spritesheet petinfo-skillicon-2-sheet { src: "../../../newui_command.jpg"; petinfo-skillicon-2: 41px 0px 19px 27px; }
@spritesheet petinfo-skillicon-3-sheet { src: "../../../newui_command.jpg"; petinfo-skillicon-3: 61px 0px 19px 27px; }

#title {
	position: absolute;
	left: 0;
	top: 13px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: token(text-primary);
	font-weight: bold;
	font-size: 1em;
	pointer-events: none;
}

.tab-row { position: absolute; left: 12px; top: 48px; width: 112px; height: 22px; }
.tab-btn {
	position: absolute;
	top: 0;
	width: 56px;
	height: 22px;
	text-align: center;
	line-height: 22px;
	font-size: 1em;
	color: token(text-muted);
	cursor: pointer;
	pointer-events: auto;
	white-space: nowrap;
	overflow: hidden;
	decorator: image(petinfo-tab-idle);
}
.tab-btn.active { color: token(text-primary); decorator: image(petinfo-tab-active); }
.tab-btn-darkhorse { left: 0; }
.tab-btn-darkspirit { left: 56px; }

.pet-tab { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* Native draws it bold in 0xFF0000FF -- an ABGR DWORD, i.e. red -- into a 160x30 text box at
   (15,100) whose background shows as a dark translucent band (the renderer's background colour is
   still set when it draws). */
.pet-no-pet-msg {
	display: block;
	position: absolute;
	left: 15px;
	top: 96px;
	width: calc((100% - 30px) * var(--root-scale));
	height: calc(27px * var(--root-scale));
	padding-top: calc(3px * var(--root-scale));
	color: #ff0000;
	background-color: rgba(0, 28, 48, 150);
	font-weight: bold;
	font-size: 1em;
	text-align: center;
}
/* display: block above would otherwise outrank base.rcss's .hidden (equal specificity, later
   rule) and keep the message up while a pet is equipped. */
.pet-no-pet-msg.hidden { display: none; }

.pet-subtitle {
	display: block;
	position: absolute;
	left: 0;
	top: 25px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	font-size: 1em;
	color: token(text-primary);
	pointer-events: none;
}

/* Group-box shape (.gbox-corner/.gbox-title-fill/.gbox-content-fill/.gbox-title-text) comes from
   docked_panel_frame.rcss -- only per-instance position + which corner sprite stays here. */
.gbox-dh-corner-tl { left: 12px; top: 75px; decorator: image(docked-corner-tl); }
.gbox-dh-corner-tr { right: 10px; top: 75px; decorator: image(docked-corner-tr); }
.gbox-dh-corner-bl { left: 12px; top: 166px; decorator: image(docked-corner-bl); }
.gbox-dh-corner-br { right: 10px; top: 166px; decorator: image(docked-corner-br); }
.gbox-dh-title-fill { left: 15px; top: 77px; width: 52px; height: 20px; }
.gbox-dh-content-fill { left: 15px; top: 97px; right: 14px; height: 78px; }
.gbox-dh-title-text { left: 14px; top: 83px; width: 56px; }

.gbox-ds1-corner-tl { left: 12px; top: 75px; decorator: image(docked-corner-tl); }
.gbox-ds1-corner-tr { right: 10px; top: 75px; decorator: image(docked-corner-tr); }
.gbox-ds1-corner-bl { left: 12px; top: 182px; decorator: image(docked-corner-bl); }
.gbox-ds1-corner-br { right: 10px; top: 182px; decorator: image(docked-corner-br); }
.gbox-ds1-title-fill { left: 15px; top: 77px; width: 52px; height: 20px; }
.gbox-ds1-content-fill { left: 15px; top: 97px; right: 14px; height: 94px; }
.gbox-ds1-title-text { left: 14px; top: 83px; width: 56px; }

.gbox-ds2-corner-tl { left: 12px; top: 196px; decorator: image(docked-corner-tl); }
.gbox-ds2-corner-tr { right: 10px; top: 196px; decorator: image(docked-corner-tr); }
.gbox-ds2-corner-bl { left: 12px; top: 377px; decorator: image(docked-corner-bl); }
.gbox-ds2-corner-br { right: 10px; top: 377px; decorator: image(docked-corner-br); }
.gbox-ds2-title-fill { left: 15px; top: 198px; width: 52px; height: 20px; }
.gbox-ds2-content-fill { left: 15px; top: 218px; right: 14px; height: 168px; }
.gbox-ds2-title-text { left: 14px; top: 204px; width: 56px; }

.pet-stat-text {
	display: block;
	position: absolute;
	left: 22px;
	font-size: 1em;
	color: token(text-primary);
	white-space: nowrap;
	pointer-events: none;
}
.pet-dh-life-text { top: 103px; }
.pet-dh-exp-text { top: 134px; }
.pet-dh-dmg-text { top: 147px; }
.pet-dh-atkspeed-text { top: 160px; }
.pet-ds-life-text { top: 103px; }
.pet-ds-exp-text { top: 134px; }
.pet-ds-dmg-text { top: 147px; }
.pet-ds-atkspeed-text { top: 160px; }
.pet-ds-charisma-text { top: 173px; }

/* HP bar: background sprite + a fill whose width is bound as a percentage of its own 147px max
   (matches RenderDarkHorseInfo/RenderDarkSpiritInfo's own `iHP = min(life,255)*147/255`). */
.hp-bar {
	position: absolute;
	left: 19px;
	width: 151px;
	height: 12px;
	decorator: image(petinfo-lifebar-back);
	pointer-events: none;
}
.hp-bar-dh { top: 115px; }
.hp-bar-ds { top: 115px; }
.hp-bar-fill {
	position: absolute;
	left: 2px;
	top: 2px;
	width: 0%;
	max-width: 147px;
	height: 8px;
	decorator: image(petinfo-lifebar-fill);
	pointer-events: none;
}

.skill-slot {
	position: absolute;
	left: 22px;
	width: 32px;
	height: 38px;
	decorator: image(petinfo-skillbox);
	pointer-events: none;
}
.skill-slot-0 { top: 224px; }
.skill-slot-1 { top: 264px; }
.skill-slot-2 { top: 304px; }
.skill-slot-3 { top: 344px; }

.skill-icon {
	position: absolute;
	left: 29px;
	width: 19px;
	height: 27px;
	pointer-events: none;
}
.skill-icon-0 { top: 230px; decorator: image(petinfo-skillicon-0); }
.skill-icon-1 { top: 270px; decorator: image(petinfo-skillicon-1); }
.skill-icon-2 { top: 310px; decorator: image(petinfo-skillicon-2); }
.skill-icon-3 { top: 350px; decorator: image(petinfo-skillicon-3); }

.skill-label {
	display: block;
	position: absolute;
	left: 14px;
	width: 100px;
	text-align: center;
	font-size: 1em;
	color: token(text-primary);
	pointer-events: none;
}
.skill-label-0 { top: 241px; }
.skill-label-1 { top: 281px; }
.skill-label-2 { top: 321px; }
.skill-label-3 { top: 361px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
.tab-btn.tab-btn-darkhorse { width: calc(56px * var(--root-scale)); height: calc(22px * var(--root-scale)); line-height: calc(22px * var(--root-scale)); }
.tab-btn.tab-btn-darkspirit { width: calc(56px * var(--root-scale)); height: calc(22px * var(--root-scale)); line-height: calc(22px * var(--root-scale)); }
.gbox-title-text.gbox-dh-title-text { width: calc(56px * var(--root-scale)); }
.pet-stat-text.pet-dh-life-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-dh-exp-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-dh-dmg-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-dh-atkspeed-text { width: calc(150px * var(--root-scale)); }
.gbox-title-text.gbox-ds1-title-text { width: calc(56px * var(--root-scale)); }
.pet-stat-text.pet-ds-life-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-ds-exp-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-ds-dmg-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-ds-atkspeed-text { width: calc(150px * var(--root-scale)); }
.pet-stat-text.pet-ds-charisma-text { width: calc(150px * var(--root-scale)); }
.gbox-title-text.gbox-ds2-title-text { width: calc(56px * var(--root-scale)); }
.skill-label.skill-label-0 { width: calc(100px * var(--root-scale)); }
.skill-label.skill-label-1 { width: calc(100px * var(--root-scale)); }
.skill-label.skill-label-2 { width: calc(100px * var(--root-scale)); }
.skill-label.skill-label-3 { width: calc(100px * var(--root-scale)); }

/* The native text size, counter-scaled out of the panel's scale. */
#panel { font-size: calc(var(--text-px) / var(--root-scale)); }

@spritesheet petinfo-classic-tab-sheet { src: "../../../win_button.tga"; petinfo-classic-tab: 0px 0px 49px 16px; }
@spritesheet petinfo-classic-line-sheet { src: ../../../Classic/Trading_line.jpg; petinfo-classic-line: 0px 0px 190px 10px; }

/* The tabs are sharp text (counter-scaled), so their own sizes are reference px times the panel's
   --root-scale, and they take the two-class selectors of legacy's sizes above, which would
   otherwise win over a plain .tab-btn rule. Their places (left, top) stay in the panel's px.
   Season 1's tabs are 49 wide every 45, for its short labels; here they are 78 wide side by side
   across the frame, so "Dark Horse" and "Dark Raven" fit. */
.tab-row { left: 15px; top: 63px; width: 159px; height: 20px; }
.tab-btn {
	top: 4px;
	color: rgb(230, 220, 200);
	image-color: rgb(153, 153, 153);
	decorator: image(petinfo-classic-tab fill);
}
.tab-btn.tab-btn-darkhorse,
.tab-btn.tab-btn-darkspirit { width: calc(78px * var(--root-scale)); height: calc(16px * var(--root-scale)); line-height: calc(16px * var(--root-scale)); }
.tab-btn.active { top: 0; z-index: 1; color: #ffffff; image-color: #ffffff; decorator: image(petinfo-classic-tab fill); }
.tab-btn.active.tab-btn-darkhorse,
.tab-btn.active.tab-btn-darkspirit { height: calc(20px * var(--root-scale)); line-height: calc(20px * var(--root-scale)); }
.tab-btn-darkhorse { left: 0; }
.tab-btn-darkspirit { left: 81px; }

/* No pet: Season 1 writes the message in red (220, 60, 60) over a black copy one pixel down and
   right, centred in the frame at y 220, with no band behind it. */
.pet-no-pet-msg {
	top: 213px;
	height: auto;
	padding-top: 0;
	color: rgb(220, 60, 60);
	background-color: transparent;
	font-effect: shadow(1px 1px black);
}

/* Season 1 has one title; the tab already names the pet, so legacy's subtitle under it goes. */
.pet-subtitle { display: none; }

/* The two Trading_lines (80 and 380) on one piece, the frame of lines on the other. */
.frame-right {
	display: block;
	left: 0;
	top: 80px;
	width: 190px;
	height: 310px;
	decorator: image(petinfo-classic-line contain left top), image(petinfo-classic-line contain left bottom);
}
.frame-bottom {
	display: block;
	left: 12px;
	top: 90px;
	width: 167px;
	height: 291px;
	box-sizing: border-box;
	border-width: 1px;
	border-color: rgb(230, 230, 153);
}

/* No S6 group boxes. */
.gbox-corner, .gbox-title-fill, .gbox-content-fill { display: none; }

/* The pet's level and stats as Season 1 draws them (00412bb0, called from 004222d0 with the window's
   left edge), in the window's units:
   - the level in a Level_box (75x21) at (13, 96), gold (223, 191, 103), centred in the 70 from 14,
     its text top at 100;
   - the life line at (24, 120), then the bar at (24, 135): a 145x8 back in (0.2, 0, 0) and the
     life, life * 143 / 255 wide and 6 high, in (0.882, 0.059, 0) one in from its top-left -- no
     texture;
   - the other lines 15 apart from 150 at x 24, all (230, 230, 230) over a band of black at 50%,
     145 wide. */
@spritesheet petinfo-classic-level-sheet { src: ../../../Classic/Level_box.jpg; petinfo-classic-level: 0px 0px 75px 21px; }

.gbox-title-fill.gbox-dh-title-fill,
.gbox-title-fill.gbox-ds1-title-fill {
	display: block;
	left: 13px;
	top: 96px;
	width: 75px;
	height: 21px;
	background-color: transparent;
	decorator: image(petinfo-classic-level);
}
.gbox-title-text.gbox-dh-title-text,
.gbox-title-text.gbox-ds1-title-text {
	left: 14px;
	top: 99px;
	width: calc(70px * var(--root-scale));
	color: rgb(223, 191, 103);
}

.pet-stat-text.pet-dh-life-text, .pet-stat-text.pet-dh-exp-text, .pet-stat-text.pet-dh-dmg-text,
.pet-stat-text.pet-dh-atkspeed-text,
.pet-stat-text.pet-ds-life-text, .pet-stat-text.pet-ds-exp-text, .pet-stat-text.pet-ds-dmg-text,
.pet-stat-text.pet-ds-atkspeed-text, .pet-stat-text.pet-ds-charisma-text {
	left: 24px;
	width: calc(145px * var(--root-scale));
	color: rgb(230, 230, 230);
	background-color: rgba(0, 0, 0, 128);
}
.pet-dh-life-text, .pet-ds-life-text { top: 119px; }
.pet-dh-exp-text, .pet-ds-exp-text { top: 149px; }
.pet-dh-dmg-text, .pet-ds-dmg-text { top: 164px; }
.pet-dh-atkspeed-text, .pet-ds-atkspeed-text { top: 179px; }
.pet-ds-charisma-text { top: 194px; }

.hp-bar {
	left: 24px;
	width: 145px;
	height: 8px;
	background-color: rgb(51, 0, 0);
	decorator: none;
}
.hp-bar-dh, .hp-bar-ds { top: 135px; }
.hp-bar-fill {
	left: 1px;
	top: 1px;
	max-width: 143px;
	height: 6px;
	background-color: rgb(225, 15, 0);
	decorator: none;
}
