/* Classic (0.97) theme for the generic menu dialog. The in-game Esc menu (kind "system-menu")
   takes the 0.97 look of the client's RenderMessageBox (0051af50), message 0x6e in the game scene:
   five Message_box plates (the 213x64 art squashed to 120x22) at x 260, y 60 + 30*i of the
   640x480 frame, one per button the C++ gives, in its order (Exit game, Select server, Switch
   character, Options, Cancel); no panel art, no header, no darkening. The plate under the mouse
   is redrawn additively in (0.8, 0.6, 0.4) and each label is centred in white at y + 5. The rules
   are at the end of this file, scoped to #panel.system-menu.

   The Chaos Goblin's menu (kind "chaos-mix"), the trainer's (npc-menu, trainer-recover), Lahap's
   (gem-integration, gem-integration-jewel, gem-integration-amount) and Elpis's (elpis,
   elpis-about) take the Season 2 client's boxes (scoped to their kinds, at the end of this file).
   The NPC menus no classic client has (the other npc-menu menus, reset-points, delgardo,
   cherry-blossom) take the trainer's box, and the personal shop's currency menu (menu id
   "personal-shop-price-type", no kind) the same parts in the flowing layout. This file replaces themes/legacy/generic_menu_dialog.rcss whole, so
   every rule below that is not scoped to the system menu is legacy's, verbatim; the four legacy
   rules the system menu drops are marked where they stood. The shell's frame sprites and header
   come from legacy's window_shell.rml/.rcss and are hidden here for the system menu only.

   From legacy: single document (unlike generic_confirm_dialog's fg/bg split) -- no item3D here,
   so no compositing-order problem to solve. Frame/border/header chrome (sprite frame + optional
   title banner) lives in window_shell.rml/.rcss, a template shared with any future consumer --
   not exclusive to this dialog (see that file's own comment). This file supplies only this
   document's own content layout (lines/buttons), not the shell.

   #panel is placed like native's menu boxes (see #panel below); dp throughout (no
   transform:scale(root_scale), like generic_confirm_dialog.rcss), text in rem (RmlNativeText.h). 230dp
   matches native's own MSGBOX_WIDTH and generic_confirm_dialog.rcss's own panel width. The height
   follows the content, as native's per-menu fixed heights were sized to theirs. */
#panel {
	/* Native menu boxes (CChaosMixMenuMsgBox, CTrainerMenuMsgBox, CSeedMasterMenuMsgBox...) sit
	   centred with their top edge at y=60 and are as tall as their content: no centering transform
	   and no fixed height here -- the shell's content box flows (below) and sizes the panel. A
	   consumer that passes its own position (.window-shell-positioned) keeps it. */
	top: 60dp;
	left: 50%;
	margin-left: -115dp;
	transform: none;
	width: 230dp;
	height: auto; /* #panel is the document body, which base.rcss makes full-screen */
	min-height: 117dp;
	font-family: "token(font-body)";
	font-size: 1rem;
	color: token(text-primary);
}
#panel.window-shell-positioned { margin-left: 0; }
/* Below the dialog canvas offset (RmlDialogCanvas.h). */
#panel { margin-top: var(--canvas-top, 0dp); }
/* A menu that names the native box it replaces (GenericMenuConfig::kind) gets that box's top edge
   and fixed height (kinds below); the shell's content box is then placed inside it as
   window_shell.rcss does, and its compact Close button sits where native's does, 20 above the
   bottom edge. */
#panel.native-frame .window-shell-content {
	position: absolute;
	top: 20dp;
	bottom: 28dp;
	left: 16dp;
	right: 16dp;
	margin: 0;
	justify-content: flex-start;
}
#panel.native-frame .window-shell-content.has-title { top: 0; }
/* A native box never scrolls: its buttons sit at fixed offsets inside the fixed frame. */
#panel.native-frame .gmd-button-row { overflow: visible; }
/* Legacy's CSystemMenuMsgBox inset (the first button 23 below the top edge) is dropped: the
   classic system menu's content box is its column of plates (the block at the end of this file). */
#panel.native-frame .gmd-button-cell.compact {
	position: absolute;
	left: 0;
	bottom: -8dp; /* content box ends 28dp above the panel bottom; native Close is 20dp above it */
	margin: 0;
}
/* The shell's content box in flow (window_shell.rcss places it absolutely inside a fixed-height
   panel), with native's text width: MSGBOX_WIDTH less ~16 each side. */
#panel .window-shell-content {
	position: relative;
	top: auto;
	bottom: auto;
	left: auto;
	right: auto;
	margin: 20dp 16dp 28dp 16dp;
	z-index: 1; /* above the shell's absolutely positioned sprite layers */
}
#panel .window-shell-content.has-title { margin-top: 0; }

.gmd-line {
	display: block;
	width: 100%;
	text-align: center;
	white-space: normal;
	color: token(text-primary); /* native menu text is white */
	margin-bottom: 4dp;
}
.gmd-line.bold { font-weight: bold; }
.gmd-lines { display: block; width: 100%; }

/* A native box drew each of its centred lines with RenderText(x + 10, y, text, MSGBOX_WIDTH - 20,
   0, RT3_SORT_CENTER): one line in a 210-wide box, shrunk to it when wider (base.rcss .native-fit).
   The content box is 198 wide (16 inset), so the box reaches 6 past it on each side. */
#panel.native-frame .gmd-line .native-fit { margin: 0 -6dp; }
/* CTrainerRecoverMsgBox draws each pet's status line under its button. */
.gmd-button-cell.lines-below { flex-direction: column-reverse; }
#panel.native-frame .gmd-button-cell.lines-below .gmd-line { line-height: 18dp; margin: 0; }

/* CElpisMsgBox's divider (newui_Message_Line.tga, 223x21) across the box at native_divider_top. */
@spritesheet msgbox-line-sheet
{
	src: "../../../newui_Message_Line.tga";
	msgbox-line-image: 0px 0px 223px 21px;
}
.gmd-divider {
	display: none;
	position: absolute;
	left: -16dp; /* the content box is inset 16dp from the panel edge */
	width: 223dp;
	height: 21dp;
	decorator: image(msgbox-line-image);
}

/* No explicit column count -- row + flex-wrap lets the button count/width and the row's own
   available width determine how many fit per line, same mechanism
   generic_confirm_dialog.rcss's own numeric-keypad grid already proves. Every native consumer's
   fixed 128dp button width only ever fits one per row within this panel, so this naturally
   reproduces their own single-column stack with no config knob needed; a future consumer with
   narrower buttons would simply wrap onto more columns on its own.
   overflow/pointer-events follow the exact same reasoning as .gcd-text-col in
   generic_confirm_dialog.rcss (shorthand order matters for scrollbar creation; pointer-events
   must be re-opted-in or the generated scrollbar can't receive input). */
.gmd-button-row {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: center;
	width: 100%;
	/* No max-height: the panel grows with its content (see #panel), so a percentage cap would
	   resolve against an auto height and hide the whole row. */
	overflow: hidden auto;
	pointer-events: auto;
}
.gmd-button-row scrollbarvertical { width: 6dp; margin: 0; }
.gmd-button-row scrollbarvertical slidertrack { background-color: token(surface-recessed); }
.gmd-button-row scrollbarvertical sliderbar { background-color: token(control-thumb); }
.gmd-button-row scrollbarvertical sliderbar:hover,
.gmd-button-row scrollbarvertical sliderbar:active { background-color: token(control-thumb-hover); }
.gmd-button-row scrollbarvertical sliderarrowdec,
.gmd-button-row scrollbarvertical sliderarrowinc { width: 0; height: 0; }
.gmd-button-row scrollbarhorizontal { height: 0; }

/* Repeated unit of .gmd-button-row -- one button plus its own optional description lines
   (button.lines), stacked in a column so text that belongs to a specific button (e.g.
   CChaosMixMenuMsgBox's per-recipe blurb) renders directly above that button instead of being
   bunched into the shared .gmd-line summary above the whole row. Width mirrors .gmd-btn's own two
   sizes below so .gmd-line's width:100% wraps to the same column the button itself occupies; the
   margin that used to live on .gmd-btn moved here so row spacing is unchanged. Empty
   button.lines (the common case) just means an empty cell around a plain button -- no visual
   difference from before this existed. */
.gmd-button-cell {
	display: flex;
	flex-direction: column;
	align-items: center;
	width: 100%; /* one button per row, as native stacks them; lines span the box */
	margin: 0 0 6dp 0; /* native NPC menus step their buttons 35 apart */
}
/* Legacy's CSystemMenuMsgBox gap (1dp between 29dp buttons, 30 apart) and button width (108dp,
   MSGBOX_BTN_EMPTY_WIDTH) are dropped: the classic plates are at the end of this file. */
.gmd-button-cell.compact { width: 100%; }
/* A button with its own description lines needs a bit more breathing room below it than a plain
   one, so it doesn't read as crowded against whatever's next in the stack. */
.gmd-button-cell.has-lines { margin-bottom: 10dp; }
/* GenericMenuConfig::columns == 2 -- sized to fit exactly 2 per row within .gmd-body's own content
   width, accounting for the WORST case where .gmd-button-row's own vertical scrollbar appears
   (10 buttons in 2 columns = 5 rows, tall enough to need it): 230dp panel - 32dp*2 margins = 166dp,
   - 6dp scrollbar = 160dp available. Margin trimmed to 2dp/side (from the base rule's 3dp) to
   leave more room for the button itself: 2*(width + 4dp cell margin) <= 160dp => width <= 76dp.
   See .gmd-btn.cols-2 below for why this needs its own decorator instead of inheriting .btn's
   fixed-pixel sprite, and for the button's own narrower content width (this engine has no
   box-sizing -- its border/padding add to width, they don't come out of it). */
.gmd-button-cell.cols-2 { width: 76dp; margin: 0 2dp 6dp 2dp; }

/* .btn defaults to position:absolute (base.rcss) -- overridden back to static so buttons flow as
   ordinary flex children, same technique .gcd-item3d-anchor/.btn.gcd-keypad-btn already use in
   generic_confirm_dialog.rcss. 128dp/64dp match native's own two button sizes exactly
   (MSGBOX_BTN_EMPTY_WIDTH/_SMALL_WIDTH, CommonMessageBox.h); 76dp (.cols-2 below) has no native
   equivalent (columns==2 is dialog-only).

   The decorator is native's own button art (sheets below), stretched to each width as native
   stretches it. */
/* Native menu buttons draw newui_btn_empty(_small).tga -- three 29px-tall states stacked, the
   108/64px-wide art stretched to the button -- not the options window's op1_b_all art. */
@spritesheet msgbox-btn-empty-sheet
{
	src: "../../../newui_btn_empty.tga";
	msgbox-btn-empty-idle:   0px  0px 108px 29px;
	msgbox-btn-empty-hover:  0px 29px 108px 29px;
	msgbox-btn-empty-active: 0px 58px 108px 29px;
}
@spritesheet msgbox-btn-empty-small-sheet
{
	src: "../../../newui_btn_empty_small.tga";
	msgbox-btn-empty-small-idle:   0px  0px 64px 29px;
	msgbox-btn-empty-small-hover:  0px 29px 64px 29px;
	msgbox-btn-empty-small-active: 0px 58px 64px 29px;
}
.gmd-btn {
	position: static;
	width: 128dp; /* native menus: MSGBOX_BTN_EMPTY_WIDTH + 20 */
	height: 29dp; /* MSGBOX_BTN_EMPTY_HEIGHT */
	line-height: 29dp;
	decorator: image(msgbox-btn-empty-idle);
}
.gmd-btn:hover { decorator: image(msgbox-btn-empty-hover); }
.gmd-btn:active { decorator: image(msgbox-btn-empty-active); }
.gmd-btn.narrow { width: 108dp; } /* MSGBOX_BTN_EMPTY_WIDTH (CGemIntegrationMsgBox) */
.gmd-btn.compact { width: 64dp; decorator: image(msgbox-btn-empty-small-idle); }
.gmd-btn.compact:hover { decorator: image(msgbox-btn-empty-small-hover); }
.gmd-btn.compact:active { decorator: image(msgbox-btn-empty-small-active); }
/* GenericMenuConfig::columns == 2 -- see .gmd-button-cell.cols-2 above for the width math (decorators
   don't consume box-model space like border/padding do, so this matches the cell exactly, no
   subtraction needed). Every button keeps the art's 29dp height: a long jewel name (e.g. "Higher
   Refining Stone") wraps onto a second line set close under the first, the label centred in the
   button. Idle/hover/active decorators are inherited unchanged from the base .gmd-btn rules above. */
.gmd-btn.cols-2 {
	width: 76dp;
	display: flex;
	align-items: center;
	justify-content: center;
	white-space: normal;
}
/* Text lives in its own element (not raw text directly in .gmd-btn) purely so a decorator change
   here doesn't require touching the shared markup structure again; no stacking-order concerns
   remain now that there's no separate absolutely-positioned fill sibling to compete with (an
   element's own decorator always paints before its children are rendered). */
.gmd-btn-label {
	display: block;
	width: 100%;
	white-space: nowrap; /* native draws a label on one line, even past the art's edge */
}
.gmd-btn.cols-2 .gmd-btn-label { padding: 0 2dp; line-height: 1.0; white-space: normal; }
/* .btn.disabled (base.rcss) already gives the exact look a disabled menu button needs --
   data-class-disabled="!button.enabled" just toggles that existing class, no new rule needed. */

/* GenericMenuConfig::highlightTitle: native's highlight orange (CChaosMixMenuMsgBox's title). */
#panel.highlight-title .window-shell-header-title { color: #ff8000; }

/* The native boxes, by GenericMenuConfig::kind. Each sits at its top edge (60 unless given) and is
   67 (top cap) + 15 per middle strip + 50 (bottom cap) tall. Offsets inside are from the panel's
   top edge: the containing block is the shell's content box, which starts there in a titled box
   and 20 lower in an untitled one. */
/* system-menu is dropped from this pair (legacy: CSystemMenuMsgBox at 100, 192 tall): the classic
   system menu takes 0.97's place and size at the end of this file. */
#panel[data-kind="gem-integration"] { top: 100dp; height: 192dp; }
#panel[data-kind="cherry-blossom"] { height: 237dp; }
#panel[data-kind="npc-menu"], #panel[data-kind="trainer-recover"],
#panel[data-kind="reset-points"], #panel[data-kind="delgardo"] { height: 222dp; }
#panel[data-kind="elpis"], #panel[data-kind="elpis-about"] { height: 297dp; }
#panel[data-kind="chaos-mix"] { height: 312dp; }
#panel[data-kind="gem-integration-jewel"], #panel[data-kind="gem-integration-amount"] { top: 100dp; height: 267dp; }

/* Where the box's RenderTexts() drew the lines: the first one's text top less half the line gap
   (the glyphs, 9 tall, centre in their line box), one advance apart. */
#panel[data-kind="npc-menu"] .gmd-lines, #panel[data-kind="trainer-recover"] .gmd-lines,
#panel[data-kind="elpis"] .gmd-lines, #panel[data-kind="elpis-about"] .gmd-lines,
#panel[data-kind="reset-points"] .gmd-lines, #panel[data-kind="delgardo"] .gmd-lines {
	position: absolute;
	left: 0;
	right: 0;
	width: auto;
	top: 38.5dp; /* text at 43, 18 apart */
	line-height: 18dp;
}
#panel[data-kind="reset-points"] .gmd-lines { top: 48.5dp; } /* text at 53 */
#panel[data-kind="delgardo"] .gmd-lines { top: 46.5dp; line-height: 12dp; } /* text at 48, 12 apart */
#panel[data-kind] .gmd-lines .gmd-line { margin-bottom: 0; }
/* CElpisMsgBox's "about" texts: left-aligned, wrapped inside an inset (its x+30). */
#panel[data-kind="elpis-about"] .gmd-lines { left: 16dp; right: 16dp; }
#panel[data-kind="elpis-about"] .gmd-lines .gmd-line { text-align: left; }
/* CElpisMsgBox's divider under the text. */
#panel[data-kind="elpis"] .gmd-divider, #panel[data-kind="elpis-about"] .gmd-divider { display: block; top: 120dp; }

/* The buttons at the box's offsets (the Close button stays 20 above the bottom edge unless given). */
#panel[data-kind="gem-integration"] .gmd-button-cell,
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(-n+3),
#panel[data-kind="npc-menu"] .gmd-button-cell:nth-child(-n+2),
#panel[data-kind="delgardo"] .gmd-button-cell:nth-child(-n+2),
#panel[data-kind="trainer-recover"] .gmd-button-cell:nth-child(-n+2),
#panel[data-kind="elpis"] .gmd-button-cell:nth-child(-n+3),
#panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(-n+3),
#panel[data-kind="reset-points"] .gmd-button-cell:nth-child(1) {
	position: absolute;
	left: 0;
	right: 0;
	width: auto;
	margin: 0;
}
/* CGemIntegrationMsgBox: untitled, BTN_TOP_BLANK 60 then 40 apart, Close included. */
#panel[data-kind="gem-integration"] .gmd-button-cell:nth-child(1) { top: 40dp; }
#panel[data-kind="gem-integration"] .gmd-button-cell:nth-child(2) { top: 80dp; }
#panel[data-kind="gem-integration"] .gmd-button-cell:nth-child(3) { top: 120dp; bottom: auto; }
#panel[data-kind="npc-menu"] .gmd-button-cell:nth-child(1),
#panel[data-kind="delgardo"] .gmd-button-cell:nth-child(1) { top: 85dp; }
#panel[data-kind="npc-menu"] .gmd-button-cell:nth-child(2),
#panel[data-kind="delgardo"] .gmd-button-cell:nth-child(2) { top: 120dp; }
#panel[data-kind="trainer-recover"] .gmd-button-cell:nth-child(1) { top: 65dp; }
#panel[data-kind="trainer-recover"] .gmd-button-cell:nth-child(2) { top: 115dp; }
#panel[data-kind="elpis"] .gmd-button-cell:nth-child(1), #panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(1) { top: 145dp; }
#panel[data-kind="elpis"] .gmd-button-cell:nth-child(2), #panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(2) { top: 175dp; }
#panel[data-kind="elpis"] .gmd-button-cell:nth-child(3), #panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(3) { top: 205dp; }
#panel[data-kind="reset-points"] .gmd-button-cell:nth-child(1) { top: 105dp; }

/* CGemIntegrationUnityMsgBox, which showed the jewels and then, in the same box, the amounts:
   untitled, its lines centred from the top as the flow sets them, the buttons from 50 below the
   top edge (30 in the content box). The jewels two per row, MSGBOX_BTN_EMPTY_SMALL_WIDTH + 20 (84)
   wide at x 20 and 124 (4 and 108 here), 34 apart; the amounts one per row, 128 wide at x 50,
   39 apart. Close 20 above the bottom edge, as in every native box. */
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(-n+10),
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) {
	position: absolute;
	width: auto;
	margin: 0;
}
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2 { width: 84dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(odd) { left: 4dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(even) { left: 108dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(1),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(2) { top: 30dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(3),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(4) { top: 64dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(5),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(6) { top: 98dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(7),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(8) { top: 132dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(9),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(10) { top: 166dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) { left: 34dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(1) { top: 30dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(2) { top: 69dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(3) { top: 108dp; }
/* The Close cell (the 11th, compact) keeps the native-frame rule's left: 0. */
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell.compact { left: 0; }

/* CChaosMixMenuMsgBox: each recipe's lines 15 apart from their own top (40, 125, 210, less half
   the line gap), one line each as native draws them (a wrapped line would run into the button),
   and the button 3 below them (at 85, 155, 225). */
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(1) { top: 37dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(2) { top: 122dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(3) { top: 207dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(-n+3) .gmd-line {
	white-space: nowrap;
	margin-bottom: 0;
	line-height: 15dp;
}
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(-n+3) .gmd-btn { margin-top: 3dp; }

/* The classic (0.97) system menu: RenderMessageBox (0051af50), message 0x6e in the game scene.
   Five Message_box plates (213x64, drawn squashed to 120x22) stacked at x 260, y 60 + 30*i of the
   640x480 frame -- Exit game, Select server, Switch character, Options, Cancel, the five buttons
   ShowSystemMenuDialog (CustomMessageBox.cpp) gives, in that order -- with no panel art, no header
   and no darkening. The plate under the mouse is lit (0.97 redraws it additively in (0.8, 0.6,
   0.4)) and its label is centred in white at y + 5 (1rem text centred in the 22dp plate). 1dp is
   one unit of the dialog canvas, as for every box above. Scoped to #panel.system-menu
   (data-class-system-menu) so no rule reaches the NPC menus. The menu still drags by any part that
   is not a plate (GenericMenuDialog.cpp); the plates are .btn (base.rcss: drag: block) and keep
   their data-hint tooltips. */
@spritesheet classic-sysmenu-plate-sheet { src: ../../../Classic/Message_box.jpg; classic-sysmenu-plate: 0px 0px 213px 64px; }

/* The S6 frame (newui_msgbox_* back, top, middle, bottom) and title rail of window_shell.rcss:
   0.97 draws nothing around its plates. */
#panel.system-menu .window-shell-sprite-back,
#panel.system-menu .window-shell-sprite-top,
#panel.system-menu .window-shell-sprite-middle,
#panel.system-menu .window-shell-sprite-bottom,
#panel.system-menu .window-shell-header-rail { display: none; }

/* The column of plates: 120 wide from x 260 (60 left of the frame's centre), its top edge at y 60,
   142 tall (five plates 30 apart, 22 each: y 60 to 202), below the dialog canvas offset like every
   #panel above. */
#panel.system-menu {
	top: 60dp;
	width: 120dp;
	height: 142dp;
	margin-left: -60dp;
}
/* The content box is the column itself: the first plate sits at its top edge. */
#panel.system-menu.native-frame .window-shell-content { top: 0; bottom: 0; left: 0; right: 0; }
/* 30 apart: 22 of plate, 8 of gap. */
#panel.system-menu .gmd-button-cell { margin-bottom: 8dp; }
/* Each button is one plate. The id-scoped rule outranks .gmd-btn's :hover/:active art above, so
   the plate stays under the mouse and the press: 0.97 has no pressed plate, only the lit one.
   0.97 lights it by drawing it again additively in (0.8, 0.6, 0.4), i.e. the plate times
   (1.8, 1.6, 1.4), clamped: image-color #ffe3c6 is that ratio with red at full (the value the
   scene menu's sys_menu.rcss uses) and brightness(1.8) scales it back up to (1.8, 1.6, 1.4)
   (brightness() is a verified filter of this renderer, engine-findings.md). The white label is
   already at full, so the filter leaves it white. */
#panel.system-menu .gmd-btn {
	width: 120dp;
	height: 22dp;
	line-height: 22dp;
	decorator: image(classic-sysmenu-plate);
}
#panel.system-menu .gmd-btn:hover {
	image-color: #ffe3c6;
	filter: brightness(1.8);
}
#panel.system-menu .gmd-btn-label { color: #ffffff; }

/* The Chaos Goblin's menu (kind "chaos-mix", CChaosMixMenuMsgBox). 0.97 opens the Chaos Machine
   straight from the goblin; this menu is the Season 2 client's message box 0x8e (RE\mains2:
   drawn in 006a9ad0, clicked in 0069ed30's 0x8e branch), in the 640x480 frame:
   - the box: Message_box2 (213x5) at (213, 60), five Message_box1 strips (213x40) each stretched
     to 213x60 from y 65, Message_box2 again at y 365 -- 213x310, no title banner;
   - the title (text 734) bold, orange (255, 128, 0), centred, its text top at y 75;
   - three buttons, Message_box (213x64) squashed to 150x35 at x 245, y 130, 215 and 300, tinted
     0.7 grey and drawn white while the mouse is over them; their labels bold, (200, 240, 255),
     centred, text top 12 under the button's;
   - each button's lines regular, white, left-aligned at x 248, 10 apart, the text tops at 90,
     100 and 110 (the first button), 180 and 190 (the second), 270 (the third) -- centred here
     (below);
   - no Close button: the box closes with the Chaos Machine (Esc here, GenericMenuConfig's
     onCancel, the Close button's own action).
   Positions below are from the box's top-left (213, 60). The stone is the derived
   Message_box1_60x5 (tools/classic_theme/make_classic_derived_textures.py): five strips already
   stretched to 60, drawn unscaled. */
@spritesheet classic-cm-edge-sheet  { src: ../../../Classic/Message_box2.jpg;      classic-cm-edge: 0px 0px 213px 5px; }
@spritesheet classic-cm-stone-sheet { src: ../../../Classic/Message_box1_60x5.jpg; classic-cm-stone: 0px 0px 213px 300px; }
@spritesheet classic-cm-plate-sheet { src: ../../../Classic/Message_box.jpg;       classic-cm-plate: 0px 0px 213px 64px; }

#panel[data-kind="chaos-mix"] {
	width: 213dp;
	height: 310dp;
	margin-left: -106.5dp;
}
#panel[data-kind="chaos-mix"] .window-shell-sprite-back,
#panel[data-kind="chaos-mix"] .window-shell-header-rail { decorator: none; }
#panel[data-kind="chaos-mix"] .window-shell-sprite-top { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="chaos-mix"] .window-shell-sprite-middle { top: 5dp; bottom: 5dp; decorator: image(classic-cm-stone fill); }
#panel[data-kind="chaos-mix"] .window-shell-sprite-bottom { height: 5dp; decorator: image(classic-cm-edge); }

/* The title: a 10 line box around its text top at 15 (the glyphs, 9 tall, centre in it). */
#panel[data-kind="chaos-mix"] .window-shell-header-title {
	top: 14.5dp;
	line-height: 10dp;
	color: #ff8000;
}

/* The content box is the whole box, so every offset below is from its top-left. */
#panel[data-kind="chaos-mix"].native-frame .window-shell-content { top: 0; bottom: 0; left: 0; right: 0; }

/* Each recipe's lines: 10 apart, the first line box 0.5 above its text top. Season 2 starts them
   at x 35 (248), left-aligned, but MuMain's lines are longer than its and ran into the box's
   right edge there: they are centred instead, between the stone's golden sides (8 in from each
   edge), and a line wider than that is drawn smaller to fit it (.native-fit). */
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(1) { top: 29.5dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(2) { top: 119.5dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(3) { top: 209.5dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(-n+3) .gmd-line {
	align-self: stretch; /* the cell centres its children: the line spans it instead */
	width: auto;
	margin: 0 8dp;
	line-height: 10dp;
	text-align: center;
}
#panel[data-kind="chaos-mix"].native-frame .gmd-line .native-fit { margin: 0; }

/* The buttons at y 70, 155 and 240 of the box, below their 3, 2 and 1 lines. The id-scoped
   rules outrank .gmd-btn's :hover/:active art above, so the plate stays under the mouse and the
   press: Season 2 only draws it white. The label's text top is 12 under the button's: a 33 line
   box from its top. */
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(1) .gmd-btn { margin-top: 10.5dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(2) .gmd-btn { margin-top: 15.5dp; }
#panel[data-kind="chaos-mix"] .gmd-button-cell:nth-child(3) .gmd-btn { margin-top: 20.5dp; }
#panel[data-kind="chaos-mix"] .gmd-btn {
	width: 150dp;
	height: 35dp;
	line-height: 33dp;
	image-color: rgb(179, 179, 179);
	decorator: image(classic-cm-plate fill);
}
#panel[data-kind="chaos-mix"] .gmd-btn:hover,
#panel[data-kind="chaos-mix"] .gmd-btn:active { image-color: #ffffff; decorator: image(classic-cm-plate fill); }
#panel[data-kind="chaos-mix"] .gmd-btn-label { font-weight: bold; color: rgb(200, 240, 255); }

/* Season 2's box has no Close button. */
#panel[data-kind="chaos-mix"] .gmd-button-cell.compact { display: none; }

/* The NPC menus of kind "npc-menu" (the trainer, and the Lucky Item, seed master and seed researcher
   menus, which no classic client has and which take the trainer's box) and the trainer's pet
   recovery (kind "trainer-recover"): the Season 2 client's trainer boxes (RE\mains2: 00462c5b and
   00463377), in the 640x480 frame:
   - the box: Message_box2 (213x5) at (213, 90), five Message_box1 rows (213x40) from y 90, and
     Message_box2 again at y 290 -- 213x205;
   - the title (text 1227) bold, centred on x 319 at y 100; Season 2 writes it black over a band of
     (200, 200, 200) at 78%, which the theme takes orange (255, 128, 0) and bandless instead, as the
     Chaos Goblin's and Lahap's titles (the user's choice);
   - the lines centred on x 319, (200, 200, 200), their text tops at 120 and 140;
   - two Message_box plates (213x64) squashed to 120x22 at x 259: at y 180
     and 210 in the menu, 150 and 210 in the recovery; their labels gold (223, 191, 103), text top
     5 under the plate's, drawn bold under the mouse; the recovery's status line 30 under each
     plate's top;
   - Close is exit_01 (24x24) at (394, 265), with no label.
   The stat reset helper (reset-points), Delgado (delgardo) and the cherry blossom menu, which no
   classic client has, take the same box: their lines from 30, 20 apart, and their buttons at 90 and
   120 (Delgado's three lines end above them), 90 (the reset's one) or 60, 90 and 120 (the cherry
   blossom's three).
   Positions below are from the box's top-left (213, 90). The stone is the derived
   Message_box1_40x7 (seven rows, unscaled), cut to the rows the box shows. */
@spritesheet classic-tr-stone-sheet { src: ../../../Classic/Message_box1_40x7.jpg; classic-tr-stone: 0px 5px 213px 195px; classic-lh-stone: 0px 0px 213px 240px; classic-lj-stone: 0px 0px 213px 280px; }
@spritesheet classic-tr-plate-sheet { src: ../../../Classic/Message_box.jpg; classic-tr-plate: 0px 0px 213px 64px; }
@spritesheet classic-tr-exit-sheet  { src: ../../../Classic/Exit_01.jpg; classic-tr-exit: 0px 0px 24px 24px; }
@spritesheet classic-tr-exit2-sheet { src: ../../../Classic/Exit_02.jpg; classic-tr-exit-pressed: 0px 0px 24px 24px; }

#panel[data-kind="npc-menu"], #panel[data-kind="trainer-recover"], #panel[data-kind="reset-points"], #panel[data-kind="delgardo"], #panel[data-kind="cherry-blossom"] {
	top: 90dp;
	width: 213dp;
	height: 205dp;
	margin-left: -106.5dp;
}
#panel[data-kind="npc-menu"] .window-shell-sprite-back, #panel[data-kind="trainer-recover"] .window-shell-sprite-back, #panel[data-kind="reset-points"] .window-shell-sprite-back, #panel[data-kind="delgardo"] .window-shell-sprite-back, #panel[data-kind="cherry-blossom"] .window-shell-sprite-back,
#panel[data-kind="npc-menu"] .window-shell-header-rail, #panel[data-kind="trainer-recover"] .window-shell-header-rail, #panel[data-kind="reset-points"] .window-shell-header-rail, #panel[data-kind="delgardo"] .window-shell-header-rail, #panel[data-kind="cherry-blossom"] .window-shell-header-rail { decorator: none; }
#panel[data-kind="npc-menu"] .window-shell-sprite-top, #panel[data-kind="trainer-recover"] .window-shell-sprite-top, #panel[data-kind="reset-points"] .window-shell-sprite-top, #panel[data-kind="delgardo"] .window-shell-sprite-top, #panel[data-kind="cherry-blossom"] .window-shell-sprite-top { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="npc-menu"] .window-shell-sprite-middle, #panel[data-kind="trainer-recover"] .window-shell-sprite-middle, #panel[data-kind="reset-points"] .window-shell-sprite-middle, #panel[data-kind="delgardo"] .window-shell-sprite-middle, #panel[data-kind="cherry-blossom"] .window-shell-sprite-middle { top: 5dp; bottom: 5dp; decorator: image(classic-tr-stone fill); }
#panel[data-kind="npc-menu"] .window-shell-sprite-bottom, #panel[data-kind="trainer-recover"] .window-shell-sprite-bottom, #panel[data-kind="reset-points"] .window-shell-sprite-bottom, #panel[data-kind="delgardo"] .window-shell-sprite-bottom, #panel[data-kind="cherry-blossom"] .window-shell-sprite-bottom { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="npc-menu"].native-frame .window-shell-content,
#panel[data-kind="trainer-recover"].native-frame .window-shell-content,
#panel[data-kind="reset-points"].native-frame .window-shell-content,
#panel[data-kind="delgardo"].native-frame .window-shell-content,
#panel[data-kind="cherry-blossom"].native-frame .window-shell-content { top: 0; bottom: 0; left: 0; right: 0; }

/* The title: a 13 line box at 10. */
#panel[data-kind="npc-menu"] .window-shell-header-title, #panel[data-kind="trainer-recover"] .window-shell-header-title, #panel[data-kind="reset-points"] .window-shell-header-title, #panel[data-kind="delgardo"] .window-shell-header-title, #panel[data-kind="cherry-blossom"] .window-shell-header-title {
	left: 5dp;
	right: 5dp;
	top: 10dp;
	line-height: 13dp;
	color: #ff8000;
}

/* The lines: 20 apart, their text tops at 30 and 50 (a 20 line box 5.5 above each). */
#panel[data-kind="npc-menu"] .gmd-lines, #panel[data-kind="trainer-recover"] .gmd-lines, #panel[data-kind="reset-points"] .gmd-lines, #panel[data-kind="delgardo"] .gmd-lines, #panel[data-kind="cherry-blossom"] .gmd-lines { top: 24.5dp; line-height: 20dp; }
#panel[data-kind="npc-menu"] .gmd-lines .gmd-line, #panel[data-kind="trainer-recover"] .gmd-lines .gmd-line, #panel[data-kind="reset-points"] .gmd-lines .gmd-line, #panel[data-kind="delgardo"] .gmd-lines .gmd-line, #panel[data-kind="cherry-blossom"] .gmd-lines .gmd-line { color: rgb(200, 200, 200); }

/* The plates at 90 and 120 (menu), 60 and 120 (recovery), 46 from the box's left. The kind-scoped
   rules outrank .gmd-btn's :hover/:active art above: Season 2 only draws the label bold. A label
   longer than the plate (other languages, the menus Season 2 doesn't have) widens it, centred. */
#panel[data-kind="npc-menu"] .gmd-button-cell:nth-child(1) { top: 90dp; }
#panel[data-kind="npc-menu"] .gmd-button-cell:nth-child(2) { top: 120dp; }
#panel[data-kind="trainer-recover"] .gmd-button-cell:nth-child(1) { top: 60dp; }
#panel[data-kind="trainer-recover"] .gmd-button-cell:nth-child(2) { top: 120dp; }
#panel[data-kind="reset-points"] .gmd-button-cell:nth-child(1),
#panel[data-kind="delgardo"] .gmd-button-cell:nth-child(1) { top: 90dp; }
#panel[data-kind="delgardo"] .gmd-button-cell:nth-child(2) { top: 120dp; }
#panel[data-kind="cherry-blossom"] .gmd-button-cell:nth-child(1) { top: 60dp; }
#panel[data-kind="cherry-blossom"] .gmd-button-cell:nth-child(2) { top: 90dp; }
#panel[data-kind="cherry-blossom"] .gmd-button-cell:nth-child(3) { top: 120dp; }
#panel[data-kind="npc-menu"] .gmd-btn, #panel[data-kind="trainer-recover"] .gmd-btn, #panel[data-kind="reset-points"] .gmd-btn, #panel[data-kind="delgardo"] .gmd-btn, #panel[data-kind="cherry-blossom"] .gmd-btn,
#panel[data-kind="npc-menu"] .gmd-btn:hover, #panel[data-kind="trainer-recover"] .gmd-btn:hover, #panel[data-kind="reset-points"] .gmd-btn:hover, #panel[data-kind="delgardo"] .gmd-btn:hover, #panel[data-kind="cherry-blossom"] .gmd-btn:hover,
#panel[data-kind="npc-menu"] .gmd-btn:active, #panel[data-kind="trainer-recover"] .gmd-btn:active, #panel[data-kind="reset-points"] .gmd-btn:active, #panel[data-kind="delgardo"] .gmd-btn:active, #panel[data-kind="cherry-blossom"] .gmd-btn:active {
	width: auto;
	min-width: 120dp;
	padding: 0 6dp;
	height: 22dp;
	line-height: 21dp;
	decorator: image(classic-tr-plate fill);
}
#panel[data-kind="npc-menu"] .gmd-btn-label, #panel[data-kind="trainer-recover"] .gmd-btn-label, #panel[data-kind="reset-points"] .gmd-btn-label, #panel[data-kind="delgardo"] .gmd-btn-label, #panel[data-kind="cherry-blossom"] .gmd-btn-label { color: rgb(223, 191, 103); }
#panel[data-kind="npc-menu"] .gmd-btn:hover .gmd-btn-label, #panel[data-kind="trainer-recover"] .gmd-btn:hover .gmd-btn-label, #panel[data-kind="reset-points"] .gmd-btn:hover .gmd-btn-label, #panel[data-kind="delgardo"] .gmd-btn:hover .gmd-btn-label, #panel[data-kind="cherry-blossom"] .gmd-btn:hover .gmd-btn-label { font-weight: bold; }
/* The recovery's status line under each plate, its text top 30 under the plate's. */
#panel[data-kind="trainer-recover"].native-frame .gmd-button-cell.lines-below .gmd-line { margin-top: 2.5dp; line-height: 10dp; }

/* Close: exit_01 at (181, 175), its label hidden. */
#panel[data-kind="npc-menu"].native-frame .gmd-button-cell.compact,
#panel[data-kind="trainer-recover"].native-frame .gmd-button-cell.compact,
#panel[data-kind="reset-points"].native-frame .gmd-button-cell.compact,
#panel[data-kind="delgardo"].native-frame .gmd-button-cell.compact,
#panel[data-kind="cherry-blossom"].native-frame .gmd-button-cell.compact {
	left: 181dp;
	right: auto;
	top: 175dp;
	bottom: auto;
	width: 24dp;
}
#panel[data-kind="npc-menu"] .gmd-btn.compact, #panel[data-kind="trainer-recover"] .gmd-btn.compact, #panel[data-kind="reset-points"] .gmd-btn.compact, #panel[data-kind="delgardo"] .gmd-btn.compact, #panel[data-kind="cherry-blossom"] .gmd-btn.compact,
#panel[data-kind="npc-menu"] .gmd-btn.compact:hover, #panel[data-kind="trainer-recover"] .gmd-btn.compact:hover, #panel[data-kind="reset-points"] .gmd-btn.compact:hover, #panel[data-kind="delgardo"] .gmd-btn.compact:hover, #panel[data-kind="cherry-blossom"] .gmd-btn.compact:hover {
	width: 24dp;
	min-width: 0;
	padding: 0;
	height: 24dp;
	decorator: image(classic-tr-exit);
}
#panel[data-kind="npc-menu"] .gmd-btn.compact:active, #panel[data-kind="trainer-recover"] .gmd-btn.compact:active, #panel[data-kind="reset-points"] .gmd-btn.compact:active, #panel[data-kind="delgardo"] .gmd-btn.compact:active, #panel[data-kind="cherry-blossom"] .gmd-btn.compact:active { width: 24dp; min-width: 0; padding: 0; height: 24dp; decorator: image(classic-tr-exit-pressed); }
#panel[data-kind="npc-menu"] .gmd-btn.compact .gmd-btn-label, #panel[data-kind="trainer-recover"] .gmd-btn.compact .gmd-btn-label, #panel[data-kind="reset-points"] .gmd-btn.compact .gmd-btn-label, #panel[data-kind="delgardo"] .gmd-btn.compact .gmd-btn-label, #panel[data-kind="cherry-blossom"] .gmd-btn.compact .gmd-btn-label { visibility: hidden; }

/* Lahap's jewel menu (kind "gem-integration"): the Season 2 client's message box 0xa1 (RE\mains2:
   drawn in 006a9ad0), in the 640x480 frame:
   - the box: Message_box2 (213x5) at (213, 120), six Message_box1 rows (213x40) from y 125, and
     Message_box2 again at y 365 -- 213x250;
   - the title (text 1801, MuMain's first line, bold orange) centred, its text top about 15 under
     the box's, as the Chaos Goblin's;
   - the lines (texts 1802 and 1803) white, left-aligned at x 248, their text tops at 150 and 160;
   - two Message_box plates squashed to 150x35 at x 245, y 190 and 255, tinted 0.7 grey and drawn
     white under the mouse; their labels bold, (200, 240, 255), centred, 12 under the plate's top;
   - Close: a Message_box plate squashed to 81x25 at (279, 320), tinted 0.8 grey and white under
     the mouse, its label like the others, 8 under its top.
   Positions below are from the box's top-left (213, 120). */
#panel[data-kind="gem-integration"] {
	top: 120dp;
	width: 213dp;
	height: 250dp;
	margin-left: -106.5dp;
}
#panel[data-kind="gem-integration"] .window-shell-sprite-back,
#panel[data-kind="gem-integration"] .window-shell-header-rail { decorator: none; }
#panel[data-kind="gem-integration"] .window-shell-sprite-top { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="gem-integration"] .window-shell-sprite-middle { top: 5dp; bottom: 5dp; decorator: image(classic-lh-stone fill); }
#panel[data-kind="gem-integration"] .window-shell-sprite-bottom { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="gem-integration"].native-frame .window-shell-content { top: 0; bottom: 0; left: 0; right: 0; }

/* The title line centred at 15; the two lines under it left-aligned at 35, at 30 and 40 (10 line
   boxes, 0.5 above each text top). */
#panel[data-kind="gem-integration"] .gmd-lines {
	position: absolute;
	left: 0;
	right: 0;
	width: auto;
	top: 14.5dp;
	line-height: 10dp;
}
#panel[data-kind="gem-integration"] .gmd-lines .gmd-line { margin-bottom: 0; padding-left: 35dp; text-align: left; white-space: nowrap; }
#panel[data-kind="gem-integration"] .gmd-lines .gmd-line:first-child { margin-bottom: 5dp; padding-left: 0; text-align: center; }

#panel[data-kind="gem-integration"] .gmd-button-cell:nth-child(1) { top: 70dp; }
#panel[data-kind="gem-integration"] .gmd-button-cell:nth-child(2) { top: 135dp; }
#panel[data-kind="gem-integration"] .gmd-btn,
#panel[data-kind="gem-integration"] .gmd-btn.narrow {
	width: 150dp;
	height: 35dp;
	line-height: 33dp;
	image-color: rgb(179, 179, 179);
	decorator: image(classic-tr-plate fill);
}
#panel[data-kind="gem-integration"] .gmd-btn:hover,
#panel[data-kind="gem-integration"] .gmd-btn:active { image-color: #ffffff; decorator: image(classic-tr-plate fill); }
#panel[data-kind="gem-integration"] .gmd-btn-label { font-weight: bold; color: rgb(200, 240, 255); }
#panel[data-kind="gem-integration"] .gmd-button-cell:nth-child(3) { top: 200dp; bottom: auto; }
#panel[data-kind="gem-integration"] .gmd-btn.compact {
	width: 81dp;
	height: 25dp;
	line-height: 25dp;
	image-color: rgb(204, 204, 204);
	decorator: image(classic-tr-plate fill);
}
#panel[data-kind="gem-integration"] .gmd-btn.compact:hover,
#panel[data-kind="gem-integration"] .gmd-btn.compact:active { image-color: #ffffff; decorator: image(classic-tr-plate fill); }

/* Lahap's jewel and amount menus (kinds "gem-integration-jewel" and "gem-integration-amount"): the
   Season 2 client's message box 0xa2 (RE\mains2: drawn in 006a9ad0), which shows both in one box,
   in the 640x480 frame:
   - the box: Message_box2 (213x5) at (213, 120), seven Message_box1 rows from y 125, and
     Message_box2 again at y 405 -- 213x290;
   - its lines (texts 1804 and 1805) white, left-aligned at x 238, their text tops at 150 and 160
     (the title as on Lahap's first box, centred at 15);
   - the jewels on Message_box plates squashed to 80x25, two to a row at x 235 and 325 (Season 2
     has only Bless and Soul, MuMain ten jewels: five rows, 30 apart from y 185), tinted 0.5 grey
     and white under the mouse, their labels white, (200, 240, 255) under the mouse;
   - the amounts on plates squashed to 170x35 at x 235, 45 apart (from y 225, under the jewels;
     MuMain shows them on their own, from the jewels' row, y 185), tinted 0.7 grey and white under
     the mouse, their labels (200, 240, 255), centred (bold in Season 2, whose labels are shorter;
     MuMain's don't fit the plate in bold);
   - Close: a plate squashed to 81x25 at (279, 365), as on Lahap's first box.
   Positions below are from the box's top-left (213, 120). */
#panel[data-kind="gem-integration-jewel"], #panel[data-kind="gem-integration-amount"] {
	top: 120dp;
	width: 213dp;
	height: 290dp;
	margin-left: -106.5dp;
}
#panel[data-kind="gem-integration-jewel"] .window-shell-sprite-back, #panel[data-kind="gem-integration-amount"] .window-shell-sprite-back,
#panel[data-kind="gem-integration-jewel"] .window-shell-header-rail, #panel[data-kind="gem-integration-amount"] .window-shell-header-rail { decorator: none; }
#panel[data-kind="gem-integration-jewel"] .window-shell-sprite-top, #panel[data-kind="gem-integration-amount"] .window-shell-sprite-top { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="gem-integration-jewel"] .window-shell-sprite-middle, #panel[data-kind="gem-integration-amount"] .window-shell-sprite-middle { top: 5dp; bottom: 5dp; decorator: image(classic-lj-stone fill); }
#panel[data-kind="gem-integration-jewel"] .window-shell-sprite-bottom, #panel[data-kind="gem-integration-amount"] .window-shell-sprite-bottom { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-kind="gem-integration-jewel"].native-frame .window-shell-content,
#panel[data-kind="gem-integration-amount"].native-frame .window-shell-content { top: 0; bottom: 0; left: 0; right: 0; }

/* The title centred at 15; the line under it left-aligned at 25, at 30. */
#panel[data-kind="gem-integration-jewel"] .gmd-lines, #panel[data-kind="gem-integration-amount"] .gmd-lines {
	position: absolute;
	left: 0;
	right: 0;
	width: auto;
	top: 14.5dp;
	line-height: 10dp;
}
#panel[data-kind="gem-integration-jewel"] .gmd-lines .gmd-line, #panel[data-kind="gem-integration-amount"] .gmd-lines .gmd-line { margin-bottom: 0; padding-left: 25dp; text-align: left; white-space: nowrap; }
#panel[data-kind="gem-integration-jewel"] .gmd-lines .gmd-line:first-child, #panel[data-kind="gem-integration-amount"] .gmd-lines .gmd-line:first-child { margin-bottom: 5dp; padding-left: 0; text-align: center; }

/* The jewels: 80x25 at 22 and 112, rows at 65, 95, 125, 155 and 185. A long name wraps onto two
   10-unit lines inside the plate. */
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(odd) { left: 22dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(even) { left: 112dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(1),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(2) { top: 65dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(3),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(4) { top: 95dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(5),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(6) { top: 125dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(7),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(8) { top: 155dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(9),
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell:nth-child(10) { top: 185dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2,
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2:hover,
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2:active {
	width: 80dp;
	height: 25dp;
	image-color: rgb(128, 128, 128);
	decorator: image(classic-tr-plate fill);
}
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2:hover,
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2:active { image-color: #ffffff; }
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2 .gmd-btn-label { line-height: 10dp; color: #ffffff; }
#panel[data-kind="gem-integration-jewel"] .gmd-btn.cols-2:hover .gmd-btn-label { color: rgb(200, 240, 255); }

/* The amounts: 170x35 at 22, rows at 65, 110 and 155. */
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) { left: 22dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(1) { top: 65dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(2) { top: 110dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(3) { top: 155dp; }
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) .gmd-btn,
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) .gmd-btn:hover,
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) .gmd-btn:active {
	width: 170dp;
	height: 35dp;
	line-height: 33dp;
	image-color: rgb(179, 179, 179);
	decorator: image(classic-tr-plate fill);
}
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) .gmd-btn:hover,
#panel[data-kind="gem-integration-amount"] .gmd-button-cell:nth-child(-n+3) .gmd-btn:active { image-color: #ffffff; }
#panel[data-kind="gem-integration-amount"] .gmd-btn-label { color: rgb(200, 240, 255); }

/* Close: 81x25 at (66, 245). */
#panel[data-kind="gem-integration-jewel"] .gmd-button-cell.compact,
#panel[data-kind="gem-integration-amount"] .gmd-button-cell.compact { left: 66dp; right: auto; top: 245dp; bottom: auto; width: 81dp; }
#panel[data-kind="gem-integration-jewel"] .gmd-btn.compact, #panel[data-kind="gem-integration-amount"] .gmd-btn.compact,
#panel[data-kind="gem-integration-jewel"] .gmd-btn.compact:hover, #panel[data-kind="gem-integration-amount"] .gmd-btn.compact:hover,
#panel[data-kind="gem-integration-jewel"] .gmd-btn.compact:active, #panel[data-kind="gem-integration-amount"] .gmd-btn.compact:active {
	width: 81dp;
	height: 25dp;
	line-height: 25dp;
	image-color: rgb(204, 204, 204);
	decorator: image(classic-tr-plate fill);
}
#panel[data-kind="gem-integration-jewel"] .gmd-btn.compact:hover, #panel[data-kind="gem-integration-amount"] .gmd-btn.compact:hover,
#panel[data-kind="gem-integration-jewel"] .gmd-btn.compact:active, #panel[data-kind="gem-integration-amount"] .gmd-btn.compact:active { image-color: #ffffff; }
#panel[data-kind="gem-integration-jewel"] .gmd-btn.compact .gmd-btn-label,
#panel[data-kind="gem-integration-amount"] .gmd-btn.compact .gmd-btn-label { font-weight: bold; color: rgb(200, 240, 255); }

/* The personal shop's currency menu (menu id "personal-shop-price-type"): no classic client has
   it, and no native box drew it, so it keeps the flowing layout and takes the classic box's
   parts, as the menus the trainer's box stands in for: the stone between the two edges, the
   title in orange, the currencies on the trainer's plates (120x22, gold labels). */
#panel[data-id="personal-shop-price-type"] .window-shell-sprite-back,
#panel[data-id="personal-shop-price-type"] .window-shell-header-rail { decorator: none; }
#panel[data-id="personal-shop-price-type"] .window-shell-sprite-top { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-id="personal-shop-price-type"] .window-shell-sprite-middle { top: 5dp; bottom: 5dp; decorator: image(classic-lj-stone fill); }
#panel[data-id="personal-shop-price-type"] .window-shell-sprite-bottom { height: 5dp; decorator: image(classic-cm-edge); }
#panel[data-id="personal-shop-price-type"] .window-shell-header-title { color: #ff8000; }
#panel[data-id="personal-shop-price-type"] .gmd-btn,
#panel[data-id="personal-shop-price-type"] .gmd-btn:hover,
#panel[data-id="personal-shop-price-type"] .gmd-btn:active {
	width: 120dp;
	height: 22dp;
	line-height: 22dp;
	margin: 3dp 0;
	image-color: rgb(204, 204, 204);
	decorator: image(classic-tr-plate fill);
}
#panel[data-id="personal-shop-price-type"] .gmd-btn:hover,
#panel[data-id="personal-shop-price-type"] .gmd-btn:active { image-color: #ffffff; }
#panel[data-id="personal-shop-price-type"] .gmd-btn-label { color: rgb(223, 191, 103); }
#panel[data-id="personal-shop-price-type"] .gmd-btn:hover .gmd-btn-label { font-weight: bold; }

/* Elpis (kinds "elpis" and "elpis-about"): the Season 2 client's window (RE\mains2: built in
   006d3959, drawn in the method that calls 006d3f52, buttons placed in 006d3b05), in the 640x480
   frame:
   - the box: 214x250 at (213, 65): Message_box2 (5) at the top, six Message_box1 rows from 5, and
     Message_box2 at 245; in the menu, two more Message_box2 strips across it at 30 and 145;
   - the title (text 2206) white, from x 10 at y 15;
   - the text in (255, 176, 73), left-aligned from (20, 50), 15 apart (MuMain passes its own colour
     with the lines, so they keep it);
   - three win_button buttons (49x16) drawn at 100x20, centred, at y 156, 189 and 222: tinted 0.8,
     white under the mouse, 0.6 while pressed; their labels (230, 220, 200), centred.
   Season 2's menu has no Close button (Esc does the same), so MuMain's is hidden. Its "about" pages
   show only an OK button; here they keep the menu's three buttons and drop the two strips.
   Positions below are from the box's top-left (213, 65). */
@spritesheet classic-elpis-btn-sheet { src: "../../../win_button.tga"; classic-elpis-btn: 0px 0px 49px 16px; }

#panel[data-kind="elpis"], #panel[data-kind="elpis-about"] {
	top: 65dp;
	width: 214dp;
	height: 250dp;
	margin-left: -107dp;
}
#panel[data-kind="elpis"] .window-shell-sprite-back, #panel[data-kind="elpis-about"] .window-shell-sprite-back,
#panel[data-kind="elpis-about"] .window-shell-header-rail { decorator: none; }
#panel[data-kind="elpis"] .window-shell-sprite-top, #panel[data-kind="elpis-about"] .window-shell-sprite-top { height: 5dp; decorator: image(classic-cm-edge fill); }
#panel[data-kind="elpis"] .window-shell-sprite-middle, #panel[data-kind="elpis-about"] .window-shell-sprite-middle { top: 5dp; bottom: 5dp; decorator: image(classic-lh-stone fill); }
#panel[data-kind="elpis"] .window-shell-sprite-bottom, #panel[data-kind="elpis-about"] .window-shell-sprite-bottom { height: 5dp; decorator: image(classic-cm-edge fill); }
#panel[data-kind="elpis"].native-frame .window-shell-content,
#panel[data-kind="elpis-about"].native-frame .window-shell-content { top: 0; bottom: 0; left: 0; right: 0; }

/* The menu's two strips: the shell's title rail at 30, the divider at 145. */
#panel[data-kind="elpis"] .window-shell-header-rail { top: 30dp; height: 5dp; decorator: image(classic-cm-edge fill); }
#panel[data-kind="elpis"] .gmd-divider { display: block; left: 0; top: 145dp; width: 214dp; height: 5dp; decorator: image(classic-cm-edge fill); }
#panel[data-kind="elpis-about"] .gmd-divider { display: none; }

/* The title: a 10 line box around its text top at 15. */
#panel[data-kind="elpis"] .window-shell-header-title, #panel[data-kind="elpis-about"] .window-shell-header-title {
	left: 10dp;
	right: 10dp;
	top: 14.5dp;
	line-height: 10dp;
	color: #ffffff;
}

/* The text from (20, 50), 15 apart, wrapped inside the stone's sides. */
#panel[data-kind="elpis"] .gmd-lines, #panel[data-kind="elpis-about"] .gmd-lines {
	left: 20dp;
	right: 20dp;
	top: 47dp;
	line-height: 15dp;
}
#panel[data-kind="elpis"] .gmd-lines .gmd-line, #panel[data-kind="elpis-about"] .gmd-lines .gmd-line { font-weight: normal; text-align: left; }

#panel[data-kind="elpis"] .gmd-button-cell:nth-child(1), #panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(1) { top: 156dp; }
#panel[data-kind="elpis"] .gmd-button-cell:nth-child(2), #panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(2) { top: 189dp; }
#panel[data-kind="elpis"] .gmd-button-cell:nth-child(3), #panel[data-kind="elpis-about"] .gmd-button-cell:nth-child(3) { top: 222dp; }
#panel[data-kind="elpis"] .gmd-btn, #panel[data-kind="elpis-about"] .gmd-btn,
#panel[data-kind="elpis"] .gmd-btn:hover, #panel[data-kind="elpis-about"] .gmd-btn:hover {
	width: 100dp;
	height: 20dp;
	line-height: 20dp;
	image-color: rgb(204, 204, 204);
	decorator: image(classic-elpis-btn fill);
}
#panel[data-kind="elpis"] .gmd-btn:hover, #panel[data-kind="elpis-about"] .gmd-btn:hover { image-color: #ffffff; }
#panel[data-kind="elpis"] .gmd-btn:active, #panel[data-kind="elpis-about"] .gmd-btn:active { image-color: rgb(153, 153, 153); decorator: image(classic-elpis-btn fill); }
#panel[data-kind="elpis"] .gmd-btn-label, #panel[data-kind="elpis-about"] .gmd-btn-label { color: rgb(230, 220, 200); }
#panel[data-kind="elpis"] .gmd-button-cell.compact, #panel[data-kind="elpis-about"] .gmd-button-cell.compact { display: none; }
