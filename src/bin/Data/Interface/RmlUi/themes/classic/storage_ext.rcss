/* Classic theme for the extended storage. 0.97 has none; it takes the 0.97 storage's parts: the
   inventory frame (Item_Back01 over Item_Back02), the white bold title, 0.97's Close at (20, 395).
   Legacy's layout and comments below. */

/* Legacy theme for CStorageInventoryExt's chrome (frame/title/exit button). #panel's left/top/
   scale come live from C++ (SyncRmlModel()), so coordinates below are plain reference px, not dp. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

#title {
	position: absolute;
	left: 0;
	top: 11px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: token(text-primary);
	font-weight: bold;
	font-size: 1em;
}

@spritesheet ext-btn-exit-sheet { src: "../../../newui_exit_00.tga"; ext-btn-exit: 0px 0px 36px 29px; }
.ext-btn {
	position: absolute;
	left: 13px;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(ext-btn-exit);
}
.ext-btn:hover { filter: brightness(1.25); }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 36px; width: calc(8 * var(--item-cell)); height: calc(15 * var(--item-cell)); }

/* The frame. */
@spritesheet ext-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   ext-bg-fill:   0px 0px 190px 429px; }
@spritesheet ext-bg-top-sheet    { src: "../../../newui_item_back01.tga";   ext-bg-top:    0px 0px 190px 64px;  }
@spritesheet ext-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; ext-bg-left:   0px 0px 21px 320px;  }
@spritesheet ext-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; ext-bg-right:  0px 0px 21px 320px;  }
@spritesheet ext-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   ext-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;    top: 0;    width: 190px; height: 429px; decorator: image(ext-bg-fill); }
.bg-top    { left: 0;    top: 0;    width: 190px; height: 64px;  decorator: image(ext-bg-top); }
.bg-left   { left: 0;    top: 64px; width: 21px;  height: 320px; decorator: image(ext-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(ext-bg-right); }
.bg-bottom { left: 0;    top: 384px; width: 190px; height: 45px; decorator: image(ext-bg-bottom); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { margin-left: calc(50% - 50% * var(--root-scale)); }

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
#panel { font-size: calc(var(--text-px, 12px) / var(--root-scale)); }

/* --- Classic ---------------------------------------------------------------------------------- */
@spritesheet classic-sext-back1-sheet { src: ../../../Classic/Item_back01.jpg; classic-sext-back1: 0px 0px 190px 256px; }
@spritesheet classic-sext-back2-sheet { src: ../../../Classic/Item_Back02.jpg; classic-sext-back2: 0px 0px 190px 177px; }
@spritesheet classic-sext-exit-sheet  { src: ../../../Classic/Exit_01.jpg; classic-sext-exit: 0px 0px 24px 24px; }
@spritesheet classic-sext-exit2-sheet { src: ../../../Classic/Exit_02.jpg; classic-sext-exit-pressed: 0px 0px 24px 24px; }
#panel { height: 433px; }
.bg-fill { top: 256px; height: 177px; decorator: image(classic-sext-back2); }
.bg-top  { height: 256px; decorator: image(classic-sext-back1); }
.bg-left, .bg-right, .bg-bottom { display: none; }
#frame_corner_close { display: none; }
.ext-btn { left: 20px; top: 395px; width: 24px; height: 24px; decorator: image(classic-sext-exit); }
.ext-btn:hover { filter: none; }
.ext-btn:active { decorator: image(classic-sext-exit-pressed); }
/* Centred as the extended inventory's: legacy's margin shifts this sharp-text title out of the window. */
#title { color: #ffffff; margin-left: 0; }
