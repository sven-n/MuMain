/* Classic (0.97) item grids: inventory, storage, trade, shop and Chaos Machine all drew their
   cells the same way in 0.97:
   an empty cell is Interface\Item_box (32x32 shrunk to the 20-unit pitch), a cell under an item is
   Interface\InventoryBox2 (its 20x21 corner) tinted by the item's state, and there is no frame
   around the grid. The items, the drop preview and the stack counts are as in legacy.
   CInventoryCtrl::FollowGrid() reads --item-cell back for the hit tests. */

@spritesheet classic-item-cell-sheet { src: ../../../Classic/Item_box.jpg; classic-item-cell: 0px 0px 32px 32px; }
@spritesheet classic-item-cell-used-sheet { src: ../../../Classic/InventoryBox2.jpg; classic-item-cell-used: 0px 0px 20px 21px; }

body { --item-cell: 20px; }

.item-grid, .item-grid-counts { position: absolute; pointer-events: none; }
.item-grid-cells, .item-grid-counts { display: flex; flex-wrap: wrap; }
.item-grid-cells { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }

.item-cell, .item-count { position: relative; flex: 0 0 var(--item-cell); width: var(--item-cell); height: var(--item-cell); }
.item-cell-art { position: absolute; left: 0; top: 0; width: var(--item-cell); height: var(--item-cell); decorator: image(classic-item-cell); }

/* Under an item: the darker square, white, or the 0.97 wear colours (0.8 0.7 0, 0.8 0.5 0,
   0.8 0.3 0.3, then red); an untradeable item takes 0.97's red-orange. */
.item-cell.tint-normal .item-cell-art,
.item-cell.tint-durability-50 .item-cell-art,
.item-cell.tint-durability-70 .item-cell-art,
.item-cell.tint-durability-80 .item-cell-art,
.item-cell.tint-durability-100 .item-cell-art,
.item-cell.tint-untradeable .item-cell-art { decorator: image(classic-item-cell-used); }
.item-cell.tint-durability-50 .item-cell-art { image-color: #ccb300; }
.item-cell.tint-durability-70 .item-cell-art { image-color: #cc8000; }
.item-cell.tint-durability-80 .item-cell-art { image-color: #cc4d4d; }
.item-cell.tint-durability-100 .item-cell-art { image-color: #ff0000; }
.item-cell.tint-untradeable .item-cell-art { image-color: #ff331a; }

.item-cell-drop { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.item-cell.drop-free .item-cell-drop { background-color: rgba(26, 102, 204, 102); }
.item-cell.drop-blocked .item-cell-drop, .item-cell.drop-invalid .item-cell-drop { background-color: rgba(255, 51, 51, 102); }
.item-cell.drop-valid .item-cell-drop { background-color: rgba(51, 102, 51, 102); }

.item-grid-frame { display: none; }

.item-count-text {
	position: absolute;
	right: 0;
	top: 1px;
	transform-origin: right top;
	white-space: nowrap;
	font-weight: bold;
	color: #ffffff;
	font-effect: outline(1px #000000);
}

.item-view { position: absolute; left: -20px; top: -20px; width: 230px; height: 469px; pointer-events: none; }
