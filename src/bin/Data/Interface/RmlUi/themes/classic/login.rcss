/* Classic (0.97) login box. Positions, sizes and colours from the 0.97 client:
   - 0Account_new (250x216) centred horizontally, resting at y=266 of 480 with its bottom 2 px
     below the screen, sliding up when it appears;
   - the Connect and Exit plates are part of the background art; the button art only lights up
     under the mouse (0On_Botton / 0On_Botton2);
   - text colour (255, 230, 210).
   1 original pixel = 1/480 of the screen height, as the 0.97 client scales its 2D art. */

@spritesheet classic-login-sheet
{
	src: ../../../../Logo/Classic/0account_new.tga;
	classic-login-back: 0px 0px 250px 216px;
}

@spritesheet classic-login-ok-sheet
{
	src: ../../../../Logo/Classic/0on_botton.jpg;
	classic-login-ok-hover: 0px 0px 70px 19px;
}

@spritesheet classic-login-exit-sheet
{
	src: ../../../../Logo/Classic/0on_botton2.jpg;
	classic-login-exit-hover: 0px 0px 70px 20px;
}

@keyframes classic-login-rise
{
	from { transform: translateY(100%); }
	to   { transform: translateY(0%); }
}

body {
	width: 100%;
	height: 100%;
	margin: 0;
	pointer-events: none;
	--px: calc(100vh / 480);
}

/* LoginWin.cpp still moves this one; the classic box is placed by the stylesheet instead. */
#panel {
	position: absolute;
	width: 0;
	height: 0;
}

#classic_box {
	position: absolute;
	left: 50%;
	bottom: calc(-2 * var(--px));
	width: calc(250 * var(--px));
	height: calc(216 * var(--px));
	margin-left: calc(-125 * var(--px));
	font-family: "token(font-body)";
	color: #ffe6d2;
	decorator: image(classic-login-back);
	pointer-events: auto;
	animation: 0.45s cubic-out 1 classic-login-rise;
}

.label {
	position: absolute;
	left: calc(32 * var(--px));
	white-space: nowrap;
}
.label-account  { top: calc(50 * var(--px)); }
.label-password { top: calc(72 * var(--px)); }

.login-field {
	position: absolute;
	left: calc(100 * var(--px));
	width: calc(119 * var(--px));
	height: calc(16 * var(--px));
	padding: 0;
	color: #ffe6d2;
	background-color: transparent;
	border-width: 0;
	box-shadow: none;
	decorator: none;
}
.login-field-account  { top: calc(48 * var(--px)); }
.login-field-password { top: calc(70 * var(--px)); }

.btn {
	position: absolute;
	width: calc(70 * var(--px));
	text-align: center;
	cursor: pointer;
	pointer-events: auto;
	decorator: none;
}
.btn-text {
	color: #ffffff;
}
.btn-ok {
	left: calc(128 * var(--px));
	top: calc(95 * var(--px));
	height: calc(19 * var(--px));
	line-height: calc(19 * var(--px));
}
.btn-ok:hover {
	decorator: image(classic-login-ok-hover);
}
.btn-cancel {
	left: calc(90 * var(--px));
	top: calc(180 * var(--px));
	height: calc(20 * var(--px));
	line-height: calc(20 * var(--px));
}
.btn-cancel:hover {
	decorator: image(classic-login-exit-hover);
}

/* The S6 "remember me" / "save password" options: the 0.97 box has neither. */
#classic_box .checkbox-row { display: none; }
