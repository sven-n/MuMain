/* Classic theme for the reconnect dialog (a MuMain feature: no original). It takes the 0.97 box and
   the progress bar of the Season 1 client's message box (00625a20): a 0.97 box 213 x 130
   (Message_box1 stones between Message_box2 edges) under the dim, the three lines (230, 220, 200)
   centred at y 14 / 32 / 50, Progress_back (150 x 12) at (31, 70) with the fill over the same
   rectangle (the two textures are drawn to overlay; its additive draw carried by the derived
   Progress_add), and 0.97's Cancel (70 x 21, Cancel2 under the mouse) at (71, 99). The stones
   are two elements stretched to the box (this document is in px under the C++ scale, where a
   repeated sprite takes a larger natural size and cuts the box's right border). Legacy's rules first, then the classic ones. */

/* Legacy theme for the reconnect dialog, reproducing UI::Reconnect's native drawing: a black dim
   over the whole screen (its alpha bound), then a 230 x 122 message-box panel -- newui_msgbox_back
   (222 x 112 from y 2), newui_msgbox_top (67), one newui_msgbox_middle strip stretched to 5,
   newui_msgbox_bottom (50) --, the newui_Bar_switch01 gauge (160 x 18 at 35, 66) with its
   newui_Bar_switch02 fill (inset 5, up to 150 x 8), the newui_button_cancel button (54 x 30 at
   88, 86; its hover row 30 below) and the lines in (230, 220, 200). Above every other document,
   the tooltip included: the original drew it after the whole frame. Reference px inside #panel. */

@spritesheet rc-back-sheet { src: "../../../newui_msgbox_back.jpg"; rc-back: 0px 0px 222px 242px; }
@spritesheet rc-top-sheet { src: "../../../newui_msgbox_top.tga"; rc-top: 0px 0px 230px 67px; }
@spritesheet rc-middle-sheet { src: "../../../newui_msgbox_middle.tga"; rc-middle: 0px 0px 230px 15px; }
@spritesheet rc-bottom-sheet { src: "../../../newui_msgbox_bottom.tga"; rc-bottom: 0px 0px 230px 50px; }
@spritesheet rc-progress-back-sheet { src: "../../../newui_Bar_switch01.jpg"; rc-progress-back: 0px 0px 160px 18px; }
@spritesheet rc-progress-bar-sheet { src: "../../../newui_Bar_switch02.jpg"; rc-progress-bar: 0px 0px 150px 8px; }
@spritesheet rc-cancel-sheet
{
	src: "../../../newui_button_cancel.tga";
	rc-cancel: 0px 0px 54px 30px;
	rc-cancel-over: 0px 30px 54px 30px;
}

body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; font-family: "token(font-body)"; }
#dim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000; pointer-events: none; }
#panel { position: absolute; transform-origin: left top; width: 230px; height: 122px; pointer-events: none; }
#back { position: absolute; left: 0; top: 2px; width: 222px; height: 112px; decorator: image(rc-back); }
#box_top { position: absolute; left: 0; top: 0; width: 230px; height: 67px; decorator: image(rc-top); }
#box_middle { position: absolute; left: 0; top: 67px; width: 230px; height: 5px; decorator: image(rc-middle); }
#box_bottom { position: absolute; left: 0; top: 72px; width: 230px; height: 50px; decorator: image(rc-bottom); }
#progress_back { position: absolute; left: 35px; top: 66px; width: 160px; height: 18px; decorator: image(rc-progress-back); }
#progress_bar { position: absolute; left: 40px; top: 71px; height: 8px; decorator: image(rc-progress-bar); }
#cancel { position: absolute; left: 88px; top: 86px; width: 54px; height: 30px; decorator: image(rc-cancel); pointer-events: auto; }
#cancel:hover { decorator: image(rc-cancel-over); }

.sharp-text { display: block; position: absolute; white-space: nowrap; pointer-events: none; }
.line { color: rgb(230, 220, 200); }

/* The status lines' own rows (PANEL_Y + 12 / 30 / 48) and the panel-wide centring box. */
.line { left: 0; text-align: center; }
#rc_title { top: 12px; font-weight: bold; }
#rc_step { top: 30px; }
#rc_countdown { top: 48px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#rc_title { width: calc(230px * var(--root-scale)); }
#rc_step { width: calc(230px * var(--root-scale)); }
#rc_countdown { width: calc(230px * var(--root-scale)); }

/* --- Classic ---------------------------------------------------------------------------------- */
@spritesheet rc-classic-stone-sheet { src: ../../../Classic/Message_box1.jpg; rc-classic-stone: 0px 0px 213px 40px; }
@spritesheet rc-classic-edge-sheet  { src: ../../../Classic/Message_box2.jpg; rc-classic-edge: 0px 0px 213px 5px; }
@spritesheet rc-classic-pback-sheet { src: ../../../Classic/Progress_back.jpg; rc-classic-pback: 0px 0px 200px 16px; }
@spritesheet rc-classic-pfill-sheet { src: ../../../Classic/Progress_add.tga; rc-classic-pfill: 0px 0px 200px 16px; }
@spritesheet rc-classic-cancel-sheet  { src: ../../../Classic/Cancel.jpg; rc-classic-cancel: 0px 0px 70px 21px; }
@spritesheet rc-classic-cancel2-sheet { src: ../../../Classic/Cancel2.jpg; rc-classic-cancel-over: 0px 0px 70px 21px; }
#panel { width: 213px; height: 130px; }
#back { left: 0; top: 5px; width: 213px; height: 60px; decorator: image(rc-classic-stone fill); }
#box_top { left: 0; top: 0; width: 213px; height: 5px; decorator: image(rc-classic-edge fill); }
#box_middle { left: 0; top: 65px; width: 213px; height: 60px; decorator: image(rc-classic-stone fill); }
#box_bottom { left: 0; top: 125px; width: 213px; height: 5px; decorator: image(rc-classic-edge fill); }
#progress_back { left: 31px; top: 70px; width: 150px; height: 12px; decorator: image(rc-classic-pback fill); }
#progress_bar { left: 31px; top: 70px; height: 12px; decorator: image(rc-classic-pfill fill); }
#cancel { left: 71px; top: 99px; width: 70px; height: 21px; decorator: image(rc-classic-cancel fill); }
#cancel:hover { decorator: image(rc-classic-cancel-over fill); }
#rc_title { top: 14px; }
#rc_step { top: 32px; }
#rc_countdown { top: 50px; }
#rc_title, #rc_step, #rc_countdown { width: calc(213px * var(--root-scale)); }
