/* Classic (0.97) chat log: no window, the messages at the top-left corner from y 13, each line on
   a strip the size of its text, coloured by type as 0.97's RenderMessages (00480980) coloured
   them. The workspace
   (classic workspace.rcss) puts the window at the top-left corner. With the frame on (F5) it
   becomes 0.97's "nis" window there (end of this file). */

#panel.workspace-placed { transform-origin: left top; }
#panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 281dp;
	font-family: "token(font-body)";
	font-size: 1rem;
	pointer-events: none;
}

/* The window fill, split three ways: whether it paints at all is frame state (.framed, native's
   own RenderBackground() m_bShowFrame guard), how opaque it is comes from the user's cycled
   transparency setting as a bound opacity, and its whole appearance is this rule's. #chat_backdrop sits
   behind #lines so the fade never touches the text.

   Flat black here because that is what the original drew -- not a constraint. A theme can make this
   a gradient, a ninepatch or a sprite by changing this one rule; `decorator` works, and the bound
   opacity fades a decorator exactly as it fades a colour (see themes/modern/chat_log.rcss, which
   does use a gradient). */
#chat_backdrop {
	display: none;
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
	bottom: 0;
	z-index: 0;
	background-color: rgb(0, 0, 0);
}
#panel.framed #chat_backdrop { display: block; }
/* Above the backdrop, and unfaded. */
#lines { position: relative; z-index: 1; }

/* Drag target for the 3-line-step resize. Native draws newui_Scrollbar_stretch across the full
   window width, 10 tall, sitting just above the top edge. */
@spritesheet chat-resize-sheet {
	src: "../../../newui_Scrollbar_stretch.jpg";
	chat-resize: 0px 0px 281px 10px;
}
#resize_handle {
	position: absolute;
	left: 0;
	bottom: -10dp;
	width: 281dp;
	height: 10dp;
	decorator: image(chat-resize);
	cursor: move;
	pointer-events: auto;
}
#resize_handle:active { filter: brightness(0.7); }

/* Messages stack from the BOTTOM up: with fewer lines than the window shows, native pushed the
   text down by (showingLines - endLine - 1) line heights (RenderMessages()), so the first message
   sits on the bottom row and earlier ones ride upward as new ones arrive. A flex column plus an
   auto top margin on the first line reproduces that exactly, and degrades correctly once the list
   overflows -- an auto margin absorbs free space when there is any and resolves to 0 when there
   isn't, so it never pushes content out of the scrollable area the way justify-content:flex-end
   would. */
#lines {
	position: absolute;
	left: 0;
	top: 13dp;
	right: 4dp;
	font-size: 11dp;
	display: flex;
	flex-direction: column;
	/* Lines hug their own text rather than stretching to the pane: native passed no box width to
	   RenderText(), so the text renderer fell back to the MEASURED width for its background quad
	   (CUIRenderTextSDLTtf.cpp -- `if (layout.boxWidth == 0) boxWidth = measuredWidth`). Flex
	   defaults to align-items:stretch, which made every line a full-width bar instead. */
	align-items: flex-start;
}
/* 0.97 filled its six rows from the top. */

/* The message well must NOT be a hover target. Core::Input::IsMouseOverUI() gates click-to-move
   on Rml::Context::IsMouseInteracting(), which is true for ANY pointer-events:auto element under
   the cursor -- clicked or not -- so leaving .scroll-pane's own `pointer-events: auto` in place
   here turned the whole chat area into a wall the player could not walk through. Native let world
   clicks pass straight through this window (its UpdateMouseEvent() only consumed on the single
   hover-transition frame), so nothing here may claim the cursor except the two controls that
   genuinely need it. */
#lines { pointer-events: none; }
.chat-line { pointer-events: none; }

/* The scrollbar is the exception, and it has to opt back in explicitly at every level: its
   generated children inherit pointer-events from #lines, which is now `none`. */
#lines scrollbarvertical,
#lines scrollbarvertical slidertrack,
#lines scrollbarvertical sliderbar { pointer-events: auto; }

/* Native's RenderFrame() draws the scrollbar AND the resize handle only while the frame is
   shown, so hiding the frame (F5) takes the scrollbar with it. Width 0 rather than
   overflow:hidden: native still scrolls on the wheel with the frame hidden (its wheel branch is
   gated on hover, not on m_bShowFrame), and overflow:hidden would kill that too. */
#lines scrollbarvertical { width: 0; }
#panel.framed #lines scrollbarvertical { width: 15dp; }

/* No padding: native's background quad is exactly the measured text (RenderText() without a box).
   Text size, height and the 15-unit row pitch come from chat_log.rml's bindings. flex-shrink 0:
   with an explicit height, a flex item would otherwise shrink to fit a full well and the rows
   would crowd together instead of scrolling. */
.chat-line {
	display: block;
	white-space: nowrap;
	flex-shrink: 0;
	/* A line is the native renderer's line height, and the next starts a row pitch below it. */
	height: var(--line-px, 0px);
	line-height: var(--line-px, 0px);
	margin-bottom: calc(var(--row-px, 0px) - var(--line-px, 0px));
}

/* Per-type colours: 0.97's (00480980) for the types it had -- normal chat beige on black, whisper
   black on yellow, system blue, error red, party black on cyan, guild black on blue; the S6-only
   types keep legacy's. */
.chat-line--chat    { background-color: rgba(0, 0, 0, 150);      color: rgb(230, 220, 200); }
.chat-line--whisper { background-color: rgba(255, 200, 50, 150); color: rgb(0, 0, 0); }
.chat-line--system  { background-color: rgba(0, 0, 0, 150);      color: rgb(100, 150, 255); }
.chat-line--error   { background-color: rgba(0, 0, 0, 150);      color: rgb(255, 30, 0); }
.chat-line--party   { background-color: rgba(0, 200, 255, 150);  color: rgb(0, 0, 0); }
.chat-line--guild   { background-color: rgb(8, 72, 251);         color: rgb(0, 0, 0); }
.chat-line--union   { background-color: rgba(200, 200, 0, 200);  color: rgb(0, 0, 0); }
.chat-line--gens    { background-color: rgba(150, 200, 100, 200); color: rgb(0, 0, 0); }
.chat-line--gm      { background-color: rgba(30, 30, 30, 200);   color: rgb(250, 200, 50); font-weight: bold; }

/* Native drops chat-line background alpha from 150 to 100 while the frame is shown, so the frame's
   own fill reads through it -- the one per-type colour that depends on frame state. */
#panel.framed .chat-line--chat { background-color: rgba(0, 0, 0, 100); }

/* Native's pointed-message highlight. NOT a :hover rule -- these lines are pointer-events:none
   so world clicks pass through, which also means they never receive hover. C++ resolves the
   pointed line itself and pushes its index, exactly as native's own
   m_bPointedMessage/m_iPointedMessageIndex pair did. */
.chat-line--pointed {
	background-color: rgba(30, 30, 30, 180);
	color: rgb(255, 128, 255);
}

/* The framed window (F5): 0.97's "nis" window (0040ce20), 268 wide: Message_box2 along the
   top, nis_vframe down both sides, the black fill (its alpha the transparency setting) inside
   them, the text 10 units in,
   the scrollbar on nis_back with the nis_bar thumb and nis_btnarrow ends (the lower one flipped),
   and the nis_rsframe grip at the top-right corner to drag the height. Lines on black lose their
   strip in the window; whisper, party and guild keep theirs. */
@spritesheet classic-nis-top-sheet   { src: ../../../Classic/Message_box2_268.jpg; classic-nis-top: 0px 0px 268px 5px; }
@spritesheet classic-nis-side-sheet  { src: ../../../Classic/Nis_vframe_tall.jpg; classic-nis-side: 0px 0px 5px 480px; }
@spritesheet classic-nis-back-sheet  { src: ../../../Classic/Nis_back.jpg;     classic-nis-back: 0px 0px 13px 1px; }
@spritesheet classic-nis-bar-sheet   { src: ../../../Classic/Nis_bar.jpg;      classic-nis-bar: 0px 0px 11px 1px; }
@spritesheet classic-nis-arrow-sheet { src: ../../../Classic/Nis_btnarrow.jpg; classic-nis-arrow: 0px 0px 13px 13px; }
@spritesheet classic-nis-grip-sheet  { src: ../../../Classic/Nis_rsframe.tga;  classic-nis-grip: 0px 0px 22px 12px; }

#panel.framed {
	width: 268dp;
	/* 0.97's fill runs 15 units under the newest line (to y 432), where its chat buttons sit. */
	padding-bottom: 15dp;
	/* 0.97 stretches Message_box2 over the width and stacks nis_vframe (5x40) down each side. The
	   game loads RmlUi textures clamped, so repeat does not tile: Message_box2_268 is the top already
	   stretched to the window's width and Nis_vframe_tall the side stacked 12 times, both drawn
	   unscaled and cut at the window's box. */
	decorator: image(classic-nis-top scale-none left top), image(classic-nis-side scale-none left top),
	           image(classic-nis-side scale-none right top);
}
#panel.framed #chat_backdrop { left: 5dp; right: 5dp; top: 5dp; }
#panel.framed #lines { left: 10dp; top: 8dp; right: 8dp; }
/* In the window the newest line is at the bottom and a short log rests on it (0040d610). */
#panel.framed .chat-line:first-child { margin-top: auto; }
#panel.framed .chat-line--chat,
#panel.framed .chat-line--system,
#panel.framed .chat-line--error { background-color: transparent; }

#panel.framed #lines scrollbarvertical { width: 13dp; }
#panel.framed #lines scrollbarvertical slidertrack { decorator: image(classic-nis-back fill); }
#panel.framed #lines scrollbarvertical sliderbar {
	width: 11dp;
	margin-left: 1dp;
	height: auto;
	min-height: 8dp;
	decorator: image(classic-nis-bar fill);
}
#panel.framed #lines scrollbarvertical sliderarrowdec,
#panel.framed #lines scrollbarvertical sliderarrowinc { height: 13dp; pointer-events: auto; }
#panel.framed #lines scrollbarvertical sliderarrowdec { decorator: image(classic-nis-arrow); }
#panel.framed #lines scrollbarvertical sliderarrowinc { decorator: image(classic-nis-arrow flip-vertical); }
#panel.framed #lines scrollbarvertical sliderarrowdec:hover,
#panel.framed #lines scrollbarvertical sliderarrowinc:hover { filter: brightness(1.2); }

#panel.framed #resize_handle {
	left: auto;
	right: 6dp;
	top: -4dp;
	bottom: auto;
	width: 22dp;
	height: 12dp;
	decorator: image(classic-nis-grip);
	/* Dragged up and down to size the window (CChatLogWindow follows the drag). */
	drag: drag;
}
