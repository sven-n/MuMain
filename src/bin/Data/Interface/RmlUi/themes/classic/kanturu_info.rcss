/* Classic theme for CKanturuInfoWindow (kanturu_info.rml is forked here). 0.97 has no Kanturu; the
   Season 2 client draws its boss-battle HUD in two pieces:
   - the count box (004399f4): MonsterCount (86x80) at (0, 300), the characters at (10, 321) and the
     monsters (or the boss) at (10, 343), yellow;
   - the hourglass timer (00414514, placed at (243, 400) by 004db3f0): hourglass (154x23 drawn
     154x30) at (238, 405), the minutes centred on x 301 and the seconds on x 332 at y 414 in
     Interface\FontTest digits 14x14, 9.8 apart, orange (1, 0.6, 0.3) over a black copy one unit
     down and right, and between them the dot (3x9) at (314, 416), blinking.
   The classic workspace puts the window's top-left at (0, 300) of the event frame; the rest is
   placed from there. Reference px, under .screen's W/640 x H/480 stretch. */

@spritesheet kanturu-classic-count-sheet { src: "../../../MonsterCount.tga"; kanturu-classic-count: 0px 0px 86px 80px; }
@spritesheet kanturu-classic-glass-sheet { src: "../../../hourglass.tga"; kanturu-classic-glass: 0px 0px 154px 23px; }
@spritesheet kanturu-classic-dot-sheet { src: "../../../dot.tga"; kanturu-classic-dot: 0px 0px 3px 9px; }
@spritesheet kanturu-classic-digits-sheet
{
	src: ../../../Classic/Fonttest.tga;
	kanturu-classic-d0: 0px 0px 16px 16px;
	kanturu-classic-d1: 16px 0px 16px 16px;
	kanturu-classic-d2: 32px 0px 16px 16px;
	kanturu-classic-d3: 48px 0px 16px 16px;
	kanturu-classic-d4: 64px 0px 16px 16px;
	kanturu-classic-d5: 80px 0px 16px 16px;
	kanturu-classic-d6: 96px 0px 16px 16px;
	kanturu-classic-d7: 112px 0px 16px 16px;
	kanturu-classic-d8: 128px 0px 16px 16px;
	kanturu-classic-d9: 144px 0px 16px 16px;
}

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
}

#panel { position: absolute; width: 86px; height: 80px; font-family: "token(font-body)"; }
#back { position: absolute; left: 0; top: 0; width: 86px; height: 80px; decorator: image(kanturu-classic-count); }
#hourglass { position: absolute; left: 238px; top: 105px; width: 154px; height: 30px; decorator: image(kanturu-classic-glass); }

.info-text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: nowrap;
	font-weight: bold;
	color: #ffff00;
}
#users { left: 10px; top: 21px; }
#monsters { left: 10px; top: 43px; }

/* The blinking dot in place of the colon's text. */
#colon {
	left: 314px;
	top: 116px;
	width: calc(3px * var(--root-scale, 1));
	height: calc(9px * var(--root-scale, 1));
	color: transparent;
	decorator: image(kanturu-classic-dot);
	image-color: rgb(255, 153, 77);
}

.digit { position: absolute; top: 114px; width: 14px; height: 14px; image-color: rgb(255, 153, 77); }
.shadow .digit { top: 115px; image-color: #000000; }
.digit.blank { visibility: hidden; }
.digit.d0 { decorator: image(kanturu-classic-d0); }
.digit.d1 { decorator: image(kanturu-classic-d1); }
.digit.d2 { decorator: image(kanturu-classic-d2); }
.digit.d3 { decorator: image(kanturu-classic-d3); }
.digit.d4 { decorator: image(kanturu-classic-d4); }
.digit.d5 { decorator: image(kanturu-classic-d5); }
.digit.d6 { decorator: image(kanturu-classic-d6); }
.digit.d7 { decorator: image(kanturu-classic-d7); }
.digit.d8 { decorator: image(kanturu-classic-d8); }
.digit.d9 { decorator: image(kanturu-classic-d9); }
/* RenderNumber(): the run starts half its digits' width left of its x, each digit 0.7 of its width
   after the last. */
#minutes .digit { left: calc(301px - var(--n) * 7px + var(--i) * 9.8px); }
#seconds .digit { left: calc(332px - var(--n) * 7px + var(--i) * 9.8px); }
#minutes_shadow .digit { left: calc(302px - var(--n) * 7px + var(--i) * 9.8px); }
#seconds_shadow .digit { left: calc(333px - var(--n) * 7px + var(--i) * 9.8px); }

/* The HUD takes no pointer events where it is placed (base.rcss gives a placed panel them). */
#panel.slot-placed { pointer-events: none; }

/* The data-for template row has no index of its own; it inherits this one. */
.run { --i: 0; }
