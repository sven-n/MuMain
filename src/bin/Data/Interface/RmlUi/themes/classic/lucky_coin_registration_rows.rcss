/* Classic rows for Delgado's lucky coin registration (CRegistrationLuckyCoin). 0.97 has no lucky coin; the window takes the
   classic Golden Archer's parts (gold_bowman.rcss): the 0.97 frame, each action on a 0.97 text plate
   (Message_box, 120 x 22, centred on the S6 button's row) lit warm under the mouse and darkened
   while locked, and the 0.97 Close (Exit_01, Exit_02 pressed) at (25, 395) in place of the Close
   text button. Legacy's rows first, then the classic rules. */

/* Where lucky_coin_registration.rml's own lines and buttons sit. CRegistrationLuckyCoin's RenderTexts(): white, centred on the 190-unit panel from y 25. Register at the panel's height - 220, Close at y 360.
   The look they share is event_item_entry.rcss; only the rows are this document's. */

.entry-text:nth-child(1) { left: 0px; top: 25px; color: #ffffff; font-weight: bold; }
.entry-text:nth-child(2) { left: 0px; top: 65px; color: #ffffff; }
.entry-text:nth-child(3) { left: 0px; top: 85px; color: #ffffff; }
.entry-text:nth-child(4) { left: 0px; top: 105px; color: #ffffff; }
.entry-text:nth-child(5) { left: 0px; top: 125px; color: #ffffff; }
.entry-text:nth-child(6) { left: 0px; top: 145px; color: #ffffff; font-weight: bold; }
.entry-text:nth-child(7) { left: 24px; top: 175px; color: #ffffff; font-weight: bold; }

.entry-btn:nth-child(1) { left: 63px; top: 209px; width: 64px; height: 29px; }
.entry-btn:nth-child(1) .entry-label { font-weight: bold; }
.entry-btn:nth-child(1) { decorator: image(coin-btn-small-up); }
.entry-btn:nth-child(1):hover { decorator: image(coin-btn-small-over); }
.entry-btn:nth-child(1):active { decorator: image(coin-btn-small-down); }
.entry-btn:nth-child(1).locked, .entry-btn:nth-child(1).locked:hover, .entry-btn:nth-child(1).locked:active { decorator: image(coin-btn-small-up); image-color: #ffffff; }

.entry-btn:nth-child(2) { left: 63px; top: 360px; width: 64px; height: 29px; }
.entry-btn:nth-child(2) .entry-label { font-weight: bold; }
.entry-btn:nth-child(2) { decorator: image(coin-btn-small-up); }
.entry-btn:nth-child(2):hover { decorator: image(coin-btn-small-over); }
.entry-btn:nth-child(2):active { decorator: image(coin-btn-small-down); }
.entry-btn:nth-child(2).locked, .entry-btn:nth-child(2).locked:hover, .entry-btn:nth-child(2).locked:active { decorator: image(coin-btn-small-up); image-color: #ffffff; }

/* Where C++ draws the live 3D preview: the original's place and size. */
.entry-item-box { position: absolute; left: -20px; top: 50px; width: 190px; height: 429px; pointer-events: none; }

/* --- Classic ---------------------------------------------------------------------------------- */
@spritesheet lcr-classic-plate-sheet { src: ../../../Classic/Message_box.jpg; lcr-classic-plate: 0px 0px 213px 64px; }
@spritesheet lcr-classic-exit-sheet  { src: ../../../Classic/Exit_01.jpg; lcr-classic-exit: 0px 0px 24px 24px; }
@spritesheet lcr-classic-exit2-sheet { src: ../../../Classic/Exit_02.jpg; lcr-classic-exit-pressed: 0px 0px 24px 24px; }
.entry-btn:nth-child(1) { left: 35px; top: 212px; width: 120px; height: 22px; decorator: image(lcr-classic-plate fill); image-color: #ffffff; }
.entry-btn:nth-child(1):hover, .entry-btn:nth-child(1):active { decorator: image(lcr-classic-plate fill); image-color: #ffd9b3; }
.entry-btn:nth-child(1).locked, .entry-btn:nth-child(1).locked:hover, .entry-btn:nth-child(1).locked:active { decorator: image(lcr-classic-plate fill); image-color: #666666; }
.entry-btn:nth-child(2) { left: 25px; top: 395px; width: 24px; height: 24px; decorator: image(lcr-classic-exit); }
.entry-btn:nth-child(2):hover { decorator: image(lcr-classic-exit); }
.entry-btn:nth-child(2):active { decorator: image(lcr-classic-exit-pressed); }
.entry-btn:nth-child(2).locked, .entry-btn:nth-child(2).locked:hover, .entry-btn:nth-child(2).locked:active { decorator: image(lcr-classic-exit); image-color: #666666; }
.entry-btn:nth-child(2) .entry-label { display: none; }
/* The web-page notice runs past the frame in longer languages: it wraps inside it (the next row is empty). */
.entry-text:nth-child(5) .sharp-text { left: 8px; width: calc(174px * var(--root-scale)); margin-left: 0; white-space: normal; transform-origin: left top; }
