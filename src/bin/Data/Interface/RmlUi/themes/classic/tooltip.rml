<rml>
	<!-- bound-geometry: tooltip is placed against the pointer -->
<head>
	<title>Tooltip</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="tooltip.rcss"/>
</head>
<!-- Classic (0.97) override of legacy's: 0.97 drew a button's hover text (0047f7f0, RenderTipText)
     in the same box as an item's (RenderTipTextList(): a 1-unit black frame around black at 80%),
     1 unit wider than the text on each side and 2 above it, where S6 draws a frameless lighter box
     3 units wider. So a button hint takes a frame of padding_px / 3 (1 unit), that padding at the
     sides and twice it on top, and no tt-button-hint class (legacy's tooltip.rcss lightens that
     one). Everything else as legacy: native text size, line heights, and box padding/border come
     from C++ (RmlTooltip.cpp's ApplyNativeMetrics()) in physical pixels, since this document has
     no parent transform.
     The one shared tooltip document every window uses (native or RmlUi) -- see RmlTooltip.h's own
     comment for the full mechanism. #tooltip_panel's children must be exactly the data-for-generated
     line divs below, in order, with no other sibling before them -- RmlTooltip.cpp's
     width-measurement pass indexes panel->GetChild(i) against config.lines[i] directly. -->
<body data-model="tooltip" data-style-left="pos_x + 'px'" data-style-top="pos_y + 'px'">
	<div id="tooltip_panel" data-class-tt-centered="center_text"
	     data-style-border-width="(button_hint ? padding_px / 3 : border_px) + 'px'" data-style-min-width="fixed_width_px + 'px'"
	     data-style-padding-left="(button_hint ? padding_px / 3 : padding_px) + 'px'"
	     data-style-padding-right="(button_hint ? padding_px / 3 : padding_px) + 'px'"
	     data-style-padding-top="(button_hint ? padding_px * 2 / 3 : 0) + 'px'"
	     data-style---line-px="line_height_px + 'px'" data-style---bold-line-px="bold_line_height_px + 'px'">
		<div class="tt-line" data-for="line : lines"
		     data-class-tt-blue="line.color_blue" data-class-tt-gray="line.color_gray"
		     data-class-tt-red="line.color_red" data-class-tt-yellow="line.color_yellow"
		     data-class-tt-green="line.color_green" data-class-tt-purple="line.color_purple"
		     data-class-tt-redpurple="line.color_redpurple" data-class-tt-violet="line.color_violet"
		     data-class-tt-orange="line.color_orange" data-class-tt-hl-darkred="line.highlight_darkred"
		     data-class-tt-hl-darkblue="line.highlight_darkblue" data-class-tt-hl-darkyellow="line.highlight_darkyellow"
		     data-class-tt-hl-greenblue="line.highlight_greenblue" data-class-bold="line.bold"
		     data-class-tt-half-spacer="line.is_half_spacer" data-class-tt-full-spacer="line.is_full_spacer"
		     data-style-font-size="text_px + 'px'"
		>{{line.text}}</div>
	</div>
</body>
</rml>
