.gm-grid .gm-cell:nth-child(38) { left: 125px; top: 160px; }
.gm-grid .gm-cell:nth-child(39) { left: 140px; top: 160px; }
.gm-grid .gm-cell:nth-child(40) { left: 155px; top: 160px; }
.gm-grid .gm-cell:nth-child(41) { left: 50px; top: 175px; }
.gm-grid .gm-cell:nth-child(42) { left: 65px; top: 175px; }
.gm-grid .gm-cell:nth-child(43) { left: 80px; top: 175px; }
.gm-grid .gm-cell:nth-child(44) { left: 95px; top: 175px; }
.gm-grid .gm-cell:nth-child(45) { left: 110px; top: 175px; }
.gm-grid .gm-cell:nth-child(46) { left: 125px; top: 175px; }
.gm-grid .gm-cell:nth-child(47) { left: 140px; top: 175px; }
