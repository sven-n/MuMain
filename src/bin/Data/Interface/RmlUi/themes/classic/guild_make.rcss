.gm-grid .gm-cell:nth-child(20) { left: 95px; top: 130px; }
.gm-grid .gm-cell:nth-child(21) { left: 110px; top: 130px; }
.gm-grid .gm-cell:nth-child(22) { left: 125px; top: 130px; }
.gm-grid .gm-cell:nth-child(23) { left: 140px; top: 130px; }
.gm-grid .gm-cell:nth-child(24) { left: 155px; top: 130px; }
.gm-grid .gm-cell:nth-child(25) { left: 50px; top: 145px; }
.gm-grid .gm-cell:nth-child(26) { left: 65px; top: 145px; }
.gm-grid .gm-cell:nth-child(27) { left: 80px; top: 145px; }
.gm-grid .gm-cell:nth-child(28) { left: 95px; top: 145px; }
.gm-grid .gm-cell:nth-child(29) { left: 110px; top: 145px; }
.gm-grid .gm-cell:nth-child(30) { left: 125px; top: 145px; }
.gm-grid .gm-cell:nth-child(31) { left: 140px; top: 145px; }
.gm-grid .gm-cell:nth-child(32) { left: 155px; top: 145px; }
.gm-grid .gm-cell:nth-child(33) { left: 50px; top: 160px; }
.gm-grid .gm-cell:nth-child(34) { left: 65px; top: 160px; }
.gm-grid .gm-cell:nth-child(35) { left: 80px; top: 160px; }
