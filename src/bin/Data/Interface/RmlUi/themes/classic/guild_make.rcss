.gm-palette .gm-cell:nth-child(16) { left: 155px; top: 280px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(100% * var(--root-scale)); }
#info { width: calc(100% * var(--root-scale)); }
.gm-label { width: calc(64px * var(--root-scale)); }
#result { width: calc(100% * var(--root-scale)); }
#name_field { width: calc(200px * var(--root-scale)); height: calc(14px * var(--root-scale)); line-height: calc(14px * var(--root-scale)); }

/* The mark grid's and the palette's cells take the pointer (guild_mark_paint, guild_mark_color). */
.gm-grid .gm-cell, .gm-palette .gm-cell { pointer-events: auto; cursor: pointer; }

/* ===== Classic (0.97) =====================================================
   0.97's guild creation window (004f0480 and the buttons in 004f5820): "Guild" in its box at the top; page 0 "Do you wish
   to be the guild master?" at (20, 50); page 1 "Name" at (17, 62) beside the Item_Money bar at
   (55, 60), the 8x8 mark grid at (50, 100), the colour at (15, 230), the hints at (50, 230 / 245)
   and the palette from (15, 260) -- already legacy's places; OK (ok.jpg, ok2 under the mouse) at
   (20, 350) and Cancel (cancel.jpg) at (100, 350), 70x21. MuMain's Create Guild (page 0) and Next
   take the OK plate, Back the Cancel plate; their art is lettered, so the labels are hidden. */
@spritesheet gm-classic-ok-sheet { src: ../../../Classic/Ok.jpg; gm-classic-ok: 0px 0px 70px 21px; }
@spritesheet gm-classic-ok2-sheet { src: ../../../Classic/Ok2.jpg; gm-classic-ok-hover: 0px 0px 70px 21px; }
@spritesheet gm-classic-cancel-sheet { src: ../../../Classic/Cancel.jpg; gm-classic-cancel: 0px 0px 70px 21px; }
@spritesheet gm-classic-cancel2-sheet { src: ../../../Classic/Cancel2.jpg; gm-classic-cancel-hover: 0px 0px 70px 21px; }
@spritesheet gm-classic-money-sheet { src: ../../../Classic/Item_money.jpg; gm-classic-money: 0px 0px 113px 18px; }

#title { left: 35px; top: 12px; width: calc(120px * var(--root-scale)); color: #dcdcdc; font-weight: bold; }
#info { left: 20px; top: 50px; text-align: left; color: #e6e6e6; }
#name_label { left: 17px; top: 62px; color: #e6e6e6; }
#name_back { left: 55px; top: 60px; width: 113px; height: 18px; decorator: image(gm-classic-money); }
#name_field { left: 60px; top: 62px; width: calc(100px * var(--root-scale)); background-color: transparent; }

.gm-btn-big, .gm-btn-small { width: 70px; height: 21px; }
#btn_make, #btn_next { left: 20px; top: 350px; decorator: image(gm-classic-ok); }
#btn_make:hover, #btn_next:hover, #btn_make:active, #btn_next:active { decorator: image(gm-classic-ok-hover); }
#btn_back { left: 100px; top: 350px; decorator: image(gm-classic-cancel); }
#btn_back:hover, #btn_back:active { decorator: image(gm-classic-cancel-hover); }
.gm-btn .gm-label { display: none; }
