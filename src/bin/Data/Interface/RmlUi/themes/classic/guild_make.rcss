.gm-grid .gm-cell:nth-child(63) { left: 140px; top: 205px; }
.gm-grid .gm-cell:nth-child(64) { left: 155px; top: 205px; }
.gm-palette .gm-cell:nth-child(1) { left: 15px; top: 260px; }
.gm-palette .gm-cell:nth-child(2) { left: 35px; top: 260px; }
.gm-palette .gm-cell:nth-child(3) { left: 55px; top: 260px; }
.gm-palette .gm-cell:nth-child(4) { left: 75px; top: 260px; }
.gm-palette .gm-cell:nth-child(5) { left: 95px; top: 260px; }
