/* Classic (0.97) look for the login's "save password" warning (RememberPasswordPrompt). 0.97 has no
   such option; the warning takes the classic confirmation's parts (generic_confirm_dialog.rcss):
   0.97's dialog stone (Message_box1) between two edge strips (Message_box2), 213 wide, the title
   bold over the text, both centred, and the two buttons on 0.97's Bar plate with their labels,
   lighter under the mouse and darker while pressed (0.97's lettered OK / Cancel plates are English
   art, and these labels are translated). Legacy's flat 340 panel, palette and dp sizes are
   replaced; .center-both still centres the panel. */

@spritesheet classic-rpp-edge-sheet  { src: ../../../Classic/Message_box2.jpg; classic-rpp-edge: 0px 0px 213px 5px; }
@spritesheet classic-rpp-stone-sheet { src: ../../../Classic/Message_box1.jpg; classic-rpp-stone: 0px 0px 213px 40px; }
@spritesheet classic-rpp-plate-sheet { src: ../../../Classic/Bar.jpg; classic-rpp-plate: 0px 0px 40px 18px; }

/* The edges on the panel (the strips fitted to its width, at the top and the bottom), the stone
   between them on the panel's art-free child. */
#panel {
	width: 213dp;
	height: 200dp;
	font-family: "token(font-body)";
	font-size: 1rem;
	color: #ffffff;
	decorator: image(classic-rpp-edge contain left top), image(classic-rpp-edge contain left bottom);
}
.frame-accent {
	position: absolute;
	left: 0;
	right: 0;
	top: 5dp;
	bottom: 5dp;
	decorator: image(classic-rpp-stone fill);
}

.prompt-title {
	position: absolute;
	left: 10dp;
	top: 15dp;
	width: 193dp;
	text-align: center;
	color: #ffffff;
	font-weight: bold;
}

.prompt-body {
	position: absolute;
	left: 10dp;
	top: 38dp;
	width: 193dp;
	text-align: center;
	line-height: 15dp;
	color: #ffffff;
	white-space: normal;
	word-break: break-word;
}

.btn-ok, .btn-cancel {
	top: auto;
	bottom: 19dp;
	width: 70dp;
	height: 21dp;
	line-height: 21dp;
	text-align: center;
	color: #ffffff;
	decorator: image(classic-rpp-plate fill);
}
.btn-ok:hover, .btn-cancel:hover { decorator: image(classic-rpp-plate fill); image-color: #ffe6b4; }
.btn-ok:active, .btn-cancel:active { decorator: image(classic-rpp-plate fill); image-color: #b4b4b4; }
.btn-ok     { left: 31dp; }
.btn-cancel { left: 112dp; }
