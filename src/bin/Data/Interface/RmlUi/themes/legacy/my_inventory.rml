<rml>
<head>
	<title>My Inventory</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="my_inventory.rcss"/>
</head>
<body data-model="my_inventory">
	<!-- Window frame/title/gold/buttons only -- paperdoll and inventory grid stay native
	     (MyInventory.h). Background lives in my_inventory_bg.rml instead, since it must paint
	     behind the native 3D icons this document never overlaps. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<span id="title">{{title}}</span>

		<div id="gold_bg"></div>
		<span id="gold_text" data-style-color="gold_color">{{gold_text}}</span>

		<div id="btn_exit" class="inv-btn inv-btn-exit" data-event-click="my_inventory_exit_click"></div>
		<span class="tooltip tooltip-exit">{{exit_tooltip}}</span>

		<div id="btn_repair" class="inv-btn inv-btn-repair" data-class-hidden="!repair_visible"
		     data-event-click="my_inventory_repair_click"></div>
		<span class="tooltip tooltip-repair">{{repair_tooltip}}</span>

		<div id="btn_myshop" class="inv-btn inv-btn-myshop" data-class-hidden="!myshop_visible"
		     data-class-close-mode="!myshop_mode_open" data-class-locked="myshop_locked"
		     data-event-click="my_inventory_myshop_click"></div>
		<span class="tooltip tooltip-myshop">{{myshop_tooltip}}</span>

		<div id="btn_expand" class="inv-btn inv-btn-expand" data-event-click="my_inventory_expand_click"></div>
		<span class="tooltip tooltip-expand">{{expand_tooltip}}</span>

		<!-- Set/Socket option header labels, each spanning half of #panel's width to match the
		     former native hover-rect split. -->
		<div id="set_option_label" class="option-label option-label-set" data-class-active="set_option_active"
		     data-event-mouseover="my_inventory_set_option_hover" data-event-mouseout="my_inventory_set_option_unhover">{{set_option_label}}</div>
		<div id="socket_option_label" class="option-label option-label-socket" data-class-active="socket_option_active"
		     data-event-mouseover="my_inventory_socket_option_hover" data-event-mouseout="my_inventory_socket_option_unhover">{{socket_option_label}}</div>

		<!-- Shared tooltip for both labels above (mutually exclusive hover targets). -->
		<div id="item_option_tooltip" data-class-hidden="!item_option_tooltip_visible">
			<div class="tt-line" data-for="line : item_option_tooltip_lines"
			     data-class-tt-blue="line.color_blue" data-class-tt-yellow="line.color_yellow"
			     data-class-tt-green="line.color_green" data-class-tt-purple="line.color_purple"
			     data-class-bold="line.bold">{{line.text}}</div>
		</div>
	</div>
</body>
</rml>
