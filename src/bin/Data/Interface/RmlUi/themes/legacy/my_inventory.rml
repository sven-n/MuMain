<rml>
<head>
	<title>My Inventory</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="my_inventory.rcss"/>
</head>
<body data-model="my_inventory">
	<!-- CMyInventory (MyInventory.h): the frame, the equipment slots, the item grid, the items
	     C++ draws live into #item_view, the stack counts, the title, gold and buttons. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- CMyInventory::RenderFrame()'s five pieces. -->
		<div class="bg-fill"></div>
		<div class="bg-top"></div>
		<div class="bg-left"></div>
		<div class="bg-right"></div>
		<div class="bg-bottom"></div>
		<!-- The equipment slots, the item grid and the item-option tooltip: boxes the theme places
		     (my_inventory.rcss); CMyInventory reads them each frame for its hit tests. A slot's class
		     is its state (MyInventory.h's slot_states). -->
		<div id="slot_helper" data-attr-class="'native-anchor equip-slot ' + slot_states[8]"><div id="slot_helper_item" class="equip-slot-item"></div></div>
		<div id="slot_helm" data-attr-class="'native-anchor equip-slot ' + slot_states[2]"><div id="slot_helm_item" class="equip-slot-item"></div></div>
		<div id="slot_wing" data-attr-class="'native-anchor equip-slot ' + slot_states[7]"><div id="slot_wing_item" class="equip-slot-item"></div></div>
		<div id="slot_weapon_left" data-attr-class="'native-anchor equip-slot ' + slot_states[1]"><div id="slot_weapon_left_item" class="equip-slot-item"></div></div>
		<div id="slot_armor" data-attr-class="'native-anchor equip-slot ' + slot_states[3]"><div id="slot_armor_item" class="equip-slot-item"></div></div>
		<div id="slot_weapon_right" data-attr-class="'native-anchor equip-slot ' + slot_states[0]"><div id="slot_weapon_right_item" class="equip-slot-item"></div></div>
		<div id="slot_gloves" data-attr-class="'native-anchor equip-slot ' + slot_states[5]"><div id="slot_gloves_item" class="equip-slot-item"></div></div>
		<div id="slot_pants" data-attr-class="'native-anchor equip-slot ' + slot_states[4]"><div id="slot_pants_item" class="equip-slot-item"></div></div>
		<div id="slot_boots" data-attr-class="'native-anchor equip-slot ' + slot_states[6]"><div id="slot_boots_item" class="equip-slot-item"></div></div>
		<div id="slot_ring_left" data-attr-class="'native-anchor equip-slot ' + slot_states[11]"><div id="slot_ring_left_item" class="equip-slot-item"></div></div>
		<div id="slot_amulet" data-attr-class="'native-anchor equip-slot ' + slot_states[9]"><div id="slot_amulet_item" class="equip-slot-item"></div></div>
		<div id="slot_ring_right" data-attr-class="'native-anchor equip-slot ' + slot_states[10]"><div id="slot_ring_right_item" class="equip-slot-item"></div></div>
		<!-- The inventory grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The equipped and the grid's items, live 3D drawn by C++ over the slots and the cells. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{c.count}}</span></div>
		</div>
		<div id="option_tooltip_anchor" class="native-anchor"></div>
		<!-- Text leaves marked native-text render at the native text renderer's size: text_px is the
		     physical size, and 1 / root_scale cancels #panel's scale so glyphs rasterise at it. #title
		     stays full size as the drag handle. -->
		<div id="title"><span class="native-text title-text" data-style-font-size="text_px + 'px'"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'">{{title}}</span></div>

		<div id="gold_bg"></div>
		<span id="gold_text" class="native-text gold-amount"
		      data-class-gold-base="gold_tier == 'base'"
		      data-class-gold-hundred-thousand="gold_tier == 'hundred-thousand'"
		      data-class-gold-million="gold_tier == 'million'"
		      data-class-gold-ten-million="gold_tier == 'ten-million'"
		      data-style-font-size="text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{gold_text}}</span>

		<div id="btn_exit" class="inv-btn inv-btn-exit" data-event-click="my_inventory_exit_click" data-attr-data-hint="exit_tooltip"></div>

		<div id="btn_repair" class="inv-btn inv-btn-repair" data-class-hidden="!repair_visible"
		     data-event-click="my_inventory_repair_click" data-attr-data-hint="repair_tooltip"></div>

		<div id="btn_myshop" class="inv-btn inv-btn-myshop" data-class-hidden="!myshop_visible"
		     data-class-close-mode="!myshop_mode_open" data-class-locked="myshop_locked"
		     data-event-click="my_inventory_myshop_click" data-attr-data-hint="myshop_tooltip"></div>

		<div id="btn_expand" class="inv-btn inv-btn-expand" data-event-click="my_inventory_expand_click" data-attr-data-hint="expand_tooltip"></div>

		<!-- Set/Socket option header: one centred line with both labels at the same size (the native
		     client shrank each label into its own narrow box, so a long label came out smaller -- not
		     reproduced). Hover areas stay the former native half-width split, as empty boxes. -->
		<div class="option-labels native-text" data-style-font-size="text_px + 'px'"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'">
			<span class="option-label" data-class-active="set_option_active">{{set_option_label}}</span>
			<span class="option-label" data-class-active="socket_option_active">{{socket_option_label}}</span>
		</div>
		<div id="set_option_label" class="option-hover option-hover-set"
		     data-event-mouseover="my_inventory_set_option_hover" data-event-mouseout="my_inventory_set_option_unhover"></div>
		<div id="socket_option_label" class="option-hover option-hover-socket"
		     data-event-mouseover="my_inventory_socket_option_hover" data-event-mouseout="my_inventory_socket_option_unhover"></div>
	</div>
</body>
</rml>
