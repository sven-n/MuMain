/* Legacy theme for CCastleWindow (Senatus), reproducing its RenderFrame(), tabs and pages: the
   docked_panel_frame.rcss frame (linked first; newui_item_back01 top), the four newui_guild_tab04
   tabs drawn 40 x 22 (the sprite's left 40 px, one unit apart from (12, 32); the selected one on
   its second row, its label white, the others (181, 181, 181)), RenderOutlineUpper() /
   RenderOutlineLower()'s newui_item_table01 / 02 / 03 pieces, senatusmap (160 x 165 of 256),
   gate_button1 / 2 and suho_button1 / 2 (24 x 24 of 32), newui_myquest_Line (188 x 21),
   newui_item_money2 (170 x 24), the boxes and texts in their bound colours, the 53 x 23
   newui_btn_empty_very_small buttons (locked ones tinted (100, 100, 100) with a grey label, never
   hovered), the tax arrows (newui_Bt_scroll_up / dn, 15 x 13: up / over / down) at x 158 and the
   exit button at (13, 391). Reference px inside #panel. */

@spritesheet cw-tab-sheet
{
	src: "../../../newui_guild_tab04.tga";
	cw-tab-up: 0px 0px 40px 22px;
	cw-tab-down: 0px 22px 40px 22px;
}
@spritesheet cw-btn-sheet
{
	src: "../../../newui_btn_empty_very_small.tga";
	cw-btn-up: 0px 0px 53px 23px;
	cw-btn-over: 0px 23px 53px 23px;
	cw-btn-down: 0px 46px 53px 23px;
}
@spritesheet cw-up-sheet
{
	src: "../../../newui_Bt_scroll_up.jpg";
	cw-up-up: 0px 0px 15px 13px;
	cw-up-over: 0px 13px 15px 13px;
	cw-up-down: 0px 26px 15px 13px;
}
@spritesheet cw-dn-sheet
{
	src: "../../../newui_Bt_scroll_dn.jpg";
	cw-dn-up: 0px 0px 15px 13px;
	cw-dn-over: 0px 13px 15px 13px;
	cw-dn-down: 0px 26px 15px 13px;
}
@spritesheet cw-tl-sheet { src: "../../../newui_item_table01(L).tga"; cw-tl: 0px 0px 14px 14px; }
@spritesheet cw-tr-sheet { src: "../../../newui_item_table01(R).tga"; cw-tr: 0px 0px 14px 14px; }
@spritesheet cw-bl-sheet { src: "../../../newui_item_table02(L).tga"; cw-bl: 0px 0px 14px 14px; }
@spritesheet cw-br-sheet { src: "../../../newui_item_table02(R).tga"; cw-br: 0px 0px 14px 14px; }
@spritesheet cw-top-sheet { src: "../../../newui_item_table03(Up).tga"; cw-top: 0px 0px 1px 14px; }
@spritesheet cw-bottom-sheet { src: "../../../newui_item_table03(Dw).tga"; cw-bottom: 0px 0px 1px 14px; }
@spritesheet cw-left-sheet { src: "../../../newui_item_table03(L).tga"; cw-left: 0px 0px 14px 1px; }
@spritesheet cw-right-sheet { src: "../../../newui_item_table03(R).tga"; cw-right: 0px 0px 14px 1px; }
@spritesheet cw-map-sheet { src: "../../../senatusmap.jpg"; cw-map: 0px 0px 160px 165px; }
@spritesheet cw-gate-on-sheet { src: "../../../gate_button1.jpg"; cw-gate-on: 0px 0px 24px 24px; }
@spritesheet cw-gate-off-sheet { src: "../../../gate_button2.jpg"; cw-gate-off: 0px 0px 24px 24px; }
@spritesheet cw-statue-on-sheet { src: "../../../suho_button1.jpg"; cw-statue-on: 0px 0px 24px 24px; }
@spritesheet cw-statue-off-sheet { src: "../../../suho_button2.jpg"; cw-statue-off: 0px 0px 24px 24px; }
@spritesheet cw-line-sheet { src: "../../../newui_myquest_Line.tga"; cw-line: 0px 0px 188px 21px; }
@spritesheet cw-money-sheet { src: "../../../newui_item_money2.tga"; cw-money: 0px 0px 170px 24px; }

.frame-top { decorator: image(docked-bg-top-b); }
#panel { pointer-events: none; }

.cw-tabs { position: static; }
.cw-tab { position: absolute; top: 32px; width: 40px; height: 22px; pointer-events: auto; decorator: image(cw-tab-up); }
.cw-tab:nth-child(1) { left: 12px; }
.cw-tab:nth-child(2) { left: 53px; }
.cw-tab:nth-child(3) { left: 94px; }
.cw-tab:nth-child(4) { left: 135px; }
.cw-tab.selected { decorator: image(cw-tab-down); }
.cw-tab-label { color: #b5b5b5; }
.cw-tab.selected .cw-tab-label { color: #ffffff; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; pointer-events: none; }

.cw-btn { display: block; position: absolute; width: 53px; height: 23px; decorator: image(cw-btn-up); pointer-events: auto; }
.cw-btn:hover { decorator: image(cw-btn-over); }
.cw-btn:active { decorator: image(cw-btn-down); }
.cw-btn.locked, .cw-btn.locked:hover, .cw-btn.locked:active { decorator: image(cw-btn-up); image-color: #646464; }
.cw-label { left: 0; text-align: center; color: #ffffff; }
.cw-btn.locked .cw-label { color: #646464; }

.tax-btn { position: absolute; left: 158px; width: 15px; height: 13px; pointer-events: auto; }
#tax_chaos_up   { top: 73px; }
#tax_chaos_down { top: 86px; }
#tax_npc_up     { top: 101px; }
#tax_npc_down   { top: 114px; }
.tax-up { decorator: image(cw-up-up); }
.tax-up:hover { decorator: image(cw-up-over); }
.tax-up:active { decorator: image(cw-up-down); }
.tax-down { decorator: image(cw-dn-up); }
.tax-down:hover { decorator: image(cw-dn-over); }
.tax-down:active { decorator: image(cw-dn-down); }

#btn_exit { top: 391px; pointer-events: auto; }

/* The window's own text. Each line is named, so the theme decides where it sits, what colour it
   is and how it is aligned; only its width and font size stay bound for the counter-scale. */
.cw-page, .cw-standing { position: static; }
.cw-heading, .cw-line, .cw-note, .cw-rule { text-align: center; }
.cw-heading { left: 15px; top: 13px; font-weight: bold; }
.cw-line { left: 0; font-weight: bold; }
.cw-note, .cw-rule { left: 15px; }
.cw-rule { font-weight: bold; }
.cw-stat { position: absolute; }
.cw-tab-label { left: 0; text-align: center; }

/* The gate and statue pages. */
#map_title { top: 61px; }
#improve_title { top: 294px; }
#stat_hp { left: 20px; top: 246px; }
#stat_defense { left: 20px; top: 259px; }
#stat_recover { left: 20px; top: 272px; }
#next_hp { left: 30px; top: 318px; }
#next_defense { left: 30px; top: 341px; }
#next_recover { left: 30px; top: 364px; }
#btn_buy { left: 68px; top: 250px; }
#btn_repair { left: 110px; top: 260px; }
#btn_hp { left: 110px; top: 310px; }
#btn_defense { left: 110px; top: 334px; }
#btn_recover { left: 110px; top: 358px; }

/* The tax page. */
#tax_title { top: 61px; }
#chaos_rate { top: 84px; }
#store_rate { top: 109px; }
#tax_note_1 { top: 162px; }
#tax_note_2 { top: 175px; }
#tax_note_3 { top: 188px; }
#tax_rule_1 { top: 208px; }
#tax_rule_2 { top: 220px; }
#tax_rule_3 { top: 232px; }
#tax_rule_4 { top: 244px; }
#tax_rule_5 { top: 256px; }
#tax_rule_6 { top: 268px; }
#tax_footer_1 { top: 350px; }
#tax_footer_2 { top: 362px; }
#tax_footer_3 { top: 374px; }
.cw-money-text { position: absolute; top: 303px; font-weight: bold; }
#zen_label { left: 14px; }
/* RT3_WRITE_RIGHT_TO_LEFT: the amount ends at x 170. */
#castle_money { right: 20px; text-align: right; }
#btn_apply { left: 120px; top: 133px; }
#btn_withdraw { left: 120px; top: 322px; }

/* A table's ten pieces, placed against its own origin; the instance says how tall it is. */
.cw-table { position: absolute; left: 12px; width: 166px; }
.cw-table > div { position: absolute; }
.cw-table .t-tl { left: 0; top: 0; }
.cw-table .t-tr { left: 152px; top: 0; }
.cw-table .t-top { left: 13px; top: 0; width: 139px; }
.cw-table .t-fill { left: 3px; top: 1px; width: 158px; height: 15px; }
.cw-table .t-left { left: 0; top: 13px; }
.cw-table .t-right { left: 152px; top: 13px; }
.cw-table .t-bottom-inner { left: 3px; top: 7px; width: 158px; }
.cw-table .t-bl { left: 0; }
.cw-table .t-br { left: 152px; }
.cw-table .t-bottom { left: 13px; width: 139px; }

.table-map { top: 57px; }
.table-map .t-left, .table-map .t-right { height: 165px; }
.table-map .t-bl, .table-map .t-br, .table-map .t-bottom { top: 172px; }
.table-improve { top: 290px; }
.table-improve .t-left, .table-improve .t-right { height: 78px; }
.table-improve .t-bl, .table-improve .t-br, .table-improve .t-bottom { top: 85px; }
.table-tax { top: 57px; }
.table-tax .t-left, .table-tax .t-right { height: 55px; }
.table-tax .t-bl, .table-tax .t-br, .table-tax .t-bottom { top: 62px; }

.cw-map { position: absolute; left: 15px; top: 73px; width: 160px; height: 165px; }
.cw-separator { position: absolute; left: 1px; top: 278px; width: 188px; height: 21px; }
.cw-money { position: absolute; left: 10px; top: 296px; width: 170px; height: 24px; }
.tax-rate-back { position: absolute; left: 15px; width: 150px; height: 24px; }
.tax-rate-chaos { top: 75px; }
.tax-rate-store { top: 103px; }
.tax-divider { position: absolute; left: 15px; top: 91px; width: 158px; }

/* The theme places each gate and statue; C++ supplies only live bar lengths. */
.cw-item { position: absolute; width: 24px; height: 24px; pointer-events: auto; }
.cw-item.item-0 { left: 82px; top: 108px; }
.cw-item.item-1 { left: 64px; top: 156px; }
.cw-item.item-2 { left: 100px; top: 156px; }
.cw-item.item-3 { left: 48px; top: 208px; }
.cw-item.item-4 { left: 82px; top: 208px; }
.cw-item.item-5 { left: 116px; top: 208px; }
.cw-page.statue .cw-item.item-0 { left: 82px; top: 93px; }
.cw-page.statue .cw-item.item-1 { left: 82px; top: 138px; }
.cw-page.statue .cw-item.item-2 { left: 64px; top: 183px; }
.cw-page.statue .cw-item.item-3 { left: 100px; top: 183px; }
.cw-bars { position: static; pointer-events: none; }
.cw-icon { position: absolute; left: 0; top: 0; width: 24px; height: 24px; pointer-events: none; }
.bar { position: absolute; left: 0; height: 3px; }
.bar-gate-hp { top: -10px; }
.bar-gate-def-track, .bar-gate-def { top: -5px; }
.bar-gate-def-track { width: 24px; }
.edge-gate-top { top: -10px; width: 24px; height: 1px; }
.edge-gate-mid { top: -7px; width: 24px; height: 1px; }
.edge-gate-left { top: -10px; width: 1px; }
.edge-gate-right { left: 24px; top: -10px; width: 1px; }
.bar-statue-hp { top: -15px; }
.bar-statue-def { top: -10px; }
.bar-statue-rec { top: -5px; }
.bar-track.bar-statue-def, .bar-track.bar-statue-rec { width: 24px; }

.cw-icon { decorator: image(cw-gate-off); }
.cw-item.current .cw-icon { decorator: image(cw-gate-on); }
.cw-item.statue .cw-icon { decorator: image(cw-statue-off); }
.cw-item.statue.current .cw-icon { decorator: image(cw-statue-on); }
.cw-map { decorator: image(cw-map); }

.cw-heading, .cw-line { color: #dcdcdc; }
/* RenderGateManagingTab() turned the figures white and left them so. */
.cw-stat, #tax_title, #chaos_rate, #store_rate, .cw-note, .cw-money-text { color: #ffffff; }
/* The tax rules kept the original's own 0xFF947BBB, read as an RGBA word. */
.cw-rule { color: rgb(187, 123, 148); }

.cw-table .t-tl { width: 14px; height: 14px; decorator: image(cw-tl); }
.cw-table .t-tr { width: 14px; height: 14px; decorator: image(cw-tr); }
.cw-table .t-bl { width: 14px; height: 14px; decorator: image(cw-bl); }
.cw-table .t-br { width: 14px; height: 14px; decorator: image(cw-br); }
.cw-table .t-top { height: 14px; decorator: image(cw-top); }
.cw-table .t-bottom, .cw-table .t-bottom-inner { height: 14px; decorator: image(cw-bottom); }
.cw-table .t-left { width: 14px; decorator: image(cw-left); }
.cw-table .t-right { width: 14px; decorator: image(cw-right); }
.cw-table .t-fill { background-color: rgba(0, 0, 0, 77); }
.tax-divider { height: 14px; decorator: image(cw-bottom); }
.cw-separator { decorator: image(cw-line); }
.cw-money { decorator: image(cw-money); }
.tax-rate-back { background-color: rgba(102, 102, 102, 128); }

.bar-track { background-color: #ffffff; }
.bar-hp { background-color: #ff0000; }
.bar-defense { background-color: #00ff00; }
.bar-recover { background-color: #ffff00; }
.bar-edge { background-color: #000000; }
