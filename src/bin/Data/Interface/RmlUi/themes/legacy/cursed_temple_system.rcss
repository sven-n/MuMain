/* Legacy theme for CCursedTempleSystem, reproducing its Render() at the 640x480 reference positions
   under .screen's W/640 x H/480 stretch: every image's file, cell and box come from C++ in the
   original's order; the tutorial step's lines at x 140 in the normal font. */

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
	font-family: "token(font-body)";
}

.sprite { position: absolute; }

.tutorial-line {
	display: block;
	position: absolute;
	left: 140px;
	transform-origin: left top;
	white-space: nowrap;
}
