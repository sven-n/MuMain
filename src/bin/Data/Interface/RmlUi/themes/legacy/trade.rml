<rml>
<head>
	<title>Trade</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="trade.rcss"/>
</head>
<body data-model="trade">
	<!-- Window frame/title/both nickname displays/both gold strips/both confirm checkboxes/divider/
	     buttons only -- both CInventoryCtrl grids stay native (Trade.h). Background lives in
	     trade_bg.rml instead, since it must paint behind the native 3D icons. The guild-mark emblem
	     (RenderGuildMark()) and the warning arrow's animated glyph (RenderWarningArrow()) also stay
	     native -- both are live-rendered/live-tracking effects, not static chrome. The arrow's
	     "Warning" text badge (item_warning_badges below) is RmlUi now, positioned per-frame from
	     C++ since it tracks a live, variable-length set of flagged item grid cells. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<span id="title">{{title}}</span>

		<div id="your_nick_bg" class="nick-bg nick-bg-your"></div>
		<span id="your_guild_name" class="guild-name" data-class-hidden="!your_guild_visible">{{your_guild_name}}</span>
		<span id="your_id_text" class="id-text id-text-your">{{your_id_text}}</span>
		<span id="your_level_text" class="level-text"
		      data-class-level-bucket-10="your_level_bucket == 10"
		      data-class-level-bucket-50="your_level_bucket == 50"
		      data-class-level-bucket-100="your_level_bucket == 100"
		      data-class-level-bucket-200="your_level_bucket == 200"
		      data-class-level-bucket-300="your_level_bucket == 300"
		      data-class-level-bucket-400="your_level_bucket == 400">{{your_level_text}}</span>

		<div id="your_gold_bg" class="gold-bg gold-bg-your"></div>
		<span id="your_gold_text" class="gold-text gold-text-your gold-amount"
		      data-class-gold-base="your_gold_tier == 'base'"
		      data-class-gold-hundred-thousand="your_gold_tier == 'hundred-thousand'"
		      data-class-gold-million="your_gold_tier == 'million'"
		      data-class-gold-ten-million="your_gold_tier == 'ten-million'">{{your_gold_text}}</span>

		<div id="your_confirm" class="checkbox-row confirm-your" data-class-checked="your_confirm_checked">
			<div class="checkbox-box"></div>
		</div>

		<div id="divider"></div>

		<div id="my_nick_bg" class="nick-bg nick-bg-my"></div>
		<span id="my_id_text" class="id-text id-text-my">{{my_id_text}}</span>

		<div id="my_gold_bg" class="gold-bg gold-bg-my"></div>
		<span id="my_gold_text" class="gold-text gold-text-my gold-amount"
		      data-class-gold-base="my_gold_tier == 'base'"
		      data-class-gold-hundred-thousand="my_gold_tier == 'hundred-thousand'"
		      data-class-gold-million="my_gold_tier == 'million'"
		      data-class-gold-ten-million="my_gold_tier == 'ten-million'">{{my_gold_text}}</span>

		<div id="my_confirm" class="checkbox-row confirm-my" data-class-checked="my_confirm_checked"
		     data-class-waiting="my_confirm_waiting" data-event-click="trade_my_confirm_click">
			<div class="checkbox-box"></div>
		</div>

		<div id="btn_exit" class="trade-btn trade-btn-exit" data-event-click="trade_exit_click"></div>
		<span class="tooltip tooltip-exit">{{close_tooltip}}</span>

		<div id="btn_zen" class="trade-btn trade-btn-zen" data-event-click="trade_zen_click"></div>
		<span class="tooltip tooltip-zen">{{zen_tooltip}}</span>

		<span id="warning_label" class="warning-label" data-style-opacity="warning_opacity">{{warning_label}}</span>
		<span id="notice_line1" class="notice-line notice-line1">{{notice_line1}}</span>
		<span id="notice_line2" class="notice-line notice-line2">{{notice_line2}}</span>
		<span id="notice_line3" class="notice-line notice-line3">{{notice_line3}}</span>

		<!-- Former RenderWarningArrow()'s "Warning" text badge, one per flagged item. -->
		<div class="item-warning-badge" data-for="w : item_warning_badges"
		     data-style-left="w.x + 'px'" data-style-top="w.y + 'px'" data-style-width="w.width + 'px'">{{item_warning_text}}</div>
	</div>
</body>
</rml>
