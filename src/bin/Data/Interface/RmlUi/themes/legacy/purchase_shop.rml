<rml>
<head>
	<title>Personal Store - Purchase</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="purchase_shop.rcss"/>
</head>
<body data-model="purchase_shop">
	<!-- CPurchaseShopInventory (PurchaseShopInventory.h): the frame, the item grid, the items C++
	     draws live into #item_view, the stack counts, title, subtitle strip, warning text and exit
	     button. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale"
	     data-style-font-size="(text_px / root_scale) + 'px'">
		<!-- The frame. -->
		<div class="bg-fill"></div>
		<div class="bg-top"></div>
		<div class="bg-left"></div>
		<div class="bg-right"></div>
		<div class="bg-bottom"></div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'">{{c.count}}</span></div>
		</div>
		<span class="sharp-text" id="title" data-style-font-size="text_px + 'px'">{{title}}</span>

		<!-- Reproduces IMAGE_MYSHOPINVENTORY_EDIT (newui_Box_openTitle.tga), the same sprite
		     CMyShopInventory's own subject strip uses -- here purely decorative behind the
		     shop-owner's (read-only) name, not a live text-input widget. -->
		<div class="shop-title-strip"></div>
		<span class="sharp-text" id="shop_owner_text" data-style-font-size="text_px + 'px'">{{shop_owner_text}}</span>

		<span class="sharp-text warning-label" data-style-font-size="text_px + 'px'">{{warning_label}}</span>
		<span class="sharp-text warning-line line-1" data-style-font-size="text_px + 'px'">{{selling_price_line}}</span>
		<span class="sharp-text warning-line line-2" data-style-font-size="text_px + 'px'">{{verify_line}}</span>
		<span class="sharp-text warning-line line-3" data-style-font-size="text_px + 'px'">{{already_in_store_line}}</span>
		<span class="sharp-text warning-line line-4" data-style-font-size="text_px + 'px'">{{cancel_purchased_line}}</span>
		<span class="sharp-text warning-line line-5" data-style-font-size="text_px + 'px'">{{cant_be_returned_line}}</span>
		<span class="sharp-text warning-label-2 line-6" data-style-font-size="text_px + 'px'">{{all_item_trading_line}}</span>
		<span class="sharp-text warning-label-2 line-7" data-style-font-size="text_px + 'px'">{{zen_only_line}}</span>

		<div id="btn_exit" class="shop-btn-exit" data-event-click="purchase_shop_exit_click"></div>
	</div>
</body>
</rml>
