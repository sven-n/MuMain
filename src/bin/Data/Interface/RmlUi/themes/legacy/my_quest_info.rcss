/* Legacy theme for CMyQuestInfoWindow, retiring its last CUIControl-family pieces
   (CUICurQuestListBox, CUIQuestContentsListBox, CButton x3). #panel's left/top/scale come live
   from C++ (SyncRmlModel()); coordinates below are plain reference px, not dp.

   Content-area layout (quest list / divider / contents) reinterprets the original's intent rather
   than porting CUICurQuestListBox/CUIQuestContentsListBox's own pixel math. Frame/tab-row/button
   positions are carried over exactly from SetPos()/SetButtonInfo()/RenderTabBtn(). */

/* Frame: same 5-piece composition my_inventory_bg.rcss's #bg_root uses (MyQuestInfoWindow.cpp:
   208-213); only the top piece differs (newui_item_back01.tga vs newui_item_back04.tga). */
@spritesheet myquest-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   myquest-bg-fill:   0px 0px 190px 429px; }
@spritesheet myquest-bg-top-sheet    { src: "../../../newui_item_back01.tga";   myquest-bg-top:    0px 0px 190px 64px; }
@spritesheet myquest-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; myquest-bg-left:   0px 0px 21px 320px; }
@spritesheet myquest-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; myquest-bg-right:  0px 0px 21px 320px; }
@spritesheet myquest-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   myquest-bg-bottom: 0px 0px 190px 45px; }

@spritesheet myquest-line-sheet    { src: "../../../newui_myquest_Line.tga"; myquest-line:    0px 0px 188px 21px; }
@spritesheet myquest-btn-open-sheet  { src: "../../../Quest_Bt_open.tga"; myquest-btn-open:  0px 0px 36px 29px; }
@spritesheet myquest-btn-giveup-sheet { src: "../../../Quest_Bt_cast.tga"; myquest-btn-giveup: 0px 0px 36px 29px; }
@spritesheet myquest-tab-back-sheet  { src: "../../../Quest_tab01.tga"; myquest-tab-back:  0px 0px 166px 22px; }
@spritesheet myquest-tab-small-sheet { src: "../../../Quest_tab02.tga"; myquest-tab-small: 0px 0px 48px 22px; }
@spritesheet myquest-tab-big-sheet   { src: "../../../Quest_tab03.tga"; myquest-tab-big:   0px 0px 72px 22px; }
@spritesheet myquest-btn-exit-sheet  { src: "../../../newui_exit_00.tga"; myquest-btn-exit: 0px 0px 36px 29px; }

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	decorator: image(myquest-bg-fill);
	font-family: "Liberation Sans";
}

/* Border frame pieces layered on top of #panel's own fill decorator, same 4-piece composition as
   my_inventory_bg.rcss's #bg_root children -- ordinary DOM children here since this window has no
   separate background context. */
.frame-piece { position: absolute; pointer-events: none; }
.frame-top    { left: 0;   top: 0;    width: 190px; height: 64px;  decorator: image(myquest-bg-top); }
.frame-left   { left: 0;   top: 64px; width: 21px;  height: 320px; decorator: image(myquest-bg-left); }
.frame-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(myquest-bg-right); }
.frame-bottom { left: 0;   top: 384px; width: 190px; height: 45px; decorator: image(myquest-bg-bottom); }

#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	color: #e6e6e6;
	font-weight: bold;
	font-size: 12px;
}

.tab-row {
	position: absolute;
	left: 10px;
	top: 27px;
	width: 166px;
	height: 22px;
	decorator: image(myquest-tab-back);
}
.tab-btn {
	position: absolute;
	top: 0;
	height: 22px;
	text-align: center;
	line-height: 22px;
	font-size: 12px;
	color: #b5b5b5;
	cursor: pointer;
	pointer-events: auto;
	white-space: nowrap;
	overflow: hidden;
}
.tab-btn.active { color: #ffffff; }
.tab-btn-quest { left: 0; width: 48px; }
.tab-btn-jobchange { left: 48px; width: 48px; }
.tab-btn-castletemple { left: 96px; width: 72px; }
.tab-btn-quest.active { decorator: image(myquest-tab-small); }
.tab-btn-jobchange.active { decorator: image(myquest-tab-small); }
.tab-btn-castletemple.active { decorator: image(myquest-tab-big); }

.quest-tab, .jobchange-tab, .castletemple-tab {
	position: absolute;
	left: 9px;
	top: 60px;
	width: 172px;
	height: 320px;
}
.hidden { display: none; }

/* display:block is load-bearing on every non-absolutely-positioned element below -- unstyled
   elements default to `display:inline`, which ignores width/height and won't stack in its own
   row. */
.quest-empty-msg {
	position: absolute;
	left: 14px;
	top: 30px;
	width: 140px;
	color: #ffff00;
	font-weight: bold;
	font-size: 12px;
	text-align: left;
}
.quest-empty-msg span { display: block; }

.quest-list {
	position: absolute;
	left: 0;
	top: 0;
	width: 172px;
	height: 130px;
	overflow: auto hidden;
}
.quest-row {
	display: block;
	width: 100%;
	height: 18px;
	line-height: 18px;
	padding-left: 4px;
	color: #ffffff;
	font-size: 12px;
	cursor: pointer;
	pointer-events: auto;
	white-space: nowrap;
}
.quest-row:hover { color: #ffee88; }
.quest-row.selected { color: #ffcc1a; font-weight: bold; }

.quest-divider {
	position: absolute;
	left: 0;
	top: 130px;
	width: 172px;
	height: 21px;
	decorator: image(myquest-line);
}

.quest-contents {
	position: absolute;
	left: 0;
	top: 151px;
	width: 172px;
	height: 169px;
	overflow: auto hidden;
}
.quest-content-row {
	display: block;
	width: 100%;
	padding: 1px 4px;
	font-size: 12px;
	color: #d2e6ff;
}
.quest-content-row.bold { font-weight: bold; }
.quest-content-row.clickable { cursor: pointer; pointer-events: auto; }
.quest-content-row.clickable:hover { color: #ffee88; }

.quest-btn, .quest-btn-exit {
	position: absolute;
	top: 392px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.quest-btn:hover, .quest-btn-exit:hover { filter: brightness(1.25); }
/* No pointer-events:none -- RmlClickOpen()/RmlClickGiveUp() already guard on
   openEnabled/giveupEnabled, so a locked click is already a safe no-op; dimming alone is
   enough. */
.quest-btn.locked { filter: brightness(0.6); }
.quest-btn-exit { left: 13px; decorator: image(myquest-btn-exit); }
.quest-btn-open { left: 50px; decorator: image(myquest-btn-open); }
.quest-btn-giveup { left: 87px; decorator: image(myquest-btn-giveup); }

/* Exit is a common close button -- legacy's sprite already has its own "X" baked in, so the
   shared label span is redundant. */
.btn-exit-label { display: none; }

/* Tooltips: siblings of their trigger button, shown via hover sibling selector. CButton never had
   these -- a real gap, not a carryover. */
.tooltip {
	display: none;
	position: absolute;
	top: 365px;
	width: 110px;
	white-space: nowrap;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 2px 4px;
	border-radius: 3px;
	font-size: 11px;
	text-align: center;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit   { left: -24px; }
.tooltip-open   { left: 13px; }
.tooltip-giveup { left: 50px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_quest_open:hover ~ .tooltip-open,
#btn_quest_giveup:hover ~ .tooltip-giveup {
	display: block;
}

.jobchange-title {
	display: block;
	text-align: center;
	width: 172px;
	color: #24f2fc;
	font-weight: bold;
	font-size: 12px;
	margin-bottom: 8px;
}
.jobchange-contents, .jobchange-state {
	display: block;
	text-align: center;
	width: 172px;
	color: #ffffff;
	font-size: 12px;
}
.jobchange-contents span, .jobchange-state span { display: block; }
.jobchange-state { color: #ffff00; font-weight: bold; margin-top: 12px; }

.castle-title, .temple-title {
	display: block;
	text-align: center;
	width: 172px;
	color: #ffff00;
	font-weight: bold;
	font-size: 12px;
	margin-top: 6px;
}
.castle-line, .temple-line {
	display: block;
	text-align: center;
	width: 172px;
	color: #ffffff;
	font-size: 12px;
}
