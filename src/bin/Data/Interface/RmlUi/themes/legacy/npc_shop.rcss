/* Legacy theme for CNPCShop's chrome (frame/title/tax-rate line/repair buttons/repair-money
   strip). #panel's left/top/scale come live from C++ (SyncRmlModel()), so coordinates below are
   plain reference px, not dp. No exit button -- see npc_shop.rml's own comment; the frame-corner
   close "X" stays native. Button/text positions match NPCShop.cpp's former RenderTexts()/
   SetButtonInfo()/RenderRepairMoney() constants. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "Liberation Sans";
}

#title {
	position: absolute;
	left: 0;
	top: 6px;
	width: 190px;
	text-align: center;
	color: #dcdcdc;
	font-weight: bold;
	font-size: 12px;
}
#tax_rate {
	position: absolute;
	left: 0;
	top: 21px;
	width: 190px;
	text-align: center;
	color: #dcdcdc;
	font-weight: bold;
	font-size: 11px;
}

/* Both buttons share one sprite -- NPCShop.cpp's former SetButtonInfo() pointed both
   m_BtnRepair/m_BtnRepairAll at the same IMAGE_NPCSHOP_BTN_REPAIR image, differing only by
   tooltip text. */
@spritesheet shop-btn-repair-sheet { src: "../../../newui_repair_00.tga"; shop-btn-repair: 0px 0px 36px 29px; }
.shop-btn {
	position: absolute;
	top: 390px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(shop-btn-repair);
}
.shop-btn:hover { filter: brightness(1.25); }
.shop-btn.hidden { display: none; }

.shop-btn-repair     { left: 54px; }
.shop-btn-repair-all { left: 98px; }

@spritesheet repair-money-sheet { src: "../../../newui_item_money2.tga"; repair-money: 0px 0px 170px 24px; }
.repair-money {
	position: absolute;
	left: 10px;
	top: 355px;
	width: 170px;
	height: 24px;
	pointer-events: none;
	decorator: image(repair-money);
}
.repair-money.hidden { display: none; }

.repair-money-label, .repair-money-value {
	position: absolute;
	top: 362px;
	font-weight: bold;
	font-size: 11px;
	white-space: nowrap;
	pointer-events: none;
}
.repair-money-label { left: 20px; color: #dcdcdc; }
.repair-money-value { left: 100px; }
.repair-money-label.hidden, .repair-money-value.hidden { display: none; }

.tooltip {
	display: none;
	position: absolute;
	top: 375px;
	width: 120px;
	white-space: nowrap;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "Liberation Sans";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
.tooltip-repair     { left: 12px; }
.tooltip-repair-all { left: 56px; }

#btn_repair:hover ~ .tooltip-repair,
#btn_repair_all:hover ~ .tooltip-repair-all {
	display: block;
}
