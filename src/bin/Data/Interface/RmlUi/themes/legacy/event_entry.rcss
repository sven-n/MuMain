/* Preserve the original frame and level-button art. Complete prose and level labels
   wrap in separate bounded panes instead of painting across fixed rows. */
@spritesheet entry-btn-sheet {
    src: "../../../newui_btn_empty_big.tga";
    entry-btn-up: 0px 0px 180px 29px;
    entry-btn-over: 0px 29px 180px 29px;
    entry-btn-down: 0px 58px 180px 29px;
}
.frame-top { decorator: image(docked-bg-top-b); }
#panel { pointer-events: auto; }

#title {
    display: block;
    position: absolute;
    left: 8px;
    top: 12px;
    --flow-w: 154px;
    font-weight: bold;
    line-height: 1.1;
    text-align: center;
    white-space: normal;
    word-break: break-word;
    pointer-events: none;
}

.entry-lines, .entry-buttons {
    position: absolute;
    left: 6px;
    --flow-w: 178px;
}
.entry-lines {
    top: 55px;
    line-height: 1.1;
    text-align: center;
}
.entry-line {
    display: block;
    white-space: normal;
    word-break: break-word;
    pointer-events: none;
}
.entry-line + .entry-line { margin-top: 0.25em; }

.entry-buttons {
    font-weight: bold;
    line-height: 1.1;
}
.entry-btn {
    /* The label centres on the band when the band's minimum height is the taller. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    min-height: calc(29px * var(--root-scale));
    padding: calc(6px * var(--root-scale)) calc(4px * var(--root-scale));
    pointer-events: auto;
}
.entry-btn + .entry-btn { margin-top: calc(4px * var(--root-scale)); }
.entry-btn-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}
.entry-label {
    display: block;
    position: relative;
    text-align: center;
    white-space: normal;
    word-break: break-word;
    pointer-events: none;
}

/* The pane is already physical-sized. Its descendants must not counter-scale again. */
.entry-lines scrollbarvertical, .entry-buttons scrollbarvertical {
    width: calc(15px * var(--root-scale));
}
.entry-lines scrollbarvertical sliderbar, .entry-buttons scrollbarvertical sliderbar {
    height: calc(30px * var(--root-scale));
}

#title, .entry-line { color: #ffffff; }
.entry-btn-art { decorator: image(entry-btn-up); }
.entry-btn.enabled:hover .entry-btn-art { decorator: image(entry-btn-over); }
.entry-btn.enabled:active .entry-btn-art { decorator: image(entry-btn-down); }
.entry-label { color: #969696; }
.entry-btn.enabled .entry-label { color: #ffffff; }

.entry-exit-glyph { display: none; }
