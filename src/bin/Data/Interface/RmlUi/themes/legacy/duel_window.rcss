/* Legacy theme for CDuelWindow, reproducing the original's RenderFrame()/RenderContents(): the
   131 x 70 figure-ground back, then the player's name and score in blue (0, 150, 255) at y + 33
   and the opponent's in red (255, 25, 25) at y + 56, names from x + 55, scores from x + 31, all
   in the bold font, left aligned (RenderText with no box). Reference px relative to the window's
   top-left, under .screen's W/640 x H/480 stretch (see duel_window.rml). */

@spritesheet duel-back-sheet { src: "../../../newui_Figure_ground.tga"; duel-back: 0px 0px 131px 70px; }

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
}

#panel { position: absolute; width: 131px; height: 70px; font-family: "token(font-body)"; }
#back { position: absolute; left: 0; top: 0; width: 131px; height: 70px; decorator: image(duel-back); }

.duel-text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: nowrap;
	font-weight: bold;
}
.duel-text.hero { color: #0096ff; top: 33px; }
.duel-text.enemy { color: #ff1919; top: 56px; }
#hero_name, #enemy_name { left: 55px; }
#hero_score, #enemy_score { left: 31px; }

/* The HUD takes no pointer events where it is placed (base.rcss gives a placed panel them). */
#panel.slot-placed { pointer-events: none; }
