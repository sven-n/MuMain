/* Legacy theme for the login/character-scene system menu (SysMenuWin). Panel chrome reproduces
   the real CWinEx art via base.rcss's shared .panel-cap-top/.panel-middle/.panel-cap-bottom.
   Buttons rely entirely on base.rcss's shared .btn; their positions are pushed from C++. */

@spritesheet sys-menu-top-sheet
{
	src: "../../../op1_back1.tga";
	sys-menu-top: 0px 0px 213px 64px;
}

#panel {
	position: absolute;
	font-family: "Liberation Sans";
	font-size: 12px;
	color: white;
}

.panel-cap-top {
	height: 64px;
	decorator: image(sys-menu-top);
}
