/* Legacy theme for the "remember password" OK/Cancel confirmation -- no dedicated sprite, flat/
   programmatic panel matching login.rcss's palette. */

/* #panel is centered via the .center-both utility class (remember_password_prompt.rml); every
   dimension is dp for the global auto-fit. */
#panel {
	width: 340dp;
	height: 150dp;
	font-family: "Liberation Sans";
	font-size: 12dp;
	color: white;
	background-color: #1a140a;
	border: 1dp #806040;
}

.prompt-title {
	position: absolute;
	left: 20dp;
	top: 15dp;
	width: 300dp;
	color: #ffd23c;
	font-weight: bold;
}

.prompt-body {
	position: absolute;
	left: 20dp;
	top: 40dp;
	width: 300dp;
	color: #ff9c40;
	white-space: normal;
}

.btn-ok     { left: 52dp;  top: 105dp; }
.btn-cancel { left: 180dp; top: 105dp; }
