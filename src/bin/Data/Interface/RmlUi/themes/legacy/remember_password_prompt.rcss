/* Legacy theme for the "remember password" OK/Cancel confirmation. No dedicated sprite asset --
   flat/programmatic panel, matching login.rcss's legacy palette. */

/* 2026-09-03: #panel no longer C++-positioned -- centered via the .center-both utility class
   (applied in remember_password_prompt.rml). Every dimension below is dp now (was px) so this
   dialog participates in the global dp auto-fit like everything else. */
#panel {
	width: 340dp;
	height: 150dp;
	font-family: "Liberation Sans";
	font-size: 12px;
	color: white;
	background-color: #1a140a;
	border: 1dp #806040;
}

.prompt-title {
	position: absolute;
	left: 20dp;
	top: 15dp;
	width: 300dp;
	color: #ffd23c;
	font-weight: bold;
}

.prompt-body {
	position: absolute;
	left: 20dp;
	top: 40dp;
	width: 300dp;
	color: #ff9c40;
	white-space: normal;
}

.btn-ok     { left: 52dp;  top: 105dp; }
.btn-cancel { left: 180dp; top: 105dp; }
