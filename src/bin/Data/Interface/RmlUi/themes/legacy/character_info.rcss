/* Legacy theme for CCharacterInfoWindow -- a plain CManager-tier window (no C3DRenderMng, no
   live-3D icon, no CUITextInputBox), so unlike the inventory family it needed no background-
   context split: 100% of its chrome/text/buttons move straight to #panel's own foreground
   document. #panel's left/top/scale come live from C++ (SyncRmlModel()); coordinates below are
   plain reference px, not dp, same convention as my_quest_info.rcss.

   The summary box's original 8-piece pixel-tiled frame (4 corner sprites + a 1px sprite tiled
   across each edge, RenderFrame()'s nested for-loops) is reproduced as corner brackets + a flat
   translucent fill instead of a literal repeating-tile port -- this build has no established,
   verified pattern for a real 1px-tile repeat (see STATUS.md's decorator-native-size finding),
   and the brackets alone already read as "framed corners" the way the original intended.

   Attribute extra-line blocks (str/agi/vit/ene) use normal block flow (each line a
   display:block span, line-height 13px) instead of individually positioned lines: the original
   (RenderAttribute()) stacks a variable number of lines per block depending on class/buff state
   at a constant +13px step, which block flow reproduces for free without hand-computing each
   line's own top offset in C++. */
@spritesheet chainfo-bg-fill-sheet { src: "../../../newui_msgbox_back.jpg"; chainfo-bg-fill: 0px 0px 190px 429px; }
@spritesheet chainfo-bg-top-sheet  { src: "../../../newui_item_back04.tga"; chainfo-bg-top: 0px 0px 190px 64px; }
@spritesheet chainfo-bg-left-sheet  { src: "../../../newui_item_back02-L.tga"; chainfo-bg-left:  0px 0px 21px 320px; }
@spritesheet chainfo-bg-right-sheet { src: "../../../newui_item_back02-R.tga"; chainfo-bg-right: 0px 0px 21px 320px; }
@spritesheet chainfo-bg-bottom-sheet { src: "../../../newui_item_back03.tga"; chainfo-bg-bottom: 0px 0px 190px 45px; }

@spritesheet chainfo-corner-tl-sheet { src: "../../../newui_item_table01(L).tga"; chainfo-corner-tl: 0px 0px 14px 14px; }
@spritesheet chainfo-corner-tr-sheet { src: "../../../newui_item_table01(R).tga"; chainfo-corner-tr: 0px 0px 14px 14px; }
@spritesheet chainfo-corner-bl-sheet { src: "../../../newui_item_table02(L).tga"; chainfo-corner-bl: 0px 0px 14px 14px; }
@spritesheet chainfo-corner-br-sheet { src: "../../../newui_item_table02(R).tga"; chainfo-corner-br: 0px 0px 14px 14px; }

@spritesheet chainfo-textbox-sheet { src: "../../../newui_cha_textbox02.tga"; chainfo-textbox: 0px 0px 170px 21px; }
@spritesheet chainfo-stat-btn-sheet { src: "../../../newui_chainfo_btn_level.tga"; chainfo-stat-btn: 0px 0px 16px 15px; }
@spritesheet chainfo-btn-exit-sheet { src: "../../../newui_exit_00.tga"; chainfo-btn-exit: 0px 0px 36px 29px; }
@spritesheet chainfo-btn-quest-sheet { src: "../../../newui_chainfo_btn_quest.tga"; chainfo-btn-quest: 0px 0px 36px 29px; }
@spritesheet chainfo-btn-pet-sheet { src: "../../../newui_chainfo_btn_pet.tga"; chainfo-btn-pet: 0px 0px 36px 29px; }
@spritesheet chainfo-btn-masterlevel-sheet { src: "../../../newui_chainfo_btn_master.tga"; chainfo-btn-masterlevel: 0px 0px 36px 29px; }

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	decorator: image(chainfo-bg-fill);
	font-family: "Liberation Sans";
}

.frame-piece { position: absolute; pointer-events: none; }
.frame-top    { left: 0;   top: 0;    width: 190px; height: 64px;  decorator: image(chainfo-bg-top); }
.frame-left   { left: 0;   top: 64px; width: 21px;  height: 320px; decorator: image(chainfo-bg-left); }
.frame-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(chainfo-bg-right); }
.frame-bottom { left: 0;   top: 384px; width: 190px; height: 45px; decorator: image(chainfo-bg-bottom); }

#name, #classname, #servername {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	font-weight: bold;
	font-size: 12px;
	pointer-events: none;
}
#classname, #servername { top: 27px; color: #ffffff; }

.summary-fill {
	position: absolute;
	left: 12px;
	top: 48px;
	width: 165px;
	height: 71px;
	background-color: rgba(0, 0, 0, 77);
	pointer-events: none;
}
.summary-corner { position: absolute; width: 14px; height: 14px; pointer-events: none; }
.corner-tl { left: 12px;  top: 48px; decorator: image(chainfo-corner-tl); }
.corner-tr { left: 163px; top: 48px; decorator: image(chainfo-corner-tr); }
.corner-bl { left: 12px;  top: 105px; decorator: image(chainfo-corner-bl); }
.corner-br { left: 163px; top: 105px; decorator: image(chainfo-corner-br); }

.level-text, .levelup-point-text, .exp-text, .point-probability-text, .point-text {
	display: block;
	position: absolute;
	left: 18px;
	font-size: 12px;
	white-space: nowrap;
	pointer-events: none;
}
.level-text { top: 58px; color: #e6e600; font-weight: bold; }
.levelup-point-text { top: 58px; left: 110px; color: #ff8a00; font-weight: bold; }
.exp-text { top: 75px; color: #ffffff; }
.point-probability-text { top: 88px; color: #4cc5fe; }
.point-text { top: 101px; color: #4cc5fe; }
.hidden { display: none; }

/* Attribute rows: textbox background (170x21) + centered label/value halves + a variable-length
   block of extra derived-stat lines below. HEIGHT_STRENGTH/DEXTERITY/VITALITY/ENERGY/CHARISMA
   (CharacterInfoWindow.h) are 120/175/240/295/350. */
.attr-textbox {
	position: absolute;
	left: 11px;
	width: 170px;
	height: 21px;
	decorator: image(chainfo-textbox);
	pointer-events: none;
}
.attr-textbox-str { top: 120px; }
.attr-textbox-agi { top: 175px; }
.attr-textbox-vit { top: 240px; }
.attr-textbox-ene { top: 295px; }
.attr-textbox-cmd { top: 350px; }

.attr-label, .attr-value {
	display: block;
	position: absolute;
	text-align: center;
	font-weight: bold;
	font-size: 12px;
	pointer-events: none;
}
.attr-label { left: 12px; width: 74px; color: #ffffff; }
.attr-value { left: 86px; width: 86px; }
.attr-label-str, .attr-value-str { top: 126px; }
.attr-label-agi, .attr-value-agi { top: 181px; }
.attr-label-vit, .attr-value-vit { top: 246px; }
.attr-label-ene, .attr-value-ene { top: 301px; }
.attr-label-cmd, .attr-value-cmd { top: 356px; }

/* Extra derived-stat lines: normal block flow, one span per line at a fixed 13px line-height --
   reproduces RenderAttribute()'s iY += 13 stacking without per-line C++ offsets (see header
   comment). Left/top per block match the original's own RenderText() call sites. */
.attr-lines { position: absolute; width: 160px; pointer-events: none; }
.attr-lines span { display: block; line-height: 13px; font-size: 12px; white-space: nowrap; }
.attr-lines-str { left: 20px; top: 145px; }
.attr-lines-agi { left: 20px; top: 199px; }
.attr-lines-vit { left: 20px; top: 264px; }
.attr-lines-ene { left: 18px; top: 319px; }

.stat-btn {
	position: absolute;
	left: 160px;
	width: 16px;
	height: 15px;
	decorator: image(chainfo-stat-btn);
	cursor: pointer;
	pointer-events: auto;
}
.stat-btn:hover { filter: brightness(1.25); }
.stat-btn-str { top: 122px; }
.stat-btn-agi { top: 177px; }
.stat-btn-vit { top: 242px; }
.stat-btn-ene { top: 297px; }
.stat-btn-cmd { top: 352px; }

.info-btn {
	position: absolute;
	top: 392px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.info-btn:hover { filter: brightness(1.25); }
.info-btn.locked { filter: brightness(0.6); }
.info-btn-exit { left: 13px; decorator: image(chainfo-btn-exit); }
.info-btn-quest { left: 50px; decorator: image(chainfo-btn-quest); }
.info-btn-pet { left: 87px; decorator: image(chainfo-btn-pet); }
.info-btn-masterlevel { left: 124px; decorator: image(chainfo-btn-masterlevel); }

/* Exit's sprite already has its own "X" baked in -- the shared label span is redundant here,
   same convention as my_quest_info.rcss. */
.btn-exit-label { display: none; }

.tooltip {
	display: none;
	position: absolute;
	top: 365px;
	width: 110px;
	white-space: nowrap;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 2px 4px;
	border-radius: 3px;
	font-size: 11px;
	text-align: center;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit { left: -24px; }
.tooltip-quest { left: 13px; }
.tooltip-pet { left: 50px; }
.tooltip-masterlevel { left: 87px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_quest:hover ~ .tooltip-quest,
#btn_pet:hover ~ .tooltip-pet,
#btn_masterlevel:hover ~ .tooltip-masterlevel {
	display: block;
}
