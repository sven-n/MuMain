/* Window placement for the legacy theme. The game reads where each open slot lands; nothing here is drawn. */

body {
	width: 100%;
	height: 100%;
	margin: 0;
	visibility: hidden;
	pointer-events: none;
}

#safe_area {
	position: absolute;
	left: 0;
	top: 0;
	right: 0;
}

.region {
	position: absolute;
}

/* The original's docked columns: open windows pack from the right edge, sitting on the HUD. */
.dock-right {
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row-reverse;
	align-items: flex-start;
}

.slot {
	display: none;
	flex: 0 0 auto;
}

.slot.open {
	display: block;
}

/* The original's left-docked warp list, sitting on the HUD. */
.dock-left {
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

/* Where a free window (the friend list) first opens: the bottom-right corner above the HUD. */
.free-bottom-right {
	right: 0;
	bottom: 0;
}

/* The original's centred NPC panels: a 640x480 stage in the screen's centre (1dp is one of its
   units at the panel scale), each panel centred across it at the original's height. */
.panel-stage {
	left: 50%;
	top: 50%;
	width: 640dp;
	height: 480dp;
	margin-left: -320dp;
	margin-top: -240dp;
	display: flex;
	flex-direction: column;
	align-items: center;
}
.panel-stage .slot[data-window="kanturu_entry"] { margin-top: 20dp; }
.panel-stage .slot[data-window="cursed_temple_entry"] { margin-top: 80dp; }
.panel-stage .slot[data-window="cursed_temple_result"] { margin-top: 120dp; }
