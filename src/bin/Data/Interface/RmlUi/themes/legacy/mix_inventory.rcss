/* Legacy theme for CMixInventory's chrome (frame/title/Mix button). #panel's left/top/scale come
   live from C++ (SyncRmlModel()), so coordinates below are plain reference px, not dp. The large
   native recipe/tax-rate/success-rate text block (RenderFrame()/RenderMixDescriptions()) and the
   socket list box render on top of this document's frame, untouched and out of scope here. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "Liberation Sans";
}

#title {
	position: absolute;
	left: 0;
	top: 11px;
	width: 190px;
	text-align: center;
	color: #ffffff;
	font-weight: bold;
	font-size: 12px;
}

/* 44x35 crop of the top-left ("up") frame of the native 2-frame vertical button sheet
   (CMixInventory::Create()'s former ChangeButtonInfo(..., 44.f, 35.f)) -- hover uses a CSS
   brightness filter instead of the sheet's own "down"/"over" frames, same convention as every
   other migrated inv-btn/ext-btn. Centered: (190-44)/2 = 73, top matches the native
   `m_Pos.y + 380`. */
@spritesheet mix-btn-sheet { src: "../../../newui_bt_mix.tga"; mix-btn: 0px 0px 44px 35px; }
.mix-btn {
	position: absolute;
	left: 73px;
	top: 380px;
	width: 44px;
	height: 35px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(mix-btn);
}
.mix-btn:hover { filter: brightness(1.25); }
.mix-btn.hidden { display: none; }
.mix-btn.locked { pointer-events: none; filter: brightness(0.6); }

.tooltip {
	display: none;
	position: absolute;
	top: 364px;
	left: 35px;
	width: 120px;
	white-space: nowrap;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "Liberation Sans";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
#btn_mix:hover ~ .tooltip-mix { display: block; }
