/* Legacy theme for the server-select dialog (CServerSelWin). A fresh RmlUi layout, not a pixel
   port of the old CWinEx/CButton/CGaugeBar screen -- there's no legacy geometry left to match (see
   ui-target-architecture.md's note on why CWinEx's asset-derived panel height couldn't safely be
   preserved when this window's native backdrop was retired). The load gauge is a flat color fill,
   matching component-catalog.md's guidance not to invent a "reusable primitive" ahead of a second
   real need.

   #panel itself is intentionally invisible (no background/border) -- the real legacy screen has
   no panel chrome at all, just buttons and text floating over the login art. #panel deliberately
   has no explicit height: only #group_row (in normal flow) contributes to its auto height; the
   absolutely-positioned #server_list/#pvp_notice/#desc_panel don't, by design. This box is what
   .center-both actually centers, so it must match the real visible content's footprint, not the
   flyout's worst-case extent -- ServerSelWin.h's kPanelWidth/kPanelHeight is a separate, oversized
   rect used only for the native click-gate (UpdateMouseEvent()); giving #panel that same oversized
   height here previously made .center-both center a box far taller than the window on common
   resolutions, pinning the real content near the top instead of the middle. */

/* No explicit position here -- .center-both (base.rcss) supplies position:absolute plus the
   left/top/transform centering math, same as sys_menu.rcss/msg_win.rcss's own #panel. Redeclaring
   position on this ID rule too is harmless in standard CSS cascade terms, but every other
   self-centering window here leaves it out, so this matches that precedent exactly rather than
   introducing an unexplained difference. */
#panel {
	width: 500px;
	font-family: "Liberation Sans";
	font-size: 12px;
	color: white;
	padding: 10px;
}

#group_row {
	position: relative;
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	width: 480px;
	height: 400px;
	padding-top: 34px;
}
/* #group_row's own height is a fixed worst-case reservation (10 groups per column --
   ServerSelWin.cpp caps leftGroups/rightGroups at 10 each), not the real button count, so the
   real buttons must be vertically centered within it (not packed to its top) -- otherwise a
   typical, mostly-empty column looks pinned near the top of #panel once .center-both centers
   that oversized row, most visibly at smaller window heights. */
#left_col, #right_col {
	display: flex;
	flex-direction: column;
	justify-content: center;
}
#test_server_btn {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
}

/* Sprite provides the border/frame (ninepatch, base.rcss), stretched from its native 108x30 rect;
   a translucent tint decorator layered on top (RmlUi paints the first-listed decorator in a
   comma-separated list frontmost, later ones behind) gives the glassy body read instead of the
   sprite's own opaque fill.

   Height (32px, no padding/border-width to add to it) matches .server-row's real on-screen height
   below (25px declared + its own 3px+4px padding = 32px -- see that rule's comment for why its
   declared height isn't literally 32 too). ServerSelWin.cpp's kGroupBtnRowHeight (36px = this real
   height + margin-bottom) must stay in sync with it, since the C++ uses it to compute the
   server-list flyout's docked top per clicked row. */
.group-btn {
	position: relative;
	width: 108px;
	height: 32px;
	margin-bottom: 4px;
	text-align: center;
	vertical-align: middle;
	line-height: 32px;
	cursor: pointer;
	pointer-events: auto;
	decorator: linear-gradient(to bottom, rgba(0, 0, 0, 140), rgba(0, 0, 0, 140)), ninepatch(legacy-btn-idle, legacy-btn-idle-inner);
	color: #d8d8d8;
}
.group-btn:hover {
	decorator: linear-gradient(to bottom, rgba(40, 40, 40, 150), rgba(40, 40, 40, 150)), ninepatch(legacy-btn-hover, legacy-btn-hover-inner);
}
.group-btn.checked {
	decorator: linear-gradient(to bottom, rgba(60, 50, 20, 150), rgba(60, 50, 20, 150)), ninepatch(legacy-btn-active, legacy-btn-active-inner);
	color: #ffffff;
}

/* Flyout: absent until a group is clicked, then docks beside that specific button -- see
   ServerSelRmlModel's own comment (ServerSelWin.h). top is always pushed from C++
   (data-style-top); dock-left/dock-right/dock-center below only resolve the horizontal side, since
   an inline data-style-top always wins over any class rule's own top. No background/border/padding
   of its own -- the .server-row buttons stacked inside it are enough on their own, no enclosing
   panel needed; width matches .server-row's own width directly since there's no padding gutter to
   size around anymore. */
#server_list {
	position: absolute;
	width: 220px;
	max-height: 352px;
	overflow: hidden auto;
}
#server_list.dock-left {
	left: 118px;
}
#server_list.dock-right {
	right: 118px;
}
#server_list.dock-center {
	left: 50%;
	transform: translateX(-50%);
}

/* Same construction as .group-btn above -- sprite ninepatch for the border/frame, a translucent
   tint decorator layered in front for the glassy body, so both buttons share one look. No CSS
   `border` property here: this element has a child (.server-gauge-slot below), and a border-width
   property on a bordered element with a child does not render as a closed rectangle in this RmlUi
   build. The ninepatch decorator paints via a separate code path and isn't affected.

   Width (200px) isn't the same as .group-btn's 108px -- the label (s.label, e.g.
   "Valhalla-1(Gold) Connect") needs this much room to fit on one line; ninepatch (unlike the plain
   image() decorator, which only renders cleanly at the sprite's native 108x30 size) stretches to
   this wider box without distortion.

   height is 25px, not .group-btn's 32px -- `height` sets content size only, and padding is added
   on top of it. 25 + this row's own 3px+4px padding = 32, matching .group-btn's real on-screen
   height (no border-width here to add on top, since the ninepatch decorator paints its own frame
   without a separate border box).

   width is a literal px value (200 = #server_list's 220px minus this row's own 10px+10px padding).
   .server-gauge-slot has neither padding nor border, so its width is the direct target (180px),
   inset by a literal 10px left margin to center it within .server-row's own 200px content width. */
.server-row {
	display: block;
	position: relative;
	width: 200px;
	height: 25px;
	margin-bottom: 1px;
	padding: 3px 10px 4px;
	text-align: center;
	line-height: 14px;
	white-space: nowrap;
	cursor: pointer;
	pointer-events: auto;
	decorator: linear-gradient(to bottom, rgba(0, 0, 0, 140), rgba(0, 0, 0, 140)), ninepatch(legacy-btn-idle, legacy-btn-idle-inner);
	color: #f0d74d;
}
.server-row:hover {
	decorator: linear-gradient(to bottom, rgba(40, 40, 40, 150), rgba(40, 40, 40, 150)), ninepatch(legacy-btn-hover, legacy-btn-hover-inner);
}
.server-row:active {
	transform: translateY(1px);
}
.server-row.gray {
	color: #b0b0b0;
}
.server-row.orange {
	color: #ff9c3c;
}

.server-gauge-slot {
	display: block;
	width: 180px;
	height: 5px;
	margin: 4px 0 0 10px;
	background-color: rgba(0, 0, 0, 160);
	decorator: repeating-linear-gradient(to right, #030303 0, #030303 17px, #222222 17px, #222222 20px);
}
.server-gauge-fill {
	display: block;
	height: 100%;
	background-color: #00bd8b;
}

#pvp_notice {
	position: absolute;
	left: 0;
	top: 420px;
	width: 480px;
	color: #ffcc66;
	font-size: 11px;
}

#desc_panel {
	position: absolute;
	left: 0;
	top: 470px;
	width: 480px;
	color: #d8d8d8;
	white-space: normal;
}
