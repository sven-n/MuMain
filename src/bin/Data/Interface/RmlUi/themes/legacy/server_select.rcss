/* Legacy theme for the server-select dialog (CServerSelWin) -- a fresh RmlUi layout, not a pixel
   port of the old CWinEx/CButton/CGaugeBar screen. The load gauge is a flat color fill. #panel is
   intentionally invisible (no background/border) -- the real legacy screen has no panel chrome,
   just buttons and text over the login art. Two always-visible columns use real flexbox, not the
   old absolutely-positioned flyout keyed to whichever group button was clicked. Sizes are pixels
   in rem (server_select.rml's body is "scene-window-scale": 1rem = one pixel of the original's fixed-size
   screen, growing like the native text, RmlNativeText.h). */

/* No explicit position -- .center-both (base.rcss) supplies position:absolute plus centering,
   same as sys_menu.rcss/msg_win.rcss's own #panel. */
#panel {
	width: 420rem;
	font-family: "token(font-body)";
	font-size: 12rem;
	color: token(text-primary);
	padding: 10rem;
}

/* height is fixed, not auto -- #panel uses .center-both, which recenters on #panel's current size;
   auto height would visibly shift the whole panel as it grew. Columns still scroll internally via
   their own overflow:auto. */
#columns {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18rem;
	height: 300rem;
}

/* height (not max-height) matches #columns' own fixed height for the same reason -- a shorter
   list just centers via justify-content:center rather than shrinking the box. */
#group_col {
	display: flex;
	flex-direction: column;
	justify-content: center;
	align-items: center;
	flex-shrink: 0;
	gap: 6rem;
	width: 140rem;
	height: 300rem;
	overflow: hidden auto;
}
/* The channels scroll when they don't fit (.scroll-pane, server_select.rml); the rows never
   shrink. #server_rows' auto margins center a short list and start a long one at the top.
   The column is as wide as its rows, which are all as wide as the widest (.server-row): a long
   channel text widens the column to the right, past #panel's width if it must. */
#server_col {
	display: flex;
	flex-direction: column;
	align-items: center;
	flex-shrink: 0;
	height: 300rem;
	padding: 0 calc(6rem + 15dp) 0 6rem;
}
/* RmlUi sizes a column to its content without its scrollbar, so a scrollbar taking its width
   from the content would squeeze the rows again: it takes none (its margin cancels its width)
   and sits in the column's right padding, beside the rows. */
#server_col scrollbarvertical {
	margin-left: -15dp;
}
#server_rows {
	display: flex;
	flex-direction: column;
	align-items: stretch;
	gap: 6rem;
	margin: auto 0;
}
#server_rows .server-row {
	flex-shrink: 0;
}
/* #server_col is an ID selector, so it always outranks base.rcss's global `.hidden{display:none}`
   on specificity alone (an ID beats any number of plain classes) -- unlike the many `.foo.hidden`
   compound overrides elsewhere in this codebase, which only break a same-specificity class-vs-class
   tie. Without this, data-class-hidden="!server_list_visible" (server_select.rml) never actually
   hid this column. */
#server_col.hidden {
	display: none;
}

/* Keep the original 108x26 group and 193x26 server frames at their native aspect
   ratios. The shared base styles provide sprites, state colors and label press offsets. */
.group-btn {
	width: 108rem;
	height: 26rem;
	text-align: center;
	line-height: 26rem;
}
/* The original 193x26 frame (tiled, base.rcss), 10px taller so the channel's text and the load
   bar below it each have room, and wider when a channel's text needs it: every row is as wide as
   the widest text in the list plus 16px on each side (#server_rows stretches them), at least the
   original 193px. */
.server-row {
	position: relative;
	min-width: 161rem;
	height: 36rem;
	padding: 0 16rem;
	text-align: center;
	white-space: nowrap;
}
.button-label {
	pointer-events: none;
}
/* The channel's text at the top, its capitals about 4px below the top border; a block, as a
   div is inline in RmlUi and would sit on the middle of the row's line instead. */
.server-row .button-label {
	display: block;
	padding-top: 4rem;
	line-height: 16rem;
}

/* The {load} text of a full or overloaded server, in the server list's look for it. */
.server-load.load-gray { color: token(server-button-gray); }
.server-load.load-orange { color: token(server-button-orange); }
.server-load.load-silver { color: token(server-button-silver); }
.server-load.bold { font-weight: bold; }
.server-load.italic { font-style: italic; }
/* For a font without an italic face. */
.server-load.slant {
	display: inline-block;
	transform: skewX(-12deg);
}

/* Original gauge footprint: 4px tall, inset 16px from the left and 17px from the right (160px
   wide in the original frame), now ten segments of 10 % each, 5px below the text's lowest
   descents and 5px above the frame's bottom edge; its geometry follows the frame's scene scale. */
.server-gauge-slot {
	position: absolute;
	left: 16rem;
	right: 17rem;
	top: 24rem;
	height: 4rem;
	display: flex;
	gap: 2rem;
	pointer-events: none;
}
.server-gauge-segment {
	flex: 1;
	height: 100%;
	background-color: token(server-load-empty);
}
.server-gauge-fill {
	display: block;
	height: 100%;
}

/* Normal block flow below #columns now, not position:absolute with a hand-picked top offset. */
#pvp_notice {
	margin-top: 16rem;
	width: 100%;
	color: #ffcc66;
	font-size: 11rem;
}

#desc_panel {
	margin-top: 10rem;
	width: 100%;
	color: token(text-secondary);
	white-space: normal;
}
