/* Shared frame for the PanelColumnX()-docked single-document window family: character_info,
   my_quest_info, pet_info, party_info. Their #panel/frame sprites/exit button are
   byte-identical (confirmed by diffing all four before this file existed) -- link this BEFORE the
   window's own .rcss and keep only genuinely window-specific content there. */

@spritesheet docked-bg-fill-sheet  { src: "../../../newui_msgbox_back.jpg";  docked-bg-fill:   0px 0px 190px 429px; }
@spritesheet docked-bg-top-a-sheet { src: "../../../newui_item_back04.tga"; docked-bg-top-a: 0px 0px 190px 64px; }
@spritesheet docked-bg-top-b-sheet { src: "../../../newui_item_back01.tga"; docked-bg-top-b: 0px 0px 190px 64px; }
@spritesheet docked-bg-left-sheet  { src: "../../../newui_item_back02-L.tga"; docked-bg-left:  0px 0px 21px 320px; }
@spritesheet docked-bg-right-sheet { src: "../../../newui_item_back02-R.tga"; docked-bg-right: 0px 0px 21px 320px; }
@spritesheet docked-bg-bottom-sheet { src: "../../../newui_item_back03.tga"; docked-bg-bottom: 0px 0px 190px 45px; }

@spritesheet docked-corner-tl-sheet { src: "../../../newui_item_table01(L).tga"; docked-corner-tl: 0px 0px 14px 14px; }
@spritesheet docked-corner-tr-sheet { src: "../../../newui_item_table01(R).tga"; docked-corner-tr: 0px 0px 14px 14px; }
@spritesheet docked-corner-bl-sheet { src: "../../../newui_item_table02(L).tga"; docked-corner-bl: 0px 0px 14px 14px; }
@spritesheet docked-corner-br-sheet { src: "../../../newui_item_table02(R).tga"; docked-corner-br: 0px 0px 14px 14px; }
@spritesheet docked-edge-top-sheet    { src: "../../../newui_item_table03(Up).tga"; docked-edge-top:    0px 0px 1px 14px; }
@spritesheet docked-edge-bottom-sheet { src: "../../../newui_item_table03(Dw).tga"; docked-edge-bottom: 0px 0px 1px 14px; }
@spritesheet docked-edge-left-sheet   { src: "../../../newui_item_table03(L).tga";  docked-edge-left:   0px 0px 14px 1px; }
@spritesheet docked-edge-right-sheet  { src: "../../../newui_item_table03(R).tga";  docked-edge-right:  0px 0px 14px 1px; }

@spritesheet docked-exit-btn-sheet { src: "../../../newui_exit_00.tga"; docked-exit-btn: 0px 0px 36px 29px; }

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	decorator: image(docked-bg-fill);
	font-family: "token(font-body)";
}

.frame-piece { position: absolute; pointer-events: none; }
/* .frame-top's own decorator is the one real per-window variation (see header comment) -- the
   window's own .rcss adds one line, ".frame-top { decorator: image(docked-bg-top-a); }" (or
   docked-bg-top-b), which merges into this rule via the normal multi-file cascade. No RML change
   needed either way. */
/* Pinned to #panel's edges, so a theme that resizes the panel stretches the strips with it. */
.frame-top    { left: 0;  right: 0; top: 0;     height: 64px; }
.frame-left   { left: 0;  top: 64px; bottom: 45px; width: 21px; decorator: image(docked-bg-left); }
.frame-right  { right: 0; top: 64px; bottom: 45px; width: 21px; decorator: image(docked-bg-right); }
.frame-bottom { left: 0;  right: 0; bottom: 0;  height: 45px; decorator: image(docked-bg-bottom); }

/* Group-box corner-bracket-and-fill technique -- reproduces RenderGroupBox()'s 9-slice tiling as 4
   corner sprites + 2 flat fills, not a literal 1px-tile port (no verified repeat pattern exists in
   this RmlUi build; character_info.rcss's original .summary-fill/.summary-corner established this
   simplification first). Shape/color only here -- each window's own per-instance class (e.g.
   ".gbox-dh-corner-tl") supplies left/top and picks which corner sprite via
   image(docked-corner-tl/tr/bl/br). */
.gbox-corner { position: absolute; width: 14px; height: 14px; pointer-events: none; }
/* RenderGroupBox()'s edge strips (the table03 sprites stretched along each side), drawn after the
   corners; each window supplies left/top and the free length. */
.gbox-edge { position: absolute; pointer-events: none; }
.gbox-edge-top { height: 14px; decorator: image(docked-edge-top); }
.gbox-edge-bottom { height: 14px; decorator: image(docked-edge-bottom); }
.gbox-edge-left { width: 14px; decorator: image(docked-edge-left); }
.gbox-edge-right { width: 14px; decorator: image(docked-edge-right); }
.gbox-title-fill { position: absolute; background-color: token(surface-panel-title); pointer-events: none; }
.gbox-content-fill { position: absolute; background-color: token(surface-panel-content); pointer-events: none; }
.gbox-title-text {
	display: block;
	position: absolute;
	text-align: center;
	font-weight: bold;
	font-size: 1em;
	color: token(text-heading);
	pointer-events: none;
}

/* Exit is byte-identical everywhere (same sprite, 36x29 at 13 from the left, 8 above the panel's
   bottom: the original's 13,392 in a 429-tall panel) -- targeted by id since
   every window's exit div already has id="btn_exit", so no per-window class or RML change is
   needed. Wins over any leftover per-window class rule regardless of link order (id beats class
   specificity), so old per-window "-exit" rules are safe to delete without a race. */
#btn_exit {
	position: absolute;
	left: 13px;
	bottom: 8px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(docked-exit-btn);
}
#btn_exit:hover { filter: brightness(1.25); }

/* A theme's data-fit="fill" slot sizes #panel (class fill-placement), its border included. */
#panel.fill-placement { box-sizing: border-box; }
/* The frame's corner close (the original's 13x12 at 169,7), pinned to #panel's top-right corner;
   each window's markup adds it with its own close event. */
#frame_corner_close {
	position: absolute;
	top: 7px;
	right: 8px;
	width: 13px;
	height: 12px;
	cursor: pointer;
	pointer-events: auto;
}
