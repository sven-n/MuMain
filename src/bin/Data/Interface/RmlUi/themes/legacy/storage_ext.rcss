/* Legacy theme for CStorageInventoryExt's chrome (frame/title/exit button). #panel's left/top/
   scale come live from C++ (SyncRmlModel()), so coordinates below are plain reference px, not dp. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

#title {
	position: absolute;
	left: 0;
	top: 11px;
	width: 190px;
	text-align: center;
	color: token(text-primary);
	font-weight: bold;
	font-size: 1em;
}

@spritesheet ext-btn-exit-sheet { src: "../../../newui_exit_00.tga"; ext-btn-exit: 0px 0px 36px 29px; }
.ext-btn {
	position: absolute;
	left: 13px;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(ext-btn-exit);
}
.ext-btn:hover { filter: brightness(1.25); }

/* Button hints as docked_panel_frame.rcss draws them (CNewUIButton::Render()): a transparent
   120-wide row (content centre at left + 4 + 60) anchored 2 above the button by its bottom
   edge; the inner .tooltip-text span carries the black 180/255 box, text width + 6. */
.tooltip {
	display: none;
	position: absolute;
	bottom: 38px; /* 429 - 391 */
	left: -30px;
	width: 120px;
	white-space: nowrap;
	color: token(text-primary);
	padding: 2px 4px;
	font-family: "token(font-body)";
	font-size: 1em;
	text-align: center;
	pointer-events: none;
	z-index: 1;
}
.tooltip.sharp-text { transform-origin: left bottom; }
.tooltip-text { background-color: rgba(0, 0, 0, 180); }
#btn_exit:hover ~ .tooltip-exit { display: block; }
