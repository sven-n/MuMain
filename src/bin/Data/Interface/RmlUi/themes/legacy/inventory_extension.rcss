/* Legacy theme for CInventoryExtension's chrome (frame/title/exit button). #panel's left/top/
   scale come live from C++ (SyncRmlModel()), so coordinates below are plain reference px, not dp. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	color: token(text-primary);
	font-weight: bold;
	font-size: 1em;
}

@spritesheet ext-btn-exit-sheet { src: "../../../newui_exit_00.tga"; ext-btn-exit: 0px 0px 36px 29px; }
.ext-btn {
	position: absolute;
	left: 13px;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(ext-btn-exit);
}
.ext-btn:hover { filter: brightness(1.25); }

/* Button hints as docked_panel_frame.rcss draws them (CNewUIButton::Render()): a transparent
   120-wide row (content centre at left + 4 + 60) anchored 2 above the button by its bottom
   edge; the inner .tooltip-text span carries the black 180/255 box, text width + 6. */
.tooltip {
	display: none;
	position: absolute;
	bottom: 38px; /* 429 - 391 */
	left: -30px;
	width: 120px;
	white-space: nowrap;
	color: token(text-primary);
	padding: 2px 4px;
	font-family: "token(font-body)";
	font-size: 1em;
	text-align: center;
	pointer-events: none;
	z-index: 1;
}
.tooltip.sharp-text { transform-origin: left bottom; }
.tooltip-text { background-color: rgba(0, 0, 0, 180); }
#btn_exit:hover ~ .tooltip-exit { display: block; }

/* Locked-page numbered lock glyph -- one file per number (not a packed atlas), each sheet is the
   whole 25x28 source image. `left`/`width`/`height` match RenderImage(IMAGE_EXTENSION_NO.., x+85,
   ..., 25, 28) (InventoryExtension.cpp); `top` comes per-instance from C++ (page.top). */
@spritesheet ext-lock-1-sheet { src: "../../../newui_item_add_marking_no01.tga"; ext-lock-1: 0px 0px 25px 28px; }
@spritesheet ext-lock-2-sheet { src: "../../../newui_item_add_marking_no02.tga"; ext-lock-2: 0px 0px 25px 28px; }
@spritesheet ext-lock-3-sheet { src: "../../../newui_item_add_marking_no03.tga"; ext-lock-3: 0px 0px 25px 28px; }
@spritesheet ext-lock-4-sheet { src: "../../../newui_item_add_marking_no04.tga"; ext-lock-4: 0px 0px 25px 28px; }

.ext-locked-page {
	position: absolute;
	left: 85px;
	width: 25px;
	height: 28px;
	pointer-events: none;
}
.ext-locked-icon {
	position: absolute;
	left: 0;
	top: 0;
	width: 25px;
	height: 28px;
	pointer-events: none;
	/* decorator set per-instance via data-style-decorator (inventory_extension.rml). */
}

/* Each locked page's own row (71 + HEIGHT_PER_EXT per page) and its marking. The pages shown are
   sparse, so a row is identified by which page it is rather than by its place in the list. */
.ext-locked-page.page-1 { top: 71px; }
.ext-locked-page.page-2 { top: 158px; }
.ext-locked-page.page-3 { top: 245px; }
.ext-locked-page.page-4 { top: 332px; }
.page-1 .ext-locked-icon { decorator: image(ext-lock-1); }
.page-2 .ext-locked-icon { decorator: image(ext-lock-2); }
.page-3 .ext-locked-icon { decorator: image(ext-lock-3); }
.page-4 .ext-locked-icon { decorator: image(ext-lock-4); }

/* Native item grids: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid_1 { left: 15px; top: 45px; }
#item_grid_2 { left: 15px; top: 132px; }
#item_grid_3 { left: 15px; top: 219px; }
#item_grid_4 { left: 15px; top: 306px; }
