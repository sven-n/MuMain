/* Legacy theme for CInventoryExtension's chrome (frame/title/exit button). The workspace places
   #panel (its slot's left/top/scale), so coordinates below are plain reference px, not dp. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: calc(100% * var(--root-scale));
	text-align: center;
	color: token(text-primary);
	font-weight: bold;
	font-size: 1em;
}

@spritesheet ext-btn-exit-sheet { src: "../../../newui_exit_00.tga"; ext-btn-exit: 0px 0px 36px 29px; }
.ext-btn {
	position: absolute;
	left: 13px;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(ext-btn-exit);
}
.ext-btn:hover { filter: brightness(1.25); }

/* Locked-page numbered lock glyph -- one file per number (not a packed atlas), each sheet is the
   whole 25x28 source image, at the original's 85,71 (74,29 within its page). */
@spritesheet ext-lock-1-sheet { src: "../../../newui_item_add_marking_no01.tga"; ext-lock-1: 0px 0px 25px 28px; }
@spritesheet ext-lock-2-sheet { src: "../../../newui_item_add_marking_no02.tga"; ext-lock-2: 0px 0px 25px 28px; }
@spritesheet ext-lock-3-sheet { src: "../../../newui_item_add_marking_no03.tga"; ext-lock-3: 0px 0px 25px 28px; }
@spritesheet ext-lock-4-sheet { src: "../../../newui_item_add_marking_no04.tga"; ext-lock-4: 0px 0px 25px 28px; }

/* A locked page's table and empty-slot art: the original's 173x87 and 161x81 from each image's
   top-left. */
@spritesheet ext-table-sheet { src: "../../../newui_item_add_table.tga"; ext-table: 0px 0px 173px 87px; }
@spritesheet ext-empty-sheet { src: "../../../newui_item_add_marking_non.jpg"; ext-empty: 0px 0px 161px 81px; }
.ext-locked-empty {
	position: absolute;
	left: 4px;
	top: 3px;
	width: 161px;
	height: 81px;
	pointer-events: none;
	decorator: image(ext-empty);
}

.ext-locked-page {
	position: absolute;
	left: 11px;
	width: 173px;
	height: 87px;
	pointer-events: none;
	decorator: image(ext-table);
}
.ext-locked-icon {
	position: absolute;
	left: 74px;
	top: 29px;
	width: 25px;
	height: 28px;
	pointer-events: none;
	/* decorator set per-instance via data-style-decorator (inventory_extension.rml). */
}

/* Each locked page's own row (42 + 87 per page) and its marking. The pages shown are
   sparse, so a row is identified by which page it is rather than by its place in the list. */
.ext-locked-page.page-1 { top: 42px; }
.ext-locked-page.page-2 { top: 129px; }
.ext-locked-page.page-3 { top: 216px; }
.ext-locked-page.page-4 { top: 303px; }
.page-1 .ext-locked-icon { decorator: image(ext-lock-1); }
.page-2 .ext-locked-icon { decorator: image(ext-lock-2); }
.page-3 .ext-locked-icon { decorator: image(ext-lock-3); }
.page-4 .ext-locked-icon { decorator: image(ext-lock-4); }

/* Native item grids: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid_1, #item_grid_1_counts { left: 15px; top: 45px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }
#item_grid_2, #item_grid_2_counts { left: 15px; top: 132px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }
#item_grid_3, #item_grid_3_counts { left: 15px; top: 219px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }
#item_grid_4, #item_grid_4_counts { left: 15px; top: 306px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
@spritesheet ext-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   ext-bg-fill:   0px 0px 190px 429px; }
@spritesheet ext-bg-top-sheet    { src: "../../../newui_item_back04.tga";   ext-bg-top:    0px 0px 190px 64px;  }
@spritesheet ext-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; ext-bg-left:   0px 0px 21px 320px;  }
@spritesheet ext-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; ext-bg-right:  0px 0px 21px 320px;  }
@spritesheet ext-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   ext-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;    top: 0;    width: 190px; height: 429px; decorator: image(ext-bg-fill); }
.bg-top    { left: 0;    top: 0;    width: 190px; height: 64px;  decorator: image(ext-bg-top); }
.bg-left   { left: 0;    top: 64px; width: 21px;  height: 320px; decorator: image(ext-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(ext-bg-right); }
.bg-bottom { left: 0;    top: 384px; width: 190px; height: 45px; decorator: image(ext-bg-bottom); }

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
#panel { font-size: calc(var(--text-px, 12px) / var(--root-scale)); }
