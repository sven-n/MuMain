<rml>
<head>
	<title>NPC Shop</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="npc_shop.rcss"/>
</head>
<body data-model="npc_shop">
	<!-- Window frame/title/tax-rate line/repair buttons/repair-money strip only -- inventory grid
	     stays native (NPCShop.h). Background lives in npc_shop_bg.rml instead, since it must paint
	     behind the native 3D icons. No exit button here -- this window's close affordance is the
	     generic frame-corner "X" hit-test (BtnProcess()'s HandleFrameCornerClose() call), untouched
	     by this migration. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'"
	     data-style-font-size="(text_px / root_scale) + 'px'">
		<span id="title">{{title}}</span>
		<span id="tax_rate">{{tax_rate_text}}</span>

		<div id="btn_repair" class="shop-btn shop-btn-repair" data-class-hidden="!repair_visible"
		     data-event-click="npc_shop_repair_click"></div>
		<span class="tooltip tooltip-repair">{{repair_tooltip}}</span>

		<div id="btn_repair_all" class="shop-btn shop-btn-repair-all" data-class-hidden="!repair_visible"
		     data-event-click="npc_shop_repair_all_click"></div>
		<span class="tooltip tooltip-repair-all">{{repair_all_tooltip}}</span>

		<div id="repair_money_bg" class="repair-money" data-class-hidden="!repair_visible"></div>
		<span id="repair_all_label" class="repair-money-label" data-class-hidden="!repair_visible">{{repair_all_label}}</span>
		<span id="repair_gold_text" class="repair-money-value gold-amount" data-class-hidden="!repair_visible"
		      data-class-gold-base="repair_gold_tier == 'base'"
		      data-class-gold-hundred-thousand="repair_gold_tier == 'hundred-thousand'"
		      data-class-gold-million="repair_gold_tier == 'million'"
		      data-class-gold-ten-million="repair_gold_tier == 'ten-million'">{{repair_gold_text}}</span>
	</div>
</body>
</rml>
