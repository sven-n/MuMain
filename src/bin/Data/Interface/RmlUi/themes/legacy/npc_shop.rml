<rml>
<head>
	<title>NPC Shop</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="npc_shop.rcss"/>
</head>
<body data-model="npc_shop">
	<!-- CNPCShop (NPCShop.h): the frame, the item grid, the items C++ draws live into #item_view,
	     the stack counts, title, tax-rate line, repair buttons and repair-money strip. No exit button
	     here -- this window's close affordance is the generic frame-corner "X" hit-test
	     (BtnProcess()'s HandleFrameCornerClose() call). -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'"
	     data-style-font-size="(text_px / root_scale) + 'px'">
		<!-- The frame. -->
		<div class="bg-fill"></div>
		<div class="bg-top"></div>
		<div class="bg-left"></div>
		<div class="bg-right"></div>
		<div class="bg-bottom"></div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{c.count}}</span></div>
		</div>
		<span class="sharp-text" id="title"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(panel_width * root_scale) + 'px'" data-style-margin-left="(panel_width / 2 - panel_width / 2 * root_scale) + 'px'"><span class="native-fit">{{title}}</span></span>
		<span class="sharp-text" id="tax_rate"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(panel_width * root_scale) + 'px'" data-style-margin-left="(panel_width / 2 - panel_width / 2 * root_scale) + 'px'"><span class="native-fit">{{tax_rate_text}}</span></span>

		<div id="btn_repair" class="shop-btn shop-btn-repair" data-class-hidden="!repair_visible"
		     data-event-click="npc_shop_repair_click" data-attr-data-hint="repair_tooltip"></div>

		<div id="btn_repair_all" class="shop-btn shop-btn-repair-all" data-class-hidden="!repair_visible"
		     data-event-click="npc_shop_repair_all_click" data-attr-data-hint="repair_all_tooltip"></div>

		<div id="repair_money_bg" class="repair-money" data-class-hidden="!repair_visible"></div>
		<span id="repair_all_label" class="sharp-text repair-money-label" data-class-hidden="!repair_visible"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'">{{repair_all_label}}</span>
		<span id="repair_gold_text" class="sharp-text repair-money-value gold-amount" data-class-hidden="!repair_visible" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-class-gold-base="repair_gold_tier == 'base'"
		      data-class-gold-hundred-thousand="repair_gold_tier == 'hundred-thousand'"
		      data-class-gold-million="repair_gold_tier == 'million'"
		      data-class-gold-ten-million="repair_gold_tier == 'ten-million'">{{repair_gold_text}}</span>
	</div>
</body>
</rml>
