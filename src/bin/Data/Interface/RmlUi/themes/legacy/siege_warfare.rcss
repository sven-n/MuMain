/* Legacy theme for CSiegeWarfare, reproducing the original CSiegeWarBase::Render() and its
   variants' OnRender(): from the frame's top-left (486, 234) the 128 x 128 map at (25, 28), the
   154 x 162 frame over it, the 134 x 37 time frame at (20, 158) with the big-font time centred
   10 below its top, the transparency button (38 x 23, up / over / down rows) at (58, 4) with its
   value centred in bold, and the 3 x 3 hero dot (255, 255, 0). The other characters' dots are the
   colour the original's RenderColor() inherited from the previous native draw, measured on the
   original client: (106, 97, 88). A command on the map: its team number in bold at (-12, -5)
   and its icon (the image's first (w - 1) x (h - 1) texels, as RenderColorBitmap()'s power-of-two
   UVs cut it) drawn 11 x 11 at (-7, -7). The commander's team buttons (26 x 22) and command
   buttons (30 x 22, icons at (8, 5), (8, 3) and (10, 5)); the chosen command follows the pointer
   (number at (-13, -6), icon at (-8, -8)). The battle-skill frame (128 x 53) sits at (26,
   -53): the skill's 20 x 28 cell at (26, 21), the kills at (78, 28) and (97, 28) in the big
   font, the scroll buttons (15 x 13) at (48, 21) and (48, 36). Reference px on .screen's
   HUD board (see siege_warfare.rml). */

@spritesheet sw-frame-sheet { src: "../../../newui_SW_Minimap_Frame.tga"; sw-frame: 0px 0px 154px 162px; }
@spritesheet sw-time-sheet { src: "../../../newui_SW_Time_Frame.tga"; sw-time: 0px 0px 134px 37px; }
@spritesheet sw-alpha-sheet {
	src: "../../../newui_SW_MiniMap_Bt_clearness.jpg";
	sw-alpha-up: 0px 0px 38px 23px;
	sw-alpha-over: 0px 23px 38px 23px;
	sw-alpha-down: 0px 46px 38px 23px;
}
@spritesheet sw-team-sheet {
	src: "../../../newui_SW_Minimap_Bt_group.tga";
	sw-team-up: 0px 0px 26px 22px;
	sw-team-over: 0px 22px 26px 22px;
	sw-team-down: 0px 44px 26px 22px;
}
@spritesheet sw-order-sheet {
	src: "../../../newui_SW_Minimap_Bt_Command.tga";
	sw-order-up: 0px 0px 30px 22px;
	sw-order-over: 0px 22px 30px 22px;
	sw-order-down: 0px 44px 30px 22px;
}
@spritesheet sw-attack-sheet { src: "../../../i_attack.tga"; sw-attack: 0px 0px 13px 13px; }
@spritesheet sw-defence-sheet { src: "../../../i_defense.tga"; sw-defence: 0px 0px 18px 15px; }
@spritesheet sw-wait-sheet { src: "../../../i_wait.tga"; sw-wait: 0px 0px 11px 12px; }
@spritesheet sw-skill-sheet { src: "../../../newui_SW_BattleSkill_Frame.tga"; sw-skill: 0px 0px 128px 53px; }
@spritesheet sw-scroll-up-sheet {
	src: "../../../newui_Bt_skill_scroll_up.jpg";
	sw-scroll-up-up: 0px 0px 15px 13px;
	sw-scroll-up-over: 0px 13px 15px 13px;
	sw-scroll-up-down: 0px 26px 15px 13px;
}
@spritesheet sw-scroll-down-sheet {
	src: "../../../newui_Bt_skill_scroll_dn.jpg";
	sw-scroll-down-up: 0px 0px 15px 13px;
	sw-scroll-down-over: 0px 13px 15px 13px;
	sw-scroll-down-down: 0px 26px 15px 13px;
}

body { pointer-events: none; }

.screen {
	pointer-events: none;
	font-family: "token(font-body)";
}

.text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: nowrap;
	color: #ffffff;
}
.text.bold { font-weight: bold; }
.button-label { left: 0; top: 0; text-align: center; }

/* The frame's top-left on the HUD board: right of the HUD's centre, above the bar. */
#siege_hud { position: absolute; left: 486px; top: 234px; width: 0; height: 0; }
#frame { position: absolute; left: 0; top: 0; width: 154px; height: 162px; }
#map { position: absolute; left: 25px; top: 28px; width: 128px; height: 128px; }
#frame_art { position: absolute; left: 0; top: 0; width: 154px; height: 162px; decorator: image(sw-frame); }
#time_frame { position: absolute; left: 20px; top: 158px; width: 134px; height: 37px; decorator: image(sw-time); }
#time { left: 20px; top: 168px; text-align: center; }

.dot { position: absolute; width: 3px; height: 3px; background-color: rgb(106, 97, 88); }
#hero { position: absolute; width: 3px; height: 3px; background-color: #ffff00; }

.command { position: absolute; width: 0; height: 0; }
.command-team { left: -12px; top: -5px; }
.command-icon { position: absolute; left: -7px; top: -7px; width: 11px; height: 11px; }

.cursor { position: absolute; width: 0; height: 0; }
.cursor-team { left: -13px; top: -6px; }
.cursor-icon { position: absolute; left: -8px; top: -8px; }
.cursor-icon.attack { width: 13px; height: 13px; }
.cursor-icon.defence { width: 18px; height: 15px; }
.cursor-icon.wait { width: 11px; height: 12px; }

.team { position: absolute; width: 26px; height: 22px; decorator: image(sw-team-up); }
.team:hover { decorator: image(sw-team-over); }
.team:active, .team.selected { decorator: image(sw-team-down); }

.order { position: absolute; width: 30px; height: 22px; }
.order-button { position: absolute; left: 0; top: 0; width: 30px; height: 22px; decorator: image(sw-order-up); }
.order-button:hover { decorator: image(sw-order-over); }
.order-button:active { decorator: image(sw-order-down); }
.order-icon { position: absolute; }
.order-icon.attack { left: 8px; top: 5px; width: 13px; height: 13px; decorator: image(sw-attack); }
.order-icon.defence { left: 8px; top: 3px; width: 18px; height: 15px; decorator: image(sw-defence); }
.order-icon.wait { left: 10px; top: 5px; width: 11px; height: 12px; decorator: image(sw-wait); }

#skill { position: absolute; left: 26px; top: -53px; width: 128px; height: 53px; }
#skill_frame { position: absolute; left: 0; top: 0; width: 128px; height: 53px; decorator: image(sw-skill); }
#skill_icon { position: absolute; left: 26px; top: 21px; width: 20px; height: 28px; }
.kills-needed { left: 78px; top: 28px; }
.kills-now { left: 97px; top: 28px; }
.scroll { position: absolute; left: 48px; width: 15px; height: 13px; }
.scroll-up { top: 21px; decorator: image(sw-scroll-up-up); }
.scroll-up:hover { decorator: image(sw-scroll-up-over); }
.scroll-up:active { decorator: image(sw-scroll-up-down); }
.scroll-down { top: 36px; decorator: image(sw-scroll-down-up); }
.scroll-down:hover { decorator: image(sw-scroll-down-over); }
.scroll-down:active { decorator: image(sw-scroll-down-down); }

#alpha_button { position: absolute; left: 58px; top: 4px; width: 38px; height: 23px; decorator: image(sw-alpha-up); }
#alpha_button:hover { decorator: image(sw-alpha-over); }
#alpha_button:active { decorator: image(sw-alpha-down); }

/* The battle skill's icon: reddened until the hero has the kills it needs. */
#skill_icon { image-color: #ffffff; }
#skill_icon.unaffordable { image-color: rgb(255, 127, 127); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#time { width: calc(134px * var(--root-scale)); }
.team .button-label { width: calc(26px * var(--root-scale)); line-height: calc(22px * var(--root-scale)); }
#alpha_button .button-label { width: calc(38px * var(--root-scale)); line-height: calc(23px * var(--root-scale)); }

/* The buttons take the pointer: a click on one is the HUD's, never the world's. The map's zoom
   button is the frame art's own, so it draws nothing of its own. */
.team, .order-button, .scroll, #alpha_button, #scale_button { pointer-events: auto; cursor: pointer; }
#scale_button { position: absolute; left: 134px; top: 7px; width: 13px; height: 12px; }
