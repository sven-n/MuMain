/* Shared, cross-window RCSS for the legacy theme -- generic rules reused by more than one
   migrated window (SysMenuWin/OptionWin's button/checkbox/panel-chrome art, plus layout utility
   classes). Every migrated window links this file first, then its own positional .rcss. */

@spritesheet legacy-btn-sheet
{
	src: "../../../op1_b_all.tga";
	legacy-btn-idle:   0px  0px 108px 30px;
	legacy-btn-hover:  0px 30px 108px 30px;
	legacy-btn-active: 0px 60px 108px 30px;

	/* Inner (stretch-safe) rects for a ninepatch decorator (used by server_select.rcss) so button
	   art stretches past its native 108x30 size without distorting. 8px inset is a guess at the
	   border thickness -- adjust if the stretched middle shows a seam or squashed corners. */
	legacy-btn-idle-inner:   8px  8px 92px 14px;
	legacy-btn-hover-inner:  8px 38px 92px 14px;
	legacy-btn-active-inner: 8px 68px 92px 14px;
}

@spritesheet legacy-checkbox-sheet
{
	src: "../../../op2_ch.tga";
	legacy-checkbox-unchecked: 0px  0px 16px 16px;
	legacy-checkbox-checked:   0px 16px 16px 16px;
}

/* Panel chrome for SysMenuWin/OptionWin's CWinEx backing, reproduced as three stacked elements
   rather than a tiled-vertical decorator -- REPEAT fit mode isn't supported in this build. */
@spritesheet legacy-panel-bottom-sheet
{
	src: "../../../op1_back2.tga";
	legacy-panel-bottom: 0px 0px 213px 43px;
}
@spritesheet legacy-panel-center-sheet
{
	src: "../../../op1_stone.jpg";
	legacy-panel-center: 0px 0px 128px 128px;
}

.panel-cap-top {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
}
.panel-cap-bottom {
	position: absolute;
	left: 0;
	bottom: 0;
	width: 100%;
	height: 43dp;
	decorator: image(legacy-panel-bottom);
}
/* Spans nearly the full panel (3dp inset each side), matching CWinEx's real WE_BG_CENTER; painted
   first so it shows through the caps' transparent negative space. */
.panel-middle {
	position: absolute;
	left: 3dp;
	top: 3dp;
	right: 3dp;
	bottom: 3dp;
	decorator: image(legacy-panel-center);
}

body {
	width: 100%;
	height: 100%;
	margin: 0;
	pointer-events: none;
}

/* Full-screen dim overlay for modal-style windows (SysMenuWin/OptionWin). */
#backdrop {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: token(surface-backdrop);
	pointer-events: auto;
}

.checkbox-row {
	position: absolute;
	cursor: pointer;
	pointer-events: auto;
}
.checkbox-box {
	display: inline-block;
	width: 16dp;
	height: 16dp;
	decorator: image(legacy-checkbox-unchecked);
}
.checkbox-box.checked {
	decorator: image(legacy-checkbox-checked);
}
.checkbox-label {
	position: absolute;
	left: 21dp;
	top: 1dp;
	white-space: nowrap;
}

.btn {
	position: absolute;
	width: 108dp;
	height: 30dp;
	text-align: center;
	vertical-align: middle;
	line-height: 30dp;
	cursor: pointer;
	decorator: image(legacy-btn-idle);
	pointer-events: auto;
}
.btn:hover {
	decorator: image(legacy-btn-hover);
}
.btn:active {
	decorator: image(legacy-btn-active);
}
.btn.disabled {
	pointer-events: none;
	opacity: 0.5;
	cursor: default;
}

/* Shared editable-text primitive for stock RmlUi <input type="text"/"password"> -- the same tier as
   .btn/.checkbox-* above. Owns appearance only (typography, fill, border, states); every consumer
   supplies its own position/size through a local class, since no two fields share a box. Length
   limits and value validation stay in C++ (the owning window sets maxlength and decides what a
   valid value is) -- this layer only reflects the outcome, via .error below. */
.text-field {
	box-sizing: border-box;
	cursor: text;
	pointer-events: auto;
	text-align: left;
	color: token(text-input);
	background-color: token(surface-control);
	border: 1px token(border-control);
	border-radius: token(radius-sm)px;
}
.text-field:focus {
	border-color: token(accent-gold);
}
/* Semantic state pushed from the model (data-class-error), never a colour set from C++. */
.text-field.error {
	border-color: token(semantic-danger);
	color: token(semantic-danger);
}
.text-field:disabled {
	pointer-events: none;
	color: token(text-disabled);
	background-color: token(surface-recessed);
}
/* RmlUi styles the selection range through the widget's own <selection> child element, which reads
   exactly these two properties (ElementTextSelection::OnPropertyChange). */
.text-field selection {
	color: token(surface-control);
	background-color: token(text-selected);
}

.hidden {
	display: none;
}

/* Layout primitives -- pure layout, no visual styling, identical in both themes. Apply one to
   express an element's responsive behavior; give it its own size (dp if it should respect UI
   scale). */

.anchor-top-left {
	position: absolute;
	left: 0;
	top: 0;
}
.anchor-top-right {
	position: absolute;
	right: 0;
	top: 0;
}
.anchor-bottom-left {
	position: absolute;
	left: 0;
	bottom: 0;
}
.anchor-bottom-right {
	position: absolute;
	right: 0;
	bottom: 0;
}

.center-x {
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
}
.center-y {
	position: absolute;
	top: 50%;
	transform: translateY(-50%);
}
.center-both {
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
}

.stretch-x {
	position: absolute;
	left: 0;
	right: 0;
}
.stretch-y {
	position: absolute;
	top: 0;
	bottom: 0;
}
.stretch-both {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
}

/* Invisible marker read by C++ via Element::GetAbsoluteOffset(), letting RCSS express a
   real-screen anchor for still-legacy-rendered content (main_frame.rml's
   #item_hotkey_anchor/#skill_list_anchor). visibility:hidden, not display:none, so it still gets
   a layout pass. */
.layout-anchor {
	position: absolute;
	visibility: hidden;
	width: 0;
	height: 0;
	pointer-events: none;
}

/* Zen amounts by wealth tier (GameLogic::Items::GoldAmountTier; the model binds its key, the RML
   toggles .gold-<key>). The original client's colors. */
.gold-amount.gold-base             { color: #ffdc96; }
.gold-amount.gold-hundred-thousand { color: #00c918; }
.gold-amount.gold-million          { color: #ff9600; }
.gold-amount.gold-ten-million      { color: #ff0000; }
