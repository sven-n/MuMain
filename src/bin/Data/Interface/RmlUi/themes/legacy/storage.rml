<rml>
<head>
	<title>Storage</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="storage.rcss"/>
</head>
<body data-model="storage">
	<!-- CStorageInventory (StorageInventory.h): the frame, the item grid, the items C++ draws live
	     into #item_view, the stack counts, title, money and buttons. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale"
	     data-style-font-size="(text_px / root_scale) + 'px'">
		<!-- The frame. -->
		<div class="bg-fill"></div>
		<div class="bg-top"></div>
		<div class="bg-left"></div>
		<div class="bg-right"></div>
		<div class="bg-bottom"></div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'">{{c.count}}</span></div>
		</div>
		<span class="sharp-text" id="title" data-class-locked="title_locked" data-style-font-size="text_px + 'px'">{{title}}</span>

		<div id="money_bg"></div>
		<span id="zen_text" class="sharp-text sharp-right gold-amount" data-style-font-size="text_px + 'px'"
		      data-class-gold-base="zen_tier == 'base'"
		      data-class-gold-hundred-thousand="zen_tier == 'hundred-thousand'"
		      data-class-gold-million="zen_tier == 'million'"
		      data-class-gold-ten-million="zen_tier == 'ten-million'">{{zen_text}}</span>
		<span class="sharp-text" id="fee_label" data-style-font-size="text_px + 'px'">{{fee_label}}</span>
		<span class="sharp-text sharp-right" id="fee_value" data-style-font-size="text_px + 'px'">{{fee_value}}</span>

		<div id="btn_insert" class="stor-btn stor-btn-insert" data-event-click="storage_insert_click" data-attr-data-hint="insert_tooltip"></div>

		<div id="btn_take" class="stor-btn stor-btn-take" data-event-click="storage_take_click" data-attr-data-hint="take_tooltip"></div>

		<div id="btn_lock" class="stor-btn stor-btn-lock" data-class-locked-mode="storage_locked"
		     data-event-click="storage_lock_click" data-attr-data-hint="lock_tooltip"></div>

		<div id="btn_expand" class="stor-btn stor-btn-expand" data-class-hidden="!expand_visible"
		     data-event-click="storage_expand_click" data-attr-data-hint="expand_tooltip"></div>
	</div>
</body>
</rml>
