/* Legacy theme for the login-scene credits screen (CCreditWin): full-screen background, the
   crossfading illustration pair, the static logo/deco art, the close button, and the scrolling
   credit text -- #panel now owns 100% of this window's visuals, nothing left in Render(). Positions
   are the original CCreditWin::Create()/SetPosition()/LoadIllust() literal 800x600-reference pixel
   values carried over directly as dp, same convention every other ported window already uses (dp
   responds to the same UI-scale system that used to be applied manually via fScaleX/fScaleY).
   Credit-text colors match the original g_pRenderText colors verbatim (CLRDW_BR_GRAY/
   CLRDW_BR_YELLOW, UIBaseDef.h); font-family is "NanumGothic" (RmlUiRuntime.cpp's own comment has
   the font-name verification note), not the shared Liberation-Sans-only convention every other
   ported window's legacy theme uses -- this screen's names are the one piece of RmlUi text so far
   that isn't guaranteed ASCII. */

@spritesheet creditwin-logo-sheet
{
	src: "../../../cr_mu_lo.tga";
	creditwin-logo-image: 0px 0px 290px 41px;
}
@spritesheet creditwin-deco-sheet
{
	src: "../../../deco.tga";
	creditwin-deco-image: 0px 0px 189px 103px;
}
@spritesheet creditwin-close-sheet
{
	src: "../../../message_close_b_all.tga";
	creditwin-close-idle:   0px  0px 54px 30px;
	creditwin-close-hover:  0px 30px 54px 30px;
	creditwin-close-active: 0px 60px 54px 30px;
}

/* One @spritesheet per illustration file (16 total, im1_1.jpg..im8_2.jpg, all confirmed 400x400)
   -- each is its own separate file, not slices of a shared sheet, so this is 16 single-rect blocks
   rather than one real spritesheet. Named illust-im{N}-{M} to match CCreditWin::SyncRmlModel()'s
   own generated decorator string ("image(illust-imN-M)") -- keep both in sync if this ever
   changes. */
@spritesheet illust-im1-1-sheet { src: "../../../im1_1.jpg"; illust-im1-1: 0px 0px 400px 400px; }
@spritesheet illust-im1-2-sheet { src: "../../../im1_2.jpg"; illust-im1-2: 0px 0px 400px 400px; }
@spritesheet illust-im2-1-sheet { src: "../../../im2_1.jpg"; illust-im2-1: 0px 0px 400px 400px; }
@spritesheet illust-im2-2-sheet { src: "../../../im2_2.jpg"; illust-im2-2: 0px 0px 400px 400px; }
@spritesheet illust-im3-1-sheet { src: "../../../im3_1.jpg"; illust-im3-1: 0px 0px 400px 400px; }
@spritesheet illust-im3-2-sheet { src: "../../../im3_2.jpg"; illust-im3-2: 0px 0px 400px 400px; }
@spritesheet illust-im4-1-sheet { src: "../../../im4_1.jpg"; illust-im4-1: 0px 0px 400px 400px; }
@spritesheet illust-im4-2-sheet { src: "../../../im4_2.jpg"; illust-im4-2: 0px 0px 400px 400px; }
@spritesheet illust-im5-1-sheet { src: "../../../im5_1.jpg"; illust-im5-1: 0px 0px 400px 400px; }
@spritesheet illust-im5-2-sheet { src: "../../../im5_2.jpg"; illust-im5-2: 0px 0px 400px 400px; }
@spritesheet illust-im6-1-sheet { src: "../../../im6_1.jpg"; illust-im6-1: 0px 0px 400px 400px; }
@spritesheet illust-im6-2-sheet { src: "../../../im6_2.jpg"; illust-im6-2: 0px 0px 400px 400px; }
@spritesheet illust-im7-1-sheet { src: "../../../im7_1.jpg"; illust-im7-1: 0px 0px 400px 400px; }
@spritesheet illust-im7-2-sheet { src: "../../../im7_2.jpg"; illust-im7-2: 0px 0px 400px 400px; }
@spritesheet illust-im8-1-sheet { src: "../../../im8_1.jpg"; illust-im8-1: 0px 0px 400px 400px; }
@spritesheet illust-im8-2-sheet { src: "../../../im8_2.jpg"; illust-im8-2: 0px 0px 400px 400px; }

#panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	background-color: #000000;
	pointer-events: none;
}

/* decorator is swapped by SyncRmlModel() every time m_byIllust advances (data-style-decorator,
   naming a sprite from one of the 16 @spritesheet blocks above); opacity animates continuously
   while AnimationIllust() is fading (data-style-opacity). Percentage sizing -- two 50%-wide boxes
   always sum to exactly 100% of #panel with no gap possible between them. */
.illust {
	position: absolute;
	top: 21%;
	width: 50%;
	height: 66.6667%;
	pointer-events: none;
}
.illust-left { left: 0%; }
.illust-right { left: 50%; }

.logo {
	position: absolute;
	left: 241dp;
	top: 549dp;
	width: 290dp;
	height: 41dp;
	pointer-events: none;
	decorator: image(creditwin-logo-image);
}

/* Anchored to the bottom-right corner, same relationship CCreditWin::SetPosition() derives from
   the screen-height fraction 527/600 -- see this class's own comment above. */
.deco {
	position: absolute;
	right: 0dp;
	bottom: 73dp;
	width: 189dp;
	height: 103dp;
	pointer-events: none;
	decorator: image(creditwin-deco-image);
}

/* Positioned relative to .deco's own corner (deco_pos + 122,63 in the original), expressed here as
   its own independent corner anchor -- 13dp/83dp is that same offset from the screen edge, not
   from .deco directly (RmlUi has no way to anchor to a sibling's box). */
.btn-close {
	position: absolute;
	right: 13dp;
	bottom: 83dp;
	width: 54dp;
	height: 30dp;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(creditwin-close-idle);
}
.btn-close:hover {
	decorator: image(creditwin-close-hover);
}
.btn-close:active {
	decorator: image(creditwin-close-active);
}

/* Real art already reads as a close button -- no visible text needed over it. */
.btn-close-label {
	display: none;
}

.credit-label {
	position: absolute;
	left: 0;
	width: 100%;
	text-align: center;
	font-family: "NanumGothic";
	font-size: 14dp;
	font-weight: bold;
	pointer-events: none;
}
.credit-department {
	top: 20dp;
	color: #e2e2e2;
}
.credit-team {
	top: 46dp;
	color: #e2e2e2;
}

.credit-names {
	position: absolute;
	left: 0;
	top: 72dp;
	width: 100%;
	display: flex;
	justify-content: center;
	pointer-events: none;
}
.credit-name {
	font-family: "NanumGothic";
	font-size: 14dp;
	font-weight: bold;
	color: #ffeec1;
	white-space: nowrap;
	margin-left: 20dp;
	margin-right: 20dp;
}
