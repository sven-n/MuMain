/* Centered entry HUD at the original 220/480 viewport-height anchor.
   A compact text field grows vertically for long names. The classic silver MU ornament
   is shared by every map and fits its slots without changing its aspect ratio. */
@spritesheet map-name-decoration
{
    src: "../../../MapName_Karutan.tga";
    map-name-rule: 0px 44px 166px 42px;
}

body { pointer-events: none; }
#banner { top: 45.8333%; width: 163.75dp; max-width: 90%; pointer-events: none; }
#ornament_bottom { display: block; width: 100dp; max-width: 100%; margin: 0 auto; height: 25.3012dp; decorator: image(map-name-rule contain); }
#name {
    min-height: 24dp;
    display: flex; align-items: center; justify-content: center;
    font-family: token(font-map-name); font-size: 21dp; font-weight: normal; font-style: token(font-map-name-style); line-height: 1.1;
    color: #f0ece2; font-effect: outline(1.25dp #100e0b), shadow(1.25dp 1.25dp #000000);
    text-align: center;
}
#name_text { max-width: 100%; word-break: break-word; }
#strife { position: absolute; top: -14dp; width: 83dp; height: 14dp; }
