/* Centered entry HUD at the original 220/480 viewport-height anchor.
   A compact text field grows vertically for long names. The existing quest divider
   is shared by every map and fits its slots without changing its aspect ratio. */
@spritesheet map-name-decoration
{
    src: "../../../newui_myquest_Line.tga";
    map-name-rule: 0px 0px 188px 21px;
}

body { pointer-events: none; }
#banner { top: 45.8333%; width: 163.75dp; max-width: 90%; pointer-events: none; }
#ornament_top { display: block; width: 127.5dp; max-width: 100%; margin: 0 auto; height: 23.75dp; decorator: image(map-name-rule contain); }
#ornament_bottom { display: block; width: 127.5dp; max-width: 100%; margin: 0 auto; height: 22.5dp; decorator: image(map-name-rule contain); }
#name {
    min-height: 26.25dp;
    display: flex; align-items: center; justify-content: center;
    font-family: token(font-title); font-size: 15dp; font-weight: bold; line-height: 1.1;
    color: #b8b6aa; font-effect: shadow(0.625dp 0.625dp #000000);
    text-align: center;
}
#name_text { max-width: 100%; word-break: break-word; }
#strife { position: absolute; top: -14dp; width: 83dp; height: 14dp; }
