/* Legacy theme for master_level_band.rml: the black padding of the original's background textures
   from reference y 428 (428/480 of the screen) to the bottom, full width. body's size must be set
   here: this document does not link base.rcss. */

body {
	width: 100%;
	height: 100%;
	pointer-events: none;
}

#band {
	position: absolute;
	left: 0;
	top: 89.1667%;
	right: 0;
	bottom: 0;
	background-color: #000000;
}
