/* Legacy theme for the character-creation dialog (CCharMakeWin) -- only idle/checked button
   frames are reproduced. Stat/description panels were flat CSprite fills originally, so they're
   plain background-color here too. */

@spritesheet charmake-job-sheet
{
	src: "../../../cha_bt.tga";
	charmake-job-unchecked: 0px 0px 108px 26px;
	charmake-job-checked:   0px 78px 108px 26px;
}

/* Static RCSS instead of C++-pushed for width/height and most children (except #panel's own
   left/top, and job buttons which are per-instance data). Deliberately px, not dp -- this panel's
   screen position also drives the live 3D character-preview viewport, a separate scale
   mechanism. */
#panel {
	position: absolute;
	width: 454px;
	height: 406px;
	font-family: "token(font-body)";
	font-size: 12px;
	color: token(text-primary);
}

/* The original's dimming sprite: black at half opacity over the whole scene. */
#backdrop { background-color: rgba(0, 0, 0, 128); }

/* The 3D preview's viewport, under every other child of the panel. */
#preview { position: absolute; left: 0px; top: 0px; width: 410px; height: 335px; }
#preview.awaiting-frame { visibility: hidden; }

#stat_panel  { left: 346px; top: 24px;  }
#desc_panel  { left: 0px;   top: 355px; }
#input_frame { left: 0px;   top: 325px; }
#btn_ok      { left: 346px; top: 325px; }
#btn_cancel  { left: 400px; top: 325px; }

.job-btn {
	position: absolute;
	width: 108px;
	height: 26px;
	text-align: center;
	vertical-align: middle;
	line-height: 26px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(charmake-job-unchecked);
	color: token(text-dim);
}
/* Every job button sits in one column; the tops are the original's own, in CLASS_* order:
   wizard/knight/elf/summoner run at a 26px pitch, then a gap, then rage-fighter/dark/dark-lord. */
.job-btn { left: 346px; }
.job-btn[job="wizard"]       { top: 131px; }
.job-btn[job="knight"]       { top: 157px; }
.job-btn[job="elf"]          { top: 183px; }
.job-btn[job="summoner"]     { top: 209px; }
.job-btn[job="rage-fighter"] { top: 246px; }
.job-btn[job="dark"]         { top: 272px; }
.job-btn[job="dark-lord"]    { top: 298px; }
.job-btn.checked {
	decorator: image(charmake-job-checked);
	color: token(text-primary);
}
.job-btn.disabled {
	pointer-events: none;
	color: token(text-disabled);
	cursor: default;
}

.stat-panel, .desc-panel {
	position: absolute;
}
.stat-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 108px;
	height: 80px;
	background-color: token(surface-overlay);
}
.stat-bg.tall {
	height: 96px;
}
.desc-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 454px;
	height: 51px;
	background-color: token(surface-overlay);
}

.stat-row {
	position: absolute;
	left: 22px;
}
.stat-label {
	color: token(text-primary);
}
.stat-value {
	position: absolute;
	left: 54px;
	color: #ffb400;
}

/* modern-only class-name title above the two description lines -- legacy's description panel
   never had one. */
.desc-title {
	display: none;
}
.desc-line {
	position: absolute;
	left: 10px;
	white-space: nowrap;
}
/* Exact original inline top:...px values for these two lines, moved to per-line classes so modern
   can add .desc-title above without shifting legacy's own offsets. */
.desc-line-1 { top: 12px; }
.desc-line-2 { top: 31px; }

.input-frame {
	position: absolute;
	width: 344px;
	height: 28px;
	background-color: token(surface-overlay);
	border: 1px token(border-control);
	pointer-events: none;
}

/* Preserve the name-field row while rendering its label as localizable text. */
.input-label {
	position: absolute;
	left: 12px;
	top: 332px;
	font-family: "token(font-body)";
	font-size: 12px;
	color: token(text-primary);
}

/* modern-only decorative backdrops/kickers (char_make.rml's own comment) -- real legacy sprite art
   already gives every element its own visual identity, no artificial backing panel needed. */
.side-panel, .panel-kicker {
	display: none;
}

/* Name field aligns with its translated label inside the existing identity row. */
.char-make-name-field {
	position: absolute;
	left: 78px;
	top: 332px;
	width: 200px;
	height: 20px;
	padding: 0;
	color: token(text-narrative);
	background-color: transparent;
	border-width: 0;
}

.btn {
	position: absolute;
	width: 54px;
	height: 30px;
	text-align: center;
	vertical-align: middle;
	line-height: 30px;
	cursor: pointer;
	pointer-events: auto;
	color: token(text-primary);
}

/* The stat rows' own places, so a theme can move them -- they were style attributes, which are
   inline properties no theme can override. */
.stat-row-0 { top: 10px; }
.stat-row-1 { top: 27px; }
.stat-row-2 { top: 44px; }
.stat-row-3 { top: 61px; }
.stat-row-4 { top: 78px; }
