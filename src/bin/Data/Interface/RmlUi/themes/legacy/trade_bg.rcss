/* Background layer for trade.rcss, rendered behind the still-native 3D trade-grid icons -- flat
   frame fill only, no interactive elements. Reuses the same 5-piece sprite composition
   CTrade::RenderBackImage() drew -- identical assets/geometry to storage_ext_bg.rcss/
   my_inventory_bg.rcss (same 190x429 frame, same source files), copied from there rather than
   re-approximated. */

@spritesheet trade-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   trade-bg-fill:   0px 0px 190px 429px; }
@spritesheet trade-bg-top-sheet    { src: "../../../newui_item_back01.tga";   trade-bg-top:    0px 0px 190px 64px;  }
@spritesheet trade-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; trade-bg-left:   0px 0px 21px 320px;  }
@spritesheet trade-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; trade-bg-right:  0px 0px 21px 320px;  }
@spritesheet trade-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   trade-bg-bottom: 0px 0px 190px 45px;  }

#bg_root {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	pointer-events: none;
}

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

.bg-fill   { left: 0;    top: 0;    width: 190px; height: 429px; decorator: image(trade-bg-fill); }
.bg-top    { left: 0;    top: 0;    width: 190px; height: 64px;  decorator: image(trade-bg-top); }
.bg-left   { left: 0;    top: 64px; width: 21px;  height: 320px; decorator: image(trade-bg-left); }
.bg-right  { left: 169px; top: 64px; width: 21px; height: 320px; decorator: image(trade-bg-right); }
.bg-bottom { left: 0;    top: 384px; width: 190px; height: 45px; decorator: image(trade-bg-bottom); }
