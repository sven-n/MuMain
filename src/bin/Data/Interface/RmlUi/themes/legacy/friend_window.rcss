/* Legacy theme for the friends family's windows (friend_window.rml), reproducing the original's
   CUIBaseWindow / CUIFriendWindow / list and button renders: the SetLineColor() palette of
   UIWindows.cpp for the flat parts and the win_* window art (win_titlebar, win_size, win_resize,
   win_button, win_scrollbar, win_check, win_mail) for the images, stretched to each part's box as
   RenderBitmap() did. Reference px inside #window. */

@spritesheet fw-title-sheet { src: "../../../win_titlebar.jpg"; fw-title-bar: 0px 0px 4px 15px; }
@spritesheet fw-size-sheet
{
	src: "../../../win_size.jpg";
	fw-minimize: 0px 0px 9px 9px;
	fw-maximize: 9px 0px 9px 9px;
	fw-restore: 9px 9px 9px 9px;
	fw-close: 0px 9px 9px 9px;
}
@spritesheet fw-resize-sheet { src: "../../../win_resize.tga"; fw-resize-grip: 0px 0px 9px 9px; }
@spritesheet fw-button-sheet
{
	src: "../../../win_button.tga";
	fw-button: 0px 0px 49px 16px;
	fw-button-pressed: 0px 0px 48px 15px;
}
@spritesheet fw-scroll-sheet
{
	src: "../../../win_scrollbar.jpg";
	fw-scroll-up: 0px 3px 13px 13px;
	fw-scroll-down: 0px 16px 13px 13px;
	fw-scroll-thumb-top: 0px 0px 11px 1px;
	fw-scroll-thumb: 0px 1px 11px 1px;
	fw-scroll-thumb-bottom: 0px 2px 11px 1px;
}
@spritesheet fw-check-sheet { src: "../../../win_check.tga"; fw-check-mark: 0px 0px 5px 5px; }
@spritesheet fw-mail-sheet
{
	src: "../../../win_mail.tga";
	fw-letter-unread: 0px 0px 13px 9px;
	fw-letter-read: 0px 9px 13px 10px;
}

#window { position: absolute; width: 0; height: 0; pointer-events: none; transform-origin: left top; font-family: "token(font-body)"; }
.slot { display: block; }
.part { position: absolute; }

/* SetLineColor() */
.window-back { background-color: rgba(0, 0, 0, 179); }
.frame-outer, .check-edge, .row-selected.after-check-box { background-color: rgb(146, 134, 121); }
.frame-band { background-color: rgb(37, 37, 37); }
.frame-inner, .separator, .scroll-track, .row-selected { background-color: rgb(106, 97, 88); }
.frame-corner { background-color: rgb(173, 167, 150); }
.tab-on, .list-header { background-color: rgb(53, 49, 48); }
.tab-off { background-color: rgb(26, 22, 21); }
.panel, .title-edge-right-bottom { background-color: rgb(0, 0, 0); }
.title-edge-light { background-color: rgb(153, 156, 166); }
.title-edge { background-color: rgb(136, 138, 147); }
.title-edge-back { background-color: rgb(83, 85, 93); }
.title-edge-right-top { background-color: rgb(102, 104, 112); }
.title-edge-right { background-color: rgb(0, 0, 8); }
.header-divider { background-color: rgb(185, 185, 185); }

/* RenderBitmap() */
.title-bar { decorator: image(fw-title-bar); }
.control-minimize { decorator: image(fw-minimize); }
.control-maximize { decorator: image(fw-maximize); }
.control-restore { decorator: image(fw-restore); }
.control-close { decorator: image(fw-close); }
.resize-grip { decorator: image(fw-resize-grip); }
.button { decorator: image(fw-button); }
.button.pressed { decorator: image(fw-button-pressed); }
/* A held scroll arrow: the other arrow's image turned by 180 degrees. */
.scroll-up { decorator: image(fw-scroll-up); }
.scroll-up.pressed { decorator: image(fw-scroll-down); transform: rotate(180deg); }
.scroll-down { decorator: image(fw-scroll-down); }
.scroll-down.pressed { decorator: image(fw-scroll-up); transform: rotate(180deg); }
.scroll-thumb { decorator: image(fw-scroll-thumb); }
.scroll-thumb-top { decorator: image(fw-scroll-thumb-top); }
.scroll-thumb-bottom { decorator: image(fw-scroll-thumb-bottom); }
.check-mark { decorator: image(fw-check-mark); }
.letter-unread { decorator: image(fw-letter-unread); }
.letter-read { decorator: image(fw-letter-read); }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; pointer-events: none; }
/* Native text keeps its spaces (the server column's "%2d Server" is right-aligned by one). */
.fw-text { white-space: pre; }
.fw-text.bold { font-weight: bold; }
.fw-text.centred { text-align: center; }
.fw-text.clip { overflow: hidden; }

/* CUITextInputBox: UIOPTION_PAINTBACK's black box, and the field drawn over it -- its text in the
   field's own colour (set from C++) with no box of its own; the selection box in the fields' select
   colour (150, 150, 150) under the unchanged (white) text. */
.field-back { background-color: rgb(0, 0, 0); }
.fw-field { display: none; position: absolute; padding: 0; border-width: 0; background-color: transparent;
	pointer-events: none; text-align: left; white-space: pre; font-family: "token(font-body)"; }
.fw-field.shown { display: block; }
.fw-field selection { color: rgb(255, 255, 255); background-color: rgb(150, 150, 150); }
.fw-field-multiline { white-space: pre-wrap; overflow-y: auto; }
