/* Legacy theme for CMyInventory's chrome (frame/title/gold/buttons). #panel's left/top/scale come
   live from C++ (SyncRmlModel()), so coordinates below are plain reference px, not dp. Button
   icons/positions match CMyInventory::SetButtonInfo()'s former constants.

   Known limitation: .inv-btn (always renders last, RmlUi's main context) can sit on top of
   CInventoryCtrl's native item tooltip when a bottom-row item's tooltip extends into this button
   strip. Confirmed cosmetic, not fixed here. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* Text rendered at the native text renderer's size: font-size and a 1 / root_scale transform come
   from the RML (see my_inventory.rml), so these leaves lay out in physical pixels and scale back
   around the edge their text is aligned to. */
.native-text { white-space: nowrap; pointer-events: none; }

/* Drag handle (MyInventory.cpp Create()) -- pointer-events/drag are force-set in C++ via
   UI::RmlBridge::MakeDraggable(); cursor here is just discoverability. The box keeps the native
   190x15 title area; only its text is counter-scaled. */
#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	height: 15px;
	cursor: move;
}
.title-text {
	display: block;
	width: 190px;
	text-align: center;
	transform-origin: center top;
	color: token(text-primary);
	font-weight: bold;
}

@spritesheet inv-money-sheet { src: "../../../newui_item_money.tga"; inv-money: 0px 0px 170px 26px; }
#gold_bg {
	position: absolute;
	left: 11px;
	top: 364px;
	width: 170px;
	height: 26px;
	decorator: image(inv-money);
	pointer-events: none;
}
#gold_text {
	position: absolute;
	left: 50px;
	top: 371px;
	transform-origin: left top;
	font-weight: bold;
}

/* Buttons: same 36x29 reference-pixel boxes SetButtonInfo() used to place them at. */
@spritesheet inv-btn-exit-sheet    { src: "../../../newui_exit_00.tga";        inv-btn-exit:    0px 0px 36px 29px; }
@spritesheet inv-btn-repair-sheet  { src: "../../../newui_repair_00.tga";      inv-btn-repair:  0px 0px 36px 29px; }
@spritesheet inv-btn-expand-sheet  { src: "../../../newui_expansion_btn.tga";  inv-btn-expand:  0px 0px 36px 29px; }
@spritesheet inv-btn-myshop-open-sheet  { src: "../../../newui_Bt_openshop.tga";  inv-btn-myshop-open:  0px 0px 36px 29px; }
@spritesheet inv-btn-myshop-close-sheet { src: "../../../newui_Bt_closeshop.tga"; inv-btn-myshop-close: 0px 0px 36px 29px; }

.inv-btn {
	position: absolute;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.inv-btn:hover { filter: brightness(1.25); }
.inv-btn.hidden { display: none; }
.inv-btn.locked { pointer-events: none; filter: brightness(0.6); }

.inv-btn-exit    { left: 13px;      decorator: image(inv-btn-exit); }
.inv-btn-repair  { left: 50px;      decorator: image(inv-btn-repair); }
.inv-btn-myshop  { left: 87px;      decorator: image(inv-btn-myshop-open); }
.inv-btn-myshop.close-mode { decorator: image(inv-btn-myshop-close); }
.inv-btn-expand  { left: 124px;     decorator: image(inv-btn-expand); }

/* Tooltips are siblings of their trigger -- this build's shrink-to-fit width can't grow past a
   narrow nested trigger. */
.tooltip {
	display: none;
	position: absolute;
	top: 375px;
	width: 120px;
	white-space: nowrap;
	background-color: token(surface-tooltip);
	color: token(text-primary);
	padding: 2px 4px;
	border-radius: token(radius-sm)px;
	font-family: "token(font-body)";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit   { left: -30px; }
.tooltip-repair { left: 7px; }
.tooltip-myshop { left: 44px; }
.tooltip-expand { left: 60px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_repair:hover ~ .tooltip-repair,
#btn_myshop:hover ~ .tooltip-myshop,
#btn_expand:hover ~ .tooltip-expand {
	display: block;
}

/* Set/Socket option header labels -- one centred line at the native y + 25, gray by default,
   yellow when that set/socket bonus is active (RenderSetOption()/RenderSocketOption()'s colors). */
.option-labels {
	position: absolute;
	left: 0;
	top: 25px;
	width: 190px;
	text-align: center;
	transform-origin: center top;
	font-weight: bold;
}
.option-label { color: #646464; }
.option-label.active { color: #ffcc19; }
.option-label + .option-label { margin-left: 0.3em; }

/* Hover areas -- each spans half of #panel's width, the former native CheckMouseIn() split. */
.option-hover {
	position: absolute;
	top: 20px;
	width: 95px;
	height: 15px;
	pointer-events: auto;
	cursor: default;
}
.option-hover-set { left: 0; }
.option-hover-socket { left: 95px; }
