/* Where doppelganger_enter.rml's own lines and buttons sit. CDoppelGangerWindow's RenderTexts(): the name bold in its 160-unit box, the description centred on 190 from y 50, the buttons 53 x 23 at x 68.
   The look they share is event_item_entry.rcss; only the rows are this document's. */

.entry-text:nth-child(1) { left: 15px; top: 13px; color: #dcdcdc; font-weight: bold; }
.entry-text:nth-child(2) { left: 0px; top: 50px; color: #dcdcdc; }
.entry-text:nth-child(3) { left: 0px; top: 65px; color: #dcdcdc; }
.entry-text:nth-child(4) { left: 0px; top: 80px; color: #dcdcdc; }
.entry-text:nth-child(5) { left: 0px; top: 95px; color: #dcdcdc; }
.entry-text:nth-child(6) { left: 0px; top: 110px; color: #dcdcdc; }
.entry-text:nth-child(7) { left: 0px; top: 170px; color: #dcdcdc; font-weight: bold; }
.entry-text:nth-child(8) { left: 0px; top: 260px; color: #dcdcdc; }
.entry-text:nth-child(9) { left: 0px; top: 280px; color: #dcdcdc; }

.entry-btn:nth-child(1) { left: 68px; top: 190px; width: 53px; height: 23px; }
.entry-btn:nth-child(1) { decorator: image(item-entry-btn-up); }
.entry-btn:nth-child(1):hover { decorator: image(item-entry-btn-over); }
.entry-btn:nth-child(1):active { decorator: image(item-entry-btn-down); }
.entry-btn:nth-child(1).locked, .entry-btn:nth-child(1).locked:hover, .entry-btn:nth-child(1).locked:active { decorator: image(item-entry-btn-up); image-color: #646464; }

.entry-btn:nth-child(2) { left: 68px; top: 360px; width: 53px; height: 23px; }
.entry-btn:nth-child(2) { decorator: image(item-entry-btn-up); }
.entry-btn:nth-child(2):hover { decorator: image(item-entry-btn-over); }
.entry-btn:nth-child(2):active { decorator: image(item-entry-btn-down); }
.entry-btn:nth-child(2).locked, .entry-btn:nth-child(2).locked:hover, .entry-btn:nth-child(2).locked:active { decorator: image(item-entry-btn-up); image-color: #646464; }

/* The name's box is 160 wide. */
.entry-text:nth-child(1) { width: 160px; }

/* Where C++ draws the live 3D preview: the original's place and size. */
.entry-item-box { position: absolute; left: 85px; top: 125px; width: 20px; height: 27px; pointer-events: none; }
