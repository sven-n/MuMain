<rml>
<head>
	<title>Lucky Item</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="lucky_item.rcss"/>
</head>
<body data-model="lucky_item">
	<!-- Window frame/title/mix-button only -- inventory grid and the large dynamic result/
	     description text block stay native (LuckyItemWnd.h/.cpp's m_sText[]/AddText()/
	     SetFrame_Text(), fully out of scope). Background lives in lucky_item_bg.rml instead, since
	     it must paint behind the native 3D icons. Unlike every other window in this "inventory
	     family", #panel's width/height are genuinely runtime-variable (root_width/root_height),
	     not a fixed CSS value -- m_fSizeX/m_fSizeY are real runtime floats (LuckyItemWnd.h). -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-width="root_width + 'px'" data-style-height="root_height + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<span id="title">{{title}}</span>

		<div id="btn_mix" class="mix-btn" data-class-hidden="!mix_visible" data-event-click="lucky_item_mix_click"></div>
		<span class="tooltip tooltip-mix">{{mix_tooltip}}</span>
	</div>
</body>
</rml>
