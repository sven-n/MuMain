<rml>
<head>
	<title>Help</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="help_window.rcss"/>
</head>
<!-- Legacy override: laid out like the original's RenderTipTextList() -- the text box, padding,
     frame, row heights and gaps and the two text sizes are the native renderer's under the Dialog
     layout, computed in C++ (CHelpWindow::RebuildPageModel()) in physical px. -->
<body data-model="help_window">
	<div id="help_panel"
	     data-style-left="panel_x + 'px'" data-style-top="panel_y + 'px'"
	     data-style-width="content_width + 'px'" data-style-border-width="border_px + 'px'"
	     data-style-padding-left="padding_px + 'px'" data-style-padding-right="padding_px + 'px'">
		<div class="help-line" data-for="line : lines"
		     data-class-heading="line.heading" data-class-half-spacer="line.half_spacer"
		     data-style-font-size="(line.heading ? bold_text_px : text_px) + 'px'"
		     data-style-height="line.height_px + 'px'" data-style-line-height="line.height_px + 'px'"
		     data-style-margin-bottom="line.gap_px + 'px'"
		>{{line.text}}</div>
	</div>
</body>
</rml>
