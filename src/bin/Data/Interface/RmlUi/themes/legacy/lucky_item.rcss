/* Legacy theme for CLuckyItemWnd's chrome (frame/title/mix button). C++ supplies position
   and scale; the theme owns width and height. Coordinates below are reference px, not dp. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* left:0/right:0 (not a fixed width) so the title stays centered across #panel's runtime width.
   top:11px matches storage_ext.rcss's own subject-text offset -- both windows' native RenderText
   call used the same `m_Pos.y + 18` baseline offset. */
#title {
	position: absolute;
	left: 0;
	right: 0;
	top: 11px;
	text-align: center;
	color: token(text-primary);
	font-weight: bold;
	font-size: 1em;
}

/* Centered via left:50%/negative margin-left (half of the button's own 44px width) rather than
   width-dependent centering math, so it stays centered regardless of #panel's runtime width --
   same technique base.rcss's .modern-joint-px uses. top:380px matches the native
   `m_ptPos.y + 380` offset exactly (LuckyItemWnd.cpp's old ChangeButtonInfo() call), a fixed
   distance from the panel's TOP, not scaled with height. */
@spritesheet lucky-mix-btn-sheet { src: "../../../newui_bt_mix.tga"; lucky-mix-btn: 0px 0px 44px 35px; }
.mix-btn {
	position: absolute;
	left: 50%;
	margin-left: -22px;
	top: 380px;
	width: 44px;
	height: 35px;
	cursor: pointer;
	pointer-events: auto;
	decorator: image(lucky-mix-btn);
}
.mix-btn:hover { filter: brightness(1.25); }
.mix-btn.hidden { display: none; }


/* Former Render_Frame()'s m_sText[]/AddText() text loop. left:10/right:10 (rather than a fixed
   width) follows #panel's theme width minus 20px. top:208px matches the native `m_ptPos.y + 18 + 190` baseline. Each line
   is a fixed 11px-tall block (matching the native loop's `11.0f * i` per-slot spacing) so blank
   spacer entries (empty text) still preserve the original's vertical rhythm. */
#text_lines {
	position: absolute;
	left: 10px;
	right: 10px;
	top: 208px;
}
/* #text_lines is a text layer (lucky_item.rml): 11px rows via its bound line height. */
.lucky-line {
	display: block;
	line-height: inherit;
	overflow: hidden;
	white-space: nowrap;
	color: token(text-primary);
	font-size: 1em;
	text-align: center;
}

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 15px; top: 110px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
@spritesheet lucky-bg-fill-sheet   { src: "../../../newui_msgbox_back.jpg";   lucky-bg-fill:   0px 0px 190px 429px; }
@spritesheet lucky-bg-top-sheet    { src: "../../../newui_item_back04.tga";   lucky-bg-top:    0px 0px 190px 64px;  }
@spritesheet lucky-bg-left-sheet   { src: "../../../newui_item_back02-L.tga"; lucky-bg-left:   0px 0px 21px 320px;  }
@spritesheet lucky-bg-right-sheet  { src: "../../../newui_item_back02-R.tga"; lucky-bg-right:  0px 0px 21px 320px;  }
@spritesheet lucky-bg-bottom-sheet { src: "../../../newui_item_back03.tga";   lucky-bg-bottom: 0px 0px 190px 45px;  }

.bg-fill, .bg-top, .bg-left, .bg-right, .bg-bottom {
	position: absolute;
	pointer-events: none;
}

/* All five pieces stretch to fill their own box regardless of the spritesheet rect above (RmlUi's
   `image` decorator always fills the element's box) -- the same stretch behavior the native
   RenderImage() calls always had, just driven by CSS now instead of C++ math. left/right have no
   explicit height: with both `top` and `bottom` set, they stretch to whatever's left between the
   fixed-height top/bottom pieces, tracking #panel's own runtime height. top/bottom have no
   explicit width for the same reason (`left`+`right` stretch), tracking runtime width. */
.bg-fill   { left: 0; top: 0; right: 0; bottom: 0; decorator: image(lucky-bg-fill); }
.bg-top    { left: 0; top: 0; right: 0; height: 64px; decorator: image(lucky-bg-top); }
.bg-left   { left: 0; top: 64px; bottom: 45px; width: 21px; decorator: image(lucky-bg-left); }
.bg-right  { right: 0; top: 64px; bottom: 45px; width: 21px; decorator: image(lucky-bg-right); }
.bg-bottom { left: 0; bottom: 0; right: 0; height: 45px; decorator: image(lucky-bg-bottom); }
