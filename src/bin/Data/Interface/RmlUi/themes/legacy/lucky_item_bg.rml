<rml>
<head>
	<title>Lucky Item Background</title>
	<link type="text/rcss" href="lucky_item_bg.rcss"/>
</head>
<body data-model="lucky_item_bg">
	<!-- Background-context document -- sits behind the grid's live 3D icons (native
	     C3DRenderMng interleave). Never interactive. Width/height are runtime-variable
	     (root_width/root_height), unlike every other window in this family -- see lucky_item.rml. -->
	<div id="bg_root" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-width="root_width + 'px'" data-style-height="root_height + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="bg-fill"></div>
		<div class="bg-top"></div>
		<div class="bg-left"></div>
		<div class="bg-right"></div>
		<div class="bg-bottom"></div>
	</div>
</body>
</rml>
