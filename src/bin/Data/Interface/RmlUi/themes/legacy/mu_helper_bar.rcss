/* RmlUi overlay for the "Official MU Helper" mini control bar + hero position readout
   (CMuHelperBar, MuHelperBar.h/.cpp -- renamed 2026-08-31 from CNewUIHeroPositionInfo; see that
   file's own header comment for why, and for why this is ported as one component rather than
   split into a separate position-readout piece). First pilot of the CNewUIObj-tier RmlUi adapter
   pattern (2026-08-31).

   Same @spritesheet-with-explicit-rect technique every prior legacy theme file uses (this
   engine's .OZT/.OZJ loader pads textures to the next power-of-two size). Source art per
   MuHelperBar.cpp's LoadImages() (unchanged by the rename): Minimap_positionA.tga (left cap, 22x25),
   Minimap_positionB.tga (stretchy middle segment -- the real content sub-rect within its padded
   texture is a best-effort approximation, not measured against the actual file; verify visually
   and adjust the named-sprite rect below if it looks wrong), Minimap_positionC.tga (right end
   cap, 73x20, under MacroUI/), MacroUI_Setup.tga/MacroUI_Start.tga/MacroUI_Stop.tga (18x13
   single-frame button icons, under MacroUI/ -- SetButtonInfo()'s ChangeButtonImgState(1, ...)
   first argument is a 1-frame count, so no hover/press art variant exists to reproduce).

   Fixed dp layout, anchored top-left via base.rcss's .anchor-top-left (see mu_helper_bar.rml's
   own comment) -- 207dp total width (22 + 112 + 73, the native reference dimensions) x 25dp
   tall, using the "WindowWidth > 800" WidenX case from the original (112) as the single fixed
   dp value; this widget no longer auto-widens by resolution, same fixed-size-anchored policy
   change already applied to every other retrofitted/new window this session
   (docs/rmlui-ui-system/layout-and-scaling.md). */

@spritesheet muhelper-seg-a-sheet
{
	src: "../../../Minimap_positionA.tga";
	muhelper-seg-a-image: 0px 0px 22px 25px;
}
@spritesheet muhelper-seg-b-sheet
{
	src: "../../../Minimap_positionB.tga";
	/* Approximated sub-rect (see file header comment) -- source is 32x32 padded, original UV
	   params (0.1, 0, 22.4/32, 25/32) converted to pixels: (3,0)-(22,25). */
	muhelper-seg-b-image: 3px 0px 19px 25px;
}
@spritesheet muhelper-seg-c-sheet
{
	src: "../../../MacroUI/Minimap_positionC.tga";
	muhelper-seg-c-image: 0px 0px 73px 20px;
}
@spritesheet muhelper-config-sheet
{
	src: "../../../MacroUI/MacroUI_Setup.tga";
	muhelper-config-image: 0px 0px 18px 13px;
}
@spritesheet muhelper-start-sheet
{
	src: "../../../MacroUI/MacroUI_Start.tga";
	muhelper-start-image: 0px 0px 18px 13px;
}
@spritesheet muhelper-stop-sheet
{
	src: "../../../MacroUI/MacroUI_Stop.tga";
	muhelper-stop-image: 0px 0px 18px 13px;
}

#panel {
	position: absolute;
	width: 207dp;
	height: 25dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
}

#seg_a {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 22dp;
	height: 25dp;
	decorator: image(muhelper-seg-a-image);
	pointer-events: none;
}
#seg_b {
	position: absolute;
	left: 22dp;
	top: 0dp;
	width: 112dp;
	height: 25dp;
	decorator: image(muhelper-seg-b-image);
	pointer-events: none;
}
#seg_c {
	position: absolute;
	left: 134dp;
	top: 0dp;
	width: 73dp;
	height: 20dp;
	decorator: image(muhelper-seg-c-image);
	pointer-events: none;
}

#text {
	position: absolute;
	left: 10dp;
	top: 5dp;
	width: 132dp;
	height: 9dp;
	text-align: center;
	color: #ffffff;
	white-space: nowrap;
	pointer-events: none;
}

.mu-btn {
	position: absolute;
	top: 0dp;
	width: 18dp;
	height: 13dp;
	cursor: pointer;
	pointer-events: auto;
}
#btn_config {
	left: 153dp;
	decorator: image(muhelper-config-image);
}
#btn_start {
	left: 171dp;
	decorator: image(muhelper-start-image);
}
#btn_stop {
	left: 171dp;
	decorator: image(muhelper-stop-image);
}

/* Real icon art already gives these buttons a visual identity -- see themes/modern's own .dot
   rule for why it exists there instead. */
.dot {
	display: none;
}

/* Small floating label below the button -- not a reproduction of the original's own
   CNewUIButton::MoveTextTipPos()-based tooltip geometry (tuned for a different rendering system),
   just a straightforward hover tooltip using the pattern every other migrated interactive
   element's spec expects: display:none by default, shown via :hover. Below rather than above
   the button (top:, not bottom:) because this whole widget is pinned to the very top of the
   screen -- a tooltip positioned above the button would render off the top edge of the viewport,
   entirely out of view. font-family/font-size declared directly here rather than relying on
   inheritance from #panel -- see docs/rmlui-ui-system/layout-and-scaling.md's "Known RmlUi
   quirk" section (text nested in a <span> two-plus levels from the font-declaring ancestor can
   silently fail to inherit it). */
.tooltip {
	display: none;
	position: absolute;
	top: 16dp;
	left: 50%;
	transform: translateX(-50%);
	white-space: nowrap;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 2dp 4dp;
	border-radius: 3dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
	pointer-events: none;
}
.mu-btn:hover .tooltip {
	display: block;
}
