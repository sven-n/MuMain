/* Legacy theme for CMasterLevel -- the master skill tree, reproducing the original's Render():
   the two background textures, per node the box, the lit or grey icon, the arrow and the level,
   the close button and the header text. Every coordinate is the original's, in reference px
   (#panel carries the HUD board's scale, see master_level.rml). Sprite rectangles are texels
   of the power-of-two textures the engine loads (a 50x38 box inside a 64x64 texture): each covers
   exactly the UV rectangle the original drew. Icons come from master_skill_icons.rcss. */

@spritesheet master-back-left-sheet { src: "../../../new_Master_back01.jpg"; master-back-left: 0px 0px 512px 428px; }
@spritesheet master-back-right-sheet { src: "../../../new_Master_back02.jpg"; master-back-right: 0px 0px 128px 428px; }
@spritesheet master-box-sheet { src: "../../../new_Master_box.tga"; master-box: 0px 0px 50px 38px; }
@spritesheet master-exit-sheet
{
	src: "../../../new_Master_exit.jpg";
	master-exit-up: 0px 0px 13px 14px;
	master-exit-down: 0px 14px 13px 14px;
}
@spritesheet master-arrow-1-sheet { src: "../../../new_Master_arrow01.tga"; master-arrow-1: 0px 0px 28px 7px; }
@spritesheet master-arrow-2-sheet { src: "../../../new_Master_arrow02.tga"; master-arrow-2: 0px 0px 28px 7px; }
@spritesheet master-arrow-3-sheet { src: "../../../new_Master_arrow03.tga"; master-arrow-3: 0px 0px 7px 12px; }
/* The original draws only the top 48 texels of this 7x52 arrow (UV 12/16 of its 8x64 texture),
   stretched over 52 units. */
@spritesheet master-arrow-4-sheet { src: "../../../new_Master_arrow04.tga"; master-arrow-4: 0px 0px 7px 48px; }
@spritesheet master-arrow-5-sheet { src: "../../../new_Master_arrow05.tga"; master-arrow-5: 0px 0px 42px 31px; }
@spritesheet master-arrow-6-sheet { src: "../../../new_Master_arrow06.tga"; master-arrow-6: 0px 0px 42px 31px; }
@spritesheet master-arrow-7-sheet { src: "../../../new_Master_arrow07.tga"; master-arrow-7: 0px 0px 40px 28px; }
@spritesheet master-arrow-8-sheet { src: "../../../new_Master_arrow08.tga"; master-arrow-8: 0px 0px 40px 28px; }

/* The whole 640x428 tree claims the cursor, as the original's UpdateMouseEvent() did. */
#panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 428px;
	transform-origin: left top;
	font-family: "token(font-body)";
	pointer-events: auto;
}

#back_left, #back_right { position: absolute; top: 0; height: 428px; }
#back_left { left: 0; width: 512px; decorator: image(master-back-left); }
#back_right { left: 512px; width: 128px; decorator: image(master-back-right); }

.node { position: absolute; width: 50px; height: 38px; }
.node-box { position: absolute; left: 0; top: 0; width: 50px; height: 38px; decorator: image(master-box); }
.node-icon { position: absolute; left: 8px; top: 5px; width: 20px; height: 28px; }

/* Arrow offsets from the node box, as RenderIcon() placed each direction. */
.node-arrow { position: absolute; pointer-events: none; }
.arrow-1 { left: 30px; top: 14px; width: 28px; height: 7px; decorator: image(master-arrow-1); }
.arrow-2 { left: 30px; top: 14px; width: 28px; height: 7px; decorator: image(master-arrow-2); }
.arrow-3 { left: 14.5px; top: 35px; width: 7px; height: 12px; decorator: image(master-arrow-3); }
.arrow-4 { left: 14.5px; top: 35px; width: 7px; height: 52px; decorator: image(master-arrow-4); }
.arrow-5 { left: 0; top: 0; width: 42px; height: 31px; decorator: image(master-arrow-5); }
.arrow-6 { left: 0; top: 0; width: 42px; height: 31px; decorator: image(master-arrow-6); }
.arrow-7 { left: 16.5px; top: 36px; width: 40px; height: 28px; decorator: image(master-arrow-7); }
.arrow-8 { left: 0; top: 0; width: 40px; height: 28px; decorator: image(master-arrow-8); }

/* Text leaves: native left-aligned RenderText() at a reference point, on the black box the
   original's SetBgColor(0, 0, 0, 1) leaves behind every text of this window (the level texts
   inherit it from the previous frame). Spaces are kept: the EXP value is %6.2f, space-padded. */
.text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: pre;
	background-color: #000000;
	pointer-events: none;
}

/* The level, RenderText(CalcX + 38, CalcY + 23): white on a node that can be raised, else
   RGBA(120, 120, 120). */
.node-level { left: 38px; top: 23px; color: #ffffff; }
.node.locked .node-level { color: #787878; }

/* The close button, native CButton at (611, 9) 13x14: the pressed frame is the texture's lower
   half. */
#close {
	position: absolute;
	left: 611px;
	top: 9px;
	width: 13px;
	height: 14px;
	decorator: image(master-exit-up);
	cursor: pointer;
}
#close:active { decorator: image(master-exit-down); }

/* Header line: SetTextColor(255, 255, 255). */
.head-text { top: 11px; color: #ffffff; }
#class_name { left: 154px; }
#master_level { left: 275px; }
#level_point { left: 372px; }
#experience { left: 466px; }
#experience_area { position: absolute; left: 458px; top: 11px; width: 81px; height: 10px; }

/* Column totals: SetTextColor(255, 155, 0). Native asked for RT3_SORT_CENTER without a box, which
   the text renderer draws left-aligned at the point. */
.column-text { top: 40px; color: #ff9b00; }
#column_0 { left: 92px; }
#column_1 { left: 302px; }
#column_2 { left: 513px; }

/* The tree's own grid, which the original computed per node: a group's column, 49 units a slot
   across it, and 55 plus 41 units a rank down. A rank past the screen was off the tree natively
   too, so the table stops where the 480-unit screen does. */
.node.column-0 { left: 11px; }
.node.column-1 { left: 221px; }
.node.column-2 { left: 431px; }
.node.slot-0 { margin-left: 0; }
.node.slot-1 { margin-left: 49px; }
.node.slot-2 { margin-left: 98px; }
.node.slot-3 { margin-left: 147px; }
.node.rank-1 { top: 55px; }
.node.rank-2 { top: 96px; }
.node.rank-3 { top: 137px; }
.node.rank-4 { top: 178px; }
.node.rank-5 { top: 219px; }
.node.rank-6 { top: 260px; }
.node.rank-7 { top: 301px; }
.node.rank-8 { top: 342px; }
.node.rank-9 { top: 383px; }
.node.rank-10 { top: 424px; }
