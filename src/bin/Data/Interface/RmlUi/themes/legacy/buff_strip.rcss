/* Position (centering + top offset) comes from base.rcss's .center-x class, applied in
   buff_strip.rml -- #panel itself must NOT set left/position here, or it would override
   .center-x's own left:50%/transform (ID beats class specificity). width:200dp matches the grid's
   own full-row content width (BUFF_MAX_LINE_COUNT * (BUFF_IMG_WIDTH + BUFF_IMG_SPACE)) so the
   centering is exact, not centering an arbitrary/auto-sized box. */
#panel {
	top: 15dp;
	width: 200dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
	pointer-events: none;
}

.buff-slot {
	position: absolute;
	width: 20dp;
	height: 28dp;
}

.buff-icon-art {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 20dp;
	height: 28dp;
	pointer-events: auto;
	/* decorator itself is set per-instance via data-style-decorator (buff_strip.rml), one of the
	   atlas1-N/atlas2-N sprites declared above -- nothing static to put here. */
}

/* Below the icon, not above -- unlike mu_helper_bar's tooltip (pinned to the screen's top edge,
   so "above" would go off-screen), this strip has room below it. white-space:pre-line renders the
   \n-joined lines from BuildTooltipText() (BuffStrip.cpp) as real line breaks -- see that
   function's own comment for why this is one plain-colored block instead of the original's
   bold-header/white-body/purple-duration per-line coloring. */
.tooltip {
	display: none;
	position: absolute;
	top: 32dp;
	left: 0dp;
	/* Explicit width, not auto/shrink-to-fit -- confirmed by direct in-game testing that this
	   RmlUi build's shrink-to-fit width computation for an absolutely-positioned, display:block,
	   multi-line (white-space:pre-line) box with no declared width badly undersizes: the
	   background/padding box ended up sized to only the single longest WORD, not the longest
	   LINE, so every line wrapped down to one word each even though the background is a normal
	   block box (which does otherwise correctly cover its own full computed height/width -- this
	   is purely a width-computation bug, not a "background doesn't follow multi-line inline
	   content" issue, since .tooltip is already display:block, not the default span inline). A
	   fixed width sidesteps that computation entirely. */
	width: 160dp;
	white-space: pre-line;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 3dp 5dp;
	border-radius: 3dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
	pointer-events: none;
}
.buff-slot:hover .tooltip {
	display: block;
}
