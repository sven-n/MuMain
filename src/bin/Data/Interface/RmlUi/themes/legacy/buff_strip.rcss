/* Position (centering + top offset) comes from base.rcss's .center-x, applied in buff_strip.rml.
   width matches the strip's own full-row content width so the centering is exact. */
#panel {
	top: 15dp;
	width: 200dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
	pointer-events: none;
}

.buff-slot {
	position: absolute;
	width: 20dp;
	height: 28dp;
}

.buff-icon-art {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 20dp;
	height: 28dp;
	pointer-events: auto;
	/* decorator set per-instance via data-style-decorator (buff_strip.rml). */
}

/* Below the icon (this strip has room below it, unlike a top-of-screen widget). width is explicit
   -- this build's shrink-to-fit undersizes a multi-line pre-line box to its longest word. */
.tooltip {
	display: none;
	position: absolute;
	top: 32dp;
	left: 0dp;
	width: 160dp;
	white-space: pre-line;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 3dp 5dp;
	border-radius: 3dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
	pointer-events: none;
}
.buff-slot:hover .tooltip {
	display: block;
}
