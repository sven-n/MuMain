/* Modern theme for CMyInventory's chrome -- frame/header/wallet/action-row are vector forged-metal
   chrome (matching Login/SysMenu's forged-dialog language). Equipment board and bag grid stay
   fully native (sprite art + live 3D icons), same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* Header uses base.rcss's .modern-header-rail-px/.modern-joint-px/.modern-header-text-px/
   .modern-header-title-px family -- the px companions of SysMenu's own
   dp-based classes (see base.rcss's comment on that class family for why a root_scale-driven
   #panel like this one needs the px variants, not the dp originals).

   top:7 matches SysMenu's own rail top exactly (so .modern-joint-px's rivet sits at the same -1px
   relative to the frame's shell-edge at -3px -- 2px contained clearance,
   identical relationship to SysMenu's). Only height is trimmed, 36 vs SysMenu's 38, because the
   native paperdoll grid starts at `m_Pos.y + 44` (MyInventory.cpp) -- ends at 43px, 1px clear. */
.inv-header-rail {
	top: 7px;
	height: 36px;
}

/* Drag handle -- pointer-events/drag are force-set in C++ by UI::RmlBridge::MakeDraggable();
   cursor here is purely cosmetic. Color/font come from .modern-header-title-px (shared with
   SysMenu's dp version). */
#title {
	cursor: move;
}

/* Wallet bar and action buttons use base.rcss's shared .modern-wallet-px/.modern-icon-btn-px
   family (generalized from this window's own original recipe -- see that file's comment) at their
   default geometry, which already matches this window exactly. Only per-instance specifics stay
   here: each button's own left offset, the exit button's warm-red accent, myshop's close-mode
   accent, and the hover-hint tooltip positions. */
.inv-btn-exit   { left: 15px;  color: #d59b79; border-color: #5c382b; }
.inv-btn-repair { left: 56px;  }
.inv-btn-myshop { left: 97px;  }
.inv-btn-myshop.close-mode { color: token(accent-gold-hover); border-color: token(border-hover); }
.inv-btn-expand { left: 138px; }

.tooltip {
	display: none;
	position: absolute;
	top: 376px;
	width: 120px;
	white-space: nowrap;
	background-color: token(surface-tooltip);
	border: 1px token(border-frame);
	color: token(text-primary);
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "token(font-body)";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit   { left: -27px; }
.tooltip-repair { left: 15px; }
.tooltip-myshop { left: 55px; }
.tooltip-expand { left: 96px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_repair:hover ~ .tooltip-repair,
#btn_myshop:hover ~ .tooltip-myshop,
#btn_expand:hover ~ .tooltip-expand {
	display: block;
}

/* Set/Socket option header labels -- gray/yellow match legacy since they're semantic
   (active vs. inactive), not part of modern's chrome palette. */
.option-label {
	position: absolute;
	top: 32px;
	width: 95px;
	height: 12px;
	text-align: center;
	font-family: "token(font-body)";
	font-weight: normal;
	font-size: 10px;
	color: #666666;
	pointer-events: auto;
	cursor: default;
}
.option-label.active { color: #ffcc1a; }
.option-label-set { left: 0; }
.option-label-socket { left: 95px; }


/* Native equipment slots, item grid and item-option tooltip: where CMyInventory places them, in
   #panel's units. A slot's box is its hit and drop area; the grid's top-left is its first cell;
   the tooltip anchor is the tooltip's top centre. */
.native-anchor { position: absolute; pointer-events: none; }
#slot_helper { left: 15px; top: 44px; width: 46px; height: 46px; }
#slot_helm { left: 75px; top: 44px; width: 46px; height: 46px; }
#slot_wing { left: 120px; top: 44px; width: 61px; height: 46px; }
#slot_weapon_left { left: 135px; top: 87px; width: 46px; height: 66px; }
#slot_armor { left: 75px; top: 87px; width: 46px; height: 66px; }
#slot_weapon_right { left: 15px; top: 87px; width: 46px; height: 66px; }
#slot_gloves { left: 15px; top: 150px; width: 46px; height: 46px; }
#slot_pants { left: 75px; top: 150px; width: 46px; height: 46px; }
#slot_boots { left: 135px; top: 150px; width: 46px; height: 46px; }
#slot_ring_left { left: 114px; top: 150px; width: 28px; height: 28px; }
#slot_amulet { left: 54px; top: 87px; width: 28px; height: 28px; }
#slot_ring_right { left: 54px; top: 150px; width: 28px; height: 28px; }
/* The slots: recessed boxes. */
.equip-slot { box-sizing: border-box; border: 1px token(border-inner); background-color: rgba(0, 0, 0, 90); }

/* A slot's state (CMyInventory::SyncSlotStates()): no-art where the class wears nothing there (a
   Dark Lord's helm, a Rage Fighter's gloves); its item's wear or unfitness as a tint inset 1 from the
   left and 4 from the right and bottom, as RenderEquippedItem() drew it; refused while the item on
   the cursor cannot go in. */
.equip-slot.no-art { background-color: transparent; border-color: transparent; }
.equip-slot-tint { position: absolute; left: 1px; top: 0; right: 3px; bottom: 4px; }
.equip-slot.broken .equip-slot-tint, .equip-slot.unequipable .equip-slot-tint { background-color: rgba(255, 0, 0, 64); }
.equip-slot.durability-20 .equip-slot-tint { background-color: rgba(255, 38, 0, 64); }
.equip-slot.durability-30 .equip-slot-tint { background-color: rgba(255, 128, 0, 64); }
.equip-slot.durability-50 .equip-slot-tint { background-color: rgba(255, 255, 0, 64); }
.equip-slot.refused .equip-slot-tint { background-color: rgba(230, 26, 26, 102); }
#item_grid, #item_grid_counts { left: 15px; top: 200px; width: 160px; height: 160px; }
#option_tooltip_anchor { left: 95px; top: 40px; }

/* The frame: values below are copied VERBATIM from sys_menu.rcss's #panel and base.rcss's
   .modern-shell-edge/.modern-groove (the unmodified defaults -- SysMenu doesn't override them,
   unlike Login's warmer .login-shell-edge/.login-groove tint) -- not approximated, so this frame
   is pixel/color-identical to SysMenu's, not just similar. If either source ever changes, update
   here too by copying the new literal values, not by eyeballing a new approximation. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

/* Outer blackened-iron edge, -3px -- base.rcss's .modern-shell-edge, unmodified. */
.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

/* Inner groove, ~4px inward -- base.rcss's .modern-groove, unmodified (no border-radius there
   either -- square inner corners is correct, matches SysMenu). */
.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .inv-header-rail (my_inventory.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 36px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested in .rail-fill so left/right/bottom resolve against it. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}
