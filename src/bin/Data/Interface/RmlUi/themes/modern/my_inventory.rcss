/* Modern theme for CMyInventory's chrome (frame/title/gold/buttons) -- same geometry and button/
   money art as legacy, only text styling and tooltip look differ. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* Fading crimson banner behind the title (base.rcss's .title-glow primitive); declared before
   #title so it paints behind it. */
.inv-title-glow {
	left: 20px;
	right: 20px;
	top: 4px;
	height: 22px;
}

/* Drag handle -- pointer-events/drag are force-set in C++ by UI::RmlBridge::MakeDraggable();
   cursor here is purely cosmetic. */
#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	color: token(text-warm);
	font-weight: bold;
	font-size: 12px;
	cursor: move;
}

@spritesheet inv-money-sheet { src: "../../../newui_item_money.tga"; inv-money: 0px 0px 170px 26px; }
#gold_bg {
	position: absolute;
	left: 11px;
	top: 364px;
	width: 170px;
	height: 26px;
	decorator: image(inv-money);
	pointer-events: none;
}
#gold_text {
	position: absolute;
	left: 50px;
	top: 371px;
	font-weight: bold;
	font-size: 11px;
	white-space: nowrap;
	pointer-events: none;
}

@spritesheet inv-btn-exit-sheet    { src: "../../../newui_exit_00.tga";        inv-btn-exit:    0px 0px 36px 29px; }
@spritesheet inv-btn-repair-sheet  { src: "../../../newui_repair_00.tga";      inv-btn-repair:  0px 0px 36px 29px; }
@spritesheet inv-btn-expand-sheet  { src: "../../../newui_expansion_btn.tga";  inv-btn-expand:  0px 0px 36px 29px; }
@spritesheet inv-btn-myshop-open-sheet  { src: "../../../newui_Bt_openshop.tga";  inv-btn-myshop-open:  0px 0px 36px 29px; }
@spritesheet inv-btn-myshop-close-sheet { src: "../../../newui_Bt_closeshop.tga"; inv-btn-myshop-close: 0px 0px 36px 29px; }

.inv-btn {
	position: absolute;
	top: 391px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
.inv-btn:hover { filter: brightness(1.25); }
.inv-btn.hidden { display: none; }
.inv-btn.locked { pointer-events: none; filter: brightness(0.6); }

.inv-btn-exit    { left: 13px;      decorator: image(inv-btn-exit); }
.inv-btn-repair  { left: 50px;      decorator: image(inv-btn-repair); }
.inv-btn-myshop  { left: 87px;      decorator: image(inv-btn-myshop-open); }
.inv-btn-myshop.close-mode { decorator: image(inv-btn-myshop-close); }
.inv-btn-expand  { left: 124px;     decorator: image(inv-btn-expand); }

.tooltip {
	display: none;
	position: absolute;
	top: 375px;
	width: 120px;
	white-space: nowrap;
	background-color: token(surface-tooltip);
	border: 1px token(border-frame);
	color: token(text-primary);
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "token(font-body)";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit   { left: -30px; }
.tooltip-repair { left: 7px; }
.tooltip-myshop { left: 44px; }
.tooltip-expand { left: 60px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_repair:hover ~ .tooltip-repair,
#btn_myshop:hover ~ .tooltip-myshop,
#btn_expand:hover ~ .tooltip-expand {
	display: block;
}

/* Set/Socket option header labels -- gray/yellow match legacy since they're semantic
   (active vs. inactive), not part of modern's chrome palette. */
.option-label {
	position: absolute;
	top: 20px;
	width: 95px;
	height: 15px;
	text-align: center;
	font-family: "token(font-body)";
	font-weight: bold;
	font-size: 12px;
	color: #666666;
	pointer-events: auto;
	cursor: default;
}
.option-label.active { color: #ffcc1a; }
.option-label-set { left: 0; }
.option-label-socket { left: 95px; }

/* Shared tooltip for both labels above -- uses a precomputed static `left` instead of
   `transform: translateX(-50%)`, since that resolves against a stale/zero box for a
   `display:none`-until-shown element. tt-line colors match legacy: they carry meaning
   (option category), not theme styling. */
#item_option_tooltip {
	position: absolute;
	left: 25px;
	top: 40px;
	width: 140px;
	text-align: center;
	background-color: token(surface-tooltip);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	padding: 4px 6px;
	font-family: "token(font-body)";
	font-size: 10px;
	pointer-events: none;
	z-index: 1;
}
.tt-line {
	display: block;
	color: #ffffff;
	white-space: normal;
	min-height: 1.2em;
	line-height: 1.2em;
}
.tt-line.tt-blue { color: #80b3ff; }
.tt-line.tt-yellow { color: #ffcc1a; }
.tt-line.tt-green { color: #1aff80; }
.tt-line.tt-purple { color: #ff1aff; }
.tt-line.bold { font-weight: bold; }
