/* Modern theme for the reconnect dialog: the modern panel surface and gauge in the legacy
   geometry (reference px inside #panel); the Cancel art carries its own label, so it stays. */

@spritesheet rc-cancel-sheet
{
	src: "../../../newui_button_cancel.tga";
	rc-cancel: 0px 0px 54px 30px;
	rc-cancel-over: 0px 30px 54px 30px;
}

body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; font-family: "token(font-body)"; }
#dim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000; pointer-events: none; }
#panel { position: absolute; transform-origin: left top; width: 230px; height: 122px; pointer-events: none; }
#back {
	position: absolute;
	left: 0;
	top: 0;
	width: 230px;
	height: 122px;
	background-color: token(surface-panel);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
#box_top, #box_middle, #box_bottom { display: none; }
#progress_back { position: absolute; left: 35px; top: 66px; width: 160px; height: 18px; background-color: token(surface-recessed); border-radius: token(radius-sm)px; }
#progress_bar { position: absolute; left: 40px; top: 71px; height: 8px; background-color: token(accent-steel); }
#cancel { position: absolute; left: 88px; top: 86px; width: 54px; height: 30px; decorator: image(rc-cancel); pointer-events: auto; }
#cancel:hover { decorator: image(rc-cancel-over); }

.sharp-text { display: block; position: absolute; white-space: nowrap; pointer-events: none; transform-origin: left top; }
.line { color: token(text-primary); }
.line.bold { font-weight: bold; }
