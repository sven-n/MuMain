/* Background-layer companion to my_inventory.rcss -- flat panel fill only, loaded into the
   background context behind the still-native 3D-composited equipment/grid icons. .bg-panel
   duplicates the combined result of base.rcss's .modern-frame + .modern-frame-crimson (the look
   every dialog/window uses) to keep this context independent; keep in sync by inspection if
   either class changes. */

#bg_root {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	pointer-events: none;
}

.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	background-color: #0e0f0c;
	decorator: linear-gradient(to bottom, #191b15, #0e0f0c 30%, #080907);
	border-width: 2px;
	border-top-color: rgba(107, 96, 69, 90); /* metal-warm-edge's rgb @ 90 alpha */
	border-left-color: rgba(0, 0, 0, 160);
	border-right-color: rgba(0, 0, 0, 160);
	border-bottom-color: rgba(0, 0, 0, 220);
	border-radius: token(radius-md)dp;
}
