/* Background-layer companion to my_inventory.rcss -- see my_inventory_bg.rml's own header
   comment. Loaded into the background context that renders behind the still-native 3D-composited
   equipment/grid icons, so this file only ever holds the flat panel fill, no interactive
   elements. .bg-panel duplicates base.rcss's .modern-frame literal (not shared via a second
   <link>, to keep this context fully independent -- same choice main_frame_bg.rcss already
   made) -- keep in sync by inspection if that value ever changes. */

#bg_root {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	pointer-events: none;
}

.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	background-color: rgba(29, 35, 43, 190); /* surface-2's rgb @ 190 alpha, kept in sync with base.rcss's .modern-frame */
	decorator: linear-gradient(to bottom, rgba(45, 53, 63, 190) 0%, rgba(29, 35, 43, 190) 40%, rgba(14, 17, 21, 190) 100%);
	border-width: 2px;
	border-top-color: rgba(170, 184, 198, 160); /* accent-steel-bright's rgb @ 160 alpha */
	border-left-color: rgba(170, 184, 198, 160);
	border-bottom-color: rgba(0, 0, 0, 190);
	border-right-color: rgba(0, 0, 0, 190);
}
