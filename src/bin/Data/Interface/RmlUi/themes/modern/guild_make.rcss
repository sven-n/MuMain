/* Modern theme for CGuildMakeWindow: docked_panel_frame.rcss's forged panel (linked first), modern
   buttons and name field; the mark editor keeps the legacy geometry (reference px under the dock
   transform) with flat cells. */

#panel { pointer-events: none; }

.sharp-text { display: block; position: absolute; white-space: nowrap; pointer-events: none; transform-origin: left top; }
.gm-centred { left: 0; text-align: center; }
#title { top: 15px; color: token(text-warm); }
#info { top: 50px; color: token(text-primary); }
#result { top: 140px; color: token(text-warm); }
#name_label { left: 10px; top: 66px; color: token(text-warm); }
.gm-hint { left: 50px; color: token(text-primary); }

.gm-btn {
	display: block;
	position: absolute;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.gm-btn:hover { border-color: token(accent-steel-hover); }
.gm-btn:active { background-color: token(surface-recessed); }
.gm-btn-big { left: 41px; top: 100px; width: 108px; height: 28px; }
.gm-btn-small { top: 379px; width: 64px; height: 28px; }
#btn_back { left: 15px; }
#btn_next { left: 110px; }
.gm-label { left: 0; text-align: center; color: token(text-primary); }

#btn_exit {
	position: absolute;
	left: 13px;
	top: 392px;
	width: 36px;
	height: 28px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
#btn_exit:hover { border-color: token(accent-steel-hover); }
.tooltip { display: none; top: 365px; }
.tooltip-exit { left: -24px; }
#btn_exit:hover ~ .tooltip-exit { display: block; }

#name_back {
	position: absolute;
	left: 45px;
	top: 60px;
	width: 108px;
	height: 23px;
	background-color: token(surface-recessed);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
}
#name_field {
	display: none;
	left: 50px;
	top: 66px;
	padding: 0;
	border-width: 0;
	background-color: transparent;
	color: token(text-primary);
	pointer-events: auto;
}
#name_field.shown { display: block; }

.gold-rect { position: absolute; border: 1px token(border-frame); pointer-events: none; }
#mark_rect { left: 45px; top: 95px; width: 130px; height: 130px; }
#result_rect { left: 72px; top: 70px; width: 53px; height: 53px; }
.gold-h, .gold-v { display: none; }

.gm-cell { position: absolute; background-color: token(surface-recessed); pointer-events: none; }
.gm-cell-13 { width: 15px; height: 15px; }
.gm-cell-18 { width: 20px; height: 20px; }
.gm-cell-23 { width: 25px; height: 25px; }
.gm-fill { position: absolute; left: 1px; top: 1px; }
.gm-cell-13 .gm-fill { width: 13px; height: 13px; }
.gm-cell-18 .gm-fill { width: 18px; height: 18px; }
.gm-cell-23 .gm-fill { width: 23px; height: 23px; }
.gm-cross { position: absolute; height: 2px; background-color: token(text-muted); transform-origin: center; }
.gm-cell-13 .gm-cross { left: -2.69px; top: 5.5px; width: 18.38px; }
.gm-cell-18 .gm-cross { left: -3.73px; top: 8px; width: 25.46px; }
.gm-cell-23 .gm-cross { left: -4.76px; top: 10.5px; width: 32.53px; }
.gm-cross-a { transform: rotate(45deg); }
.gm-cross-b { transform: rotate(-45deg); }

#result_mark { position: absolute; left: 72px; top: 74px; width: 48px; height: 48px; pointer-events: none; }
.mark-cell { float: left; width: 6px; height: 6px; }
