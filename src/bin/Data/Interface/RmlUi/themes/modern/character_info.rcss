/* Modern theme for CCharacterInfoWindow -- same forged-dialog chrome recipe as CMyInventory
   (shell-edge/groove/gradient panel fill, rail-with-rivet header, bordered square icon buttons),
   not the generic .modern-frame/.modern-frame-crimson treatment: this window docks in the same
   PanelColumnX() row as CMyInventory/CMyQuestInfoWindow and should read as the same family when
   open side by side.

   CMyInventory splits this look into a separate background RmlUi context (my_inventory_bg.rcss)
   purely to solve one paint-order problem: its equipped item's live-3D icon renders natively
   *behind* the frame, and RmlUi's main context always composites last, so the frame has to live in
   a context that renders before the icon does. CCharacterInfoWindow has no live-3D content at all,
   so that constraint doesn't apply -- the whole look lives directly in this single foreground
   document instead. Values below are copied from my_inventory_bg.rcss/my_inventory.rcss's own px
   literals (already unmodified defaults, same as those files copy from base.rcss's dp originals),
   not approximated -- keep this file in sync by inspection if either of those change. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

/* Outer blackened-iron edge, -3px -- base.rcss's .modern-shell-edge, unmodified (its own is `dp`,
   this window's #panel is root_scale-transformed so needs the literal-px copy, same reasoning
   base.rcss's -px header-rail/icon-btn/wallet family exists for). */
.chainfo-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}
/* Inner groove, ~4px inward -- base.rcss's .modern-groove, unmodified. This is what gives the
   panel body its recessed/carved surface, the same treatment CMyInventory's body reads as. */
.chainfo-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Header rail: base.rcss's .modern-header-rail-px (layout only -- paint normally lives in a
   window's own *_bg.rcss for the live-3D-icon-overflow reason documented there; this window has
   no such content, so the paint lives here directly instead, copied from my_inventory_bg.rcss's
   .rail-fill/.rail-accent). top:7/height:38 matches CMyInventory/SysMenu exactly. */
.chainfo-header-rail {
	top: 7px;
	height: 38px;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
.chainfo-rail-accent {
	position: absolute;
	left: -1px;
	right: -1px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

#name, #classname, #servername {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	font-weight: bold;
	font-size: 12px;
	font-family: "token(font-body)";
	pointer-events: none;
	font-effect: shadow(0px 1px #000000);
}
#name { color: token(text-warm); }
#classname, #servername { top: 27px; color: token(text-secondary); font-weight: normal; font-size: 11px; }

.summary-fill {
	position: absolute;
	left: 12px;
	top: 48px;
	width: 165px;
	height: 71px;
	background-color: token(surface-panel);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}

.level-text, .levelup-point-text, .exp-text, .point-probability-text, .point-text {
	display: block;
	position: absolute;
	left: 18px;
	font-size: 12px;
	font-family: "token(font-body)";
	white-space: nowrap;
	pointer-events: none;
}
.level-text { top: 58px; color: token(accent-gold-hover); font-weight: bold; }
.levelup-point-text { top: 58px; left: 110px; color: token(accent-gold-hover); font-weight: bold; }
.exp-text { top: 75px; color: token(text-primary); }
.point-probability-text { top: 88px; color: token(accent-steel-hover); }
.point-text { top: 101px; color: token(accent-steel-hover); }
.hidden { display: none; }

.attr-textbox {
	position: absolute;
	left: 11px;
	width: 170px;
	height: 21px;
	background-color: token(surface-control);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}
.attr-textbox-str { top: 120px; }
.attr-textbox-agi { top: 175px; }
.attr-textbox-vit { top: 240px; }
.attr-textbox-ene { top: 295px; }
.attr-textbox-cmd { top: 350px; }

.attr-label, .attr-value {
	display: block;
	position: absolute;
	text-align: center;
	font-weight: bold;
	font-size: 12px;
	font-family: "token(font-body)";
	pointer-events: none;
}
.attr-label { left: 12px; width: 74px; color: token(text-secondary); }
.attr-value { left: 86px; width: 86px; }
.attr-label-str, .attr-value-str { top: 126px; }
.attr-label-agi, .attr-value-agi { top: 181px; }
.attr-label-vit, .attr-value-vit { top: 246px; }
.attr-label-ene, .attr-value-ene { top: 301px; }
.attr-label-cmd, .attr-value-cmd { top: 356px; }

.attr-lines { position: absolute; width: 160px; pointer-events: none; }
.attr-lines span { display: block; line-height: 13px; font-size: 12px; font-family: "token(font-body)"; white-space: nowrap; }
.attr-lines-str { left: 20px; top: 145px; }
.attr-lines-agi { left: 20px; top: 199px; }
.attr-lines-vit { left: 20px; top: 264px; }
.attr-lines-ene { left: 18px; top: 319px; }

/* Flat "+" button -- a generic affordance, kept simple rather than a full forged-metal square
   (too small at 16x15 to carry that much chrome); recolored to this window's own metal/border
   tokens instead of the generic accent-steel so it still reads as part of the same palette. */
.stat-btn {
	display: block;
	position: absolute;
	left: 160px;
	width: 16px;
	height: 15px;
	background-color: token(metal-dark);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)dp;
	text-align: center;
	line-height: 13px;
	font-weight: bold;
	font-size: 11px;
	color: token(text-warm);
	cursor: pointer;
	pointer-events: auto;
}
.stat-btn:hover { color: token(accent-gold-hover); border-color: token(border-hover); }
.stat-btn-str { top: 122px; }
.stat-btn-agi { top: 177px; }
.stat-btn-vit { top: 242px; }
.stat-btn-ene { top: 297px; }
.stat-btn-cmd { top: 352px; }

/* Action row: base.rcss's .modern-icon-btn-px at its own default geometry (top:392/37x26) --
   same shared class CMyInventory's Exit/Repair/My Shop/Expand use, just this window's own left
   offsets and glyphs. */
.chainfo-btn-exit        { left: 13px;  color: #d59b79; border-color: #5c382b; }
.chainfo-btn-quest       { left: 54px; }
.chainfo-btn-pet         { left: 95px; }
.chainfo-btn-masterlevel { left: 136px; }

.tooltip {
	display: none;
	position: absolute;
	top: 376px;
	width: 110px;
	white-space: nowrap;
	background-color: token(surface-tooltip);
	border: 1px token(border-frame);
	color: token(text-primary);
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "token(font-body)";
	font-size: 11px;
	text-align: center;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit        { left: -24px; }
.tooltip-quest       { left: 14px; }
.tooltip-pet         { left: 55px; }
.tooltip-masterlevel { left: 92px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_quest:hover ~ .tooltip-quest,
#btn_pet:hover ~ .tooltip-pet,
#btn_masterlevel:hover ~ .tooltip-masterlevel {
	display: block;
}
