<rml>
<head>
	<title>Generic Menu Dialog</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="generic_menu_dialog.rcss"/>
</head>
<body>
	<!-- Modern theme's own copy of the generic menu dialog -- per-theme file since the forged-
	     dialog shell structure differs by theme, same reasoning as every other *_dialog.rml pair.
	     Keep ids/data-model/event-callback names in sync with ../../generic_menu_dialog.rml.

	     Reuses base.rcss's shared forged-dialog shell directly (.modern-frame/.modern-shell-edge/
	     .modern-groove/.modern-header-rail/.modern-content-well) -- the same pieces sys_menu.rml
	     already proves for "a small forged-iron dialog with no hero-banner," no bespoke paint
	     needed since (unlike generic_confirm_dialog) there's no item3D forcing a second document. -->
	<div id="panel" class="center-both modern-frame" data-model="generic_menu_dialog">
		<div class="modern-shell-edge"></div>
		<div class="modern-groove"></div>

		<!-- Content well painted BEFORE the header rail (below it in this document's own paint
		     order), so the rail's own opaque fill correctly covers the well wherever their boxes
		     overlap -- the same net z-order generic_confirm_dialog achieves via two documents,
		     here achieved with plain markup order since this primitive only needs one. -->
		<div class="gmd-content-well modern-content-well" data-class-has-title="has_title">
			<div class="gmd-line" data-for="line : lines" data-class-bold="line.bold">{{line.text}}</div>
			<!-- See ../../generic_menu_dialog.rml's own comment for why there's no explicit
			     column count -- .gmd-button-row's own flex-wrap derives it from content. -->
			<div class="gmd-button-row">
				<!-- it_index (RmlUi's own data-for loop variable) passed straight into the click
				     handler -- proven pattern, see ../../generic_menu_dialog.rml's own comment.
				     gmd-button-cell wraps each button with its own optional description lines --
				     see ../../generic_menu_dialog.rml's own comment for why (nested data-for). -->
				<div class="gmd-button-cell" data-for="button : buttons" data-class-compact="button.compact" data-class-has-lines="button.has_lines">
					<div class="gmd-line" data-for="line : button.lines" data-class-bold="line.bold">{{line.text}}</div>
					<div class="btn gmd-btn" data-class-compact="button.compact" data-class-disabled="!button.enabled"
					     data-event-click="gmd_button_click(it_index)">
						{{button.label}}
						<span class="gmd-tooltip" data-class-hidden="!button.has_tooltip">{{button.tooltip}}</span>
					</div>
				</div>
			</div>
		</div>

		<div class="gmd-header-rail modern-header-rail" data-class-hidden="!has_title">
			<div class="modern-joint"></div>
			<div class="modern-header-accent"></div>
			<div class="modern-header-text">
				<div class="modern-header-title">{{title}}</div>
			</div>
		</div>
	</div>
</body>
</rml>
