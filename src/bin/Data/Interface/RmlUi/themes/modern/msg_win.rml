<rml>
<head>
	<title>Message Box</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="msg_win.rcss"/>
</head>
<body data-model="msg_win">
	<!-- Modern theme's own copy of the generic message/confirm dialog -- per-theme file since
	     modern-frame/modern-frame-crimson is modern-specific structure, not just style. mode-*
	     classes select which of CMsgWin's five MSG_WIN_TYPE variants is active; keep ids/
	     data-model names in sync with ../../msg_win.rml. -->
	<div id="panel" class="center-both modern-frame modern-frame-crimson"
	     data-class-no-buttons="no_buttons"
	     data-class-mode-cancel-only="mode_cancel_only"
	     data-class-mode-ok-only="mode_ok_only"
	     data-class-mode-both="mode_both"
	     data-class-mode-input="mode_input">
		<div class="modern-header-rivet"></div>
		<div id="msg_line1" class="msg-line" data-class-multi-line="!line2_hidden">{{line1}}</div>
		<div id="msg_line2" class="msg-line" data-class-hidden="line2_hidden">{{line2}}</div>

		<!-- Background art only for the resident-password re-entry step; live text drawn on top by legacy code. -->
		<!-- Background art only -- the field itself is the <input> below. -->
		<div id="input_frame"></div>

		<!-- Resident-password entry (MWT_STR_INPUT / MESSAGE_DELETE_CHARACTER_RESIDENT). Stock RmlUi
		     <input type="password">, bound to MsgWinRmlModel::residentPassword; maxlength comes from
		     C++ (InitResidentNumInput()). Declared after #input_frame so it paints on top of it --
		     RmlUi draws siblings in document order. -->
		<input id="msgwin_input" type="password" class="text-field msgwin-input-field"
		       data-value="password_input" data-class-hidden="!mode_input"/>

		<!-- Raised footer band (base.rcss) for structural separation only -- no title text here
		     so it gets a footer, not .modern-header, avoiding an empty raised strip that would
		     look like a mistake. -->
		<div class="modern-footer"></div>

		<div id="btn_ok" class="btn btn-ok" data-event-click="msgwin_ok_click">{{ok_label}}</div>
		<div id="btn_cancel" class="btn btn-cancel" data-event-click="msgwin_cancel_click">{{cancel_label}}</div>
	</div>
</body>
</rml>
