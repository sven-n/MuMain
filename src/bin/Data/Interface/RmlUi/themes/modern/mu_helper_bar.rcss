/* Modern theme for the MU Helper mini control bar + hero position readout -- flat programmatic
   chrome, no legacy sprite art. Same layout as themes/legacy/mu_helper_bar.rcss. */

#panel {
	position: absolute;
	width: 207dp;
	height: 25dp;
	font-family: "Liberation Sans";
	font-size: 11dp;
	background-color: rgba(20, 20, 20, 180);
	border: 1dp rgba(140, 146, 152, 130); /* border-metal */
	border-radius: 3dp; /* radius-sm */
}

/* No legacy seam art -- the three segments collapse into #panel's own flat fill; elements stay in
   the document (data bindings target them by id) but render nothing of their own. */
#seg_a, #seg_b, #seg_c {
	display: none;
}

#text {
	position: absolute;
	left: 10dp;
	top: 5dp;
	width: 132dp;
	height: 9dp;
	text-align: center;
	color: #d9d3c5; /* text-body */
	white-space: nowrap;
	pointer-events: none;
}

.mu-btn {
	position: absolute;
	top: 2dp;
	width: 18dp;
	height: 13dp;
	cursor: pointer;
	pointer-events: auto;
	background-color: rgba(255, 244, 224, 12); /* surface-3 */
	border: 1dp rgba(140, 146, 152, 130); /* border-metal */
	border-radius: 2dp;
}
.mu-btn:hover {
	background-color: #c0a050; /* accent-gold */
	border: 1dp #c0a050; /* accent-gold */
}
#btn_config { left: 153dp; }
#btn_start  { left: 171dp; }
#btn_stop   { left: 171dp; }

/* Plain colored dot per button (no icon art) -- config: neutral, start: success, stop: danger. */
.dot {
	position: absolute;
	left: 50%;
	top: 50%;
	width: 6dp;
	height: 6dp;
	transform: translate(-50%, -50%);
	border-radius: 3dp;
	pointer-events: none;
}
#btn_config .dot { background-color: #9a958c; } /* semantic-neutral */
#btn_start .dot  { background-color: #6fae6f; } /* semantic-success */
#btn_stop .dot   { background-color: #b2394a; } /* semantic-danger */

.tooltip {
	display: none;
	position: absolute;
	top: 18dp;
	left: 50%;
	transform: translateX(-50%);
	white-space: nowrap;
	background-color: rgba(0, 0, 0, 200);
	color: #ffffff;
	padding: 2dp 4dp;
	border-radius: 3dp; /* radius-sm */
	font-family: "Liberation Sans";
	font-size: 11dp;
	pointer-events: none;
}
.mu-btn:hover .tooltip {
	display: block;
}
