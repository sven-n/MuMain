/* Modern theme for CCatapultWindow: docked_panel_frame.rcss's forged panel (linked first), modern
   buttons, the chosen area and a locked Shoot dimmed. Geometry is the legacy one (reference px
   under the dock transform). */

#panel { pointer-events: auto; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: center; pointer-events: none; transform-origin: left top; }
.cp-title { left: 0; top: 13px; font-weight: bold; color: token(text-warm); }
.cp-line { left: 0; font-weight: bold; color: token(text-primary); }
.cp-lines { position: static; }
.cp-line:nth-child(1) { top: 50px; }
.cp-line:nth-child(2) { top: 65px; }
.cp-line:nth-child(3) { top: 80px; }

/* The target table draws no frame here; the panel surface is the table. */
.t-edge-top, .t-edge-bottom, .t-edge-left, .t-edge-right, .t-corner { display: none; }

.cp-area, #btn_fire {
	display: block;
	position: absolute;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.cp-area { width: 46px; height: 36px; }
.cp-area.big { width: 77px; height: 47px; }
#btn_fire { left: 41px; top: 250px; width: 108px; height: 28px; }
.cp-area:hover, #btn_fire:hover { border-color: token(accent-steel-hover); }
.cp-area.locked, #btn_fire.locked { background-color: token(surface-recessed); border-color: token(border-frame); }
.cp-label { left: 0; color: token(text-primary); }
.locked .cp-label { color: token(text-muted); }

#btn_exit {
	position: absolute;
	left: 13px;
	top: 392px;
	width: 36px;
	height: 28px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
#btn_exit:hover { border-color: token(accent-steel-hover); }

/* The two modes' own target areas (kAttackAreas / kDefenseAreas). A label is centred on its
   button, where C++ used to measure the text and halve the remainder. */
.cp-areas { position: static; }
.cp-area-label { left: 0; text-align: center; }
.cp-areas.attack .cp-area:nth-child(1) { left: 22px; top: 135px; }
.cp-areas.attack .cp-area:nth-child(2) { left: 74px; top: 135px; }
.cp-areas.attack .cp-area:nth-child(3) { left: 126px; top: 135px; }
.cp-areas.attack .cp-area:nth-child(4) { left: 59px; top: 182px; }
.cp-areas.defense .cp-area:nth-child(1) { left: 18px; top: 125px; }
.cp-areas.defense .cp-area:nth-child(2) { left: 97px; top: 125px; }
.cp-areas.defense .cp-area:nth-child(3) { left: 56px; top: 179px; }
