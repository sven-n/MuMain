<rml>
<head>
	<title>Storage Ext Background</title>
	<link type="text/rcss" href="storage_ext_bg.rcss"/>
</head>
<body data-model="storage_ext_bg">
	<!-- Background-context document (see my_inventory_bg.rml for the mechanism) -- paints the
	     outer frame behind CInventoryCtrl's own native grid/table-frame/item-icon rendering. -->
	<div id="bg_root" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill/accent, relocated from storage_ext.rml's foreground rail --
			     see storage_ext_bg.rcss's .rail-fill comment for why. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
	</div>
</body>
</rml>
