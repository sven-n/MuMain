/* Window placement for the modern theme. The game reads where each open slot lands; nothing here is drawn. */

body {
	width: 100%;
	height: 100%;
	margin: 0;
	visibility: hidden;
	pointer-events: none;
}

#workspace_shell { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; }
#shell_middle { position: relative; display: flex; flex-direction: row; flex: 1 1 0; min-height: 0; }
#safe_area { position: relative; flex: 1 1 0; min-width: 0; min-height: 0; }
.region.shell-region { position: relative; display: flex; flex: 0 0 auto; }
/* Steady while the MU Helper bar hides for a fourth column of windows, so the docks keep their scale. */
#shell_header { align-items: flex-start; min-height: 25dp; }
#shell_header .slot[data-window="top_bar"] { margin-left: auto; }
#shell_footer { justify-content: center; }
#shell_left, #shell_right { flex-direction: column; }
.shell-region[data-participation="overlay"] { position: absolute; }
#shell_header[data-participation="overlay"] { top: 0; left: 0; right: 0; }
#shell_footer[data-participation="overlay"] { bottom: 0; left: 0; right: 0; }
#shell_left[data-participation="overlay"] { left: 0; top: 0; bottom: 0; }
#shell_right[data-participation="overlay"] { right: 0; top: 0; bottom: 0; }

.region {
	position: absolute;
}

/* The original's docked columns: open windows pack from the right edge, sitting on the HUD.
   Capped to the content area, so the windows draw smaller rather than cover the top bar. */
.dock-right {
	max-height: 100%;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row-reverse;
	align-items: flex-start;
}

.slot {
	display: none;
	flex: 0 0 auto;
}

.slot.open {
	display: block;
}

/* The original's left-docked warp list, sitting on the HUD. */
.dock-left {
	max-height: 100%;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

/* The chat in the bottom-left corner above the HUD; the log overlaps the input box by 1 unit,
   as the original drew them. */
.chat-stack {
	left: 0;
	bottom: 0;
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}
.chat-stack .slot[data-window="chat_log"] { margin-bottom: -1dp; }

/* The event HUDs: the original's 640x480 frame standing on the HUD (1dp is one of its units, its
   top 429 units above the HUD), each at the original's place in it. Anchor it right instead
   to keep them in the screen's corner on wide screens. The spectator list's slot is its
   bottom-left corner; the list grows upwards. */
.event-hud {
	left: 0;
	bottom: 0;
	width: 640dp;
	height: 429dp;
}
.event-hud .slot { position: absolute; }
.event-hud .slot[data-window="blood_castle_time"],
.event-hud .slot[data-window="chaos_castle_time"] { left: 513dp; top: 348dp; }
.event-hud .slot[data-window="battle_soccer"],
.event-hud .slot[data-window="duel"] { left: 509dp; top: 359dp; }
.event-hud .slot[data-window="kanturu_info"] { left: 541dp; top: 351dp; }
.event-hud .slot[data-window="empire_guardian_timer"] { left: 507dp; top: 342dp; }
.event-hud .slot[data-window="doppelganger_frame"] { left: 413dp; top: 342dp; }
.event-hud .slot[data-window="duel_watch_users"] { left: 583dp; top: 429dp; }

/* Where a free window (the friend list) first opens: the bottom-right corner above the HUD. */
.free-bottom-right {
	right: 0;
	bottom: 0;
}

/* The original's centred NPC panels: a 640x480 stage in the screen's centre (1dp is one of its
   units at the panel scale), each panel centred across it at the original's height. */
.panel-stage {
	left: 50%;
	top: 50%;
	width: 640dp;
	height: 480dp;
	margin-left: -320dp;
	margin-top: -240dp;
	display: flex;
	flex-direction: column;
	align-items: center;
}
.panel-stage .slot[data-window="kanturu_entry"] { margin-top: 20dp; }
.panel-stage .slot[data-window="cursed_temple_entry"] { margin-top: 80dp; }
.panel-stage .slot[data-window="cursed_temple_result"] { margin-top: 120dp; }

/* Passive overlays share a column. The six-line message area never collapses between messages. */
.diagnostics-stack {
    left: 4dp;
    top: 84dp;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}
.diagnostics-stack .slot[data-window="diagnostics"] { margin-top: 6dp; }
