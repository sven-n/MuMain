/* Window placement for the modern theme. The game reads where each open slot lands; nothing here is drawn. */

body {
	width: 100%;
	height: 100%;
	margin: 0;
	visibility: hidden;
	pointer-events: none;
}

#workspace_shell { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; }
#shell_middle { position: relative; display: flex; flex-direction: row; flex: 1 1 0; min-height: 0; }
#safe_area { position: relative; flex: 1 1 0; min-width: 0; min-height: 0; }
.region.shell-region { position: relative; display: flex; flex: 0 0 auto; }
#shell_header, #shell_footer { justify-content: center; }
#shell_left, #shell_right { flex-direction: column; }
.shell-region[data-participation="overlay"] { position: absolute; }
#shell_header[data-participation="overlay"] { top: 0; left: 0; right: 0; }
#shell_footer[data-participation="overlay"] { bottom: 0; left: 0; right: 0; }
#shell_left[data-participation="overlay"] { left: 0; top: 0; bottom: 0; }
#shell_right[data-participation="overlay"] { right: 0; top: 0; bottom: 0; }

.region {
	position: absolute;
}

/* The original's docked columns: open windows pack from the right edge, sitting on the HUD. */
.dock-right {
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row-reverse;
	align-items: flex-start;
}

.slot {
	display: none;
	flex: 0 0 auto;
}

.slot.open {
	display: block;
}

/* The original's left-docked warp list, sitting on the HUD. */
.dock-left {
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	flex-direction: row;
	align-items: flex-start;
}

/* Where a free window (the friend list) first opens: the bottom-right corner above the HUD. */
.free-bottom-right {
	right: 0;
	bottom: 0;
}

/* The original's centred NPC panels: a 640x480 stage in the screen's centre (1dp is one of its
   units at the panel scale), each panel centred across it at the original's height. */
.panel-stage {
	left: 50%;
	top: 50%;
	width: 640dp;
	height: 480dp;
	margin-left: -320dp;
	margin-top: -240dp;
	display: flex;
	flex-direction: column;
	align-items: center;
}
.panel-stage .slot[data-window="kanturu_entry"] { margin-top: 20dp; }
.panel-stage .slot[data-window="cursed_temple_entry"] { margin-top: 80dp; }
.panel-stage .slot[data-window="cursed_temple_result"] { margin-top: 120dp; }
