/* Modern theme for CPurchaseShopInventory's chrome -- header/nameplate-strip/warning-text/exit
   button are vector forged-metal chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-
   dialog language). Inventory grid stays fully native (sprite art + live 3D icons), same as
   legacy -- no RmlUi involvement there. No gold wallet strip -- this window shows no Zen total
   (same as StorageExt, the other gold-less window in this family). */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:7/height:29 -- rail ends at 36px. The nameplate strip below (.pshop-title-strip) runs
   44-70px, and the native grid starts at `m_Pos.y + 90` (PurchaseShopInventory.cpp's
   CInventoryCtrl::Create() call) -- 20px clear after the strip. top:7 (same as MyInventory's own
   rail top) keeps .modern-joint-px's rivet at -1px, inside the frame's
   .inv-shell-edge at -3px -- same contained relationship as StorageExt/MyInventory. */
.pshop-header-rail {
	top: 7px;
	height: 29px;
}

/* Nameplate strip for the dynamic shop-owner name -- native's separate text row (RenderTextInfo(),
   PurchaseShopInventory.cpp) painted over IMAGE_MYSHOPINVENTORY_EDIT's sprite; here a plain vector
   strip using the same metal-rail gradient as the header above. Sits between the header rail
   (ends 36px) and the native grid (starts 90px). */
.pshop-title-strip {
	position: absolute;
	left: 12px;
	top: 44px;
	width: 166px;
	height: 26px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 10), transparent 30%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-radius: token(radius-sm)px;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 15),
		inset 0 -1px 0 #000000;
}
.pshop-title-strip-text {
	position: absolute;
	left: 0;
	top: 6px;
	width: 166px;
	text-align: center;
	color: token(text-warm);
	font-family: "token(font-title)";
	font-weight: 500;
	font-size: 12px;
	font-effect: shadow(0px 1px #000000);
	pointer-events: none;
}

/* Static warning notice -- semantic red/gold match legacy exactly (meaning, not theme palette),
   same convention as my_inventory.rcss's tt-line colors. shop_notice.rcss lays it out. */
.warning-label { color: #ff2d2f; }
.warning-line { color: #f7ce4d; }

/* Single exit button, centered: (190-37)/2. */
.pshop-btn-exit {
	left: 77px;
	color: #d59b79;
	border-color: #5c382b;
}

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 16px; top: 90px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .pshop-header-rail (purchase_shop.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 29px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
