/* The package description in the cash shop's buy dialog. A read-only wrapped text block -- the
   native list box it replaced rendered no selection (SetLineColorRender(false)) and only ever
   scrolled. The pane counter-scales out of the dialog's root transform so its text stays at the
   native renderer's physical size, like every other dense list. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 198px;
	height: 291px;
	pointer-events: none;
}

/* Native placed the box at (14, 216) in left-down coordinates, 175 x 95 -- so its top edge is
   216 - 95. The height here is the 7 rows it actually drew. */
#igs_package_info {
	position: absolute;
	left: 14px;
	top: 121px;
	transform-origin: left top;
	overflow: hidden scroll;
	pointer-events: auto;
}

/* display: block is explicit: a data-for <div> is inline without it in this build and every line
   lands on the same row. The 3-unit inset is RenderDataLine()'s own m_iPos_x + 3. */
.igs-line {
	position: relative;
	display: block;
	padding-left: 3px;
	white-space: nowrap;
	color: rgb(255, 230, 210);
}
