/* Modern theme for CDuelWatchMainFrameWindow: the modern panel surface instead of the menu_pk
   frame; the gauges, score marks, names and exit button keep the legacy geometry and art (see the
   legacy theme). */

@spritesheet dwf-score-sheet { src: "../../../menu_pk_bt02.tga"; dwf-score: 0px 0px 16px 17px; }
@spritesheet dwf-exit-sheet
{
	src: "../../../newui_exit_00.tga";
	dwf-exit-up: 0px 0px 36px 29px;
	dwf-exit-down: 0px 29px 36px 29px;
}

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
}

#back1, #back2, #back3 {
	position: absolute;
	top: 429px;
	height: 51px;
	background-color: token(surface-panel);
}
#back1 { left: 0; width: 256px; border: 1px token(border-frame); border-right-width: 0; }
#back2 { left: 256px; width: 128px; border: 1px token(border-frame); border-left-width: 0; border-right-width: 0; }
#back3 { left: 384px; width: 256px; border: 1px token(border-frame); border-left-width: 0; }

#fight { position: absolute; left: 0; top: 0; width: 640px; height: 480px; }
.gauge { position: absolute; }
.gauge.mirrored { transform: scale(-1, 1); }

.score { position: absolute; top: 460px; width: 16px; height: 17px; decorator: image(dwf-score); }

.name {
	display: block;
	position: absolute;
	top: 465px;
	transform-origin: left top;
	white-space: nowrap;
	text-align: center;
	font-family: "token(font-body)";
	font-weight: bold;
	color: token(text-primary);
}

#exit {
	position: absolute;
	left: 604px;
	top: 451px;
	width: 36px;
	height: 29px;
	decorator: image(dwf-exit-up);
	pointer-events: auto;
}
#exit:active { decorator: image(dwf-exit-down); }
