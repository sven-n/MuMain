/* Modern theme for the "remember password" confirmation -- 2026-09-03: now consumes base.rcss's
   .modern-frame/.modern-frame-accent primitives plus the -crimson palette variant (applied in
   remember_password_prompt.rml) instead of its own bespoke gray panel, same nested-frame look as
   login.rcss's pilot. #panel keeps only what's genuinely structural/local (position/size/font/
   border-width/radius); background/border-color come from .modern-frame-crimson. */

#panel {
	position: absolute;
	width: 340px;
	height: 150px;
	font-family: "Liberation Sans";
	font-size: 12px;
	color: #d9d3c5; /* text-body */
	border-width: 1px;
	border-radius: 10px;
}

/* Thin accent line just inside the frame -- position/inset local, palette from
   .modern-frame-accent-crimson (applied in remember_password_prompt.rml). Same 4px inset
   convention as login.rcss's own .frame-accent. */
.frame-accent {
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	border-radius: 8px;
}

/* Stays semantic-warning (this dialog's title IS the security warning being confirmed), not
   converted to a crimson banner -- see modern-theme-visual-direction.md's Semantic colors
   section: real data-meaning colors aren't displaced by decoration. */
.prompt-title {
	position: absolute;
	left: 20px;
	top: 15px;
	width: 300px;
	color: #d69a3e; /* semantic-warning */
	font-weight: bold;
}

.prompt-body {
	position: absolute;
	left: 20px;
	top: 40px;
	width: 300px;
	color: #d9d3c5; /* text-body */
	white-space: normal;
}

.btn-ok     { left: 52px;  top: 105px; }
.btn-cancel { left: 180px; top: 105px; }
