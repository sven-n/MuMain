/* Modern theme for the "remember password" confirmation -- consumes base.rcss's
   .modern-frame/.modern-frame-accent plus the -crimson palette variant instead of a bespoke
   gray panel. #panel keeps only structural/local values; background/border-color come from
   .modern-frame-crimson. */

/* #panel is centered via the .center-both utility class, not a GetProperty()-read-back centering
   calc -- GetProperty() returns the raw declared dp number, not the resolved pixel size, so that
   would silently miscenter and never recenter on resize. */
#panel {
	width: 340dp;
	height: 150dp;
	font-family: "token(font-body)";
	font-size: 12dp;
	color: token(text-primary);
	border-width: 1dp;
	border-radius: 3dp;
}

/* Thin accent line just inside the frame -- palette from .modern-frame-accent-crimson, same
   4dp inset convention as login.rcss's .frame-accent. */
.frame-accent {
	left: 4dp;
	right: 4dp;
	top: 4dp;
	bottom: 4dp;
	border-radius: 2dp;
}

.prompt-header {
	height: 31dp; /* 35dp minus the 4dp top inset .modern-header's own base rule now starts from */
	border-top-left-radius: 3dp;
	border-top-right-radius: 3dp;
}
.prompt-footer {
	top: 95dp;
	border-bottom-left-radius: 3dp;
	border-bottom-right-radius: 3dp;
}

/* Stays semantic-warning, not a crimson banner: this title IS the warning being confirmed, and
   meaning-carrying color isn't displaced by decoration. */
.prompt-title {
	position: absolute;
	left: 20dp;
	top: 15dp;
	width: 300dp;
	color: token(semantic-warning);
	font-weight: bold;
	font-family: "token(font-body)";
}

.prompt-body {
	position: absolute;
	left: 20dp;
	top: 40dp;
	width: 300dp;
	color: token(text-primary);
	white-space: normal;
	font-family: "token(font-body)";
}

.btn-ok     { left: 52dp;  top: 105dp; }
.btn-cancel { left: 180dp; top: 105dp; }
