/* Modern theme for the "remember password" confirmation -- consumes base.rcss's
   .modern-frame/.modern-frame-accent primitives plus the -crimson palette variant (applied in
   remember_password_prompt.rml) instead of its own bespoke gray panel, same nested-frame look as
   login.rcss's pilot. #panel keeps only what's genuinely structural/local (position/size/font/
   border-width/radius); background/border-color come from .modern-frame-crimson. */

/* #panel is not C++-positioned -- centered via the .center-both utility class
   (applied in remember_password_prompt.rml) instead of a live GetProperty()-read-back centering
   calc, which would never recenter on resize and would silently miscenter now that this file's
   width/height are dp, since Element::GetProperty() returns the raw declared number, not the
   resolved pixel size. Every dimension below is dp so this dialog participates in the global dp
   auto-fit like everything else. */
#panel {
	width: 340dp;
	height: 150dp;
	font-family: "token(font-body)";
	font-size: 12dp;
	color: token(text-primary);
	border-width: 1dp;
	border-radius: 3dp;
}

/* Thin accent line just inside the frame -- position/inset local, palette from
   .modern-frame-accent-crimson (applied in remember_password_prompt.rml). Same 4dp inset
   convention as login.rcss's own .frame-accent. */
.frame-accent {
	left: 4dp;
	right: 4dp;
	top: 4dp;
	bottom: 4dp;
	border-radius: 2dp;
}

.prompt-header {
	height: 31dp; /* 35dp minus the 4dp top inset .modern-header's own base rule now starts from */
	border-top-left-radius: 3dp;
	border-top-right-radius: 3dp;
}
.prompt-footer {
	top: 95dp;
	border-bottom-left-radius: 3dp;
	border-bottom-right-radius: 3dp;
}

/* Stays semantic-warning (this dialog's title IS the security warning being confirmed), not
   converted to a crimson banner: real data-meaning colors aren't displaced by decoration. */
.prompt-title {
	position: absolute;
	left: 20dp;
	top: 15dp;
	width: 300dp;
	color: token(semantic-warning);
	font-weight: bold;
	font-family: "token(font-body)";
}

.prompt-body {
	position: absolute;
	left: 20dp;
	top: 40dp;
	width: 300dp;
	color: token(text-primary);
	white-space: normal;
	font-family: "token(font-body)";
}

.btn-ok     { left: 52dp;  top: 105dp; }
.btn-cancel { left: 180dp; top: 105dp; }
