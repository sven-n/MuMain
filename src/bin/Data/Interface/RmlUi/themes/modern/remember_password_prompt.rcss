/* Modern theme for the "remember password" confirmation -- flat programmatic panel, matching
   login.rcss's modern translucent-dark-panel look. */

#panel {
	position: absolute;
	width: 340px;
	height: 150px;
	font-family: "Liberation Sans";
	font-size: 12px;
	color: #d9d3c5; /* text-body */
	background-color: rgba(26, 27, 29, 228);
	border: 1px rgba(140, 146, 152, 130); /* border-metal */
	border-radius: 10px;
}

.prompt-title {
	position: absolute;
	left: 20px;
	top: 15px;
	width: 300px;
	color: #d69a3e; /* semantic-warning */
	font-weight: bold;
}

.prompt-body {
	position: absolute;
	left: 20px;
	top: 40px;
	width: 300px;
	color: #d9d3c5; /* text-body */
	white-space: normal;
}

.btn-ok     { left: 52px;  top: 105px; }
.btn-cancel { left: 180px; top: 105px; }
