/* Modern theme for the cash shop's gift dialog (CMsgBoxIGSSendGift): legacy's layout on a flat
   panel, the fields recessed. Reference px under the dialog's root transform; each field
   counter-scales out of it. */

/* Centred on the cash shop's 640 x 429 area of the stage, 210 x 267. */
#stage { pointer-events: none; }
#panel {
	position: absolute;
	left: 215px;
	top: 81px;
	width: 210px;
	height: 267px;
	font-family: "token(font-body)";
	pointer-events: none;
}

.igs-dialog-frame { position: absolute; left: 0; top: 0; width: 210px; height: 267px; background-color: token(surface-panel); border: 1px token(border-frame); border-radius: token(radius-md)px; }
.igs-gift-icon, .igs-gift-namebox { display: none; }

.igs-dialog-line { position: absolute; left: 0; width: 210px; height: 1px; font-weight: bold; }
#igs_title { top: 10px; color: token(text-primary); }
#igs_item_info { position: absolute; left: 30px; top: 38px; width: 143px; color: token(accent-gold); }
.igs-item-info-line { position: relative; display: block; height: 12px; }
#igs_recipient_label { left: 28px; top: 87px; color: token(text-primary); font-weight: bold; }
#igs_message_label { top: 110px; color: token(text-secondary); }
#igs_notice { position: absolute; left: 0; top: 205px; width: 210px; color: token(text-muted); }
.igs-notice-line { position: relative; display: block; height: 10px; }

.igs-field {
	position: absolute;
	transform-origin: left top;
	pointer-events: auto;
	box-sizing: border-box;
	background-color: token(surface-recessed);
	border: 1px token(border-inner);
	color: token(text-primary);
}
.igs-field:focus { border-color: token(border-selected); }

/* Native's own IGS_ID_INPUT_TEXT_POS_X / _POS_Y. */
#igs_gift_id { left: 120px; top: 84px; }

/* IGS_MESSAGE_INPUT_TEXT_POS_X / _POS_Y. */
#igs_gift_message { left: 22px; top: 126px; }

.igs-dialog-buttons { position: absolute; left: 35px; top: 230px; display: flex; pointer-events: none; }
.igs-dialog-buttons .igs-btn { position: relative; flex: 0 0 52px; margin-right: 35px; }

.igs-debug { position: absolute; left: 210px; top: 10px; color: token(semantic-danger); }
.igs-debug-line { position: relative; display: block; height: 10px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
/* Inside the 76 x 17 name box at (118, 82): the original's 200-unit edit buffer showed only there. */
#igs_gift_id { width: calc(72px * var(--root-scale)); height: calc(13px * var(--root-scale)); }
#igs_gift_message { width: calc(170px * var(--root-scale)); height: calc(65px * var(--root-scale)); }
