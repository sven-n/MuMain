/* Where empire_guardian_enter.rml's own lines and buttons sit. CEmpireGuardianNPC's RenderTexts(): the headings bold in their 110-unit box centred on the panel, the warning red, the round-7 note on 200 units from x -5.
   The look they share is event_item_entry.rcss; only the rows are this document's. */

.entry-text:nth-child(1) { left: 40px; top: 13px; color: token(text-primary); font-weight: bold; }
.entry-text:nth-child(2) { left: 0px; top: 50px; color: token(text-primary); }
.entry-text:nth-child(3) { left: 0px; top: 70px; color: token(text-primary); }
.entry-text:nth-child(4) { left: 0px; top: 90px; color: token(text-primary); }
.entry-text:nth-child(5) { left: 0px; top: 110px; color: token(text-primary); }
.entry-text:nth-child(6) { left: 40px; top: 170px; color: token(accent-gold); font-weight: bold; }
.entry-text:nth-child(7) { left: 40px; top: 260px; color: token(semantic-danger); font-weight: bold; }
.entry-text:nth-child(8) { left: -5px; top: 280px; color: token(text-primary); }
.entry-text:nth-child(9) { left: -5px; top: 300px; color: token(text-primary); }
.entry-text:nth-child(10) { left: -5px; top: 320px; color: token(text-primary); }
.entry-text:nth-child(11) { left: 0px; top: 340px; color: token(text-primary); }
.entry-text:nth-child(12) { left: 0px; top: 360px; color: token(text-primary); }

.entry-btn:nth-child(1) { left: 68px; top: 190px; width: 53px; height: 23px; }

.entry-btn:nth-child(2) { left: 68px; top: 380px; width: 53px; height: 23px; }
