/* Modern theme for the login-scene menu/credit button bar -- flat programmatic icon buttons, no
   legacy sprite art. Plain single-letter monograms (M/C) stand in for icon art. */

#panel {
	position: absolute;
	font-family: "Liberation Sans";
	font-size: 14px;
}

.btn-icon {
	position: absolute;
	width: 54px;
	height: 30px;
	cursor: pointer;
	pointer-events: auto;
	background-color: rgba(255, 255, 255, 15);
	border: 1px rgba(255, 255, 255, 50);
	border-radius: 4px;
	text-align: center;
	line-height: 30px;
}
.btn-icon:hover {
	background-color: #c0a050;
	border: 1px #c0a050;
}
.btn-icon-label {
	color: white;
	font-weight: bold;
}
.btn-icon-menu {
	left: 0px;
	top: 0px;
}
.btn-icon-credit {
	top: 0px;
}

.btn-credit-deco {
	display: none;
}

.btn-credit-icon {
	display: none;
}
