/* Modern theme for the login-scene menu/credit button bar -- flat programmatic icon buttons, no
   legacy sprite art. Plain single-letter monograms (M/C) stand in for icon art.

   .btn-icon/.btn-icon-label are base.rcss's shared classes now (this file used to carry its own
   full copy, byte-identical to char_sel_main.rcss's independent copy of the same two classes --
   consolidated into one definition). Only this window's own positional classes remain below. */

#panel {
	position: absolute;
	font-family: "token(font-body)";
	font-size: 14dp;
}

.btn-icon-menu {
	left: 0;
	top: 0;
}
/* right:0dp replaces a C++-pushed `left` (LoginMainWin.cpp) -- anchors to #panel's own
   right edge instead of a computed real-pixel offset, so it tracks .btn-icon's now-dp width
   automatically instead of needing a matching C++ recompute on every resize. */
.btn-icon-credit {
	top: 0;
	right: 0dp;
}

.btn-credit-deco {
	display: none;
}

.btn-credit-icon {
	display: none;
}
