<rml>
<head>
	<title>Mix Inventory</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="mix_inventory.rcss"/>
</head>
<body data-model="mix_inventory">
	<!-- CMixInventory: the frame, the item grid, the items and the mix sparkle C++ draws live into
	     #item_view, the stack counts, title, Mix button, recipe-result content and the socket list
	     box (SyncMixContentModel(), SyncSocketListModel(), MixInventory.cpp). -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- The frame. -->
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill and accent; the title is the rail below. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{c.count}}</span></div>
		</div>
		<!-- Same header composition as MyInventory/StorageExt (base.rcss's .modern-header-rail
		     family, -px variant since #panel carries transform:scale(root_scale)). -->
		<div class="modern-header-rail-px mix-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<div class="mix-tax-rate" data-class-hidden="!show_tax_rate">{{tax_rate_text}}</div>

		<div class="mix-content" data-class-hidden="!show_recipe">
			<div class="mix-line mix-recipe-line mix-recipe" data-class-ready="recipe_ready">{{recipe_line1}}</div>
			<div class="mix-line mix-recipe-line mix-recipe" data-class-ready="recipe_ready"
			     data-class-hidden="!show_recipe_line2">{{recipe_line2}}</div>

			<div class="mix-line mix-success-rate mix-success" data-class-hidden="!show_success_rate"
			     data-class-boosted="success_boosted">{{success_rate_text}}</div>

			<div class="mix-line mix-required-zen" data-class-hidden="!show_required_zen">{{required_zen_text}}</div>

			<div class="mix-line mix-prediction" data-class-hidden="!show_prediction">{{prediction_text}}</div>

			<div class="mix-line mix-kind" data-for="s : source_lines" data-class-missing="s.kind == 'missing'" data-class-partial="s.kind == 'partial'" data-class-ready="s.kind == 'ready'" data-class-normal="s.kind == 'normal'" data-class-warning="s.kind == 'warning'" data-class-loss="s.kind == 'loss'" data-class-dim="s.kind == 'dim'">{{s.text}}</div>
			<div class="mix-line mix-kind" data-for="s : status_lines" data-class-missing="s.kind == 'missing'" data-class-partial="s.kind == 'partial'" data-class-ready="s.kind == 'ready'" data-class-normal="s.kind == 'normal'" data-class-warning="s.kind == 'warning'" data-class-loss="s.kind == 'loss'" data-class-dim="s.kind == 'dim'">{{s.text}}</div>
			<div class="mix-line mix-kind" data-for="a : advice_lines" data-class-missing="a.kind == 'missing'" data-class-partial="a.kind == 'partial'" data-class-ready="a.kind == 'ready'" data-class-normal="a.kind == 'normal'" data-class-warning="a.kind == 'warning'" data-class-loss="a.kind == 'loss'" data-class-dim="a.kind == 'dim'">{{a.text}}</div>
			<div class="mix-line mix-kind" data-for="d : description_lines" data-class-missing="d.kind == 'missing'" data-class-partial="d.kind == 'partial'" data-class-ready="d.kind == 'ready'" data-class-normal="d.kind == 'normal'" data-class-warning="d.kind == 'warning'" data-class-loss="d.kind == 'loss'" data-class-dim="d.kind == 'dim'">{{d.text}}</div>

			<div class="mix-line mix-socket-prompt" data-class-hidden="!show_socket_prompt">{{socket_prompt_text}}</div>
		</div>

		<div class="socket-list-box" data-if="show_socket_list"></div>
		<div id="socket_list" class="scroll-pane" data-if="show_socket_list"
		     data-style-width="(160 * root_scale) + 'px'"
		     data-style-height="(65 * root_scale) + 'px'"
		     data-style-font-size="11 * root_scale + 'px'"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'">
			<div class="socket-row" data-for="l : socket_lines" data-class-selected="l.selected"
			     data-style-width="(148 * root_scale) + 'px'"
			     data-style-height="(13 * root_scale) + 'px'"
			     data-event-click="mix_inventory_select_socket(l.index)">
				<div class="socket-row-back"></div>
				<span class="socket-line-text">{{l.text}}</span>
			</div>
		</div>

		<div id="btn_mix" class="modern-icon-btn-px mix-btn-mix" data-class-hidden="!mix_visible"
		     data-class-locked="mix_locked" data-event-click="mix_inventory_mix_click">
			<span class="modern-icon-btn-glyph-px">&#8644;</span>
		</div>
		<span class="tooltip tooltip-mix">{{mix_tooltip}}</span>
	</div>
</body>
</rml>
