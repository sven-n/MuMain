<rml>
<head>
	<title>My Shop Background</title>
	<link type="text/rcss" href="my_shop_bg.rcss"/>
</head>
<body data-model="my_shop_bg">
	<!-- Background-context document -- sits behind the grid's live 3D icons (native
	     C3DRenderMng interleave). Never interactive. Does NOT link base.rcss -- no *_bg.rml in
	     this theme does. -->
	<div id="bg_root" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill/accent, relocated from my_shop.rml's foreground rail --
			     see my_shop_bg.rcss's .rail-fill comment for why. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
			<!-- Edit-box background strip, relocated from my_shop.rml's foreground document --
			     see my_shop_bg.rcss's #edit_bg comment for why. -->
			<div id="edit_bg"></div>
		</div>
	</div>
</body>
</rml>
