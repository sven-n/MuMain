/* Modern theme for CGatemanWindow: docked_panel_frame.rcss's forged panel (linked first), modern
   buttons and checkbox, a locked Enter dimmed. Geometry is the legacy one (reference px under the
   dock transform). */

#panel { pointer-events: none; }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; pointer-events: none; transform-origin: left top; }

#public_toggle { position: absolute; left: 35px; top: 110px; width: 100px; height: 16px; pointer-events: auto; }
#checkbox { position: absolute; left: 0; top: 0; width: 9px; height: 9px; pointer-events: none; border: 1px token(border-frame); box-sizing: border-box; background-color: token(surface-recessed); }
#check_mark { position: absolute; left: 1px; top: 1px; width: 5px; height: 5px; pointer-events: none; background-color: token(accent-steel); }
#fee_back { position: absolute; left: 20px; top: 180px; width: 90px; height: 30px; background-color: token(surface-recessed); border-radius: token(radius-sm)px; }

.fee-btn, .gk-btn {
	position: absolute;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.fee-btn { left: 118px; width: 15px; height: 12px; }
.fee-up { top: 180px; }
.fee-down { top: 196px; }
.gk-btn { display: block; width: 53px; height: 22px; }
.fee-btn:hover, .gk-btn:hover { border-color: token(accent-steel-hover); }
.gk-btn.locked { background-color: token(surface-recessed); border-color: token(border-frame); }
.gk-label { left: 0; text-align: center; color: token(text-primary); }
.gk-btn.locked .gk-label { color: token(text-muted); }

#btn_exit {
	position: absolute;
	left: 13px;
	top: 391px;
	width: 36px;
	height: 28px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
#btn_exit:hover { border-color: token(accent-steel-hover); }

/* The window's own text. Each line is named, so the theme decides where it sits, what colour it
   is and how it is aligned; only its width and font size stay bound for the counter-scale. */
.gk-page { position: static; }
.gk-heading, .gk-line { text-align: center; }
.gk-heading { left: 15px; top: 13px; font-weight: bold; }
.gk-line { left: 0; }

#restriction { top: 50px; font-weight: bold; }
#members_1 { top: 70px; }
#members_2 { top: 80px; }
#members_3 { top: 90px; }
#open_to_non_members { left: 55px; top: 110px; }
#entrance_fee { left: 35px; top: 128px; }
#fee_setting_label { top: 158px; font-weight: bold; }
/* RT3_WRITE_RIGHT_TO_LEFT: the text ends at x 80. */
#view_fee { right: 110px; top: 190px; text-align: right; }
#fee_range { top: 248px; }
#fee_range_for { top: 261px; }
#fee_increment { top: 274px; }

#member_question { top: 50px; font-weight: bold; }

#guest_fee { top: 50px; font-weight: bold; }
#guest_pay_prompt { top: 60px; font-weight: bold; }
#guest_question { top: 70px; font-weight: bold; }
#denied_1 { top: 50px; font-weight: bold; }
#denied_2 { top: 60px; font-weight: bold; }
#denied_3 { top: 70px; font-weight: bold; }
#denied_4 { top: 80px; font-weight: bold; }

/* The master's page pushes Enter below the fee controls. */
#btn_confirm { left: 68px; top: 220px; }
#btn_enter { left: 68px; top: 100px; }
#panel.master #btn_enter { top: 320px; }

.gk-heading { color: token(text-primary); }
.gk-line, .gk-note { color: token(text-secondary); }
#fee_range, #fee_range_for, #fee_increment, #guest_pay_prompt, #guest_question { color: token(text-primary); }
#guest_fee { color: token(accent-gold); }
#guest_fee.unaffordable { color: token(semantic-danger); }
