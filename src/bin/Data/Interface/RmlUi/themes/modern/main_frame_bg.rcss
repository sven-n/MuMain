/* Background-layer companion to main_frame.rcss -- flat fills only, loaded into a separate RmlUi
   context that renders behind the legacy 3D-composited item/skill icons. */

#bg_root {
	position: absolute;
	pointer-events: none;
}

#bg_left, #bg_center {
	position: absolute;
	top: 429px;
	pointer-events: none;
	/* Same literal as main_frame.rcss's .slot-fill, duplicated to keep this context independent. */
	background-color: rgba(10, 10, 10, 150);
}

#bg_left {
	width: 152px;
	height: 41px;
}

#bg_center {
	width: 210px; /* 424 - 214, RenderCenterFrame()'s own reference-space span */
	height: 41px;
}
