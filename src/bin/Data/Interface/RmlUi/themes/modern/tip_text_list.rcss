/* Modern theme for the RenderTipTextList() tables: the same geometry and colours (the table is
   data, not chrome), in the modern body font. Reference px. */

/* #panel is a .stage (base.rcss): the original's 640x480 screen, centred at the UI scale. */
#panel { font-family: "token(font-body)"; pointer-events: none; }
.tip-box { position: absolute; }
.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: left; pointer-events: none; transform-origin: left top; }
/* A line's box is reference px; the line itself is laid out in physical px (.sharp-text). */
.tip-line { --line-width: 0px; width: calc(var(--line-width) * var(--root-scale)); }
.tip-line.centred { text-align: center; }
.tip-line.right { text-align: right; }
.tip-line.bold { font-weight: bold; }

.tip-box.border { background-color: token(border-frame); }
.tip-box.fill { background-color: token(surface-recessed); }
.tip-box.line-backdrop { background-color: token(surface-raised); }
