<rml>
<head>
	<title>Trade</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="trade.rcss"/>
</head>
<body data-model="trade">
	<!-- CTrade (Trade.h): both item grids, and the items, guild mark and warning arrow C++ draws
	     live into #item_view (RenderGuildMark(), RenderWarningArrow()). Elements below sit in the
	     gaps the grids' fixed y-offsets leave. The arrow's "Warning" text badge
	     (item_warning_badges below) is positioned per-frame from C++ since it tracks a live,
	     variable-length set of flagged item grid cells. -->
	<div id="panel" data-style---text-px="text_px + 'px'">
		<div id="frame_corner_close" data-event-click="window_close"></div>
		<!-- The frame. -->
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill and accent; the title is the rail below. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
		<!-- Where the native item grids go: invisible boxes the theme places; the window reads them each frame. -->
		<!-- The partner_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="partner_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : partner_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="partner_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : partner_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'">{{c.count}}</span></div>
		</div>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'">{{c.count}}</span></div>
		</div>
		<!-- Header rail: `-px` since #panel carries its placement's scale. -->
		<div class="modern-header-rail-px trade-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<span id="your_guild_name" class="guild-name" data-class-hidden="!your_guild_visible">{{your_guild_name}}</span>
		<span id="your_id_text" class="id-text id-text-your">{{your_id_text}}</span>
		<span id="your_level_text" class="level-text"
		      data-class-level-bucket-10="your_level_bucket == 10"
		      data-class-level-bucket-50="your_level_bucket == 50"
		      data-class-level-bucket-100="your_level_bucket == 100"
		      data-class-level-bucket-200="your_level_bucket == 200"
		      data-class-level-bucket-300="your_level_bucket == 300"
		      data-class-level-bucket-400="your_level_bucket == 400">{{your_level_text}}</span>

		<div id="your_gold_bg" class="modern-wallet-px trade-gold-your">
			<div class="modern-wallet-coin-px"></div>
			<span class="modern-wallet-label-px">Zen</span>
		</div>
		<span id="your_gold_text" class="modern-wallet-value-px trade-gold-your-value gold-amount"
		      data-class-gold-base="your_gold_tier == 'base'"
		      data-class-gold-hundred-thousand="your_gold_tier == 'hundred-thousand'"
		      data-class-gold-million="your_gold_tier == 'million'"
		      data-class-gold-ten-million="your_gold_tier == 'ten-million'">{{your_gold_text}}</span>

		<div id="your_confirm" class="trade-confirm-btn confirm-your" data-class-checked="your_confirm_checked">
			<span class="confirm-glyph">&#10003;</span>
		</div>

		<div id="divider" class="trade-divider"></div>

		<span id="my_id_text" class="id-text id-text-my">{{my_id_text}}</span>

		<div id="my_gold_bg" class="modern-wallet-px trade-gold-my">
			<div class="modern-wallet-coin-px"></div>
			<span class="modern-wallet-label-px">Zen</span>
		</div>
		<span id="my_gold_text" class="modern-wallet-value-px trade-gold-my-value gold-amount"
		      data-class-gold-base="my_gold_tier == 'base'"
		      data-class-gold-hundred-thousand="my_gold_tier == 'hundred-thousand'"
		      data-class-gold-million="my_gold_tier == 'million'"
		      data-class-gold-ten-million="my_gold_tier == 'ten-million'">{{my_gold_text}}</span>

		<div id="my_confirm" class="trade-confirm-btn confirm-my" data-class-checked="my_confirm_checked"
		     data-class-waiting="my_confirm_waiting" data-event-click="trade_my_confirm_click">
			<span class="confirm-glyph">&#10003;</span>
		</div>

		<div id="btn_exit" class="modern-icon-btn-px trade-btn-exit" data-event-click="trade_exit_click" data-attr-data-hint="close_tooltip">
			<span class="modern-icon-btn-glyph-px">&#215;</span>
		</div>

		<div id="btn_zen" class="modern-icon-btn-px trade-btn-zen" data-event-click="trade_zen_click" data-attr-data-hint="zen_tooltip">
			<span class="modern-icon-btn-glyph-px">$</span>
		</div>

		<span id="warning_label" class="warning-label" data-style-opacity="warning_opacity">{{warning_label}}</span>
		<span id="notice_line1" class="notice-line notice-line1">{{notice_line1}}</span>
		<span id="notice_line2" class="notice-line notice-line2">{{notice_line2}}</span>
		<span id="notice_line3" class="notice-line notice-line3">{{notice_line3}}</span>

		<!-- Former RenderWarningArrow()'s "Warning" text badge, one per flagged item. -->
		<div class="item-warning-badge" data-for="w : item_warning_badges"
		     data-style-left="w.x + 'px'" data-style-top="w.y + 'px'" data-style-width="w.width + 'px'">{{item_warning_text}}</div>
	</div>
</body>
</rml>
