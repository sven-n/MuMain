/* Modern theme for the character-select scene's button bar -- flat programmatic icon buttons, no
   legacy sprite art. Icon-only buttons get a short plain-ASCII label (.btn-icon-label) instead of
   real art. Positioning matches legacy's anchor-*/dp retrofit exactly.

   .btn-icon/.btn-icon-label's visual definition is base.rcss's shared version now (this file used
   to carry its own full copy, byte-identical to login_main.rcss's independent copy of the same
   two classes -- consolidated into one definition). Only this window's own positional/local
   overrides remain below: `bottom` (this button row's own placement) and the label's `font-size`
   (base.rcss's shared .btn-icon-label doesn't set one). */

#panel {
	position: absolute;
	font-family: "token(font-body)";
	font-size: 14dp;
}

.btn-icon {
	bottom: 11dp;
}
#btn_create { left: 22dp; }
#btn_menu   { left: 77dp; }
#btn_connect { right: 77dp; }
#btn_delete  { right: 22dp; }

/* font-family/size redeclared directly here (not inherited from #panel) -- this document's
   data-model bindings make inheritance silently fail for this text in this RmlUi build. */
.btn-icon-label {
	font-size: 14dp;
}

.deco {
	display: none;
}

.info-bar {
	position: absolute;
	left: 133dp;
	right: 133dp;
	bottom: 15dp;
	height: 21dp;
	background-color: rgba(0, 0, 0, 143);
	pointer-events: none;
}

#account_block_message {
	position: absolute;
	left: 0;
	top: 330dp;
	width: 640dp;
	pointer-events: none;
}
.line-row {
	line-height: 18dp;
	text-align: center;
}
.line {
	display: inline-block;
	color: token(text-warm);
	background-color: token(semantic-danger);
	white-space: nowrap;
	padding: 0 2dp;
	font-family: "token(font-body)";
}
