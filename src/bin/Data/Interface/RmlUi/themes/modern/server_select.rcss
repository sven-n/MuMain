/* Modern theme for the server-select dialog -- flat programmatic chrome, no legacy sprite art.
   Same DOM/class structure as the legacy theme (server_select.rml is shared); only the visual
   treatment differs. #panel stays invisible, matching the real legacy screen.

   Two always-visible columns laid out by real flexbox (#columns/#group_col/#server_col), not an
   absolutely-positioned flyout. #panel/#pvp_notice/#desc_panel are plain normal-flow block
   content, sized to their real children. */

/* No explicit position here -- .center-both (base.rcss) supplies position:absolute plus the
   centering math, same as sys_menu.rcss/msg_win.rcss's #panel. */
#panel {
	width: 428px;
	font-family: "token(font-body)";
	font-size: 12px;
	color: token(text-primary);
	padding: 10px;
}

/* height:300px is fixed, not auto -- #panel uses .center-both, which recenters around #panel's
   current size on every change, so an auto height here would visibly shift the whole panel as
   #columns grows/shrinks. Each column scrolls internally via overflow:auto instead. */
#columns {
	display: flex;
	flex-direction: row;
	align-items: flex-start;
	gap: 18px; /* matches the reference's own two-column gap */
	height: 300px;
}

/* height (not max-height) matches #columns' fixed height -- a shorter list centers within this
   fixed box instead of shrinking it; overflow:auto still scrolls a taller one. */
#group_col {
	display: flex;
	flex-direction: column;
	justify-content: center;
	flex-shrink: 0;
	gap: 6px; /* matches the reference's own list row gap */
	width: 140px;
	height: 300px;
	overflow: hidden auto;
}
/* The channels scroll when they don't fit (.scroll-pane, server_select.rml); the rows never
   shrink. #server_rows' auto margins center a short list and start a long one at the top. The
   column is as wide as its rows, which are all as wide as the widest (.server-row), and 8px
   wider for the scrollbar: a long channel text widens it to the right, past #panel's width if it
   must. */
#server_col {
	display: flex;
	flex-direction: column;
	flex-shrink: 0;
	height: 300px;
	padding-right: 8dp;
}
/* RmlUi sizes a column to its content without its scrollbar, so a scrollbar taking its width
   from the content would squeeze the rows again: it takes none (its margin cancels its width)
   and sits in the column's right padding. */
#server_col scrollbarvertical {
	margin-left: -8dp;
}
#server_rows {
	display: flex;
	flex-direction: column;
	gap: 6px;
	margin: auto 0;
}
#server_rows .server-row {
	flex-shrink: 0;
}
/* #server_col is an ID selector, so it always outranks base.rcss's global `.hidden{display:none}`
   on specificity alone (an ID beats any number of plain classes) -- unlike the many `.foo.hidden`
   compound overrides elsewhere in this codebase, which only break a same-specificity class-vs-class
   tie. Without this, data-class-hidden="!server_list_visible" (server_select.rml) never actually
   hid this column. */
#server_col.hidden {
	display: none;
}

/* Shared base styles supply selectable-button chrome and states. Geometry stays
   local so this theme can keep its wider rows and population bars. */
.group-btn {
	width: 140px;
	height: 30px;
	text-align: center;
	line-height: 30px;
}
/* Every row is as wide as the widest channel text in the list plus its padding (#server_rows
   stretches them), at least 218px. */
.server-row {
	display: block;
	min-width: 218px;
	height: 23px;
	padding: 3px 10px 4px;
	text-align: center;
	line-height: 14px;
	white-space: nowrap;
}
.button-label {
	pointer-events: none;
}

/* The {load} text of a full or overloaded server, in the server list's look for it. */
.server-load.load-gray { color: token(server-button-gray); }
.server-load.load-orange { color: token(server-button-orange); }
.server-load.load-silver { color: token(server-button-silver); }
.server-load.bold { font-weight: bold; }
.server-load.italic { font-style: italic; }
/* For a font without an italic face. */
.server-load.slant {
	display: inline-block;
	transform: skewX(-12deg);
}

/* Population track of ten recessed segments of 10 % each; the server list colors their lit part.
   As wide as the row's text area less 9px on each side (200px in a 218px row). */
.server-gauge-slot {
	display: flex;
	gap: 2px;
	height: 5px;
	margin: 4px 9px 0;
}
.server-gauge-segment {
	flex: 1;
	height: 100%;
	background-color: token(server-load-empty);
	box-shadow: inset 0 1px 2px rgba(0, 0, 0, 199);
}
.server-gauge-fill {
	display: block;
	height: 100%;
	box-shadow: inset 0 1px 0 rgba(255, 255, 255, 23);
}

/* Normal block flow below #columns, not position:absolute with a hand-picked top offset. */
#pvp_notice {
	margin-top: 16px;
	width: 100%;
	color: token(semantic-warning);
	font-size: 11px;
	font-family: "token(font-body)";
}

#desc_panel {
	margin-top: 10px;
	width: 100%;
	color: token(text-primary);
	white-space: normal;
	font-family: "token(font-body)";
}
