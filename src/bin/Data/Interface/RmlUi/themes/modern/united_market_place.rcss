/* Modern theme for CUnitedMarketPlaceWindow: docked_panel_frame.rcss's forged panel (linked
   first), the Warp button as a modern button, dimmed while locked. Geometry is the legacy one
   (reference px under the dock transform). */

#panel { pointer-events: auto; }

#title, .market-line, #warp_label {
	display: block;
	position: absolute;
	white-space: nowrap;
	text-align: center;
	pointer-events: none;
}
#title { left: 15px; top: 13px; font-weight: bold; color: token(text-warm); }
.market-line { left: 0; color: token(text-primary); }

#warp {
	display: block;
	position: absolute;
	left: 68px;
	top: 230px;
	width: 53px;
	height: 22px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
#warp:hover { border-color: token(accent-steel-hover); }
#warp.locked, #warp.locked:hover { background-color: token(surface-recessed); border-color: token(border-frame); }
#warp_label { left: 0; color: token(text-primary); }
#warp.locked #warp_label { color: token(text-muted); }

/* The description's own rows: every 20 units from y 60. */
.market-lines { position: static; }
.market-line:nth-child(1) { top: 60px; }
.market-line:nth-child(2) { top: 80px; }
.market-line:nth-child(3) { top: 100px; }
.market-line:nth-child(4) { top: 120px; }
.market-line:nth-child(5) { top: 140px; }
.market-line:nth-child(6) { top: 160px; }
.market-line:nth-child(7) { top: 180px; }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#title { width: calc(160px * var(--root-scale)); }
.market-line { width: calc(190px * var(--root-scale)); }
#warp_label { width: calc(53px * var(--root-scale)); }
