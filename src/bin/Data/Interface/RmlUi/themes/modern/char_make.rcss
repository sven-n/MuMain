/* Modern theme for the character-creation dialog -- flat programmatic chrome, no legacy sprite
   art. Stat/description panels share the identical treatment as legacy (already flat fills in
   the original). */

#panel {
	position: absolute;
	font-family: "Liberation Sans";
	font-size: 12px;
	color: #d9d3c5; /* text-body */
}

.job-btn {
	position: absolute;
	width: 108px;
	height: 26px;
	text-align: center;
	vertical-align: middle;
	line-height: 26px;
	cursor: pointer;
	pointer-events: auto;
	background-color: rgba(255, 244, 224, 12); /* surface-3 */
	border: 1px rgba(140, 146, 152, 130); /* border-metal */
	border-radius: 4px; /* radius-md */
	color: #d9d3c5; /* text-body */
}
.job-btn:hover {
	background-color: rgba(140, 146, 152, 60); /* accent-gold wash */
	border: 1px #c0a050; /* accent-gold */
}
.job-btn.checked {
	background-color: #c0a050; /* accent-gold */
	border: 1px #c0a050; /* accent-gold */
	color: #efe6d3; /* text-title */
}
.job-btn.disabled {
	pointer-events: none;
	color: #9a958c; /* semantic-neutral */
	cursor: default;
	background-color: rgba(255, 244, 224, 12); /* surface-3 */
	border: 1px rgba(140, 146, 152, 130); /* border-metal */
}

.stat-panel, .desc-panel {
	position: absolute;
}
.stat-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 108px;
	height: 80px;
	background-color: rgba(0, 0, 0, 143);
}
.stat-bg.tall {
	height: 96px;
}
.desc-bg {
	position: absolute;
	left: 0;
	top: 0;
	width: 454px;
	height: 51px;
	background-color: rgba(0, 0, 0, 143);
}

.stat-row {
	position: absolute;
	left: 22px;
}
.stat-label {
	color: #d9d3c5; /* text-body */
}
.stat-value {
	position: absolute;
	left: 54px;
	color: #c0a050; /* accent-gold */
}

.desc-line {
	position: absolute;
	left: 10px;
	white-space: nowrap;
}

.input-frame {
	position: absolute;
	width: 346px;
	height: 38px;
	background-color: rgba(0, 0, 0, 110);
	border: 1px rgba(140, 146, 152, 130); /* border-metal */
	border-radius: 3px; /* radius-sm */
	pointer-events: none;
}

.btn {
	position: absolute;
	width: 54px;
	height: 30px;
	cursor: pointer;
	background-color: rgba(255, 244, 224, 12); /* surface-3 */
	border: 1px rgba(140, 146, 152, 130); /* border-metal */
	border-radius: 4px; /* radius-md */
	pointer-events: auto;
}
.btn:hover {
	background-color: #c0a050; /* accent-gold */
	border: 1px #c0a050; /* accent-gold */
}
