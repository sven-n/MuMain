/* Keep the map artwork's proportions and vertical anchor in step with the legacy theme.
   dp makes the entry banner follow UI scale. */

body { pointer-events: none; }

#banner { top: 45.8333%; width: 166dp; height: 90dp; pointer-events: none; }
#name { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
#strife { position: absolute; left: 0; top: -28dp; width: 100%; height: 28dp; }
