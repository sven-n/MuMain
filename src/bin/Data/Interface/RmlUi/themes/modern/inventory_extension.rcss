/* Modern theme for CInventoryExtension's chrome -- header/exit-button are vector forged-metal
   chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-dialog language). Extension
   grids stay fully native (sprite art + live 3D icons), same as legacy -- no RmlUi involvement
   there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:7/height:37 -- top matches MyInventory/SysMenu's own rail top exactly (so
   .modern-joint-px's rivet sits at the same -1px relative to the frame's shell-edge at -3px in
   the frame -- same contained relationship as those windows). Height trimmed to
   37 (not MyInventory's 36, not SysMenu/StorageExt's own values) because this window's first
   extension grid starts at `m_Pos.y + 45` (InventoryExtension.cpp) -- ends at 44px, 1px clear. */
.ext-header-rail {
	top: 7px;
	height: 37px;
}

/* Single exit button, centered: (190-37)/2. */
.ext-btn-exit {
	left: 77px;
	color: #d59b79;
	border-color: #5c382b;
}

.tooltip {
	display: none;
	position: absolute;
	top: 376px;
	left: 40px;
	width: 120px;
	white-space: nowrap;
	background-color: token(surface-tooltip);
	border: 1px token(border-frame);
	color: token(text-primary);
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "token(font-body)";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
#btn_exit:hover ~ .tooltip-exit { display: block; }

/* Locked (not-yet-purchased) page badge -- vector tile instead of legacy's raster lock-number
   sprite, matching this theme's forged-metal chrome language (same dimmed-tile idea as
   base.rcss's .modern-icon-btn-px.locked). Footprint matches the native placeholder area this
   overlays (RenderImage(IMAGE_EXTENSION_NO.., x+85, ..., 25, 28) in InventoryExtension.cpp) so it
   lines up with the still-native table/empty-slot backing art around it. */
.ext-locked-page {
	position: absolute;
	left: 85px;
	width: 25px;
	height: 28px;
	pointer-events: none;
}
.ext-locked-badge {
	position: absolute;
	left: 0;
	top: 0;
	width: 25px;
	height: 28px;
	text-align: center;
	line-height: 28px;
	color: token(text-secondary);
	font-family: "token(font-title)";
	font-size: 13px;
	font-weight: 500;
	background-color: #13140f;
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow:
		inset 0 1px 0 rgba(232, 215, 168, 12),
		inset 0 -1px 0 #000000;
	opacity: 0.75;
	pointer-events: none;
}

/* Each locked page's own row (71 + HEIGHT_PER_EXT per page). The pages shown are sparse, so a row
   is identified by which page it is rather than by its place in the list. */
.ext-locked-page.page-1 { top: 71px; }
.ext-locked-page.page-2 { top: 158px; }
.ext-locked-page.page-3 { top: 245px; }
.ext-locked-page.page-4 { top: 332px; }

/* Native item grids: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid_1, #item_grid_1_counts { left: 15px; top: 45px; width: 160px; height: 80px; }
#item_grid_2, #item_grid_2_counts { left: 15px; top: 132px; width: 160px; height: 80px; }
#item_grid_3, #item_grid_3_counts { left: 15px; top: 219px; width: 160px; height: 80px; }
#item_grid_4, #item_grid_4_counts { left: 15px; top: 306px; width: 160px; height: 80px; }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .ext-header-rail (inventory_extension.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 37px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}
