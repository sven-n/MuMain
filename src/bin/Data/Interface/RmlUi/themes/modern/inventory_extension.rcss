/* Modern theme for CInventoryExtension's chrome -- header/exit-button are vector forged-metal
   chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-dialog language). The grids'
   items stay live 3D, drawn by C++. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* top:7/height:37 -- top matches MyInventory/SysMenu's own rail top exactly (so
   .modern-joint-px's rivet sits at the same -1px relative to the frame's shell-edge at -3px in
   the frame -- same contained relationship as those windows). Height trimmed to
   37 (not MyInventory's 36, not SysMenu/StorageExt's own values) because this window's first
   extension grid starts at `m_Pos.y + 45` (InventoryExtension.cpp) -- ends at 44px, 1px clear. */
.ext-header-rail {
	top: 7px;
	height: 37px;
}

/* Single exit button, centered: (190-37)/2. */
.ext-btn-exit {
	left: 77px;
	color: #d59b79;
	border-color: #5c382b;
}

/* Locked (not-yet-purchased) page badge -- vector tile instead of legacy's raster lock-number
   sprite, matching this theme's forged-metal chrome language (same dimmed-tile idea as
   base.rcss's .modern-icon-btn-px.locked). Footprint and place match legacy's 25x28 lock
   glyph on its page's table art. */
/* A locked page's table and empty-slot art: the original's 173x87 and 161x81 from each image's
   top-left. */
@spritesheet ext-table-sheet { src: "../../../newui_item_add_table.tga"; ext-table: 0px 0px 173px 87px; }
@spritesheet ext-empty-sheet { src: "../../../newui_item_add_marking_non.jpg"; ext-empty: 0px 0px 161px 81px; }
.ext-locked-empty {
	position: absolute;
	left: 4px;
	top: 3px;
	width: 161px;
	height: 81px;
	pointer-events: none;
	decorator: image(ext-empty);
}

.ext-locked-page {
	position: absolute;
	left: 11px;
	width: 173px;
	height: 87px;
	pointer-events: none;
	decorator: image(ext-table);
}
.ext-locked-badge {
	position: absolute;
	left: 74px;
	top: 29px;
	width: 25px;
	height: 28px;
	text-align: center;
	line-height: 28px;
	color: token(text-secondary);
	font-family: "token(font-title)";
	font-size: 13px;
	font-weight: 500;
	background-color: #13140f;
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	box-shadow:
		inset 0 1px 0 rgba(232, 215, 168, 12),
		inset 0 -1px 0 #000000;
	opacity: 0.75;
	pointer-events: none;
}

/* Each locked page's own row (42 + 87 per page). The pages shown are sparse, so a row
   is identified by which page it is rather than by its place in the list. */
.ext-locked-page.page-1 { top: 42px; }
.ext-locked-page.page-2 { top: 129px; }
.ext-locked-page.page-3 { top: 216px; }
.ext-locked-page.page-4 { top: 303px; }

/* Native item grids: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid_1, #item_grid_1_counts { left: 15px; top: 45px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }
#item_grid_2, #item_grid_2_counts { left: 15px; top: 132px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }
#item_grid_3, #item_grid_3_counts { left: 15px; top: 219px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }
#item_grid_4, #item_grid_4_counts { left: 15px; top: 306px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match .ext-header-rail (inventory_extension.rcss). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 37px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
