/* Modern theme for CHelpWindow -- the key and chat help pages in the modern tooltip's surface
   (themes/modern/tooltip.rcss): same fill, frame, radius and text tokens. The box keeps the
   original's place and row metrics; reference px on the .stage. */

#panel { pointer-events: none; }

#help_panel {
	position: absolute;
	left: 0px;
	top: 1px;
	--text-width: 0px;
	width: var(--text-width);
	padding: 3px 5px;
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	background-color: token(surface-tooltip);
}

/* display:block required -- RmlUi's default `display` is inline, even for a <div>. */
/* RenderTipTextList()'s rows: one line height, the next row 1.1 of them below; a half spacer
   takes half of that advance. */
.help-line {
	display: block;
	position: relative;
	height: var(--line-height, 0px);
	margin-bottom: calc(var(--line-height, 0px) * 0.1);
}
.help-line.heading {
	height: var(--bold-line-height, 0px);
	margin-bottom: calc(var(--bold-line-height, 0px) * 0.1);
}
.help-line.half-spacer {
	height: calc(var(--line-height, 0px) * 0.55);
	margin-bottom: 0px;
}
/* The row is reference px; its text is laid out in physical px (.sharp-text). */
.help-text {
	display: block;
	position: absolute;
	white-space: nowrap;
	left: 0px;
	top: 0px;
	width: calc(var(--text-width) * var(--root-scale));
	line-height: calc(var(--line-height, 0px) * var(--root-scale));
	text-align: center;
	color: token(text-primary);
	font-family: "token(font-body)";
}
.help-line.heading .help-text {
	line-height: calc(var(--bold-line-height, 0px) * var(--root-scale));
	color: token(text-warm);
	font-weight: bold;
}
