<rml>
<head>
	<title>Generic Confirm Dialog</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="generic_confirm_dialog.rcss"/>
</head>
<body>
	<!-- Modern theme's own copy of the generic confirm dialog -- per-theme file since the
	     forged-dialog shell structure differs by theme. Keep ids/data-model/event-callback names
	     in sync with ../../generic_confirm_dialog.rml.

	     #panel's own paint (background/border/box-shadow), the shell-edge/groove, and the well's
	     recessed fill all moved to generic_confirm_dialog_bg.rml -- a background-context document
	     rendered BEFORE the 3D pass that draws item3D each frame, so item3D shows through this
	     now-paint-less #panel instead of being painted over by it. -->
	<div id="panel" class="center-both" data-model="generic_confirm_dialog" data-class-tall="has_tall_panel">
		<!-- data-class-has-title: with a title shown, .gcd-body reserves the header's own space
		     as padding-top instead of stacking it as a flex sibling of .gcd-content-row -- see
		     .rcss's own comment for why (keeps content-row's own centering scoped to the space
		     actually left below the header, not the whole box). -->
		<div class="gcd-body" data-class-has-title="has_title">
			<!-- See ../../generic_confirm_dialog.rml's own comment for why this banner collapses
			     to nothing when untitled, and why .gcd-content-row below is nested one level down
			     -- keep both fork copies' structure in sync. -->
			<div class="gcd-header-rail" data-class-hidden="!has_title" data-class-warning="severity_warning"
			     data-class-error="severity_error">
				<!-- Rivet + accent line (plain/warning look, base.rcss's .modern-joint/
				     .modern-header-accent) vs twin side studs (error look, login.rcss's
				     .login-hero-cap) -- mutually exclusive. Literal sibling divs, not
				     ::before/::after -- this engine doesn't support generated content. -->
				<div class="gcd-header-joint" data-class-hidden="severity_error"></div>
				<div class="gcd-header-accent" data-class-hidden="severity_error"></div>
				<div class="gcd-header-cap gcd-header-cap-left" data-class-hidden="!severity_error"></div>
				<div class="gcd-header-cap gcd-header-cap-right" data-class-hidden="!severity_error"></div>
				<span class="gcd-header-title">{{title}}</span>
			</div>
			<div class="gcd-content-row">
				<!-- See ../../generic_confirm_dialog.rml's own comment for why gcd_item3d_anchor
				     is a flex sibling of .gcd-text-col (icon-left/text-right), not a member of it
				     -- keep both fork copies' structure in sync. -->
				<div id="gcd_item3d_anchor" class="gcd-item3d-anchor layout-anchor" data-class-hidden="!has_item3d"></div>
				<!-- See ../../generic_confirm_dialog.rml's own comment for Portrait2D's Beside
				     layout -- keep both fork copies' structure in sync. -->
				<div class="gcd-portrait2d gcd-portrait2d-beside" data-class-hidden="!has_portrait2d_beside"></div>
				<div class="gcd-text-col">
					<!-- See ../../generic_confirm_dialog.rml's own comment for what this
					     reproduces and why it nests inside .gcd-text-col instead of beside it
					     like #gcd_item3d_anchor -- keep both fork copies' structure in sync. -->
					<div class="gcd-portrait2d" data-class-hidden="!has_portrait2d_overlay">
						<div class="gcd-portrait2d-text">{{portrait2d_text}}</div>
					</div>
					<div class="gcd-line" data-for="line : lines" data-class-bold="line.bold">{{line.text}}</div>
					<div class="gcd-input-row" data-class-hidden="!has_input">
						<div class="gcd-keypad-display" data-class-hidden="!input_is_keypad">{{input_text}}</div>
						<div class="gcd-keypad-grid" data-class-hidden="!input_is_keypad">
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(0)">{{keypad_digit_0}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(1)">{{keypad_digit_1}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(2)">{{keypad_digit_2}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(3)">{{keypad_digit_3}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(4)">{{keypad_digit_4}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(5)">{{keypad_digit_5}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(6)">{{keypad_digit_6}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(7)">{{keypad_digit_7}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(8)">{{keypad_digit_8}}</div>
							<div class="btn gcd-keypad-btn" data-event-click="gcd_keypad_click(9)">{{keypad_digit_9}}</div>
							<div class="btn gcd-keypad-delete" data-event-click="gcd_keypad_delete_click">Del</div>
						</div>
						<!-- Text mode: a stock RmlUi <input>. Its type (text/password), maxlength and
						     seeded value are set per Show() from C++ (ApplyInputFieldConfig()), since
						     this dialog is shared and reconfigured per caller. Numeric-only filtering
						     is an application rule, enforced in C++ (DigitOnlyInputFilter). -->
						<input id="gcd_input" type="text" class="text-field gcd-input-field"
						       data-value="input_value" data-class-hidden="input_is_keypad"/>
					</div>
					<div class="gcd-progress-track" data-class-hidden="!has_progress">
						<div class="gcd-progress-fill" data-style-width="progress_fraction * 100 + '%'"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="gcd-footer modern-footer"></div>
		<!-- See ../../generic_confirm_dialog.rml's own comment for the 3-slot role model and
		     solo/paired/triple layout logic -- keep both fork copies' structure in sync. -->
		<div id="gcd_btn_primary" class="btn btn-ok gcd-btn-primary"
		     data-class-solo="!has_secondary &amp;&amp; !show_cancel"
		     data-class-triple="has_secondary &amp;&amp; show_cancel"
		     data-class-hidden="has_progress" data-event-click="gcd_primary_click">{{primary_label}}</div>
		<div id="gcd_btn_secondary" class="btn gcd-btn-secondary"
		     data-class-triple="has_secondary &amp;&amp; show_cancel"
		     data-class-hidden="!has_secondary || has_progress"
		     data-event-click="gcd_secondary_click">{{secondary_label}}</div>
		<div id="gcd_btn_cancel" class="btn gcd-btn-cancel"
		     data-class-triple="has_secondary &amp;&amp; show_cancel"
		     data-class-hidden="!show_cancel || has_progress"
		     data-event-click="gcd_cancel_click">{{cancel_label}}</div>
	</div>
</body>
</rml>
