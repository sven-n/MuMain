<rml>
<head>
	<title>System Menu</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="sys_menu.rcss"/>
</head>
<body>
	<!-- Modern theme's own copy of the system menu -- per-theme file since modern-frame is
	     modern-specific structure, not just style. .panel-cap-top/.panel-middle/.panel-cap-bottom
	     stay in the markup but render as nothing here (no matching rule in modern's rcss, unlike
	     legacy's sprite-backed versions). Keep ids/data-model/event-callback names in sync with
	     ../../sys_menu.rml.

	     Uses base.rcss's shared dialog shell with the metal .modern-header-rail + single
	     .modern-joint rivet, not Login's crimson hero-banner -- the two header styles are never
	     combined, and this dialog has no -crimson variant since crimson belongs to the hero-banner
	     only. -->
	<div id="backdrop"></div>
	<div id="panel" class="center-both modern-frame" data-class-compact="select_server_hidden" data-model="sys_menu">
		<div id="panel_middle" class="panel-middle"></div>
		<!-- Exterior silhouette + inner groove -- same shell as Login's #panel, applied to a
		     plain (non-crimson) frame. -->
		<div class="modern-shell-edge"></div>
		<div class="modern-groove"></div>

		<!-- Raised header rail with a single center-rivet stud and the title text -- no separate
		     "System" eyebrow, redundant with the title. -->
		<div class="modern-header-rail">
			<div class="modern-joint"></div>
			<div class="modern-header-accent"></div>
			<div class="modern-header-text">
				<div class="modern-header-title">{{system_menu_label}}</div>
			</div>
		</div>

		<div class="panel-cap-top"></div>
		<div class="panel-cap-bottom"></div>
		<div id="btn_exit_game" class="btn" data-event-click="sysmenu_exit_game_click">{{exit_game_label}}</div>
		<div id="btn_select_server" class="btn" data-class-hidden="select_server_hidden" data-event-click="sysmenu_select_server_click">{{select_server_label}}</div>
		<div id="btn_option" class="btn" data-event-click="sysmenu_option_click">{{option_label}}</div>
		<div id="btn_close" class="btn" data-event-click="sysmenu_close_click">{{close_label}}</div>
	</div>
</body>
</rml>
