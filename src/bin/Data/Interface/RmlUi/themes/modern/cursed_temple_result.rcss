/* Modern theme for CCursedTempleResult: the modern panel surface instead of the message-box art,
   a modern Close button, the hero's row in the steel accent; the banner art stays. Geometry is
   the legacy one (reference px under the Dialog transform). */

@spritesheet result-success-sheet { src: "../../../illusion_success.tga"; result-success: 0px 0px 351px 115px; }
@spritesheet result-failure-sheet { src: "../../../illusion_failure.tga"; result-failure: 0px 0px 351px 115px; }

#panel {
	position: absolute;
	transform-origin: left top;
	width: 230px;
	height: 282px;
	font-family: "token(font-body)";
	background-color: token(surface-panel);
	border: 1px token(border-frame);
	pointer-events: auto;
}

#back, #frame_top, .frame-middle, #frame_bottom { display: none; }
.line { position: absolute; left: 10px; width: 210px; height: 1px; margin-top: 10px; background-color: token(border-frame); }

.result-banner { position: absolute; top: -110px; width: 351px; height: 115px; pointer-events: none; }
.result-banner.success { decorator: image(result-success); }
.result-banner.failure { decorator: image(result-failure); }

.hero-row { position: absolute; left: 2px; width: 220px; background-color: token(accent-steel); pointer-events: none; }

.sharp-text { display: block; position: absolute; white-space: pre; text-align: center; pointer-events: none; transform-origin: left top; }
.result-text.cell { text-align: left; }

.result-btn {
	display: block;
	position: absolute;
	left: 88px;
	top: 245px;
	width: 54px;
	height: 22px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.result-btn:hover { border-color: token(accent-steel-hover); }
.result-btn:active { background-color: token(surface-recessed); }
.result-label { left: 0; color: token(text-primary); }
