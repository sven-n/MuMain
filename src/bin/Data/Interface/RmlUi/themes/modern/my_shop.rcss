/* Modern theme for CMyShopInventory's chrome -- header/shop-name field/buttons are vector
   forged-metal chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-dialog language).
   Only the inventory grid stays native, same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* No .modern-header-rail-px override -- the default (top:7/height:38) already clears this
   window's grid start (`m_Pos.y + 90`) and the edit-box strip below it. */

/* Shop-name field: placement/size only -- the forged-metal fill, border and focus/error/disabled
   states all come from base.rcss's shared .text-field. Same 169x26 @ (12,49) box the #edit_bg strip
   occupied before the field itself became RmlUi; padding-left keeps the first glyph where the native
   CUITextInputBox drew it (SetPosition(m_Pos.x + 50, ...)). */
.my-shop-title-field {
	position: absolute;
	left: 12px;
	top: 49px;
	width: 169px;
	height: 26px;
	padding: 6px 6px 0 38px;
	font-size: 12px;
}

/* Buttons: base.rcss's shared .modern-icon-btn-px family at its default 37x26/top:392 geometry --
   only left offsets differ (13/53/93, this window's own native spacing). */
.shop-btn-exit  { left: 13px; color: #d59b79; border-color: #5c382b; }
.shop-btn-open  { left: 53px; }
.shop-btn-close { left: 93px; }

.tooltip {
	display: none;
	position: absolute;
	top: 376px;
	width: 120px;
	white-space: nowrap;
	background-color: token(surface-tooltip);
	border: 1px token(border-frame);
	color: token(text-primary);
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "token(font-body)";
	font-size: 11px;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit  { left: -27px; }
.tooltip-open  { left: 12px; }
.tooltip-close { left: 52px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_open:hover ~ .tooltip-open,
#btn_close:hover ~ .tooltip-close {
	display: block;
}

/* Former RenderTextInfo() -- same reference-pixel offsets the native RenderText() calls used. */
.myshop-line {
	position: absolute;
	left: 30px;
	font-family: "token(font-body)";
	font-size: 12px;
}
.myshop-line-still-opening {
	left: 0;
	top: 200px;
	width: 190px;
	text-align: center;
	color: token(text-warm);
	font-weight: bold;
}
.myshop-line-warning { color: token(semantic-danger); font-weight: bold; }
.myshop-line-info { color: token(text-warm); }

#warning_line { top: 230px; }
#selling_price_line { top: 250px; }
#please_verify_line { top: 262px; }
#already_in_store_line { top: 274px; }
#cancel_sold_line { top: 286px; }
#cant_be_returned_line { top: 298px; }
#all_item_trading_line { top: 320px; }
#can_only_be_done_using_zen_line { top: 332px; }
