/* Modern theme for CMyShopInventory's chrome -- header/shop-name field/buttons are vector
   forged-metal chrome (matching Login/SysMenu/MyInventory/StorageExt's forged-dialog language).
   Only the inventory grid stays native, same as legacy -- no RmlUi involvement there. */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	font-family: "token(font-body)";
}

/* No .modern-header-rail-px override -- the default (top:7/height:38) already clears this
   window's grid start (`m_Pos.y + 90`) and the edit-box strip below it. */

/* Shop-name field: placement/size only -- the forged-metal fill, border and focus/error/disabled
   states all come from base.rcss's shared .text-field. Same 169x26 @ (12,49) box the #edit_bg strip
   occupied before the field itself became RmlUi; padding-left keeps the first glyph where the native
   CUITextInputBox drew it (SetPosition(m_Pos.x + 50, ...)). */
.my-shop-title-field {
	position: absolute;
	left: 12px;
	top: 49px;
	width: 169px;
	height: 26px;
	padding: 6px 6px 0 38px;
	font-size: 12px;
}

/* Buttons: base.rcss's shared .modern-icon-btn-px family at its default 37x26/top:392 geometry --
   only left offsets differ (13/53/93, this window's own native spacing). */
.shop-btn-exit  { left: 13px; color: #d59b79; border-color: #5c382b; }
.shop-btn-open  { left: 53px; }
.shop-btn-close { left: 93px; }

/* Former RenderTextInfo() -- same reference-pixel offsets the native RenderText() calls used. */
.myshop-line {
	position: absolute;
	left: 30px;
	font-family: "token(font-body)";
	font-size: 12px;
}
.myshop-line-still-opening {
	left: 0;
	top: 200px;
	width: 190px;
	text-align: center;
	color: token(text-warm);
	font-weight: bold;
}
.myshop-line-warning { color: token(semantic-danger); font-weight: bold; }
.myshop-line-info { color: token(text-warm); }

#warning_line { top: 230px; }
#selling_price_line { top: 250px; }
#please_verify_line { top: 262px; }
#already_in_store_line { top: 274px; }
#cancel_sold_line { top: 286px; }
#cant_be_returned_line { top: 298px; }
#all_item_trading_line { top: 320px; }
#can_only_be_done_using_zen_line { top: 332px; }

/* Native item grid: the first cell's top-left, in #panel's units. */
.native-anchor { position: absolute; pointer-events: none; }
#item_grid, #item_grid_counts { left: 16px; top: 90px; width: calc(8 * var(--item-cell)); height: calc(4 * var(--item-cell)); }

/* The frame. */
.bg-panel {
	position: absolute;
	left: 0;
	top: 0;
	width: 190px;
	height: 429px;
	pointer-events: none;
	border-radius: token(radius-sm)px;
	background-color: #080a08;
	decorator: linear-gradient(to bottom, #11130f 0%, #080a08 100%);
	border-width: 1px;
	border-color: token(border-frame);
	box-shadow:
		0 11px 30px rgba(0, 0, 0, 158),
		0 2px 5px rgba(0, 0, 0, 217),
		inset 0 0 0 1px #090a08,
		inset 0 0 0 3px rgba(120, 115, 90, 190);
}

.inv-shell-edge {
	position: absolute;
	left: -3px;
	right: -3px;
	top: -3px;
	bottom: -3px;
	pointer-events: none;
	background-color: transparent;
	border-radius: token(radius-sm)px;
	border-width: 1px;
	border-color: rgba(31, 31, 26, 242);
	box-shadow:
		inset 1px 0 0 rgba(130, 121, 91, 110),
		inset -1px 0 0 rgba(0, 0, 0, 204),
		inset 0 1px 0 rgba(151, 139, 101, 90),
		inset 0 -1px 0 rgba(0, 0, 0, 230);
}

.inv-groove {
	position: absolute;
	left: 4px;
	right: 4px;
	top: 4px;
	bottom: 4px;
	pointer-events: none;
	border-width: 1px;
	border-color: #24261f;
	box-shadow:
		inset 0 0 0 1px rgba(121, 112, 83, 40),
		inset 0 0 12px rgba(0, 0, 0, 153);
}

/* Rail fill/accent relocated from the fg's now paint-less .modern-header-rail-px -- see
   base.rcss's comment on that class. top/height match its default (my_shop.rcss has no override). */
.rail-fill {
	position: absolute;
	left: 8px;
	right: 8px;
	top: 7px;
	height: 38px;
	pointer-events: none;
	background-color: token(metal-dark);
	decorator:
		linear-gradient(to bottom, rgba(205, 184, 129, 13), transparent 31%),
		linear-gradient(to bottom, token(metal-rail), #171813 45%, token(metal-rail-dark));
	border-width: 1px;
	border-color: token(border-rail);
	border-bottom-color: #171812;
	box-shadow:
		inset 0 1px 0 rgba(235, 218, 169, 18),
		inset 0 -1px 0 #000000,
		0 2px 4px rgba(0, 0, 0, 133);
}
/* Nested inside .rail-fill -- its left/right/bottom resolve against that box. */
.rail-accent {
	position: absolute;
	left: 7px;
	right: 7px;
	bottom: 2px;
	height: 1px;
	pointer-events: none;
	opacity: 0.35;
	decorator: linear-gradient(to right,
		transparent,
		token(metal-warm-edge) 30%,
		#84754e 50%,
		token(metal-warm-edge) 70%,
		transparent);
}

/* The grid's clicks are native (CInventoryCtrl), so the placed panel takes no pointer events; its
   controls take their own. */
#panel.slot-placed { pointer-events: none; }
/* The frame's corner close (the original's 13x12 at 169,7). */
#frame_corner_close { position: absolute; top: 7px; right: 8px; width: 13px; height: 12px; cursor: pointer; pointer-events: auto; }
