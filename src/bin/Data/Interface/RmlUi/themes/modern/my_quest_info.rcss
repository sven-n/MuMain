/* Modern theme for CMyQuestInfoWindow -- flat/token styling for common chrome, but Open/Give-up
   are quest-specific actions with no generic equivalent (unlike Exit, an ordinary close button),
   so they reuse legacy's own sprites here rather than inventing a flat placeholder for them --
   same file/rect legacy's own theme declares (theme-local duplication, this codebase's own
   convention, see credit_win.rcss's own comment). Same positioning as legacy otherwise (see that
   file's own header comment for where the values come from and why the content-area layout is a
   reinterpretation, not a literal legacy-pixel carryover). */
@spritesheet myquest-btn-open-sheet   { src: "../../../Quest_Bt_open.tga"; myquest-btn-open:   0px 0px 36px 29px; }
@spritesheet myquest-btn-giveup-sheet { src: "../../../Quest_Bt_cast.tga"; myquest-btn-giveup: 0px 0px 36px 29px; }

#panel {
	position: absolute;
	transform-origin: left top;
	width: 190px;
	height: 429px;
	background-color: token(surface-1);
	border: 1dp token(border-metal);
	border-radius: token(radius-md)dp;
	font-family: "token(font-body)";
}

.frame-piece { display: none; }

#title {
	position: absolute;
	left: 0;
	top: 12px;
	width: 190px;
	text-align: center;
	color: token(text-title);
	font-weight: bold;
	font-size: 12px;
}

.tab-row {
	position: absolute;
	left: 10px;
	top: 27px;
	width: 166px;
	height: 22px;
	background-color: token(surface-2);
	border-radius: token(radius-sm)dp;
}
.tab-btn {
	position: absolute;
	top: 0;
	height: 22px;
	text-align: center;
	line-height: 22px;
	font-size: 12px;
	color: token(text-muted);
	cursor: pointer;
	pointer-events: auto;
	white-space: nowrap;
	overflow: hidden;
}
.tab-btn.active { color: token(text-title); background-color: token(accent-steel); border-radius: token(radius-sm)dp; }
.tab-btn-quest { left: 0; width: 48px; }
.tab-btn-jobchange { left: 48px; width: 48px; }
.tab-btn-castletemple { left: 96px; width: 72px; }

.quest-tab, .jobchange-tab, .castletemple-tab {
	position: absolute;
	left: 9px;
	top: 60px;
	width: 172px;
	height: 320px;
}
.hidden { display: none; }

/* display:block on every non-absolutely-positioned element below is load-bearing -- see
   my_quest_info.rcss's (legacy theme) own header comment for why. */
.quest-empty-msg {
	position: absolute;
	left: 14px;
	top: 30px;
	width: 140px;
	color: token(accent-gold-bright);
	font-weight: bold;
	font-size: 12px;
	text-align: left;
}
.quest-empty-msg span { display: block; }

.quest-list {
	position: absolute;
	left: 0;
	top: 0;
	width: 172px;
	height: 130px;
	overflow: auto hidden;
}
.quest-row {
	display: block;
	width: 100%;
	height: 18px;
	line-height: 18px;
	padding-left: 4px;
	color: token(text-body);
	font-size: 12px;
	cursor: pointer;
	pointer-events: auto;
	white-space: nowrap;
}
.quest-row:hover { color: token(accent-gold-bright); }
.quest-row.selected { color: token(accent-gold-bright); font-weight: bold; background-color: token(surface-2); }

.quest-divider {
	position: absolute;
	left: 0;
	top: 130px;
	width: 172px;
	height: 21px;
	border-top: 1dp token(border-metal);
}

.quest-contents {
	position: absolute;
	left: 0;
	top: 151px;
	width: 172px;
	height: 169px;
	background-color: token(surface-2);
	border-radius: token(radius-sm)dp;
	overflow: auto hidden;
}
.quest-content-row {
	display: block;
	width: 100%;
	padding: 1px 4px;
	font-size: 12px;
	color: token(text-body);
}
.quest-content-row.bold { font-weight: bold; }
.quest-content-row.clickable { cursor: pointer; pointer-events: auto; }
.quest-content-row.clickable:hover { color: token(accent-gold-bright); }

.quest-btn, .quest-btn-exit {
	position: absolute;
	top: 392px;
	width: 36px;
	height: 29px;
	cursor: pointer;
	pointer-events: auto;
}
/* Same brightness-filter hover this codebase already uses uniformly regardless of whether a
   button has a sprite decorator or a flat background (my_inventory.rcss's own .inv-btn:hover
   precedent) -- works identically on top of either. */
.quest-btn:hover, .quest-btn-exit:hover { filter: brightness(1.25); }
/* No pointer-events:none here -- see legacy theme's own comment on this same rule for why
   (locked would otherwise block :hover, and with it the tooltip, for as long as the button
   starts locked -- the default state until a quest is selected). */
.quest-btn.locked { filter: brightness(0.6); }

.quest-btn-open { left: 50px; decorator: image(myquest-btn-open); }
.quest-btn-giveup { left: 87px; decorator: image(myquest-btn-giveup); }

/* Exit is a common close button, not a quest-specific one -- flat/token chrome plus a word/glyph
   (the shared RML's .btn-exit-label span) instead of reusing legacy's sprite, unlike Open/Give-up
   above. */
.quest-btn-exit {
	left: 13px;
	background-color: token(surface-3);
	border: 1dp token(border-metal);
	border-radius: token(radius-sm)dp;
}
.btn-exit-label {
	display: block;
	width: 100%;
	height: 100%;
	text-align: center;
	line-height: 29px;
	font-weight: bold;
	font-size: 14px;
	color: token(text-body);
}

/* Tooltips: siblings of their trigger button -- same convention my_inventory.rcss's own
   #btn_exit/.tooltip-exit already establishes. */
.tooltip {
	display: none;
	position: absolute;
	top: 365px;
	width: 110px;
	white-space: nowrap;
	background-color: rgba(20, 21, 22, 230);
	border: 1px token(accent-steel-bright);
	color: token(text-body);
	padding: 2px 4px;
	border-radius: 3px;
	font-family: "token(font-body)";
	font-size: 11px;
	text-align: center;
	pointer-events: none;
	z-index: 1;
}
.tooltip-exit   { left: -24px; }
.tooltip-open   { left: 13px; }
.tooltip-giveup { left: 50px; }

#btn_exit:hover ~ .tooltip-exit,
#btn_quest_open:hover ~ .tooltip-open,
#btn_quest_giveup:hover ~ .tooltip-giveup {
	display: block;
}

.jobchange-title {
	display: block;
	text-align: center;
	width: 172px;
	color: token(accent-steel-bright);
	font-weight: bold;
	font-size: 12px;
	margin-bottom: 8px;
}
.jobchange-contents, .jobchange-state {
	display: block;
	text-align: center;
	width: 172px;
	color: token(text-body);
	font-size: 12px;
}
.jobchange-contents span, .jobchange-state span { display: block; }
.jobchange-state { color: token(accent-gold-bright); font-weight: bold; margin-top: 12px; }

.castle-title, .temple-title {
	display: block;
	text-align: center;
	width: 172px;
	color: token(accent-gold-bright);
	font-weight: bold;
	font-size: 12px;
	margin-top: 6px;
}
.castle-line, .temple-line {
	display: block;
	text-align: center;
	width: 172px;
	color: token(text-body);
	font-size: 12px;
}
