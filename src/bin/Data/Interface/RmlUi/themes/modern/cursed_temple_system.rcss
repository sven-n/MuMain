/* Modern theme for CCursedTempleSystem: the Illusion Temple art has no modern counterpart yet, so it
   keeps the legacy theme's images, geometry and colours (see themes/legacy/cursed_temple_system.rcss). */

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
	font-family: "token(font-body)";
}

.sprite { position: absolute; }

.tutorial-line {
	display: block;
	position: absolute;
	left: 140px;
	transform-origin: left top;
	white-space: nowrap;
}

/* The HUD's own frames, in the original's places. */
@spritesheet ct-hud-sheet
{
	src: "../../../newui_ctgametimeframe.tga";
	ct-game-time-frame: 0px 0px 134px 37px;
}
@spritesheet ct-dot-sheet { src: "../../../dot.tga"; ct-dot: 0px 0px 3px 9px; }
@spritesheet ct-skill-frame-sheet { src: "../../../newui_ctskillframe.tga"; ct-skill-frame: 0px 0px 128px 53px; }
@spritesheet ct-minmap-sheet { src: "../../../newui_ctminmap.jpg"; ct-minmap: 0px 0px 128px 128px; }
@spritesheet ct-minmap-frame-sheet { src: "../../../newui_ctminmapframe.tga"; ct-minmap-frame: 0px 0px 128px 165px; }

.panels, .score, .tutorial { position: static; }
/* The corner part moves left of the worn-equipment icons, which modern's dock transform puts below
   the top bar, into the original's place. */
#corner { position: absolute; left: -72px; top: 0; width: 0; height: 0; }

#game_time_frame { position: absolute; left: 506px; top: 393px; width: 134px; height: 37px;
                   decorator: image(ct-game-time-frame); }
#game_time_dot { position: absolute; left: 574.5px; top: 407.5px; width: 3px; height: 9px; decorator: image(ct-dot); }
#skill_frame { position: absolute; left: 512px; top: 179px; width: 128px; height: 53px;
               decorator: image(ct-skill-frame); }
#mini_map { position: absolute; left: 512px; top: 263px; width: 128px; height: 128px; decorator: image(ct-minmap); }
#mini_map_frame { position: absolute; left: 512px; top: 232px; width: 128px; height: 165px;
                  decorator: image(ct-minmap-frame); }

/* The digit runs, each starting half its digit count's width left of its x: RenderNumber() at
   scale 1 (8.4-unit digits 6.72 apart) and 1.1 (9.6-unit digits 7.68 apart) in newui_number1,
   RenderNumber2D() in FontTest (8-unit digits 5.6 apart). */
.ct-digit { position: absolute; }
.ct-digit.blank { visibility: hidden; }
.ct-time-minutes .ct-digit, .ct-time-seconds .ct-digit { top: 404.5px; width: 9.6px; height: 12.8px; }
.ct-time-minutes .ct-digit { left: calc(559.5px - var(--n) * 4.8px + var(--i) * 7.68px); }
.ct-time-seconds .ct-digit { left: calc(594.5px - var(--n) * 4.8px + var(--i) * 7.68px); }
#ct_alpha .ct-digit, #ct_allied .ct-digit, #ct_illusion .ct-digit { top: 246px; width: 8px; height: 8px; }
#ct_alpha .ct-digit { left: calc(532px - var(--n) * 4px + var(--i) * 5.6px); }
#ct_allied .ct-digit { left: calc(583px - var(--n) * 4px + var(--i) * 5.6px); }
#ct_illusion .ct-digit { left: calc(627px - var(--n) * 4px + var(--i) * 5.6px); }
#ct_kills_needed .ct-digit, #ct_kills .ct-digit { top: 208px; width: 8.4px; height: 11.2px; }
#ct_kills_needed .ct-digit { left: calc(594px - var(--n) * 4.2px + var(--i) * 6.72px); }
#ct_kills .ct-digit { left: calc(616px - var(--n) * 4.2px + var(--i) * 6.72px); }
#skill_icon { position: absolute; left: 539px; top: 200px; width: 20px; height: 28px; }

/* The score effect's banners and digits. */
@spritesheet ct-score-colon-sheet { src: "../../../newui_ctscorevs1.tga"; ct-score-colon: 0px 0px 20px 45px; }
@spritesheet ct-score-vs-sheet { src: "../../../newui_ctscorevs0.tga"; ct-score-vs: 0px 0px 49px 27px; }
@spritesheet ct-score-allied-sheet
{
	src: "../../../newui_ctscorealliedgaail.tga";
	ct-score-allied-badge: 0px 0px 40px 36px;
}
@spritesheet ct-score-illusion-sheet
{
	src: "../../../newui_ctscoreillsiongaail.tga";
	ct-score-illusion-badge: 0px 0px 40px 36px;
}
@spritesheet ct-score-left-sheet { src: "../../../newui_ctscoreleft.tga"; ct-score-left: 0px 0px 67px 125px; }
@spritesheet ct-score-right-sheet { src: "../../../newui_ctscoreright.tga"; ct-score-right: 0px 0px 67px 125px; }

#score_allied_tens, #score_allied_ones, #score_illusion_tens, #score_illusion_ones {
	position: absolute;
	top: 160px;
	width: 56px;
	height: 66px;
}
#score_allied_tens { left: 196px; }
#score_allied_ones { left: 224px; }
#score_allied_ones.wide { left: 253px; }
#score_illusion_tens { left: 331px; }
#score_illusion_ones { left: 358px; }
#score_illusion_ones.wide { left: 388px; }
#score_colon { position: absolute; left: 310px; top: 168px; width: 20px; height: 45px;
               decorator: image(ct-score-colon); }
#score_allied_badge { position: absolute; left: 232px; top: 115px; width: 40px; height: 36px;
                      decorator: image(ct-score-allied-badge); }
#score_vs { position: absolute; left: 292px; top: 123px; width: 49px; height: 27px; decorator: image(ct-score-vs); }
#score_illusion_badge { position: absolute; left: 367px; top: 115px; width: 40px; height: 36px;
                        decorator: image(ct-score-illusion-badge); }
#score_left_banner { position: absolute; left: 133px; top: 115px; width: 67px; height: 125px;
                     decorator: image(ct-score-left); }
#score_right_banner { position: absolute; left: 445px; top: 115px; width: 67px; height: 125px;
                      decorator: image(ct-score-right); }

/* RenderTutorialStep()'s own rows: the step's title at y 50 and its three lines 14 units apart,
   with the second row left empty as the original left it. */
.tutorial-line { color: #ffffff; }
.tutorial-line.title { color: #ffb049; }
.tutorial-line:nth-child(1) { top: 50px; }
.tutorial-line:nth-child(2) { top: 78px; }
.tutorial-line:nth-child(3) { top: 92px; }
.tutorial-line:nth-child(4) { top: 106px; }
