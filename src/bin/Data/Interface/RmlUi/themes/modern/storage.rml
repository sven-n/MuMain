<rml>
<head>
	<title>Storage</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="storage.rcss"/>
</head>
<body data-model="storage">
	<!-- CStorageInventory (StorageInventory.h): the frame, the item grid, the items C++ draws live
	     into #item_view, the stack counts, title, money and buttons. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- The frame. -->
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill and accent; the title is the rail below. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{c.count}}</span></div>
		</div>
		<!-- Header rail: `-px` since #panel carries transform:scale(root_scale) (base.rcss). -->
		<div class="modern-header-rail-px stor-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<!-- Wallet + fee row: base.rcss's shared .modern-wallet-px family, heightened to fit both
		     the Zen balance and the Storage Fee line CStorageInventory::RenderText() used to draw.
		     Fixed warm-gold value color, not styled by zen_tier's native wealth-tier blue/green
		     scheme -- same reasoning as MyInventory's #gold_text (my_inventory.rml). -->
		<div id="money_bg" class="modern-wallet-px stor-wallet-px">
			<div class="modern-wallet-coin-px"></div>
			<span class="modern-wallet-label-px">Zen</span>
		</div>
		<span id="zen_text" class="modern-wallet-value-px">{{zen_text}}</span>
		<span id="fee_label" class="stor-fee-label-px">{{fee_label}}</span>
		<span id="fee_value" class="modern-wallet-value-px">{{fee_value}}</span>

		<div id="btn_insert" class="modern-icon-btn-px stor-btn-insert" data-event-click="storage_insert_click" data-attr-data-hint="insert_tooltip">
			<span class="modern-icon-btn-glyph-px">&#8595;</span>
		</div>

		<div id="btn_take" class="modern-icon-btn-px stor-btn-take" data-event-click="storage_take_click" data-attr-data-hint="take_tooltip">
			<span class="modern-icon-btn-glyph-px">&#8593;</span>
		</div>

		<!-- Lock icon toggle mirrors my_inventory.rml's .inv-btn-myshop/data-class-close-mode --
		     modern doesn't have distinct open/closed art, so only the accent recolors (see
		     storage.rcss's .stor-btn-lock.locked-mode), same as myshop's own modern treatment. -->
		<div id="btn_lock" class="modern-icon-btn-px stor-btn-lock" data-class-locked-mode="storage_locked"
		     data-event-click="storage_lock_click" data-attr-data-hint="lock_tooltip">
			<span class="modern-icon-btn-glyph-px">&#9679;</span>
		</div>

		<div id="btn_expand" class="modern-icon-btn-px stor-btn-expand" data-class-hidden="!expand_visible"
		     data-event-click="storage_expand_click" data-attr-data-hint="expand_tooltip">
			<span class="modern-icon-btn-glyph-px">+</span>
		</div>
	</div>
</body>
</rml>
