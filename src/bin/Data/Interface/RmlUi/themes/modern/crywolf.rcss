/* Modern theme for CCryWolf: the Crywolf art has no modern counterpart yet, so it keeps the legacy
   theme's images, geometry and colours (see themes/legacy/crywolf.rcss). */

body { pointer-events: none; }

.screen {
	position: absolute;
	left: 0;
	top: 0;
	width: 640px;
	height: 480px;
	transform-origin: left top;
	pointer-events: none;
	font-family: "token(font-body)";
}

img { position: absolute; }

#banner { top: 50px; width: 329px; height: 94px; }
#rank_table { left: 230px; top: 150px; width: 196px; height: 141px; }
#rank_label { top: 188px; width: 110px; height: 28px; }
#rank_letter { left: 370px; top: 188px; width: 29px; height: 28px; }
#exp_label { left: 229px; top: 235px; width: 60px; height: 19px; }
.exp-digit { width: 15px; height: 19px; }

#main { left: 518px; top: 278px; width: 122px; height: 119px; }
.altar { width: 13px; height: 13px; }
#dark_elf_icon { left: 623px; top: 358px; width: 15px; height: 15px; }
#plate { left: 538px; top: 392px; width: 104px; height: 37px; }
#balgass_icon { left: 623px; top: 379px; width: 15px; height: 15px; }
#balgass_bar { left: 548px; top: 388px; height: 8px; }
.timer-digit { width: 14px; height: 14px; }
#statue_bar { top: 323px; height: 30px; }

.hud-text {
	display: block;
	position: absolute;
	transform-origin: left top;
	white-space: nowrap;
	text-align: center;
	color: #ff9415;
}
#dark_elf_text { left: 482px; top: 359px; }
#balgass_text { left: 500px; top: 380px; }

.notice {
	display: block;
	position: absolute;
	left: 190px;
	transform-origin: left top;
	white-space: nowrap;
	font-weight: bold;
	background-color: rgba(0, 0, 0, 170);
}

/* The repeated sets, each counted inside its own container; the containers take no space. */
.exp-digits, .altars, .notices { position: static; }

/* RenderRank()'s nine experience digits, 15 units apart from x 289 at y 235. */
.exp-digit:nth-child(1) { left: 289px; top: 235px; }
.exp-digit:nth-child(2) { left: 304px; top: 235px; }
.exp-digit:nth-child(3) { left: 319px; top: 235px; }
.exp-digit:nth-child(4) { left: 334px; top: 235px; }
.exp-digit:nth-child(5) { left: 349px; top: 235px; }
.exp-digit:nth-child(6) { left: 364px; top: 235px; }
.exp-digit:nth-child(7) { left: 379px; top: 235px; }
.exp-digit:nth-child(8) { left: 394px; top: 235px; }
.exp-digit:nth-child(9) { left: 409px; top: 235px; }

/* The five altars, on the places the original's own table put them along the hill. */
.altar:nth-child(1) { left: 565px; top: 280px; }
.altar:nth-child(2) { left: 582px; top: 282px; }
.altar:nth-child(3) { left: 598px; top: 286px; }
.altar:nth-child(4) { left: 613px; top: 294px; }
.altar:nth-child(5) { left: 625px; top: 306px; }

/* The advance notice's four lines, 13 units apart from y 63, the first one its heading. */
.notice:nth-child(1) { top: 63px; }
.notice:nth-child(2) { top: 76px; }
.notice:nth-child(3) { top: 89px; }
.notice:nth-child(4) { top: 102px; }
.notice { color: rgb(100, 150, 255); }
.notice.heading { color: rgb(100, 200, 255); }

/* The clock reddens while Balgass is on the field. */
.timer-digit { image-color: #ffffff; }
.timer-digit.urgent { image-color: rgb(255, 77, 77); }

/* Lengths inside counter-scaled layers: reference px times the panel's --root-scale. */
#dark_elf_text { width: calc(200px * var(--root-scale)); }
#balgass_text { width: calc(200px * var(--root-scale)); }
