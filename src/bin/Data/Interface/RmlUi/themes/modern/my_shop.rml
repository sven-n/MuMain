<rml>
<head>
	<title>Personal Store</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="my_shop.rcss"/>
</head>
<body data-model="my_shop">
	<!-- Window frame/title/shop-name field/Open-Close-Exit buttons only -- the inventory grid stays
	     native (MyShopInventory.h). Frame background lives in my_shop_bg.rml instead, since it must
	     paint behind the native 3D icons. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- Header rail: no top/height override needed -- the shared default already clears this
		     window's grid budget (`m_Pos.y + 90`, the widest in the family). -->
		<div class="modern-header-rail-px">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<!-- Shop name. Stock RmlUi <input>: it owns the edit buffer, caret, selection and IME, and
		     two-way binds the committed value to MyShopRmlModel::shopTitle. autofocus is what
		     reproduces the old native GiveFocus()-on-open -- ElementDocument::Show()'s own
		     FocusFlag::Auto picks it up, so no C++ focus call is needed. maxlength comes from C++
		     (ApplyShopTitleLimit()). Owns its own background now, so the separate #edit_bg strip
		     this window used to need in the background document is gone. -->
		<input id="shop_title" type="text" class="text-field my-shop-title-field"
		       data-value="shop_title" autofocus/>

		<div id="btn_exit" class="modern-icon-btn-px shop-btn-exit" data-event-click="my_shop_exit_click">
			<span class="modern-icon-btn-glyph-px">&#215;</span>
		</div>
		<span class="tooltip tooltip-exit">{{exit_tooltip}}</span>

		<div id="btn_open" class="modern-icon-btn-px shop-btn-open" data-class-locked="open_locked"
		     data-event-click="my_shop_open_click">
			<span class="modern-icon-btn-glyph-px">&#10003;</span>
		</div>
		<span class="tooltip tooltip-open">{{open_tooltip}}</span>

		<div id="btn_close" class="modern-icon-btn-px shop-btn-close" data-class-locked="close_locked"
		     data-event-click="my_shop_close_click">
			<span class="modern-icon-btn-glyph-px">&#9632;</span>
		</div>
		<span class="tooltip tooltip-close">{{close_tooltip}}</span>

		<!-- Former RenderTextInfo() -- fixed instructional text at the same reference-pixel offsets
		     the native RenderText() calls used, static except still_opening's visibility. Colors are
		     plain RCSS (myshop-line-* classes), not data-bound -- fixed decorative constants. -->
		<div id="still_opening_line" class="myshop-line myshop-line-still-opening" data-class-hidden="!show_still_opening">{{still_opening_text}}</div>
		<div id="warning_line" class="myshop-line myshop-line-warning">{{warning_text}}</div>
		<div id="selling_price_line" class="myshop-line myshop-line-info">{{selling_price_text}}</div>
		<div id="please_verify_line" class="myshop-line myshop-line-info">{{please_verify_text}}</div>
		<div id="already_in_store_line" class="myshop-line myshop-line-info">{{already_in_store_text}}</div>
		<div id="cancel_sold_line" class="myshop-line myshop-line-info">{{cancel_sold_text}}</div>
		<div id="cant_be_returned_line" class="myshop-line myshop-line-info">{{cant_be_returned_text}}</div>
		<div id="all_item_trading_line" class="myshop-line myshop-line-warning">{{all_item_trading_text}}</div>
		<div id="can_only_be_done_using_zen_line" class="myshop-line myshop-line-warning">{{can_only_be_done_using_zen_text}}</div>
	</div>
</body>
</rml>
