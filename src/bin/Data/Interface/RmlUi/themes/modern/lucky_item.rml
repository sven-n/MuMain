<rml>
<head>
	<title>Lucky Item</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="lucky_item.rcss"/>
</head>
<body data-model="lucky_item">
	<!-- CLuckyItemWnd (LuckyItemWnd.h/.cpp): the frame, the item grid, the items and the
	     mix-completion sparkle C++ draws live into #item_view, the stack counts, title, mix button and
	     result-description text block. The theme sizes #panel in its RCSS. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale">
		<!-- The frame. -->
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill and accent; the title is the rail below. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'">{{c.count}}</span></div>
		</div>
		<!-- Header rail: left/right insets (base.rcss default) let it stretch with #panel. -->
		<div class="modern-header-rail-px lucky-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<!-- Centered via left:50%/negative margin-left (not width-dependent centering math) so it
		     stays centered regardless of #panel's runtime width -- top:380px matches the native
		     `m_ptPos.y + 380` offset exactly (LuckyItemWnd.cpp), fixed from the panel's TOP. -->
		<div id="btn_mix" class="modern-icon-btn-px lucky-btn-mix" data-class-hidden="!mix_visible"
		     data-event-click="lucky_item_mix_click" data-attr-data-hint="mix_tooltip">
			<span class="modern-icon-btn-glyph-px">&#8644;</span>
		</div>

		<!-- Former Render_Frame()'s m_sText[]/AddText() result/description block. -->
		<div id="text_lines">
			<div class="lucky-line" data-for="t : text_lines" data-style-color="t.color"
			     data-style-text-align="t.align">{{t.text}}</div>
		</div>
	</div>
</body>
</rml>
