<rml>
	<!-- bound-geometry: the three gauges' fill levels -->
<head>
	<title>MU Helper Detail</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="mu_helper_common.rcss"/>
	<link type="text/rcss" href="mu_helper_detail.rcss"/>
</head>
<body>
	<!-- Modern theme's own copy of CMuHelperDetailWindow's panel -- the forged-dialog shell and
	     header rail its right-dock neighbours use (party_info, character_info), with plain px text
	     that scales with the panel like theirs. Same layout, ids, model fields and event names as
	     ../../mu_helper_detail.rml; keep them in step. -->
	<div id="panel" data-model="mu_helper_detail">
		<div class="modern-shell-edge"></div>
		<div class="modern-groove"></div>
		<div class="modern-header-rail-px docked-header-rail-fill">
			<div class="modern-joint-px"></div>
			<div class="docked-rail-accent"></div>
		</div>

		<span class="mh-text mh-center mh-bold mh-title" data-class-hidden="!(page == 2 || page == 3)">{{labels.title_activation}}</span>
		<span class="mh-text mh-center mh-bold mh-title" data-class-hidden="!(page == 4 || page == 5 || page == 6)">{{labels.title_recovery}}</span>
		<span class="mh-text mh-center mh-bold mh-title" data-class-hidden="page != 7 &amp;&amp; page != 8">{{labels.title_party}}</span>

		<div id="pane_top" class="mh-pane" data-class-hidden="!(page == 2 || page == 3 || page == 4 || page == 5 || page == 6 || page == 7)">
			<div class="p p-tab"></div>
			<div class="p p-body"></div>
			<span class="mh-text" data-class-hidden="!(page == 2 || page == 3)">{{labels.pane_precon}}</span>
			<span class="mh-text" data-class-hidden="!(page == 4 || page == 5 || page == 6)">{{labels.pane_auto_potion}}</span>
			<span class="mh-text" data-class-hidden="page != 7">{{labels.pane_buff_support}}</span>
		</div>
		<div id="pane_lower" class="mh-pane" data-class-hidden="!(page == 2 || page == 3 || page == 4 || page == 5)">
			<div class="p p-tab"></div>
			<div class="p p-body"></div>
			<span class="mh-text" data-class-hidden="!(page == 2 || page == 3)">{{labels.pane_subcon}}</span>
			<span class="mh-text" data-class-hidden="page != 4">{{labels.pane_auto_heal}}</span>
			<span class="mh-text" data-class-hidden="page != 5">{{labels.pane_drain_life}}</span>
		</div>
		<div id="pane_heal_support" class="mh-pane mh-pane-h70" data-class-hidden="page != 8">
			<div class="p p-tab"></div>
			<div class="p p-body"></div>
			<span class="mh-text">{{labels.pane_heal_support}}</span>
		</div>
		<div id="pane_buff_support_elf" class="mh-pane" data-class-hidden="page != 8">
			<div class="p p-tab"></div>
			<div class="p p-body"></div>
			<span class="mh-text">{{labels.pane_buff_support}}</span>
		</div>

		<!-- Activation condition: which monsters trigger the skill, and how many. Radios. -->
		<div class="mhd-page" data-class-hidden="!(page == 2 || page == 3)">
			<div id="precon_range" class="mh-check mh-radio">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="precon == 0" data-event-click="muhelper_detail_precon(0)"></div>
				<span class="mh-text checkbox-label">{{labels.precon_hunt_range}}</span>
			</div>
			<div id="precon_attacking" class="mh-check mh-radio">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="precon == 1" data-event-click="muhelper_detail_precon(1)"></div>
				<span class="mh-text checkbox-label">{{labels.precon_attacking}}</span>
			</div>
			<div id="subcon_two" class="mh-check mh-radio">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="subcon == 0" data-event-click="muhelper_detail_subcon(0)"></div>
				<span class="mh-text checkbox-label">{{labels.subcon_two}}</span>
			</div>
			<div id="subcon_three" class="mh-check mh-radio">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="subcon == 1" data-event-click="muhelper_detail_subcon(1)"></div>
				<span class="mh-text checkbox-label">{{labels.subcon_three}}</span>
			</div>
			<div id="subcon_four" class="mh-check mh-radio">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="subcon == 2" data-event-click="muhelper_detail_subcon(2)"></div>
				<span class="mh-text checkbox-label">{{labels.subcon_four}}</span>
			</div>
			<div id="subcon_five" class="mh-check mh-radio">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="subcon == 3" data-event-click="muhelper_detail_subcon(3)"></div>
				<span class="mh-text checkbox-label">{{labels.subcon_five}}</span>
			</div>
		</div>

		<!-- Recovery: the potion threshold on every class, plus auto heal (elf) or drain life (summoner). -->
		<div class="mhd-page" data-class-hidden="!(page == 4 || page == 5 || page == 6)">
			<div id="gauge_potion" class="level-gauge mh-gauge">
				<div class="level-gauge-hit mh-gauge-hit" data-event-mousedown="muhelper_detail_gauge(0)"
				     data-event-drag="muhelper_detail_gauge(0)"
				     data-event-mousescroll="muhelper_detail_gauge(0)"></div>
			</div>
			<div id="gauge_potion_fill" class="level-gauge-fill mh-gauge-fill" data-class-hidden="potion_level == 0"
			     data-style-width="(potion_level * 12.4) + 'px'"></div>
			<span class="mh-text mh-center" id="gauge_potion_label">{{labels.hp_status}}</span>
		</div>
		<div class="mhd-page" data-class-hidden="page != 4 &amp;&amp; page != 5">
			<div id="gauge_heal" class="level-gauge mh-gauge">
				<div class="level-gauge-hit mh-gauge-hit" data-event-mousedown="muhelper_detail_gauge(1)"
				     data-event-drag="muhelper_detail_gauge(1)"
				     data-event-mousescroll="muhelper_detail_gauge(1)"></div>
			</div>
			<div id="gauge_heal_fill" class="level-gauge-fill mh-gauge-fill" data-class-hidden="heal_level == 0"
			     data-style-width="(heal_level * 12.4) + 'px'"></div>
			<span class="mh-text mh-center" id="gauge_heal_label">{{labels.hp_status}}</span>
		</div>

		<!-- Party support, standard classes. -->
		<div class="mhd-page" data-class-hidden="page != 7">
			<div id="party_duration" class="mh-check">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="party_duration" data-event-click="muhelper_detail_party_duration"></div>
				<span class="mh-text checkbox-label">{{labels.party_duration}}</span>
			</div>
			<span class="mh-text" id="time_space">{{labels.time_space}}</span>
			<div id="buff_plate" class="mh-number-plate"></div>
			<input id="buff_interval" type="text" class="text-field text-field--numeric mh-field"
			       data-value="buff_interval"/>
			<span class="mh-text" id="buff_unit">s</span>
		</div>

		<!-- Party support, elf: heal preference and its threshold above the same buff options. -->
		<div class="mhd-page" data-class-hidden="page != 8">
			<div id="party_heal" class="mh-check">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="party_heal" data-event-click="muhelper_detail_party_heal"></div>
				<span class="mh-text checkbox-label">{{labels.party_heal}}</span>
			</div>
			<div id="gauge_party_heal" class="level-gauge mh-gauge">
				<div class="level-gauge-hit mh-gauge-hit" data-event-mousedown="muhelper_detail_gauge(2)"
				     data-event-drag="muhelper_detail_gauge(2)"
				     data-event-mousescroll="muhelper_detail_gauge(2)"></div>
			</div>
			<div id="gauge_party_heal_fill" class="level-gauge-fill mh-gauge-fill" data-class-hidden="party_heal_level == 0"
			     data-style-width="(party_heal_level * 12.4) + 'px'"></div>
			<span class="mh-text mh-center" id="gauge_party_heal_label">{{labels.hp_status_party}}</span>
			<div id="party_duration_elf" class="mh-check">
				<div class="checkbox-box modern-checkbox-px" data-class-checked="party_duration" data-event-click="muhelper_detail_party_duration"></div>
				<span class="mh-text checkbox-label">{{labels.party_duration}}</span>
			</div>
			<span class="mh-text" id="time_space_elf">{{labels.time_space}}</span>
			<div id="buff_plate_elf" class="mh-number-plate"></div>
			<input id="buff_interval_elf" type="text" class="text-field text-field--numeric mh-field"
			       data-value="buff_interval"/>
			<span class="mh-text" id="buff_unit_elf">s</span>
		</div>

		<div id="btn_save" class="mh-btn-igs modern-btn-px" data-event-click="muhelper_detail_save"></div>
		<span class="mh-text mh-center mh-btn-label mh-btn-label-igs" id="btn_save_label">{{labels.save}}</span>
		<div id="btn_init" class="mh-btn-igs modern-btn-px" data-event-click="muhelper_detail_init"></div>
		<span class="mh-text mh-center mh-btn-label mh-btn-label-igs" id="btn_init_label">{{labels.init}}</span>

		<div id="btn_exit" class="modern-icon-btn-px" data-event-click="muhelper_detail_close" data-attr-data-hint="labels.close_tip">
			<span class="modern-icon-btn-glyph-px">&#215;</span>
		</div>
	</div>
</body>
</rml>
