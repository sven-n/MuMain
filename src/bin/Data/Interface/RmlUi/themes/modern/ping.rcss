/* The ping ($ping), in the look of the FPS counter. The workspace places this passive panel at the
   top-right corner of the content area. */
body { pointer-events: none; }
#panel {
    position: absolute;
    left: 4dp;
    top: 4dp;
    padding: 3dp 5dp;
    font-family: "token(font-body)";
    font-size: 9dp;
    line-height: 13dp;
    white-space: nowrap;
    pointer-events: none;
}
#panel.workspace-placed { transform-origin: left top; }
#panel div { display: block; }
.section-back { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.title { position: relative; font-weight: bold; }

/* As see-through as the legacy panel: the game stays visible behind the number. */
#panel { color: token(text-primary); }
.section-back { background-color: rgba(10, 10, 12, 100); }
.title { color: token(accent-gold); }
