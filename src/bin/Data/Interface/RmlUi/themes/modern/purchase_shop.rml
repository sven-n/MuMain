<rml>
<head>
	<title>Personal Store - Purchase</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="purchase_shop.rcss"/>
	<link type="text/rcss" href="shop_notice.rcss"/>
</head>
<body data-model="purchase_shop">
	<!-- CPurchaseShopInventory (PurchaseShopInventory.h): the frame, the item grid, the items C++
	     draws live into #item_view, the stack counts, title, subtitle strip, warning text and exit
	     button. -->
	<div id="panel" data-style---text-px="text_px + 'px'">
		<div id="frame_corner_close" data-event-click="window_close"></div>
		<!-- The frame. -->
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill and accent; the title is the rail below. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
		<!-- The item_grid grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The items, live 3D drawn by C++ over the cells, then the stack counts. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text counter-scaled" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'">{{c.count}}</span></div>
		</div>
		<!-- Header rail holds only the static "Personal Store" label -- the shop-owner's name
		     gets its own nameplate strip below (.pshop-title-strip). -->
		<div class="modern-header-rail-px pshop-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<!-- Vector nameplate strip standing in for IMAGE_MYSHOPINVENTORY_EDIT's sprite (legacy
		     theme reproduces that art losslessly instead; see purchase_shop.rcss there). -->
		<div class="pshop-title-strip">
			<span id="shop_owner_text" class="pshop-title-strip-text">{{shop_owner_text}}</span>
		</div>

		<div id="shop_notice" class="scroll-pane shop-notice">
			<div class="notice-group">
				<div class="notice-line notice-warning warning-label">{{warning_label}}</div>
			</div>
			<div class="notice-group warning-line">
				<div class="notice-line">{{selling_price_line}}</div>
				<div class="notice-line">{{verify_line}}</div>
				<div class="notice-line">{{already_in_store_line}}</div>
				<div class="notice-line">{{cancel_purchased_line}}</div>
				<div class="notice-line">{{cant_be_returned_line}}</div>
			</div>
			<div class="notice-group notice-warning warning-label">
				<div class="notice-line">{{all_item_trading_line}}</div>
				<div class="notice-line">{{zen_only_line}}</div>
			</div>
		</div>

		<div id="btn_exit" class="modern-icon-btn-px pshop-btn-exit" data-event-click="purchase_shop_exit_click">
			<span class="modern-icon-btn-glyph-px">&#215;</span>
		</div>
	</div>
</body>
</rml>
