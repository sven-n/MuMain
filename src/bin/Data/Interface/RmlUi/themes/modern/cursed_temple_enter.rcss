/* Modern theme for CCursedTempleEnter: the modern panel surface instead of the message-box art,
   modern buttons, the hero's band in the steel accent. Geometry is the legacy one (reference px
   under the Dialog transform). */

#panel {
	position: absolute;
	transform-origin: left top;
	width: 230px;
	height: 252px;
	font-family: "token(font-body)";
	background-color: token(surface-panel);
	border: 1px token(border-frame);
	pointer-events: auto;
}

#back, #frame_top, .frame-middle, #frame_bottom { display: none; }
#line { position: absolute; left: 10px; top: 185px; width: 210px; height: 1px; background-color: token(border-frame); }

.sharp-text { display: block; position: absolute; white-space: nowrap; text-align: center; pointer-events: none; }
#title { left: 0; top: 13px; font-weight: bold; color: token(text-warm); }
.temple-line { color: #ffffff; }
.temple-line.red { color: #ff0000; }
/* The frame tiles and the level bands are containers so each piece can be counted; the containers
   themselves take no space. */
.frame-middles, .temple-bands { position: static; }
.frame-middles .frame-middle:nth-child(1) { top: 67px; }
.frame-middles .frame-middle:nth-child(2) { top: 82px; }
.frame-middles .frame-middle:nth-child(3) { top: 97px; }
.frame-middles .frame-middle:nth-child(4) { top: 112px; }
.frame-middles .frame-middle:nth-child(5) { top: 127px; }
.frame-middles .frame-middle:nth-child(6) { top: 142px; }
.frame-middles .frame-middle:nth-child(7) { top: 157px; }
.frame-middles .frame-middle:nth-child(8) { top: 172px; }
.frame-middles .frame-middle:nth-child(9) { top: 187px; }

/* RenderText()'s own rows: the temple at y 42, the six bands 15 units apart from y 67, the members
   count under them, and -- without a level band -- the minimum-level notice on its own. */
#ct_temple { left: 3px; top: 42px; }
#ct_members { left: 3px; top: 160px; }
#ct_notice { left: 0; top: 52px; }
.temple-band { position: absolute; left: 3px; width: 220px; height: 15px; margin-top: 67px; }
.temple-band:nth-child(1) { top: 0px; }
.temple-band:nth-child(2) { top: 15px; }
.temple-band:nth-child(3) { top: 30px; }
.temple-band:nth-child(4) { top: 45px; }
.temple-band:nth-child(5) { top: 60px; }
.temple-band:nth-child(6) { top: 75px; }
.temple-band .temple-line { left: 0; top: 0; }
.band-hero { position: absolute; left: 0; top: 0; width: 220px;
             background-color: token(accent-steel); pointer-events: none; }

.temple-btn {
	display: block;
	position: absolute;
	top: 203px;
	width: 54px;
	height: 22px;
	background-color: token(surface-raised);
	border: 1px token(border-frame);
	border-radius: token(radius-sm)px;
	pointer-events: auto;
}
.temple-btn:hover { border-color: token(accent-steel-hover); }
.temple-btn:active { background-color: token(surface-recessed); }
#btn_enter { left: 30px; }
#btn_close { left: 145px; }
.temple-label { left: 0; color: token(text-primary); }
