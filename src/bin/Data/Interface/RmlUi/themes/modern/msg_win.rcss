/* Modern theme for the generic message/confirm dialog -- flat programmatic chrome, no legacy
   sprite art. OK/Cancel show real localized text instead of art.

   #panel consumes base.rcss's .modern-frame-crimson instead of a bespoke background/border.
   .modern-frame sets no border-radius, so this still needs its own value. */
#panel {
	position: absolute;
	width: 352dp;
	height: 113dp;
	font-family: "token(font-body)";
	font-size: 12dp;
	color: token(text-primary);
	border-width: 1dp;
	border-radius: token(radius-md)dp;
}

#msg_line1 {
	position: absolute;
	left: 0;
	right: 0;
	top: 38dp;
	text-align: center;
	white-space: nowrap;
	pointer-events: none;
	font-family: "token(font-body)";
}
.no-buttons #msg_line1 { top: 54dp; }
#msg_line1.multi-line {
	left: 25dp;
	right: auto;
	text-align: left;
	top: 32dp;
}
.no-buttons #msg_line1.multi-line { top: 44dp; }

#msg_line2 {
	position: absolute;
	left: 25dp;
	top: 51dp;
	text-align: left;
	white-space: nowrap;
	pointer-events: none;
	font-family: "token(font-body)";
}
.no-buttons #msg_line2 { top: 66dp; }

/* Footer band (base.rcss's .modern-footer) -- border-radius matches #panel's so the band's
   bottom corners don't square off past the frame's rounded corners. */
.modern-footer {
	top: 68dp;
	border-bottom-left-radius: token(radius-md)dp;
	border-bottom-right-radius: token(radius-md)dp;
}

#input_frame {
	display: none;
	position: absolute;
	left: 32dp;
	top: 76dp;
	width: 171dp;
	height: 23dp;
	background-color: rgba(0, 0, 0, 110);
	border: 1dp token(border-frame);
	border-radius: token(radius-sm)dp;
	pointer-events: none;
}
.mode-input #input_frame { display: block; }

/* Do NOT redeclare background-color/border/border-radius here -- `border` is a shorthand that
   resets border-color on all sides, silently stomping .btn-ok's crimson border back to gray
   (same specificity, this file wins the tie since it's linked after base.rcss). Only the
   mode-gated hidden state and this window's local position/size stay here. */
.btn {
	display: none;
	position: absolute;
	width: 54dp;
	height: 30dp;
	top: 72dp;
	text-align: center;
	vertical-align: middle;
	line-height: 30dp;
	cursor: pointer;
	pointer-events: auto;
}

#btn_ok { left: 149dp; }
.mode-ok-only #btn_ok, .mode-both #btn_ok, .mode-input #btn_ok { display: block; }
.mode-both #btn_ok { left: 98dp; }
.mode-input #btn_ok { left: 209dp; }

#btn_cancel { left: 149dp; }
.mode-cancel-only #btn_cancel, .mode-both #btn_cancel, .mode-input #btn_cancel { display: block; }
.mode-both #btn_cancel { left: 200dp; }
.mode-input #btn_cancel { left: 264dp; }
