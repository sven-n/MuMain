<rml>
<head>
	<title>My Inventory</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="item_grid.rcss"/>
	<link type="text/rcss" href="my_inventory.rcss"/>
</head>
<body data-model="my_inventory">
	<!-- CMyInventory (MyInventory.h): the frame, the equipment slots, the item grid, the items
	     C++ draws live into #item_view, the stack counts, the title, gold and buttons. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
		<!-- The equipment slots, the item grid and the item-option tooltip: boxes the theme places
		     (my_inventory.rcss); CMyInventory reads them each frame for its hit tests. A slot's class
		     is its state (MyInventory.h's slot_states). -->
		<div id="slot_helper" data-attr-class="'native-anchor equip-slot ' + slot_states[8]"><div class="equip-slot-tint"></div></div>
		<div id="slot_helm" data-attr-class="'native-anchor equip-slot ' + slot_states[2]"><div class="equip-slot-tint"></div></div>
		<div id="slot_wing" data-attr-class="'native-anchor equip-slot ' + slot_states[7]"><div class="equip-slot-tint"></div></div>
		<div id="slot_weapon_left" data-attr-class="'native-anchor equip-slot ' + slot_states[1]"><div class="equip-slot-tint"></div></div>
		<div id="slot_armor" data-attr-class="'native-anchor equip-slot ' + slot_states[3]"><div class="equip-slot-tint"></div></div>
		<div id="slot_weapon_right" data-attr-class="'native-anchor equip-slot ' + slot_states[0]"><div class="equip-slot-tint"></div></div>
		<div id="slot_gloves" data-attr-class="'native-anchor equip-slot ' + slot_states[5]"><div class="equip-slot-tint"></div></div>
		<div id="slot_pants" data-attr-class="'native-anchor equip-slot ' + slot_states[4]"><div class="equip-slot-tint"></div></div>
		<div id="slot_boots" data-attr-class="'native-anchor equip-slot ' + slot_states[6]"><div class="equip-slot-tint"></div></div>
		<div id="slot_ring_left" data-attr-class="'native-anchor equip-slot ' + slot_states[11]"><div class="equip-slot-tint"></div></div>
		<div id="slot_amulet" data-attr-class="'native-anchor equip-slot ' + slot_states[9]"><div class="equip-slot-tint"></div></div>
		<div id="slot_ring_right" data-attr-class="'native-anchor equip-slot ' + slot_states[10]"><div class="equip-slot-tint"></div></div>
		<!-- The inventory grid: its cells, then its frame (UI/Inventory/ItemGridModel.h). -->
		<div id="item_grid" class="native-anchor item-grid">
			<div class="item-grid-cells">
				<div data-for="c : grid_cells" data-attr-class="'item-cell ' + c.tint + ' ' + c.drop">
					<div class="item-cell-art"></div><div class="item-cell-drop"></div>
				</div>
			</div>
			<div class="item-grid-frame">
				<div class="igf igf-t"></div><div class="igf igf-b"></div><div class="igf igf-l"></div><div class="igf igf-r"></div>
				<div class="igf igf-tl"></div><div class="igf igf-tr"></div><div class="igf igf-bl"></div><div class="igf igf-br"></div>
			</div>
		</div>
		<!-- The equipped and the grid's items, live 3D drawn by C++ over the slots and the cells. -->
		<img id="item_view" class="item-view"/>
		<div id="item_grid_counts" class="item-grid-counts">
			<div class="item-count" data-for="c : grid_cells"><span class="item-count-text" data-if="c.count != ''"
			     data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{c.count}}</span></div>
		</div>
		<div id="option_tooltip_anchor" class="native-anchor"></div>
		<!-- Header rail: `-px` variants since #panel carries transform:scale(root_scale) (see
		     base.rcss). Fill/accent are the frame's .rail-fill/.rail-accent above. -->
		<div class="modern-header-rail-px inv-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">{{title}}</div>
			</div>
		</div>

		<!-- Wallet + action buttons: base.rcss's shared .modern-wallet-px/.modern-icon-btn-px
		     family (generalized from this window). Fixed warm-gold value color, not bound to
		     gold_tier's native wealth-tier blue/green scheme -- that palette was tuned for
		     legacy's dark theme and clashes with modern's warm-iron chrome. -->
		<div id="gold_bg" class="modern-wallet-px">
			<div class="modern-wallet-coin-px"></div>
			<span class="modern-wallet-label-px">Zen</span>
		</div>
		<span id="gold_text" class="modern-wallet-value-px">{{gold_text}}</span>

		<div id="btn_exit" class="modern-icon-btn-px inv-btn-exit" data-event-click="my_inventory_exit_click">
			<span class="modern-icon-btn-glyph-px">&#215;</span>
		</div>
		<span class="tooltip tooltip-exit">{{exit_tooltip}}</span>

		<div id="btn_repair" class="modern-icon-btn-px inv-btn-repair" data-class-hidden="!repair_visible"
		     data-event-click="my_inventory_repair_click">
			<span class="modern-icon-btn-glyph-px">&#9099;</span>
		</div>
		<span class="tooltip tooltip-repair">{{repair_tooltip}}</span>

		<div id="btn_myshop" class="modern-icon-btn-px inv-btn-myshop" data-class-hidden="!myshop_visible"
		     data-class-close-mode="!myshop_mode_open" data-class-locked="myshop_locked"
		     data-event-click="my_inventory_myshop_click">
			<span class="modern-icon-btn-glyph-px">&#9635;</span>
		</div>
		<span class="tooltip tooltip-myshop">{{myshop_tooltip}}</span>

		<div id="btn_expand" class="modern-icon-btn-px inv-btn-expand" data-event-click="my_inventory_expand_click">
			<span class="modern-icon-btn-glyph-px">+</span>
		</div>
		<span class="tooltip tooltip-expand">{{expand_tooltip}}</span>

		<!-- Set/Socket option header labels, each spanning half of #panel's width to match the
		     former native hover-rect split. -->
		<div id="set_option_label" class="option-label option-label-set" data-class-active="set_option_active"
		     data-event-mouseover="my_inventory_set_option_hover" data-event-mouseout="my_inventory_set_option_unhover">{{set_option_label}}</div>
		<div id="socket_option_label" class="option-label option-label-socket" data-class-active="socket_option_active"
		     data-event-mouseover="my_inventory_socket_option_hover" data-event-mouseout="my_inventory_socket_option_unhover">{{socket_option_label}}</div>
	</div>
</body>
</rml>
