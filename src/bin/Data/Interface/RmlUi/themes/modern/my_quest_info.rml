<rml>
<head>
	<title>My Quest Info</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="my_quest_info.rcss"/>
</head>
<body>
	<!-- Modern theme's own copy of CMyQuestInfoWindow's frame -- per-theme file since the
	     header-rail chrome is modern-specific structure, not just style. #panel/shell-edge/groove/
	     header-rail paint now come from docked_panel_frame.rcss, shared with
	     CCharacterInfoWindow/CPetInfoWindow/CPartyInfoWindow (this window used to be the visual
	     outlier in this family, on .modern-frame/.modern-frame-crimson instead of the forged-dialog
	     recipe the other three use -- brought in line per explicit instruction: all four should read
	     as one family). Keep ids/data-model/event-callback names in sync with ../../my_quest_info.rml. -->
	<div id="panel" data-model="my_quest_info" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="modern-shell-edge"></div>
		<div class="modern-groove"></div>

		<!-- Header uses base.rcss's shared .modern-header-rail-px/.modern-joint-px/
		     .modern-header-text-px/.modern-header-title-px family -- same forged-metal rail the
		     rest of the inventory family (CMyInventory, CTrade, CStorageInventory, etc.) and
		     CSysMenuWin use, replacing this window's own older .modern-header/.title-glow/
		     .modern-header-rivet chrome. `-px` variants since #panel carries
		     transform:scale(root_scale) (see base.rcss's comment on that class family). Fill/border/
		     shadow paint is docked_panel_frame.rcss's shared .docked-header-rail-fill/
		     .docked-rail-accent now; .quest-header-rail only overrides height (20px, shorter than
		     the family default 38px, to leave room for the tab-row right below it). -->
		<div class="modern-header-rail-px docked-header-rail-fill quest-header-rail">
			<div class="modern-joint-px"></div>
			<div class="modern-header-text-px">
				<div id="title" class="modern-header-title-px">Quest</div>
			</div>
			<div class="docked-rail-accent"></div>
		</div>

		<div class="tab-row">
			<div id="tab_quest" class="tab-btn tab-btn-quest" data-class-active="active_tab == 0"
			     data-event-click="myquest_select_tab(0)">{{tab_quest_label}}</div>
			<div id="tab_jobchange" class="tab-btn tab-btn-jobchange" data-class-active="active_tab == 1"
			     data-event-click="myquest_select_tab(1)">{{tab_jobchange_label}}</div>
			<div id="tab_castletemple" class="tab-btn tab-btn-castletemple" data-class-active="active_tab == 2"
			     data-event-click="myquest_select_tab(2)">{{tab_castletemple_label}}</div>
		</div>

		<!-- Quest tab -->
		<div class="quest-tab" data-class-hidden="active_tab != 0">
			<div class="quest-empty-msg" data-class-hidden="!quest_list_empty">
				<span data-for="line : empty_quest_lines">{{line.text}}</span>
			</div>
			<div class="quest-list" data-class-hidden="quest_list_empty">
				<div class="quest-row" data-for="q : quests" data-class-selected="q.selected"
				     data-event-click="myquest_select_quest(q.index)">{{q.text}}</div>
			</div>

			<!-- Native size 188x21, always drawn at native size (RenderQuestInfo()) -- its own
			     element, not a decorator on .quest-contents, to avoid stretching a 188x21 sprite
			     across the 162px-tall box (a real vertical-warp regression). -->
			<div class="quest-divider"></div>

			<div class="quest-contents">
				<span class="quest-content-row" data-for="c : contents" data-class-bold="c.bold"
				      data-class-clickable="c.clickable" data-style-color="c.color"
				      data-event-click="myquest_select_content(c.index)">{{c.text}}</span>
			</div>
		</div>

		<!-- Siblings of .quest-tab, not children -- .quest-tab is itself position:absolute, so a
		     child inside it would resolve left/top against ITS box (172x320 @ 9,60), not #panel's.
		     As children these buttons' top:392px landed past the panel's own 429px height, found
		     only via in-game testing. No footer band here (unlike the older chrome this replaces)
		     -- the inventory-family reference windows just place .modern-icon-btn-px buttons
		     directly on the frame surface, no separate raised footer strip. -->
		<div id="btn_quest_open" class="quest-btn quest-btn-open" data-class-hidden="active_tab != 0"
		     data-class-locked="!open_enabled" data-event-click="myquest_click_open"></div>
		<span class="tooltip tooltip-open">{{open_tooltip}}</span>
		<div id="btn_quest_giveup" class="quest-btn quest-btn-giveup" data-class-hidden="active_tab != 0"
		     data-class-locked="!giveup_enabled" data-event-click="myquest_click_giveup"></div>
		<span class="tooltip tooltip-giveup">{{giveup_tooltip}}</span>

		<!-- Job-change tab -->
		<div class="jobchange-tab" data-class-hidden="active_tab != 1">
			<div class="jobchange-title">{{jobchange_title}}</div>
			<div class="jobchange-contents">
				<span data-for="line : jobchange_lines">{{line.text}}</span>
			</div>
			<div class="jobchange-state">
				<span data-for="line : jobchange_state_lines">{{line.text}}</span>
			</div>
		</div>

		<!-- Castle/Temple tab -->
		<div class="castletemple-tab" data-class-hidden="active_tab != 2">
			<div class="castle-title">{{castle_title}}</div>
			<div class="castle-line">{{castle_line0}}</div>
			<div class="castle-line">{{castle_line1}}</div>
			<div class="temple-title">{{temple_title}}</div>
			<div class="temple-line">{{temple_line0}}</div>
			<div class="temple-line">{{temple_line1}}</div>
		</div>

		<!-- Exit uses base.rcss's shared .modern-icon-btn-px/.modern-icon-btn-glyph-px family --
		     same primitive every other window in this family uses for its corner buttons, replacing
		     this window's own bespoke flat-token button+label pair. -->
		<div id="btn_exit" class="modern-icon-btn-px quest-btn-exit" data-event-click="myquest_click_exit">
			<span class="modern-icon-btn-glyph-px">&#215;</span>
		</div>
		<span class="tooltip tooltip-exit">{{exit_tooltip}}</span>
	</div>
</body>
</rml>
