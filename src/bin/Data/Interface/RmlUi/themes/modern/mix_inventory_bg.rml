<rml>
<head>
	<title>Mix Inventory Background</title>
	<link type="text/rcss" href="mix_inventory_bg.rcss"/>
</head>
<body data-model="mix_inventory_bg">
	<!-- Background-context document (see legacy/mix_inventory_bg.rml for the mechanism). Same
	     forged-dialog look as Login/SysMenu/MyInventory's #panel (outer iron edge, inner groove,
	     real box-shadow depth) -- duplicated locally in mix_inventory_bg.rcss since this document
	     doesn't link base.rcss (see that file's own comment). -->
	<div id="bg_root" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="bg-panel">
			<div class="inv-shell-edge"></div>
			<div class="inv-groove"></div>
			<!-- Header rail's fill/accent, relocated from mix_inventory.rml's foreground rail --
			     see mix_inventory_bg.rcss's .rail-fill comment for why. -->
			<div class="rail-fill">
				<div class="rail-accent"></div>
			</div>
		</div>
	</div>
</body>
</rml>
