<rml>
<head>
	<title>Guild</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="guild_info.rcss"/>
</head>
<body>
	<!-- The guild window (CGuildInfoWindow), docked right: the no-guild hint, or the Guild, Members
	     and Alliance tabs. The static art of each tab (tables, fills, scroll track) is here; the
	     texts, the list lines and their white boxes, the marks and the buttons are bound from
	     C++, which keeps the native list controls for their data, scrolling and line clicks. The
	     tabs, the lines and the scroll thumb are hit-tested natively, so #panel leaves the
	     pointer alone outside the buttons. root_x/root_y/root_scale come from the dock transform;
	     everything inside is reference px; text is .sharp-text at the native size,
	     counter-scaled out of the panel. A button click is queued with guild_info_button(n). -->
	<div id="panel" data-model="guild_info" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<div data-if="!no_guild">
			<div id="tab_list"></div>
			<div id="tab_point" data-style-left="(12 + tab * 56) + 'px'"></div>
		</div>

		<div data-if="!no_guild &amp;&amp; tab == 0">
			<div class="t-edge-top" style="left: 73px; top: 104px; width: 42px;"></div>
			<div class="t-edge-bottom" style="left: 73px; top: 138px; width: 42px;"></div>
			<div class="t-edge-left" style="left: 70px; top: 104px; height: 42px;"></div>
			<div class="t-edge-right" style="left: 105px; top: 104px; height: 42px;"></div>
			<div class="t-corner t-tl" style="left: 70px; top: 104px;"></div>
			<div class="t-corner t-tr" style="left: 105px; top: 104px;"></div>
			<div class="t-corner t-bl" style="left: 70px; top: 138px;"></div>
			<div class="t-corner t-br" style="left: 105px; top: 138px;"></div>
			<div id="guild_mark"><div class="mark-cell" data-for="m : mark_cells" data-style-background-color="m"></div></div>
			<div class="t-edge-top" style="left: 12px; top: 159px; width: 166px;"></div>
			<div class="t-edge-bottom" style="left: 12px; top: 215px; width: 166px;"></div>
			<div class="t-edge-left" style="left: 10px; top: 159px; height: 65px;"></div>
			<div class="t-edge-right" style="left: 167px; top: 159px; height: 65px;"></div>
			<div class="t-corner t-tl" style="left: 10px; top: 159px;"></div>
			<div class="t-corner t-tr" style="left: 167px; top: 159px;"></div>
			<div class="t-corner t-bl" style="left: 10px; top: 215px;"></div>
			<div class="t-corner t-br" style="left: 167px; top: 215px;"></div>
			<div class="fill" style="left: 11px; top: 260px; width: 165px; height: 84px; background-color: #000000;"></div>
			<div class="t-edge-top" style="left: 12px; top: 260px; width: 165px;"></div>
			<div class="t-edge-bottom" style="left: 12px; top: 334px; width: 165px;"></div>
			<div class="t-edge-left" style="left: 10px; top: 260px; height: 82px;"></div>
			<div class="t-edge-right" style="left: 167px; top: 260px; height: 82px;"></div>
			<div class="t-corner t-tr" style="left: 167px; top: 260px;"></div>
			<div class="t-corner t-bl" style="left: 10px; top: 334px;"></div>
			<div class="t-corner t-br" style="left: 167px; top: 334px;"></div>
			<div id="tab_head"></div>
			<div class="scroll" data-style-top="scroll_top + 'px'">
				<div class="s-top" style="left: 167px; top: 0px;"></div>
				<div class="s-mid" style="left: 167px; top: 3px;"></div>
				<div class="s-mid" style="left: 167px; top: 13px;"></div>
				<div class="s-mid" style="left: 167px; top: 23px;"></div>
				<div class="s-mid" style="left: 167px; top: 33px;"></div>
				<div class="s-mid" style="left: 167px; top: 43px;"></div>
				<div class="s-mid" style="left: 167px; top: 53px;"></div>
				<div class="s-mid" style="left: 167px; top: 63px;"></div>
				<div class="s-bottom" style="left: 167px; top: 76px;"></div>
			</div>
			<div class="thumb" style="left: 163px;" data-style-top="thumb_top + 'px'"></div>
		</div>

		<div data-if="!no_guild &amp;&amp; tab == 1">
			<div class="fill" style="left: 12px; top: 125px; width: 165px; height: 232px; background-color: rgba(21, 21, 21, 150);"></div>
			<div class="fill" style="left: 12px; top: 105px; width: 165px; height: 20px; background-color: rgba(59, 59, 59, 150);"></div>
			<div class="t-edge-top" style="left: 12px; top: 105px; width: 165px;"></div>
			<div class="t-edge-bottom" style="left: 12px; top: 347px; width: 165px;"></div>
			<div class="t-edge-left" style="left: 8px; top: 105px; height: 251px;"></div>
			<div class="t-edge-right" style="left: 168px; top: 105px; height: 251px;"></div>
			<div class="t-corner t-tl" style="left: 8px; top: 105px;"></div>
			<div class="t-corner t-tr" style="left: 168px; top: 105px;"></div>
			<div class="t-corner t-bl" style="left: 8px; top: 347px;"></div>
			<div class="t-corner t-br" style="left: 168px; top: 347px;"></div>
			<div class="scroll" data-style-top="scroll_top + 'px'">
				<div class="s-top" style="left: 170px; top: 0px;"></div>
				<div class="s-mid" style="left: 170px; top: 3px;"></div>
				<div class="s-mid" style="left: 170px; top: 13px;"></div>
				<div class="s-mid" style="left: 170px; top: 23px;"></div>
				<div class="s-mid" style="left: 170px; top: 33px;"></div>
				<div class="s-mid" style="left: 170px; top: 43px;"></div>
				<div class="s-mid" style="left: 170px; top: 53px;"></div>
				<div class="s-mid" style="left: 170px; top: 63px;"></div>
				<div class="s-mid" style="left: 170px; top: 73px;"></div>
				<div class="s-mid" style="left: 170px; top: 83px;"></div>
				<div class="s-mid" style="left: 170px; top: 93px;"></div>
				<div class="s-mid" style="left: 170px; top: 103px;"></div>
				<div class="s-mid" style="left: 170px; top: 113px;"></div>
				<div class="s-mid" style="left: 170px; top: 123px;"></div>
				<div class="s-mid" style="left: 170px; top: 133px;"></div>
				<div class="s-mid" style="left: 170px; top: 143px;"></div>
				<div class="s-mid" style="left: 170px; top: 153px;"></div>
				<div class="s-mid" style="left: 170px; top: 163px;"></div>
				<div class="s-mid" style="left: 170px; top: 173px;"></div>
				<div class="s-mid" style="left: 170px; top: 183px;"></div>
				<div class="s-mid" style="left: 170px; top: 193px;"></div>
				<div class="s-mid" style="left: 170px; top: 203px;"></div>
				<div class="s-mid" style="left: 170px; top: 213px;"></div>
				<div class="s-bottom" style="left: 170px; top: 227px;"></div>
			</div>
			<div class="thumb" style="left: 166px;" data-style-top="thumb_top + 'px'"></div>
		</div>

		<div data-if="!no_guild &amp;&amp; tab == 2 &amp;&amp; union_shown">
			<div class="fill" style="left: 12px; top: 125px; width: 165px; height: 85px; background-color: rgba(21, 21, 21, 150);"></div>
			<div class="fill" style="left: 12px; top: 110px; width: 165px; height: 15px; background-color: rgba(59, 59, 59, 150);"></div>
			<div class="t-edge-top" style="left: 12px; top: 109px; width: 166px;"></div>
			<div class="t-edge-bottom" style="left: 12px; top: 201px; width: 166px;"></div>
			<div class="t-edge-left" style="left: 10px; top: 109px; height: 100px;"></div>
			<div class="t-edge-right" style="left: 167px; top: 109px; height: 100px;"></div>
			<div class="t-corner t-tl" style="left: 10px; top: 109px;"></div>
			<div class="t-corner t-tr" style="left: 167px; top: 109px;"></div>
			<div class="t-corner t-bl" style="left: 10px; top: 201px;"></div>
			<div class="t-corner t-br" style="left: 167px; top: 201px;"></div>
		</div>

		<div class="line-box" data-for="b : boxes" data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
		     data-style-width="b.width + 'px'" data-style-height="b.height + 'px'"></div>
		<div class="line-mark" data-for="mk : marks" data-style-left="mk.left + 'px'" data-style-top="mk.top + 'px'">
			<div class="line-mark-cell" data-for="c : mk.cells" data-style-background-color="c"></div>
		</div>
		<span class="sharp-text gi-text" data-for="t : texts" data-class-bold="t.bold"
		      data-class-centred="t.align == 1" data-class-right="t.align == 2"
		      data-style-left="t.left + 'px'" data-style-top="t.top + 'px'" data-style-color="t.color"
		      data-style-font-size="t.text_px + 'px'"
		      data-style-width="t.width == 0 ? 'auto' : (t.width * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.text}}</span>

		<div class="gi-btn" data-for="b : buttons" data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
		     data-event-click="guild_info_button(b.index)">
			<span class="sharp-text gi-label" data-style-font-size="text_px + 'px'"
			      data-style-width="(64 * root_scale) + 'px'" data-style-top="label_top + 'px'"
			      data-style-line-height="label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{b.label}}</span>
		</div>

		<div id="btn_exit" data-event-click="guild_info_button(6)"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'">{{exit_tooltip}}</span>
	</div>
</body>
</rml>
