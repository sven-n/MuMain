<rml>
<head>
	<title>MU Helper Detail</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="mu_helper_common.rcss"/>
	<link type="text/rcss" href="mu_helper_detail.rcss"/>
</head>
<body>
	<!-- The MU Helper's detail panel (CMuHelperDetailWindow), docked in PanelColumnX(2) beside the
	     config window. `page` is EMuHelperDetailPage: 2/3 a skill's activation condition, 4/5/6 the
	     elf / summoner / standard recovery thresholds, 7/8 the standard / elf party support. Every
	     position is native's own m_Pos + K from the native Render(), in reference px under the root
	     transform; text leaves are .sharp-text layers at the native text size (character_info.rml has
	     the technique). themes/modern/mu_helper_detail.rml is this theme's sibling -- keep ids, model
	     fields and event names in step with it.

	     The four tabbed panes are laid out once by geometry rather than once per page -- each carries
	     the header of every page it appears on, and shows only the current one's. The gauges draw
	     here but take their input in C++ (CMuHelperDetailWindow::UpdateGauge). -->
	<div id="panel" data-model="mu_helper_detail" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span class="sharp-text mh-text mh-center mh-bold mh-title" data-class-hidden="!(page == 2 || page == 3)" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(190 * root_scale) + 'px'">{{labels.title_activation}}</span>
		<span class="sharp-text mh-text mh-center mh-bold mh-title" data-class-hidden="!(page == 4 || page == 5 || page == 6)" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(190 * root_scale) + 'px'">{{labels.title_recovery}}</span>
		<span class="sharp-text mh-text mh-center mh-bold mh-title" data-class-hidden="page != 7 &amp;&amp; page != 8" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(190 * root_scale) + 'px'">{{labels.title_party}}</span>

		<div id="pane_top" class="mh-pane" data-class-hidden="!(page == 2 || page == 3 || page == 4 || page == 5 || page == 6 || page == 7)">
			<div class="p p-fill-tab"></div>
			<div class="p p-fill-body"></div>
			<div class="p p-tab-tl"></div>
			<div class="p p-tab-tr"></div>
			<div class="p p-tab-top"></div>
			<div class="p p-tab-right"></div>
			<div class="p p-box-tr"></div>
			<div class="p p-box-bl"></div>
			<div class="p p-box-br"></div>
			<div class="p p-box-top"></div>
			<div class="p p-box-right"></div>
			<div class="p p-box-bottom"></div>
			<div class="p p-left"></div>
			<span class="sharp-text mh-text" data-class-hidden="!(page == 2 || page == 3)" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_precon}}</span>
			<span class="sharp-text mh-text" data-class-hidden="!(page == 4 || page == 5 || page == 6)" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_auto_potion}}</span>
			<span class="sharp-text mh-text" data-class-hidden="page != 7" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_buff_support}}</span>
		</div>
		<div id="pane_lower" class="mh-pane" data-class-hidden="!(page == 2 || page == 3 || page == 4 || page == 5)">
			<div class="p p-fill-tab"></div>
			<div class="p p-fill-body"></div>
			<div class="p p-tab-tl"></div>
			<div class="p p-tab-tr"></div>
			<div class="p p-tab-top"></div>
			<div class="p p-tab-right"></div>
			<div class="p p-box-tr"></div>
			<div class="p p-box-bl"></div>
			<div class="p p-box-br"></div>
			<div class="p p-box-top"></div>
			<div class="p p-box-right"></div>
			<div class="p p-box-bottom"></div>
			<div class="p p-left"></div>
			<span class="sharp-text mh-text" data-class-hidden="!(page == 2 || page == 3)" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_subcon}}</span>
			<span class="sharp-text mh-text" data-class-hidden="page != 4" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_auto_heal}}</span>
			<span class="sharp-text mh-text" data-class-hidden="page != 5" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_drain_life}}</span>
		</div>
		<div id="pane_heal_support" class="mh-pane mh-pane-h70" data-class-hidden="page != 8">
			<div class="p p-fill-tab"></div>
			<div class="p p-fill-body"></div>
			<div class="p p-tab-tl"></div>
			<div class="p p-tab-tr"></div>
			<div class="p p-tab-top"></div>
			<div class="p p-tab-right"></div>
			<div class="p p-box-tr"></div>
			<div class="p p-box-bl"></div>
			<div class="p p-box-br"></div>
			<div class="p p-box-top"></div>
			<div class="p p-box-right"></div>
			<div class="p p-box-bottom"></div>
			<div class="p p-left"></div>
			<span class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_heal_support}}</span>
		</div>
		<div id="pane_buff_support_elf" class="mh-pane" data-class-hidden="page != 8">
			<div class="p p-fill-tab"></div>
			<div class="p p-fill-body"></div>
			<div class="p p-tab-tl"></div>
			<div class="p p-tab-tr"></div>
			<div class="p p-tab-top"></div>
			<div class="p p-tab-right"></div>
			<div class="p p-box-tr"></div>
			<div class="p p-box-bl"></div>
			<div class="p p-box-br"></div>
			<div class="p p-box-top"></div>
			<div class="p p-box-right"></div>
			<div class="p p-box-bottom"></div>
			<div class="p p-left"></div>
			<span class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pane_buff_support}}</span>
		</div>

		<!-- Activation condition: which monsters trigger the skill, and how many. Radios. -->
		<div class="mhd-page" data-class-hidden="!(page == 2 || page == 3)">
			<div id="precon_range" class="mh-check mh-radio">
				<div class="checkbox-box" data-class-checked="precon == 0" data-event-click="muhelper_detail_precon(0)"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.precon_hunt_range}}</span>
			</div>
			<div id="precon_attacking" class="mh-check mh-radio">
				<div class="checkbox-box" data-class-checked="precon == 1" data-event-click="muhelper_detail_precon(1)"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.precon_attacking}}</span>
			</div>
			<div id="subcon_two" class="mh-check mh-radio">
				<div class="checkbox-box" data-class-checked="subcon == 0" data-event-click="muhelper_detail_subcon(0)"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.subcon_two}}</span>
			</div>
			<div id="subcon_three" class="mh-check mh-radio">
				<div class="checkbox-box" data-class-checked="subcon == 1" data-event-click="muhelper_detail_subcon(1)"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.subcon_three}}</span>
			</div>
			<div id="subcon_four" class="mh-check mh-radio">
				<div class="checkbox-box" data-class-checked="subcon == 2" data-event-click="muhelper_detail_subcon(2)"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.subcon_four}}</span>
			</div>
			<div id="subcon_five" class="mh-check mh-radio">
				<div class="checkbox-box" data-class-checked="subcon == 3" data-event-click="muhelper_detail_subcon(3)"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.subcon_five}}</span>
			</div>
		</div>

		<!-- Recovery: the potion threshold on every class, plus auto heal (elf) or drain life (summoner). -->
		<div class="mhd-page" data-class-hidden="!(page == 4 || page == 5 || page == 6)">
			<div id="gauge_potion" class="mh-gauge"></div>
			<div id="gauge_potion_fill" class="mh-gauge-fill" data-class-hidden="potion_level == 0"
			     data-style-width="(potion_level * 12.4) + 'px'"
			     data-style-decorator="'image(mh-gauge-fill-' + potion_level + ')'"></div>
			<span class="sharp-text mh-text mh-center" id="gauge_potion_label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(124 * root_scale) + 'px'">{{labels.hp_status}}</span>
		</div>
		<div class="mhd-page" data-class-hidden="page != 4 &amp;&amp; page != 5">
			<div id="gauge_heal" class="mh-gauge"></div>
			<div id="gauge_heal_fill" class="mh-gauge-fill" data-class-hidden="heal_level == 0"
			     data-style-width="(heal_level * 12.4) + 'px'"
			     data-style-decorator="'image(mh-gauge-fill-' + heal_level + ')'"></div>
			<span class="sharp-text mh-text mh-center" id="gauge_heal_label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(124 * root_scale) + 'px'">{{labels.hp_status}}</span>
		</div>

		<!-- Party support, standard classes. -->
		<div class="mhd-page" data-class-hidden="page != 7">
			<div id="party_duration" class="mh-check">
				<div class="checkbox-box" data-class-checked="party_duration" data-event-click="muhelper_detail_party_duration"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.party_duration}}</span>
			</div>
			<span class="sharp-text mh-text" id="time_space" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.time_space}}</span>
			<div id="buff_plate" class="mh-number-plate"></div>
			<input id="buff_interval" type="text" class="sharp-text text-field text-field--numeric mh-field"
			       data-value="buff_interval" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(17 * root_scale) + 'px'" data-style-height="(12 * root_scale) + 'px'"/>
			<span class="sharp-text mh-text" id="buff_unit" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">s</span>
		</div>

		<!-- Party support, elf: heal preference and its threshold above the same buff options. -->
		<div class="mhd-page" data-class-hidden="page != 8">
			<div id="party_heal" class="mh-check">
				<div class="checkbox-box" data-class-checked="party_heal" data-event-click="muhelper_detail_party_heal"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.party_heal}}</span>
			</div>
			<div id="gauge_party_heal" class="mh-gauge"></div>
			<div id="gauge_party_heal_fill" class="mh-gauge-fill" data-class-hidden="party_heal_level == 0"
			     data-style-width="(party_heal_level * 12.4) + 'px'"
			     data-style-decorator="'image(mh-gauge-fill-' + party_heal_level + ')'"></div>
			<span class="sharp-text mh-text mh-center" id="gauge_party_heal_label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(124 * root_scale) + 'px'">{{labels.hp_status_party}}</span>
			<div id="party_duration_elf" class="mh-check">
				<div class="checkbox-box" data-class-checked="party_duration" data-event-click="muhelper_detail_party_duration"></div>
				<span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.party_duration}}</span>
			</div>
			<span class="sharp-text mh-text" id="time_space_elf" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.time_space}}</span>
			<div id="buff_plate_elf" class="mh-number-plate"></div>
			<input id="buff_interval_elf" type="text" class="sharp-text text-field text-field--numeric mh-field"
			       data-value="buff_interval" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(17 * root_scale) + 'px'" data-style-height="(12 * root_scale) + 'px'"/>
			<span class="sharp-text mh-text" id="buff_unit_elf" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">s</span>
		</div>

		<div id="btn_save" class="mh-btn-igs" data-event-click="muhelper_detail_save"></div>
		<span class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-igs" id="btn_save_label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(52 * root_scale) + 'px'" data-style-height="(26 * root_scale) + 'px'" data-style-line-height="(26 * root_scale) + 'px'">{{labels.save}}</span>
		<div id="btn_init" class="mh-btn-igs" data-event-click="muhelper_detail_init"></div>
		<span class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-igs" id="btn_init_label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(52 * root_scale) + 'px'" data-style-height="(26 * root_scale) + 'px'" data-style-line-height="(26 * root_scale) + 'px'">{{labels.init}}</span>

		<div id="btn_exit" data-event-click="muhelper_detail_close"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{labels.close_tip}}</span></span>
	</div>
</body>
</rml>
