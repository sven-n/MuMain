<rml>
<head>
	<title>Jerint's Imperial Guardian entry background</title>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="event_item_entry_bg.rcss"/>
</head>
<body>
	<!-- Background-context document of empire_guardian_enter.rml: the docked frame and the separator line,
	     painted before the native 3D preview of the entry item so the item draws over them. Never
	     interactive. -->
	<div id="panel" data-model="empire_guardian_enter_bg" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>
		<div class="line"></div>
	</div>
</body>
</rml>
