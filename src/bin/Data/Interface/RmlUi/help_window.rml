<rml>
<head>
	<title>Help</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="help_window.rcss"/>
</head>
<!-- The F1 help window (CHelpWindow): the key page, then the chat page, as RenderTipTextList()
     laid them out. #panel is the original's screen (.stage); the box and the rows are reference
     px, spaced by the theme from the native renderer's line heights. Text is .sharp-text at the native size,
     counter-scaled out of the stage. -->
<body data-model="help_window">
	<div id="panel" class="stage">
		<div id="help_panel" data-style---text-width="content_width + 'px'"
		     data-style---line-height="line_height + 'px'" data-style---bold-line-height="bold_line_height + 'px'">
			<div class="help-line" data-for="line : lines"
			     data-class-heading="line.heading" data-class-half-spacer="line.half_spacer"><span class="sharp-text help-text" data-if="!line.half_spacer"
			       data-style-font-size="(line.heading ? bold_text_px : text_px) + 'px'">{{line.text}}</span></div>
		</div>
	</div>
</body>
</rml>
