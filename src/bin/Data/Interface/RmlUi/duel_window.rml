<rml>
<head>
	<title>Duel</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="duel_window.rcss"/>
</head>
<body data-model="duel_window">
	<!-- The duel score window (CDuelWindow) above the bottom HUD's right end: both duellists' names and
	     scores. Its workspace slot places #panel at the bottom HUD's scale. Text does not scale: each value takes
	     the native bold text size and cancels the scale with the inverse one. Takes no pointer events,
	     as the original took none. -->
	<div class="screen">
		<div id="panel">
			<div id="back"></div>
			<span class="duel-text hero counter-scaled" id="hero_name" data-style-font-size="bold_text_px + 'px'">{{hero_name}}</span>
			<span class="duel-text hero counter-scaled" id="hero_score" data-style-font-size="bold_text_px + 'px'">{{hero_score}}</span>
			<span class="duel-text enemy counter-scaled" id="enemy_name" data-style-font-size="bold_text_px + 'px'">{{enemy_name}}</span>
			<span class="duel-text enemy counter-scaled" id="enemy_score" data-style-font-size="bold_text_px + 'px'">{{enemy_score}}</span>
		</div>
	</div>
</body>
</rml>
