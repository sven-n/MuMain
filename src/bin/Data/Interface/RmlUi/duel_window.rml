<rml>
<head>
	<title>Duel</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="duel_window.rcss"/>
</head>
<body data-model="duel_window">
	<!-- The duel score window (CDuelWindow) above the bottom HUD's right end: both duellists' names and
	     scores. A LayoutMode::HudFrame window, so .screen carries the bottom HUD's uniform scale and
	     #panel sits at the window's reference position (m_Pos). Text does not scale: each value takes
	     the native bold text size and cancels the scale with the inverse one. Takes no pointer events,
	     as the original took none. -->
	<div class="screen" data-style-transform="'scale(' + scale_x + ', ' + scale_y + ')'" data-style---root-scale="scale_x" data-style---root-scale-y="scale_y">
		<div id="panel" data-style-left="panel_x + 'px'" data-style-top="panel_y + 'px'">
			<div id="back"></div>
			<span class="duel-text hero counter-scaled-xy" id="hero_name" data-style-font-size="bold_text_px + 'px'">{{hero_name}}</span>
			<span class="duel-text hero counter-scaled-xy" id="hero_score" data-style-font-size="bold_text_px + 'px'">{{hero_score}}</span>
			<span class="duel-text enemy counter-scaled-xy" id="enemy_name" data-style-font-size="bold_text_px + 'px'">{{enemy_name}}</span>
			<span class="duel-text enemy counter-scaled-xy" id="enemy_score" data-style-font-size="bold_text_px + 'px'">{{enemy_score}}</span>
		</div>
	</div>
</body>
</rml>
