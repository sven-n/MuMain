<rml>
<head>
	<title>Duel</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="duel_window.rcss"/>
</head>
<body data-model="duel_window">
	<!-- The duel score window (CDuelWindow) above the bottom HUD's right end: both duellists' names
	     and scores. A LayoutMode::Hud window, so .screen is the 640x480 reference screen stretched
	     W/640 x H/480 like the original and #panel sits at the window's reference position (m_Pos).
	     Text does not stretch: each value takes the native bold text size and cancels the stretch
	     with the inverse one. Takes no pointer events, as the original took none. -->
	<div class="screen" data-style-transform="'scale(' + scale_x + ', ' + scale_y + ')'">
		<div id="panel" data-style-left="panel_x + 'px'" data-style-top="panel_y + 'px'">
			<div id="back"></div>
			<span class="duel-text hero" id="hero_name" data-style-font-size="bold_text_px + 'px'"
			      data-style-transform="'scale(' + inverse_scale_x + ', ' + inverse_scale_y + ')'">{{hero_name}}</span>
			<span class="duel-text hero" id="hero_score" data-style-font-size="bold_text_px + 'px'"
			      data-style-transform="'scale(' + inverse_scale_x + ', ' + inverse_scale_y + ')'">{{hero_score}}</span>
			<span class="duel-text enemy" id="enemy_name" data-style-font-size="bold_text_px + 'px'"
			      data-style-transform="'scale(' + inverse_scale_x + ', ' + inverse_scale_y + ')'">{{enemy_name}}</span>
			<span class="duel-text enemy" id="enemy_score" data-style-font-size="bold_text_px + 'px'"
			      data-style-transform="'scale(' + inverse_scale_x + ', ' + inverse_scale_y + ')'">{{enemy_score}}</span>
		</div>
	</div>
</body>
</rml>
