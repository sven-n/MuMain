<rml>
<head>
	<title>NPC Quest</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="npc_quest.rcss"/>
</head>
<!-- CNPCQuest's own foreground document -- the legacy g_csQuest/CSQuest quest system's generic
     NPC-dialogue-with-quest-affordances screen (a separate, older system from CQuestMng, which
     CNPCDialogue/CQuestProgress use). Two mutually exclusive upper panels (conditions checklist with
     a live-3D item preview, or a Zen-cost banner) plus a shared dialogue/answers block below them.

     #content_root is the positioning root; the frame is #panel inside it, then the item preview,
     then every element below at its own absolute position in npc_quest.rcss. -->
<body>
	<div id="content_root" data-model="npc_quest"
	     data-style---text-px="text_px + 'px'">
		<div id="panel">
			<div class="frame-piece frame-top"></div>
			<div class="frame-piece frame-left"></div>
			<div class="frame-piece frame-right"></div>
			<div class="frame-piece frame-bottom"></div>
			<!-- Native RenderBackImage() always draws this divider under the dialogue text. -->
			<div class="nq-divider nq-divider-dialogue"></div>
		</div>
		<!-- The live 3D quest-condition items, drawn by C++ beside their rows over the frame. -->
		<img id="nq_item" class="nq-item"/>
		<span class="sharp-text" id="title" data-style-font-size="text_px + 'px'">{{npc_name}}</span>
		<div class="sharp-text nq-quest-title" data-class-hidden="!show_quest_title" data-style-font-size="text_px + 'px'">{{quest_title}}</div>

		<div class="nq-divider" data-class-hidden="!show_conditions"></div>
		<!-- id read live by NPCQuest.cpp's RenderItem3D() -- its own resolved position/child-row
		     height replace a hardcoded m_Pos+235/32px-step, so the still-native quest-item icon
		     preview stays aligned with these RmlUi-rendered rows across a theme change. -->
		<div id="conditions_anchor" class="sharp-text nq-conditions" data-class-hidden="!show_conditions" data-style-font-size="text_px + 'px'">
			<div class="nq-condition-row" data-for="c : conditions" data-style-color="c.color">{{c.text}}</div>
		</div>
		<div id="btn_complete" class="sharp-text nq-btn-complete" data-class-hidden="!show_conditions" data-style-font-size="text_px + 'px'"
		     data-class-disabled="!complete_enabled" data-event-click="npcquest_complete">{{complete_label}}</div>

		<div class="nq-cost" data-class-hidden="!show_cost">
			<span class="sharp-text nq-cost-label" data-style-font-size="text_px + 'px'">{{cost_label}}</span>
			<span class="sharp-text nq-cost-amount gold-amount" data-style-font-size="text_px + 'px'"
			      data-class-gold-base="cost_tier == 'base'"
			      data-class-gold-hundred-thousand="cost_tier == 'hundred-thousand'"
			      data-class-gold-million="cost_tier == 'million'"
			      data-class-gold-ten-million="cost_tier == 'ten-million'">{{cost_amount}}</span>
		</div>

		<!-- The messages and the answers, centred together on the dialogue band. With no quest in
		     progress the answers drop to their anchor under the cost banner, and the messages keep the
		     room the answers would have taken (--answer-lines). -->
		<div id="nq_dialogue" class="sharp-text sharp-flow centred" data-style-font-size="text_px + 'px'"
		     data-class-answers-anchored="!show_conditions" data-style---answer-lines="answers.size">
			<span class="nq-message-line" data-for="m : message_lines">{{m.text}}</span>
			<div class="nq-answers">
				<div class="nq-answer-row" data-for="a : answers"
				     data-event-click="npcquest_select_answer(a.index)">{{a.text}}</div>
			</div>
		</div>

		<div id="btn_exit" data-event-click="npcquest_click_close" data-attr-data-hint="exit_tooltip">
			<span class="btn-exit-label">×</span>
		</div>
		<div id="frame_corner_close" data-event-click="npcquest_click_close"></div>
	</div>
</body>
</rml>
