<rml>
<head>
	<title>Illusion Temple Result</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="cursed_temple_result.rcss"/>
</head>
<body>
	<!-- The Illusion Temple result window (CCursedTempleResult): a message-box frame with the
	     "Hero List" title, the column headings, the MU Alliance rows from y 65 and the Illusion
	     Sorcery rows from y 140 (the hero's on a red text box), the reward notice, Close, and the
	     victory / defeat banner fading in above the window. Dialog layout: root_x/root_y/root_scale
	     come from the Dialog transform; everything inside is reference px; text is .sharp-text at
	     the native size, counter-scaled out of the panel. C++ keeps the result packet, Escape and
	     the reward request; a click is queued with result_close. -->
	<div id="panel" data-model="cursed_temple_result" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div id="back"></div>
		<div id="frame_top"></div>
		<div class="frame-middle" style="top: 67px;"></div>
		<div class="frame-middle" style="top: 82px;"></div>
		<div class="frame-middle" style="top: 97px;"></div>
		<div class="frame-middle" style="top: 112px;"></div>
		<div class="frame-middle" style="top: 127px;"></div>
		<div class="frame-middle" style="top: 142px;"></div>
		<div class="frame-middle" style="top: 157px;"></div>
		<div class="frame-middle" style="top: 172px;"></div>
		<div class="frame-middle" style="top: 187px;"></div>
		<div class="frame-middle" style="top: 202px;"></div>
		<div class="frame-middle" style="top: 217px;"></div>
		<div id="frame_bottom"></div>
		<div class="line" style="top: 205px;"></div>
		<div class="line" style="top: 45px;"></div>

		<div class="result-banner success" data-if="banner == 1" data-style-left="banner_left + 'px'"
		     data-style-opacity="banner_alpha"></div>
		<div class="result-banner failure" data-if="banner == 2" data-style-left="banner_left + 'px'"
		     data-style-opacity="banner_alpha"></div>

		<div class="hero-row" data-for="row_top : hero_row_tops" data-style-top="row_top + 'px'"
		     data-style-height="(line_height_px / root_scale) + 'px'"></div>
		<span class="sharp-text result-text" data-for="t : texts" data-class-cell="t.width == 0"
		      data-style-left="t.left + 'px'" data-style-top="t.top + 'px'" data-style-color="t.color"
		      data-style-font-size="t.text_px + 'px'" data-style-width="t.width == 0 ? 'auto' : (t.width * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.text}}</span>

		<div class="result-btn" id="btn_close" data-event-click="result_close">
			<span class="sharp-text result-label" data-style-font-size="text_px + 'px'"
			      data-style-width="(54 * root_scale) + 'px'" data-style-top="label_top + 'px'"
			      data-style-line-height="label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{close_text}}</span>
		</div>
	</div>
</body>
</rml>
