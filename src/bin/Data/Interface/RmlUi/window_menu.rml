<rml>
<head>
	<title>Window Menu</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="window_menu.rcss"/>
</head>
<body data-model="window_menu">
	<!-- The window menu (CWindowMenu), opened from the bottom HUD: six rows above its right end. Drawn on
	     the HUD board: #screen is the 640x480 reference screen at the bottom HUD's scale, centred
	     like the HUD, and #panel sits at the original's reference point inside it.

	     Each label takes the native text renderer's physical size (text_px) and cancels the scale
	     (--root-scale), so its glyphs rasterise at the original's size.

	     A row click runs the row's action from C++ (windowmenu_select); the hover highlight and
	     arrows are the row's own :hover. -->
	<div id="screen" class="hud-board">
		<div id="panel">
			<div id="back"></div>
			<div id="frame_up"></div>
			<div class="frame-middles"><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div></div>
			<div id="frame_down"></div>
			<div class="lines"><div class="line"></div><div class="line"></div><div class="line"></div><div class="line"></div><div class="line"></div></div>

			<div id="rows">
				<div class="menu-row" data-for="row : rows" data-event-click="windowmenu_select(row.index)">
					<span class="menu-label counter-scaled" data-style-font-size="text_px + 'px'">{{row.label}}</span>
					<div class="arrow arrow-left"></div>
					<div class="arrow arrow-right"></div>
				</div>
			</div>
		</div>
	</div>
</body>
</rml>
