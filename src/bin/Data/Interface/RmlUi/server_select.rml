<rml>
<head>
	<title>Select Server</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="server_select.rcss"/>
</head>
<body data-model="server_select">
	<div id="panel" class="center-both">
		<div id="group_row">
			<div id="test_server_btn" class="group-btn" data-class-hidden="!test_server_visible" data-class-checked="test_server_checked"
			     data-event-click="serversel_select_group(0)">{{test_server_label}}</div>
			<div id="left_col" class="group-col">
				<div class="group-btn" data-for="g : left_groups" data-class-checked="g.checked"
				     data-event-click="serversel_select_group(g.btn_pos)">{{g.label}}</div>
			</div>
			<div id="right_col" class="group-col">
				<div class="group-btn" data-for="g : right_groups" data-class-checked="g.checked"
				     data-event-click="serversel_select_group(g.btn_pos)">{{g.label}}</div>
			</div>
		</div>

		<!-- Flyout, not a fixed panel region -- absent until a group button is clicked, then docks
		     beside that specific button (server_list_top/dock_left/dock_right), same as a nested
		     context menu's submenu. See ServerSelRmlModel's own comment (ServerSelWin.h). -->
		<div id="server_list" data-class-hidden="!server_list_visible" data-class-dock-left="server_list_dock_left"
		     data-class-dock-right="server_list_dock_right" data-class-dock-center="!server_list_dock_left && !server_list_dock_right"
		     data-style-top="server_list_top + 'px'">
			<div class="server-row" data-for="s : servers" data-class-gray="s.color_gray" data-class-orange="s.color_orange"
			     data-event-click="serversel_select_server(s.index)">{{s.label}}
				<div class="server-gauge-slot"><div class="server-gauge-fill" data-style-width="s.load_fraction * 100 + '%'"></div></div>
			</div>
		</div>

		<div id="pvp_notice" data-class-hidden="!pvp_notice">
			<div class="pvp-line">{{pvp_notice_line0}}</div>
			<div class="pvp-line">{{pvp_notice_line1}}</div>
			<div class="pvp-line">{{pvp_notice_line2}}</div>
		</div>

		<div id="desc_panel">{{description_text}}</div>
	</div>
</body>
</rml>
