<rml>
<head>
	<title>Kanturu</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="kanturu_enter.rcss"/>
</head>
<body>
	<!-- Kanturu's entry window (CKanturu2ndEnterNpc): a message-box frame with the state subject,
	     the state texts and the Refresh / Enter / Close buttons. Dialog layout: root_x/root_y/
	     root_scale come from the Dialog transform; everything inside is reference px; text is
	     .sharp-text at the native size, counter-scaled out of the panel. C++ keeps the texts, the
	     button locks, the equipment checks, Escape and the requests; a click is queued with
	     kanturu_refresh / kanturu_enter / kanturu_close. -->
	<div id="panel" data-model="kanturu_enter" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale">
		<div id="back"></div>
		<div id="frame_top"></div>
		<div class="frame-middles"><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div></div>
		<div id="frame_bottom"></div>

		<!-- The lines sit where the wrapping put them; what each one is, the theme styles. -->
		<span class="sharp-text kanturu-line" data-for="line : lines"
		      data-class-tone-subject="line.kind == 'subject'" data-class-tone-state="line.kind == 'state'"
		      data-class-tone-note="line.kind == 'note'"
		      data-style-top="line.top + 'px'" data-style-font-size="line.text_px + 'px'">{{line.text}}</span>

		<div class="kanturu-btn" id="btn_refresh" data-class-locked="refresh_locked" data-event-click="kanturu_refresh">
			<span class="sharp-text sharp-middle kanturu-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="label_line_px + 'px'">{{refresh_text}}</span>
		</div>
		<div class="kanturu-btn" id="btn_enter" data-class-locked="enter_locked" data-event-click="kanturu_enter">
			<span class="sharp-text sharp-middle kanturu-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="label_line_px + 'px'">{{enter_text}}</span>
		</div>
		<div class="kanturu-btn" id="btn_close" data-event-click="kanturu_close">
			<span class="sharp-text sharp-middle kanturu-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="label_line_px + 'px'">{{close_text}}</span>
		</div>
	</div>
</body>
</rml>
