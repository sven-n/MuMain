<rml>
<head>
	<title>Kanturu</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="kanturu_enter.rcss"/>
</head>
<body>
	<!-- Kanturu's entry window (CKanturu2ndEnterNpc): a message-box frame with the state subject,
	     the state texts and the Refresh / Enter / Close buttons. Dialog layout: root_x/root_y/
	     root_scale come from the Dialog transform; everything inside is reference px; text is
	     .sharp-text at the native size, counter-scaled out of the panel. C++ keeps the texts, the
	     button locks, the equipment checks, Escape and the requests; a click is queued with
	     kanturu_refresh / kanturu_enter / kanturu_close. -->
	<div id="panel" data-model="kanturu_enter" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div id="back"></div>
		<div id="frame_top"></div>
		<div class="frame-middle" style="top: 67px;"></div>
		<div class="frame-middle" style="top: 82px;"></div>
		<div class="frame-middle" style="top: 97px;"></div>
		<div class="frame-middle" style="top: 112px;"></div>
		<div class="frame-middle" style="top: 127px;"></div>
		<div class="frame-middle" style="top: 142px;"></div>
		<div class="frame-middle" style="top: 157px;"></div>
		<div class="frame-middle" style="top: 172px;"></div>
		<div class="frame-middle" style="top: 187px;"></div>
		<div class="frame-middle" style="top: 202px;"></div>
		<div id="frame_bottom"></div>

		<span class="sharp-text kanturu-line" data-for="line : lines" data-class-bold="line.bold"
		      data-class-tone-state="line.tone == 1" data-class-tone-note="line.tone == 2"
		      data-style-top="line.top + 'px'" data-style-font-size="line.text_px + 'px'"
		      data-style-width="(230 * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{line.text}}</span>

		<div class="kanturu-btn" id="btn_refresh" data-class-locked="refresh_locked" data-event-click="kanturu_refresh">
			<span class="sharp-text kanturu-label" data-style-font-size="text_px + 'px'"
			      data-style-width="(53 * root_scale) + 'px'" data-style-top="label_top + 'px'"
			      data-style-line-height="label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{refresh_text}}</span>
		</div>
		<div class="kanturu-btn" id="btn_enter" data-class-locked="enter_locked" data-event-click="kanturu_enter">
			<span class="sharp-text kanturu-label" data-style-font-size="text_px + 'px'"
			      data-style-width="(53 * root_scale) + 'px'" data-style-top="label_top + 'px'"
			      data-style-line-height="label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{enter_text}}</span>
		</div>
		<div class="kanturu-btn" id="btn_close" data-event-click="kanturu_close">
			<span class="sharp-text kanturu-label" data-style-font-size="text_px + 'px'"
			      data-style-width="(53 * root_scale) + 'px'" data-style-top="label_top + 'px'"
			      data-style-line-height="label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{close_text}}</span>
		</div>
	</div>
</body>
</rml>
