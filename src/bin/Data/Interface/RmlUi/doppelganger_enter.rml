<rml>
<head>
	<title>Lugard's Doppelganger entry (CDoppelGangerWindow)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="event_item_entry.rcss"/>
	<link type="text/rcss" href="doppelganger_enter_rows.rcss"/>
</head>
<body>
	<!-- Lugard's Doppelganger entry window (CDoppelGangerWindow), docked right: the docked frame, the live 3D
	     preview of the entry item, its texts and buttons (UI/Events/EventItemEntryView.h).
	     root_x/root_y/root_scale come from the dock transform; everything inside is reference px; text is .sharp-text at the native size, counter-scaled
	     out of the panel. C++ keeps the corner close, Escape and the requests; a click is queued
	     with item_entry_press. -->
	<div id="panel" data-model="doppelganger_enter" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- The docked frame. -->
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>
		<div class="entry-line"></div>
		<!-- The live 3D preview, drawn by C++ at its original place over the frame. -->
		<img id="entry_item" class="entry-item"/>
		<!-- The rows these land on are the theme's: this document's own _rows.rcss gives one
		     :nth-child rule per line and per button. Each repeated set has its own container so
		     the count starts at the first one. -->
		<div class="entry-texts">
			<div class="entry-text" data-for="t : texts">
				<span class="sharp-text sharp-centre"
				      data-style-font-size="t.text_px + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.text}}</span>
			</div>
		</div>

		<div class="entry-buttons">
			<div class="entry-btn" data-for="b, i : buttons" data-class-locked="b.locked"
			     data-event-click="item_entry_press(i)" data-attr-data-hint="b.hint">
				<span class="sharp-text sharp-middle sharp-centre entry-label" data-if="b.label != ''"
				      data-style-font-size="(b.bold ? bold_text_px : text_px) + 'px'"
				      data-style-line-height="b.label_line_px + 'px'"
				      data-style-transform="'translateY(-50%) scale(' + (1 / root_scale) + ')'">{{b.label}}</span>
			</div>
		</div>
	</div>
</body>
</rml>
