<rml>
<head>
	<title>MU Helper</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="skill_icons.rcss"/>
	<link type="text/rcss" href="master_skill_icons.rcss"/>
	<link type="text/rcss" href="mu_helper_common.rcss"/>
	<link type="text/rcss" href="mu_helper_config.rcss"/>
</head>
<body>
	<!-- The MU Helper's configuration window (CMuHelperConfigWindow), docked in PanelColumnX(1).
	     Three tabs over one staged copy of the bot's settings. Every position is native's own
	     m_Pos + K from the draw and registration calls it replaces, in reference px under the root
	     transform; text leaves are .sharp-text layers at the native text size (character_info.rml).
	     themes/modern/mu_helper_config.rml is this theme's sibling -- keep ids, model fields and
	     event names in step with it.

	     Which class-specific controls show is `features`, resolved in C++
	     (UI::MuHelper::ResolveClassFeatures) -- a game rule, so it never lives in a theme. -->
	<div id="panel" data-model="mu_helper_config" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span id="title" class="sharp-text mh-text mh-center mh-bold mh-title" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(panel_width * root_scale) + 'px'">{{labels.title}}</span>

		<div id="tab_0" class="mh-tab" data-class-active="active_tab == 0" data-event-click="muhelper_tab(0)"></div><span id="tab_0_label" class="sharp-text mh-text mh-center mh-tab-label" data-class-active="active_tab == 0" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(56 * root_scale) + 'px'" data-style-height="(22 * root_scale) + 'px'" data-style-line-height="(22 * root_scale) + 'px'">{{labels.tab_hunting}}</span>
		<div id="tab_1" class="mh-tab" data-class-active="active_tab == 1" data-event-click="muhelper_tab(1)"></div><span id="tab_1_label" class="sharp-text mh-text mh-center mh-tab-label" data-class-active="active_tab == 1" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(56 * root_scale) + 'px'" data-style-height="(22 * root_scale) + 'px'" data-style-line-height="(22 * root_scale) + 'px'">{{labels.tab_obtaining}}</span>
		<div id="tab_2" class="mh-tab" data-class-active="active_tab == 2" data-event-click="muhelper_tab(2)"></div><span id="tab_2_label" class="sharp-text mh-text mh-center mh-tab-label" data-class-active="active_tab == 2" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(56 * root_scale) + 'px'" data-style-height="(22 * root_scale) + 'px'" data-style-line-height="(22 * root_scale) + 'px'">{{labels.tab_other}}</span>

		<!-- Hunting -->
		<div class="mhc-tab" data-class-hidden="active_tab != 0">
			<div id="box_h_range" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_h_recovery" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_h_movement" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_h_skills" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_h_buffs" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<span id="h_range_label" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.range}}</span>
			<span id="h_range_rule" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">________</span>
			<div id="h_range_digit" class="mh-range-digit" data-style-decorator="'image(mh-range-' + hunt_range + ')'"></div>
			<div id="btn_hunt_add" class="mh-btn-plus" data-event-click="muhelper_button('hunt_add')"></div>
			<div id="btn_hunt_minus" class="mh-btn-minus" data-event-click="muhelper_button('hunt_minus')"></div>
			<div id="cb_potion" class="mh-check"><div class="checkbox-box" data-class-checked="checks.potion" data-event-click="muhelper_toggle('potion')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.potion}}</span></div>
			<div id="cb_auto_heal" class="mh-check" data-class-hidden="!features.auto_heal"><div class="checkbox-box" data-class-checked="checks.auto_heal" data-event-click="muhelper_toggle('auto_heal')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.auto_heal}}</span></div>
			<div id="cb_drain_life" class="mh-check" data-class-hidden="!features.drain_life"><div class="checkbox-box" data-class-checked="checks.drain_life" data-event-click="muhelper_toggle('drain_life')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.drain_life}}</span></div>
			<div id="btn_potion_setting" class="mh-btn-setting" data-class-summoner="features.potion_summoner" data-event-click="muhelper_button('potion_setting')"></div><span id="btn_potion_setting_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-setting" data-class-summoner="features.potion_summoner" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(38 * root_scale) + 'px'" data-style-height="(24 * root_scale) + 'px'" data-style-line-height="(24 * root_scale) + 'px'">{{labels.setting}}</span>
			<div id="cb_long_distance" class="mh-check"><div class="checkbox-box" data-class-checked="checks.long_distance" data-event-click="muhelper_toggle('long_distance')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.long_distance}}</span></div>
			<div id="cb_orig_position" class="mh-check"><div class="checkbox-box" data-class-checked="checks.orig_position" data-event-click="muhelper_toggle('orig_position')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.orig_position}}</span></div>
			<span id="distance_label" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.distance}}</span>
			<div id="distance_plate" class="mh-number-plate"></div>
			<input id="distance_time" type="text" class="sharp-text text-field text-field--numeric mh-field" data-value="distance_time" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(17 * root_scale) + 'px'" data-style-height="(12 * root_scale) + 'px'"/>
			<span id="distance_unit" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.seconds}}</span>
			<span id="basic_skill_label" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.basic_skill}}</span>
			<span id="activation1_label" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.activation_skill1}}</span>
			<div id="slot_0" class="mh-slot" data-event-click="muhelper_slot(0)" data-event-mouseup="muhelper_slot_clear(0)"><div class="mh-slot-icon" data-style-decorator="slots.s0"></div></div>
			<div id="slot_1" class="mh-slot" data-event-click="muhelper_slot(1)" data-event-mouseup="muhelper_slot_clear(1)"><div class="mh-slot-icon" data-style-decorator="slots.s1"></div></div>
			<div id="cb_skill2_delay" class="mh-check"><div class="checkbox-box" data-class-checked="checks.skill2_delay" data-event-click="muhelper_toggle('skill2_delay')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.delay}}</span></div>
			<div id="skill2_plate" class="mh-number-plate"></div>
			<input id="skill2_delay" type="text" class="sharp-text text-field text-field--numeric mh-field" data-value="skill2_delay" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(17 * root_scale) + 'px'" data-style-height="(12 * root_scale) + 'px'"/>
			<span id="skill2_unit" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.seconds}}</span>
			<div id="cb_skill2_condition" class="mh-check"><div class="checkbox-box" data-class-checked="checks.skill2_condition" data-event-click="muhelper_toggle('skill2_condition')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.condition}}</span></div>
			<div id="btn_skill2_setting" class="mh-btn-setting" data-event-click="muhelper_button('skill2_setting')"></div><span id="btn_skill2_setting_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-setting" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(38 * root_scale) + 'px'" data-style-height="(24 * root_scale) + 'px'" data-style-line-height="(24 * root_scale) + 'px'">{{labels.setting}}</span>
			<span id="activation2_label" class="sharp-text mh-text" data-class-hidden="!features.skill3" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.activation_skill2}}</span>
			<div id="slot_2" class="mh-slot" data-class-hidden="!features.skill3" data-event-click="muhelper_slot(2)" data-event-mouseup="muhelper_slot_clear(2)"><div class="mh-slot-icon" data-style-decorator="slots.s2"></div></div>
			<div id="cb_skill3_delay" class="mh-check" data-class-hidden="!features.skill3"><div class="checkbox-box" data-class-checked="checks.skill3_delay" data-event-click="muhelper_toggle('skill3_delay')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.delay}}</span></div>
			<div id="skill3_plate" class="mh-number-plate" data-class-hidden="!features.skill3"></div>
			<input id="skill3_delay" type="text" class="sharp-text text-field text-field--numeric mh-field" data-class-hidden="!features.skill3" data-value="skill3_delay" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(17 * root_scale) + 'px'" data-style-height="(12 * root_scale) + 'px'"/>
			<span id="skill3_unit" class="sharp-text mh-text" data-class-hidden="!features.skill3" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.seconds}}</span>
			<div id="cb_skill3_condition" class="mh-check" data-class-hidden="!features.skill3"><div class="checkbox-box" data-class-checked="checks.skill3_condition" data-event-click="muhelper_toggle('skill3_condition')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.condition}}</span></div>
			<div id="btn_skill3_setting" class="mh-btn-setting" data-class-hidden="!features.skill3" data-event-click="muhelper_button('skill3_setting')"></div><span id="btn_skill3_setting_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-setting" data-class-hidden="!features.skill3" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(38 * root_scale) + 'px'" data-style-height="(24 * root_scale) + 'px'" data-style-line-height="(24 * root_scale) + 'px'">{{labels.setting}}</span>
			<div id="cb_combo" class="mh-check" data-class-hidden="!features.combo"><div class="checkbox-box" data-class-checked="checks.combo" data-event-click="muhelper_toggle('combo')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.combo}}</span></div>
			<div id="cb_fallback" class="mh-check"><div class="checkbox-box" data-class-checked="checks.fallback" data-event-click="muhelper_toggle('fallback')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.fallback}}</span></div>
			<div id="cb_use_pet" class="mh-check" data-class-hidden="!features.pet"><div class="checkbox-box" data-class-checked="checks.use_pet" data-event-click="muhelper_toggle('use_pet')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.use_pet}}</span></div>
			<div id="rb_raven_cease" class="mh-check mh-radio" data-class-hidden="!features.pet"><div class="checkbox-box" data-class-checked="raven_mode == 0" data-event-click="muhelper_raven_mode(0)"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.raven_cease}}</span></div>
			<div id="rb_raven_auto" class="mh-check mh-radio" data-class-hidden="!features.pet"><div class="checkbox-box" data-class-checked="raven_mode == 1" data-event-click="muhelper_raven_mode(1)"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.raven_auto}}</span></div>
			<div id="rb_raven_together" class="mh-check mh-radio" data-class-hidden="!features.pet"><div class="checkbox-box" data-class-checked="raven_mode == 2" data-event-click="muhelper_raven_mode(2)"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.raven_together}}</span></div>
			<div id="cb_party" class="mh-check" data-class-hidden="!features.party"><div class="checkbox-box" data-class-checked="checks.party" data-event-click="muhelper_toggle('party')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.party}}</span></div>
			<div id="btn_party_setting" class="mh-btn-setting" data-class-hidden="!features.party" data-event-click="muhelper_button('party_setting')"></div><span id="btn_party_setting_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-setting" data-class-hidden="!features.party" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(38 * root_scale) + 'px'" data-style-height="(24 * root_scale) + 'px'" data-style-line-height="(24 * root_scale) + 'px'">{{labels.setting}}</span>
			<div id="cb_buff_duration" class="mh-check"><div class="checkbox-box" data-class-checked="checks.buff_duration" data-event-click="muhelper_toggle('buff_duration')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.buff_duration}}</span></div>
			<div id="slot_3" class="mh-slot" data-event-click="muhelper_slot(3)" data-event-mouseup="muhelper_slot_clear(3)"><div class="mh-slot-icon" data-style-decorator="slots.s3"></div></div>
			<div id="slot_4" class="mh-slot" data-event-click="muhelper_slot(4)" data-event-mouseup="muhelper_slot_clear(4)"><div class="mh-slot-icon" data-style-decorator="slots.s4"></div></div>
			<div id="slot_5" class="mh-slot" data-event-click="muhelper_slot(5)" data-event-mouseup="muhelper_slot_clear(5)"><div class="mh-slot-icon" data-style-decorator="slots.s5"></div></div>
		</div>

		<!-- Item pick-up -->
		<div class="mhc-tab" data-class-hidden="active_tab != 1">
			<div id="box_o_range" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_o_repair" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_o_mode" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_o_items" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_o_list" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<span id="o_range_label" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.range}}</span>
			<span id="o_range_rule" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">________</span>
			<div id="o_range_digit" class="mh-range-digit" data-style-decorator="'image(mh-range-' + pick_range + ')'"></div>
			<div id="btn_pick_add" class="mh-btn-plus" data-event-click="muhelper_button('pick_add')"></div>
			<div id="btn_pick_minus" class="mh-btn-minus" data-event-click="muhelper_button('pick_minus')"></div>
			<div id="cb_repair" class="mh-check"><div class="checkbox-box" data-class-checked="checks.repair" data-event-click="muhelper_toggle('repair')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.repair}}</span></div>
			<div id="cb_pick_all" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_all" data-event-click="muhelper_toggle('pick_all')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_all}}</span></div>
			<div id="cb_pick_selected" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_selected" data-event-click="muhelper_toggle('pick_selected')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_selected}}</span></div>
			<div id="cb_pick_jewel" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_jewel" data-event-click="muhelper_toggle('pick_jewel')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_jewel}}</span></div>
			<div id="cb_pick_ancient" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_ancient" data-event-click="muhelper_toggle('pick_ancient')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_ancient}}</span></div>
			<div id="cb_pick_zen" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_zen" data-event-click="muhelper_toggle('pick_zen')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_zen}}</span></div>
			<div id="cb_pick_excellent" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_excellent" data-event-click="muhelper_toggle('pick_excellent')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_excellent}}</span></div>
			<div id="cb_pick_extra" class="mh-check"><div class="checkbox-box" data-class-checked="checks.pick_extra" data-event-click="muhelper_toggle('pick_extra')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.pick_extra}}</span></div>
			<div id="item_plate" class="mh-string-plate"></div>
			<input id="item_name" type="text" class="sharp-text text-field mh-field" data-value="item_name" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(88 * root_scale) + 'px'" data-style-height="(12 * root_scale) + 'px'"/>
			<div id="btn_add_item" class="mh-btn-setting" data-event-click="muhelper_button('add_item')"></div><span id="btn_add_item_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-setting" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(38 * root_scale) + 'px'" data-style-height="(24 * root_scale) + 'px'" data-style-line-height="(24 * root_scale) + 'px'">{{labels.add}}</span>
			<div id="extra_list" class="sharp-text scroll-pane" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(160 * root_scale) + 'px'" data-style-height="(70 * root_scale) + 'px'">
				<div class="mh-extra-row" data-for="it : extra_items" data-class-selected="it.selected" data-event-click="muhelper_extra_select(it.index)" data-style-height="(13 * root_scale) + 'px'" data-style-padding="(3 * root_scale) + 'px 0 0 ' + (8 * root_scale) + 'px'">{{it.name}}</div>
			</div>
			<div id="btn_delete_item" class="mh-btn-setting" data-event-click="muhelper_button('delete_item')"></div><span id="btn_delete_item_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-setting" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(38 * root_scale) + 'px'" data-style-height="(24 * root_scale) + 'px'" data-style-line-height="(24 * root_scale) + 'px'">{{labels.remove}}</span>
		</div>

		<!-- Other settings -->
		<div class="mhc-tab" data-class-hidden="active_tab != 2">
			<div id="box_x_accept" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="box_x_defend" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<div id="cb_auto_friend" class="mh-check"><div class="checkbox-box" data-class-checked="checks.auto_friend" data-event-click="muhelper_toggle('auto_friend')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.auto_friend}}</span></div>
			<div id="cb_auto_guild" class="mh-check"><div class="checkbox-box" data-class-checked="checks.auto_guild" data-event-click="muhelper_toggle('auto_guild')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.auto_guild}}</span></div>
			<div id="cb_auto_defend" class="mh-check"><div class="checkbox-box" data-class-checked="checks.auto_defend" data-event-click="muhelper_toggle('auto_defend')"></div><span class="sharp-text mh-text checkbox-label" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.auto_defend}}</span></div>
		</div>

		<!-- The extension-function note native drew under the second and third tabs. -->
		<div class="mhc-tab" data-class-hidden="active_tab == 0">
			<div id="box_extension" class="mh-box"><div class="b b-fill"></div><div class="b b-tl"></div><div class="b b-tr"></div><div class="b b-bl"></div><div class="b b-br"></div><div class="b b-top"></div><div class="b b-right"></div><div class="b b-bottom"></div><div class="b b-left"></div></div>
			<span id="extension_used" class="sharp-text mh-text" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.extension_used}}</span>
			<span id="extension_none" class="sharp-text mh-text mh-orange" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'">{{labels.extension_none}}</span>
		</div>

		<div id="btn_save" class="mh-btn-igs" data-event-click="muhelper_button('save')"></div><span id="btn_save_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-igs" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(52 * root_scale) + 'px'" data-style-height="(26 * root_scale) + 'px'" data-style-line-height="(26 * root_scale) + 'px'">{{labels.save}}</span>
		<div id="btn_init" class="mh-btn-igs" data-event-click="muhelper_button('init')"></div><span id="btn_init_label" class="sharp-text mh-text mh-center mh-btn-label mh-btn-label-igs" data-style-font-size="text_px + 'px'" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-width="(52 * root_scale) + 'px'" data-style-height="(26 * root_scale) + 'px'" data-style-line-height="(26 * root_scale) + 'px'">{{labels.init}}</span>

		<div id="btn_exit" data-event-click="muhelper_button('close')"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{labels.close_tip}}</span></span>
	</div>
</body>
</rml>
