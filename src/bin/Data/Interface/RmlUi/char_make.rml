<rml>
<head>
	<title>Character Creation</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="char_make.rcss"/>
</head>
<body data-model="char_make">
	<!-- Character-creation dialog; #panel has no background so the live 3D preview shows through
	     around its children. -->
	<div id="panel">
		<!-- Decorative backdrops (modern only) -- siblings, not parents, so nesting doesn't shift the
		     existing #panel-relative positions of the real content below. -->
		<div id="attributes_panel" class="side-panel"></div>
		<span class="panel-kicker panel-kicker-attributes">Base Attributes</span>

		<div id="class_panel" class="side-panel"></div>
		<span class="panel-kicker panel-kicker-class">Class</span>

		<div id="identity_strip" class="side-panel"></div>

		<div class="job-btn" data-for="job : jobs" data-class-checked="job.checked" data-class-disabled="job.disabled"
		     data-style-left="job.rel_left + 'px'" data-style-top="job.rel_top + 'px'"
		     data-event-click="charmake_select_job(it_index)">{{job.label}}</div>

		<div id="stat_panel" class="stat-panel">
			<div class="stat-bg" data-class-tall="dark_lord_extra"></div>
			<div class="stat-row" style="top: 10px;"><span class="stat-label">{{stat_label0}}</span><span class="stat-value">{{stat_value0}}</span></div>
			<div class="stat-row" style="top: 27px;"><span class="stat-label">{{stat_label1}}</span><span class="stat-value">{{stat_value1}}</span></div>
			<div class="stat-row" style="top: 44px;"><span class="stat-label">{{stat_label2}}</span><span class="stat-value">{{stat_value2}}</span></div>
			<div class="stat-row" style="top: 61px;"><span class="stat-label">{{stat_label3}}</span><span class="stat-value">{{stat_value3}}</span></div>
			<div class="stat-row" style="top: 78px;" data-class-hidden="!dark_lord_extra"><span class="stat-label">{{stat_label4}}</span><span class="stat-value">25</span></div>
		</div>

		<!-- desc-line-1/-2 use classes, not inline style like stat-row, so modern can add
		     .desc-title above without touching legacy's unchanged offsets -- inline style can't
		     be overridden per-theme. -->
		<div id="desc_panel" class="desc-panel">
			<div class="desc-bg"></div>
			<div class="desc-title">{{desc_title}}</div>
			<div class="desc-line desc-line-1">{{desc_line1}}</div>
			<div class="desc-line desc-line-2">{{desc_line2}}</div>
		</div>

		<!-- "Name" label needed only by modern -- legacy's cha_id.tga sprite already bakes it into
		     the art. Static text, not {{...}}-bound, matching other hardcoded captions. -->
		<span id="input_label" class="input-label">Name</span>

		<!-- Frame art behind the field; each theme positions/sizes both to agree. -->
		<div id="input_frame" class="input-frame"></div>

		<!-- Character name. Stock RmlUi <input>: owns the edit buffer, caret, selection and IME, and
		     two-way binds the committed value to CharMakeRmlModel::charName (copied into the legacy
		     InputText[0] buffer only at submit time). autofocus replaces the old
		     g_pSingleTextInputBox->GiveFocus() -- ElementDocument::Show()'s FocusFlag::Auto picks it
		     up. maxlength comes from C++ (ApplyNameLimit()). Replaces #input_text_anchor, which only
		     existed so C++ could position a native widget over this frame. -->
		<input id="char_name" type="text" class="text-field char-make-name-field"
		       data-value="char_name" autofocus/>

		<div id="btn_ok" class="btn btn-ok" data-event-click="charmake_ok_click">{{ok_label}}</div>
		<div id="btn_cancel" class="btn btn-cancel" data-event-click="charmake_cancel_click">{{cancel_label}}</div>
	</div>
</body>
</rml>
