<rml>
<head>
	<title>Delgado's lucky coin registration (CRegistrationLuckyCoin) background</title>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="lucky_coin_bg.rcss"/>
</head>
<body>
	<!-- Background-context document of lucky_coin_registration.rml: the docked frame, painted before the
	     native windows and the 3D coin. Never interactive. -->
	<div id="panel" data-model="lucky_coin_registration_bg" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>
	</div>
</body>
</rml>
