<rml>
<head>
	<title>Guard NPC</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="gateman.rcss"/>
</head>
<body>
	<!-- The castle gatekeeper (CGatemanWindow), docked right: the guest, guild member or guild
	     master page. For the master: the public toggle, the fee backdrop
	     and the fee arrows. root_x/root_y/root_scale come from the dock transform; every position
	     and size below is the theme's. A .sharp-text layer's font size stays bound: it is laid
	     out in physical pixels and counter-scaled out of the panel (base.rcss). C++ keeps
	     the gatekeeper state and every request; a click is queued with gateman_button(n). -->
	<div id="panel" data-model="gateman" data-class-master="page == 1"
	     data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span id="heading" class="sharp-text gk-heading"
		      data-style-font-size="title.text_px + 'px'">{{title.text}}</span>

		<div class="gk-page" data-if="page == 1">
			<div id="public_toggle" data-event-click="gateman_public_toggle">
				<div id="checkbox"><div id="check_mark" data-if="is_public"></div></div>
			</div>
			<div id="fee_back"></div>
			<div class="fee-btn fee-up" data-event-click="gateman_button(2)"></div>
			<div class="fee-btn fee-down" data-event-click="gateman_button(3)"></div>

			<span id="restriction" class="sharp-text gk-line"
			      data-style-font-size="restriction.text_px + 'px'">{{restriction.text}}</span>
			<span id="members_1" class="sharp-text gk-line"
			      data-style-font-size="members_line1.text_px + 'px'">{{members_line1.text}}</span>
			<span id="members_2" class="sharp-text gk-line"
			      data-style-font-size="members_line2.text_px + 'px'">{{members_line2.text}}</span>
			<span id="members_3" class="sharp-text gk-line"
			      data-style-font-size="members_line3.text_px + 'px'">{{members_line3.text}}</span>
			<span id="open_to_non_members" class="sharp-text gk-note"
			      data-style-font-size="open_to_non_members.text_px + 'px'">{{open_to_non_members.text}}</span>
			<span id="entrance_fee" class="sharp-text gk-note" data-style-font-size="entrance_fee.text_px + 'px'">{{entrance_fee.text}}</span>
			<span id="fee_setting_label" class="sharp-text gk-line"
			      data-style-font-size="fee_setting_label.text_px + 'px'">{{fee_setting_label.text}}</span>
			<span id="view_fee" class="sharp-text sharp-right gk-note" data-style-font-size="view_fee.text_px + 'px'">{{view_fee.text}}</span>
			<span id="fee_range" class="sharp-text gk-line"
			      data-style-font-size="fee_range.text_px + 'px'">{{fee_range.text}}</span>
			<span id="fee_range_for" class="sharp-text gk-line"
			      data-style-font-size="fee_range_for.text_px + 'px'">{{fee_range_for.text}}</span>
			<span id="fee_increment" class="sharp-text gk-line"
			      data-style-font-size="fee_increment.text_px + 'px'">{{fee_increment.text}}</span>
		</div>

		<div class="gk-page" data-if="page == 2">
			<span id="member_question" class="sharp-text gk-line"
			      data-style-font-size="member_question.text_px + 'px'">{{member_question.text}}</span>
		</div>

		<div class="gk-page" data-if="page == 3">
			<div data-if="is_public">
				<span id="guest_fee" class="sharp-text gk-line" data-class-unaffordable="!guest_can_afford" data-style-font-size="guest_fee.text_px + 'px'">{{guest_fee.text}}</span>
				<span id="guest_pay_prompt" class="sharp-text gk-line"
				      data-style-font-size="guest_pay_prompt.text_px + 'px'">{{guest_pay_prompt.text}}</span>
				<span id="guest_question" class="sharp-text gk-line"
				      data-style-font-size="guest_question.text_px + 'px'">{{guest_question.text}}</span>
			</div>
			<div data-if="!is_public">
				<span id="denied_1" class="sharp-text gk-line"
				      data-style-font-size="denied_line1.text_px + 'px'">{{denied_line1.text}}</span>
				<span id="denied_2" class="sharp-text gk-line"
				      data-style-font-size="denied_line2.text_px + 'px'">{{denied_line2.text}}</span>
				<span id="denied_3" class="sharp-text gk-line"
				      data-style-font-size="denied_line3.text_px + 'px'">{{denied_line3.text}}</span>
				<span id="denied_4" class="sharp-text gk-line"
				      data-style-font-size="denied_line4.text_px + 'px'">{{denied_line4.text}}</span>
			</div>
		</div>

		<div id="btn_confirm" class="gk-btn" data-if="confirm_button.shown"
		     data-class-locked="confirm_button.locked" data-event-click="gateman_button(1)">
			<span class="sharp-text sharp-middle gk-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="line_height_px + 'px'">{{confirm_button.label}}</span>
		</div>
		<div id="btn_enter" class="gk-btn" data-if="enter_button.shown"
		     data-class-locked="enter_button.locked" data-event-click="gateman_button(0)">
			<span class="sharp-text sharp-middle gk-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="line_height_px + 'px'">{{enter_button.label}}</span>
		</div>

		<div id="btn_exit" data-event-click="gateman_button(4)" data-attr-data-hint="exit_tooltip"></div>
	</div>
</body>
</rml>
