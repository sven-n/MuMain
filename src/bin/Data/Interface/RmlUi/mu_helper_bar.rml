<rml>
<head>
	<title>MU Helper Bar</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="mu_helper_bar.rcss"/>
</head>
<body class="native-text" data-model="mu_helper_bar">
	<!-- MU Helper mini control bar + hero position readout. Fixed dp size, anchored top-left. -->
	<div id="panel" class="anchor-top-left">
		<div id="seg_a"></div>
		<div id="seg_b"></div>
		<div id="seg_c"></div>
		<div id="text">{{position_text}}</div>

		<!-- Each button's hint is the shared tooltip (CMuHelperBar::SyncHint()). -->
		<div id="btn_config" class="mu-btn" data-event-click="mu_helper_config_click"
		     data-event-mouseover="mu_helper_hint(0)" data-event-mouseout="mu_helper_hint_leave">
			<div class="dot"></div>
		</div>
		<!-- Start/Stop share one screen position, mutually exclusive by mu_helper_active. -->
		<div id="btn_start" class="mu-btn" data-class-hidden="mu_helper_active" data-event-click="mu_helper_toggle_click"
		     data-event-mouseover="mu_helper_hint(1)" data-event-mouseout="mu_helper_hint_leave">
			<div class="dot"></div>
		</div>
		<div id="btn_stop" class="mu-btn" data-class-hidden="!mu_helper_active" data-event-click="mu_helper_toggle_click"
		     data-event-mouseover="mu_helper_hint(2)" data-event-mouseout="mu_helper_hint_leave">
			<div class="dot"></div>
		</div>
	</div>
</body>
</rml>
