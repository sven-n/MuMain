<rml>
<head>
	<title>Credits</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="credit_win.rcss"/>
</head>
<body>
	<!-- Full-screen background, the crossfading illustration pair, deco/logo, close button, and the
	     scrolling credit text (department/team/names, each independently opacity-faded -- see
	     CreditWin.h's own class comment). Illustration divs declared first so they paint behind
	     deco/logo/text/close-button, matching the original CSprite render order. Plain divs with a
	     per-instance data-style-decorator (matching the 16 named single-image @spritesheet blocks
	     in credit_win.rcss), not <img data-attr-src> -- see CreditWinRmlModel's own comment
	     (CreditWin.h) for why. -->
	<div id="panel" data-model="credit_win">
		<div id="illust_left" class="illust illust-left" data-style-decorator="illust_left_decorator" data-style-opacity="illust_opacity"></div>
		<div id="illust_right" class="illust illust-right" data-style-decorator="illust_right_decorator" data-style-opacity="illust_opacity"></div>

		<div id="logo" class="logo"></div>
		<div id="deco" class="deco"></div>
		<div id="btn_close" class="btn-close" data-event-click="creditwin_close_click"><span class="btn-close-label">X</span></div>

		<span id="credit_department" class="credit-label credit-department" data-style-opacity="department_opacity">{{department}}</span>
		<span id="credit_team" class="credit-label credit-team" data-style-opacity="team_opacity">{{team}}</span>
		<div id="credit_names" class="credit-names" data-style-opacity="names_opacity">
			<span class="credit-name" data-for="n : names">{{n.text}}</span>
		</div>
	</div>
</body>
</rml>
