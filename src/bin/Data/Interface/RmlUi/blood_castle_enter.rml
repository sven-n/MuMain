<rml>
<head>
	<title>Blood Castle entry (CEnterBloodCastle)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="event_entry.rcss"/>
	<link type="text/rcss" href="blood_castle_enter.rcss"/>
</head>
<body>
	<!-- The Blood Castle entry (CEnterBloodCastle) window, docked right: the title, the description lines, one button per level
	     band (only the hero's is enabled) and the exit button. Shared shape with the other event
	     entry windows (UI/Events/EventEntryView.h, event_entry.rcss). root_x/root_y/root_scale come
	     from the dock transform; everything inside is reference px; text is .sharp-text at the
	     native size, counter-scaled out of the panel. C++ keeps the level check, the corner close,
	     Escape and the entry request; a click is queued with entry_press / entry_exit. -->
	<div id="panel" data-model="blood_castle_enter" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span class="sharp-text" id="title" data-style-font-size="title_text_px + 'px'"
		      data-style-line-height="title_line_px + 'px'" data-style-width="(72 * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{title_text}}</span>

		<!-- The rows each of these lands on are the theme's: this window's own .rcss gives one
		     :nth-child rule per row. Each repeated set has its own container so the count starts
		     at the first line / first button. -->
		<div class="entry-lines">
			<span class="sharp-text entry-line" data-for="line : lines"
			      data-style-font-size="line.text_px + 'px'" data-style-width="(panel_width * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{line.text}}</span>
		</div>

		<div class="entry-buttons">
			<div class="entry-btn" data-for="b, i : buttons" data-class-enabled="b.enabled"
			     data-event-click="entry_press(i)">
				<span class="sharp-text entry-label" data-style-top="button_label_top + 'px'"
				      data-style-font-size="button_label_text_px + 'px'"
				      data-style-line-height="button_label_line_px + 'px'"
				      data-style-width="(180 * root_scale) + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{b.label}}</span>
			</div>
		</div>

		<div id="btn_exit" data-event-click="entry_exit"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{exit_tooltip}}</span></span>
	</div>
</body>
</rml>
