<rml>
<head>
	<title>Castle Gate Switch</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="gate_switch.rcss"/>
</head>
<body>
	<!-- The castle gate switch (CGateSwitchWindow), docked right: the title, the three lines (the
	     warning on a red text box), the gate picture (closed or open) in its table, Open / Close
	     and the exit button. root_x/root_y/root_scale come from the dock transform; everything
	     inside is reference px; text is .sharp-text at the native size, counter-scaled out of the
	     panel. C++ keeps the gate state and the request; a click is queued with
	     gate_switch_toggle / gate_switch_exit. -->
	<div id="panel" data-model="gate_switch" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span class="sharp-text" id="title" data-style-font-size="title_px + 'px'">{{title}}</span>
		<div class="sharp-text gs-line" id="gs_line_1" data-style-font-size="bold_text_px + 'px'">{{line1}}</div>
		<div class="sharp-text gs-line" id="gs_line_2" data-style-font-size="bold_text_px + 'px'">{{line2}}</div>
		<div class="sharp-text gs-line" id="gs_line_3" data-style-font-size="bold_text_px + 'px'"><span class="gs-warning">{{warning}}</span></div>

		<!-- The table's frame: one shape, each theme placing its own edges. -->
		<div class="t-corner t-tl"></div>
		<div class="t-corner t-tr"></div>
		<div class="t-edge-top"></div>
		<div class="t-edge-left"></div>
		<div class="t-edge-right"></div>
		<div class="t-corner t-bl"></div>
		<div class="t-corner t-br"></div>
		<div class="t-edge-bottom"></div>
		<div id="gate" data-class-opened="gate_opened"></div>

		<div id="btn_toggle" data-event-click="gate_switch_toggle">
			<span class="sharp-text sharp-middle gs-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="label_line_px + 'px'">{{button_text}}</span>
		</div>

		<div id="btn_exit" data-event-click="gate_switch_exit" data-attr-data-hint="exit_tooltip"></div>
	</div>
</body>
</rml>
