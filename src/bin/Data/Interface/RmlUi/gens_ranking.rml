<rml>
<head>
	<title>Gens Info</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="gens_ranking.rcss"/>
</head>
<body>
	<!-- The Gens ranking window (CGensRanking), docked right: the family mark on its rank back,
	     the family, title, ranking and contribution, the description box with the rewards text
	     and its scroll bar, the exit button. The text box and the scroll bar stay native controls
	     (their lines and thumb are bound here); the thumb is dragged natively, so #panel leaves the
	     pointer alone outside the exit button. root_x/root_y/root_scale come from the dock
	     transform; every position and size below is the theme's. A .sharp-text layer's own width
	     and font size stay bound: it is laid out in physical pixels and counter-scaled out of the
	     panel (base.rcss). The window's layout is Hud (the original stretched it per axis):
	     root_scale is x, root_scale_y is y. -->
	<div id="panel" data-model="gens_ranking" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ', ' + root_scale_y + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<div id="rank_back"></div>
		<div id="mark" data-if="mark_sprite != ''" data-attr-class="mark_sprite"></div>

		<!-- The rank strip and the description box: their fills, corners and edges, each placed by
		     the theme rather than by a style attribute no theme could override. -->
		<div class="fill fill-strip"></div>
		<div class="fill fill-desc"></div>
		<div class="t-corner corner-strip-tl"></div>
		<div class="t-corner corner-strip-tr"></div>
		<div class="t-corner corner-desc-tr"></div>
		<div class="t-corner corner-bl"></div>
		<div class="t-corner corner-br"></div>
		<div class="t-edge-top edge-strip-top"></div>
		<div class="t-edge-right edge-strip-right"></div>
		<div class="t-edge-top edge-desc-top"></div>
		<div class="t-edge-right edge-desc-right"></div>
		<div class="t-edge-bottom edge-bottom"></div>
		<div class="t-edge-left edge-left"></div>

		<div class="text-back text-back-level"></div>
		<div class="text-back text-back-rank"></div>

		<div class="gr-scroll">
			<div class="s-top"></div>
			<div class="s-mid"></div>
			<div class="s-mid"></div>
			<div class="s-mid"></div>
			<div class="s-mid"></div>
			<div class="s-mid"></div>
			<div class="s-mid"></div>
			<div class="s-mid"></div>
			<div class="s-bottom"></div>
		</div>
		<div class="thumb" data-class-off="!thumb_active" data-style-top="thumb_top + 'px'"></div>

		<span id="gr_title" class="sharp-text gr-line" data-style-width="(190 * root_scale) + 'px'"
		      data-style-font-size="title.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{title.text}}</span>
		<span id="gr_gens_label" class="sharp-text gr-line" data-style-width="(190 * root_scale) + 'px'"
		      data-style-font-size="gens_label.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{gens_label.text}}</span>
		<span id="gr_gens_name" class="sharp-text gr-line" data-style-width="(190 * root_scale) + 'px'"
		      data-style-font-size="gens_name.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{gens_name.text}}</span>
		<span id="gr_level_label" class="sharp-text gr-line" data-style-width="(190 * root_scale) + 'px'"
		      data-style-font-size="level_label.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{level_label.text}}</span>
		<span id="gr_title_name" class="sharp-text gr-line" data-style-width="(174 * root_scale) + 'px'"
		      data-style-font-size="title_name.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{title_name.text}}</span>
		<span id="gr_rank_label" class="sharp-text gr-line" data-style-width="(74 * root_scale) + 'px'"
		      data-style-font-size="rank_label.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{rank_label.text}}</span>
		<span id="gr_rank_value" class="sharp-text gr-line" data-style-width="(170 * root_scale) + 'px'"
		      data-style-font-size="rank_value.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{rank_value.text}}</span>
		<span id="gr_contrib_label" class="sharp-text gr-line" data-style-width="(74 * root_scale) + 'px'"
		      data-style-font-size="contrib_label.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{contrib_label.text}}</span>
		<span id="gr_contrib_value" class="sharp-text gr-line" data-style-width="(170 * root_scale) + 'px'"
		      data-style-font-size="contrib_value.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{contrib_value.text}}</span>
		<span id="gr_desc_label" class="sharp-text gr-line" data-style-width="(58 * root_scale) + 'px'"
		      data-style-font-size="desc_label.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{desc_label.text}}</span>

		<!-- The promotion note, present only while there is a next rank: the theme gives the group
		     its own rows (gens_ranking.rcss). -->
		<div class="gr-promo">
			<span class="sharp-text gr-promo-line" data-for="l : promo_lines" data-style-width="(180 * root_scale) + 'px'"
			      data-style-font-size="l.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{l.text}}</span>
		</div>

		<!-- The description box's visible lines. The theme places the box; the pitch inside it is
		     the text renderer's own measured line height, so it stays bound. -->
		<div class="gr-desc">
			<span class="sharp-text gr-desc-line" data-for="l, i : desc_lines"
			      data-style-top="(i * desc_line_step) + 'px'" data-style-width="(150 * root_scale) + 'px'"
			      data-style-font-size="l.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{l.text}}</span>
		</div>

		<div id="btn_exit" data-event-click="gens_ranking_exit"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale_y) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{exit_tooltip}}</span></span>
	</div>
</body>
</rml>
