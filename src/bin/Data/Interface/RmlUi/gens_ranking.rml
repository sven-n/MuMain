<rml>
<head>
	<title>Gens Info</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="gens_ranking.rcss"/>
</head>
<body>
	<!-- The Gens ranking window (CGensRanking), docked right: the family mark on its rank back,
	     the family, title, ranking and contribution, the description box with the rewards text
	     and its scroll bar, the exit button. The text box and the scroll bar stay native controls
	     (their lines and thumb are bound here); the thumb is dragged natively, so #panel leaves the
	     pointer alone outside the exit button. root_x/root_y/root_scale come from the dock
	     transform; everything inside is reference px; text is .sharp-text at the native size,
	     counter-scaled out of the panel. The window's layout is Hud (the original stretched it per
	     axis): root_scale is x, root_scale_y is y. -->
	<div id="panel" data-model="gens_ranking" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ', ' + root_scale_y + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<div id="rank_back"></div>
		<div id="mark" data-if="mark_sprite != ''" data-attr-class="mark_sprite"></div>

		<div class="fill" style="left: 16px; top: 252px; width: 52px; height: 20px;"></div>
		<div class="fill" style="left: 16px; top: 272px; width: 161px; height: 113px;"></div>
		<div class="t-corner t-tl" style="left: 13px; top: 250px;"></div>
		<div class="t-corner t-tr" style="left: 59px; top: 250px;"></div>
		<div class="t-corner t-tr" style="left: 167px; top: 270px;"></div>
		<div class="t-corner t-bl" style="left: 13px; top: 376px;"></div>
		<div class="t-corner t-br" style="left: 167px; top: 376px;"></div>
		<div class="t-edge-top" style="left: 19px; top: 250px; width: 48px;"></div>
		<div class="t-edge-right" style="left: 59px; top: 256px; height: 14px;"></div>
		<div class="t-edge-top" style="left: 68px; top: 270px; width: 102px;"></div>
		<div class="t-edge-right" style="left: 167px; top: 276px; height: 106px;"></div>
		<div class="t-edge-bottom" style="left: 19px; top: 376px; width: 156px;"></div>
		<div class="t-edge-left" style="left: 13px; top: 256px; height: 126px;"></div>

		<div class="text-back" style="top: 151px;"></div>
		<div class="text-back" style="top: 175px;"></div>

		<div class="s-top" style="top: 273px;"></div>
		<div class="s-mid" style="top: 276px;"></div>
		<div class="s-mid" style="top: 291px;"></div>
		<div class="s-mid" style="top: 306px;"></div>
		<div class="s-mid" style="top: 321px;"></div>
		<div class="s-mid" style="top: 336px;"></div>
		<div class="s-mid" style="top: 351px;"></div>
		<div class="s-mid" style="top: 366px; height: 14px;"></div>
		<div class="s-bottom" style="top: 380px;"></div>
		<div class="thumb" data-class-off="!thumb_active" data-style-top="thumb_top + 'px'"></div>

		<span class="sharp-text gr-text" data-for="t : texts" data-class-bold="t.bold"
		      data-class-centred="t.align == 1" data-class-right="t.align == 2"
		      data-style-left="t.left + 'px'" data-style-top="t.top + 'px'" data-style-color="t.color"
		      data-style-font-size="t.text_px + 'px'"
		      data-style-width="t.width == 0 ? 'auto' : (t.width * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'">{{t.text}}</span>

		<div id="btn_exit" data-event-click="gens_ranking_exit"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ', ' + (1 / root_scale_y) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale_y) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{exit_tooltip}}</span></span>
	</div>
</body>
</rml>
