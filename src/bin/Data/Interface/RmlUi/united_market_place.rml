<rml>
<head>
	<title>Julia</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="united_market_place.rcss"/>
</head>
<body>
	<!-- Julia's market warp service (CUnitedMarketPlaceWindow), docked right: the description of
	     the market (or, in the market, of the way back to town), the Warp button and the exit
	     button. root_x/root_y/root_scale come from the dock transform; everything inside is
	     reference px; text is .sharp-text at the native size, counter-scaled out of the panel.
	     C++ keeps the texts, the button lock, the corner close, Escape and the warp request; a
	     click is queued with market_warp / market_exit. -->
	<div id="panel" data-model="united_market_place" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span class="sharp-text" id="title" data-style-font-size="bold_text_px + 'px'"
		      data-style-width="(160 * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{title}}</span>
		<span class="sharp-text market-line" data-for="line : lines" data-style-top="line.top + 'px'"
		      data-style-font-size="text_px + 'px'" data-style-width="(190 * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{line.text}}</span>

		<div id="warp" data-class-locked="warp_locked" data-event-click="market_warp">
			<span class="sharp-text" id="warp_label" data-style-font-size="text_px + 'px'"
			      data-style-width="(53 * root_scale) + 'px'" data-style-top="label_top + 'px'"
				      data-style-line-height="label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{warp_text}}</span>
		</div>

		<div id="btn_exit" data-event-click="market_exit"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{exit_tooltip}}</span></span>
	</div>
</body>
</rml>
