<rml>
<head>
	<title>IGS Buy Select</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="igs_buy_select.rcss"/>
</head>
<body data-model="igs_buy_select">
	<!-- Only the option list lives here. The dialog's frame, texts and buttons are still native:
	     the frame is the shop's own art, not the newui_msgbox family MessageBoxView draws. -->
	<div id="panel" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- 3 rows of 33 units, the native box's own m_iNumRenderLine times TEXT_HEIGHTSIZE. -->
		<div id="igs_option_list" class="scroll-pane igs-pane"
		     data-style-font-size="text_px + 'px'"
		     data-style-width="(180 * root_scale) + 'px'"
		     data-style-height="(99 * root_scale) + 'px'"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'">
			<div class="igs-option" data-for="o : options"
			     data-class-selected="o.selected"
			     data-style-width="(165 * root_scale) + 'px'"
			     data-style-height="(33 * root_scale) + 'px'"
			     data-event-click="igs_select_option(it_index)">
				<!-- Was a ::CRadioButton carried on every row; the indicator is the theme's now. -->
				<div class="igs-option-radio"></div>
				<span class="igs-option-label">{{o.name}}</span>
			</div>
		</div>
	</div>
</body>
</rml>
