<rml>
<head>
	<title>Guild Master</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="guild_make.rcss"/>
</head>
<body>
	<!-- The guild master's guild creation window (CGuildMakeWindow), docked right, one of three
	     pages: the question and Create Guild (page 0); the name field, the 8 x 8 mark editor, its
	     palette and the selected colour, Back / Next (page 1); the finished mark and name, Back /
	     Next (page 2). root_x/root_y/root_scale come from the dock transform; everything inside is
	     reference px; text is .sharp-text at the native size, counter-scaled out of the panel.
	     The grid and palette take no pointer events: the window paints the mark with its native
	     hit tests, as the original did. A button click is queued with guild_make_button(n). -->
	<div id="panel" data-model="guild_make" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span class="sharp-text gm-centred" id="title" data-style-font-size="title_px + 'px'"
		      data-style-width="(190 * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{title_text}}</span>

		<div data-if="page == 0">
			<span class="sharp-text gm-centred" id="info" data-style-font-size="info_px + 'px'"
			      data-style-width="(190 * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{info_text}}</span>
			<div class="gm-btn gm-btn-big" id="btn_make" data-event-click="guild_make_button(0)">
				<span class="sharp-text gm-label" data-style-font-size="text_px + 'px'"
				      data-style-width="(108 * root_scale) + 'px'" data-style-top="label_top + 'px'"
				      data-style-line-height="label_line_px + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{make_text}}</span>
			</div>
			<div id="btn_exit" data-event-click="guild_make_button(3)"></div>
			<span class="sharp-text tooltip tooltip-exit"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
			      data-style-width="(110 * root_scale) + 'px'"
			      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{exit_tooltip}}</span></span>
		</div>

		<div data-if="page == 1">
			<span class="sharp-text" id="name_label" data-style-font-size="text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{name_text}}</span>
			<div id="name_back"></div>
			<div class="gold-rect" id="mark_rect"><div class="gold-h"></div><div class="gold-h gold-h-end"></div><div class="gold-v"></div><div class="gold-v gold-v-end"></div></div>
			<div class="gm-cell gm-cell-13" data-for="c : cells" data-style-left="c.left + 'px'" data-style-top="c.top + 'px'">
				<div class="gm-fill" data-style-background-color="c.color">
					<div class="gm-cross gm-cross-a" data-if="c.empty"></div>
					<div class="gm-cross gm-cross-b" data-if="c.empty"></div>
				</div>
			</div>
			<div class="gm-cell gm-cell-18" data-for="c : palette" data-style-left="c.left + 'px'" data-style-top="c.top + 'px'">
				<div class="gm-fill" data-style-background-color="c.color">
					<div class="gm-cross gm-cross-a" data-if="c.empty"></div>
					<div class="gm-cross gm-cross-b" data-if="c.empty"></div>
				</div>
			</div>
			<div class="gm-cell gm-cell-23" data-style-left="selected.left + 'px'" data-style-top="selected.top + 'px'">
				<div class="gm-fill" data-style-background-color="selected.color">
					<div class="gm-cross gm-cross-a" data-if="selected.empty"></div>
					<div class="gm-cross gm-cross-b" data-if="selected.empty"></div>
				</div>
			</div>
			<span class="sharp-text gm-hint" style="top: 230px;" data-style-font-size="text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{palette_hint_1}}</span>
			<span class="sharp-text gm-hint" style="top: 245px;" data-style-font-size="text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{palette_hint_2}}</span>
		</div>

		<div data-if="page == 2">
			<div class="gold-rect" id="result_rect"><div class="gold-h"></div><div class="gold-h gold-h-end"></div><div class="gold-v"></div><div class="gold-v gold-v-end"></div></div>
			<div id="result_mark"><div class="mark-cell" data-for="m : mark_cells" data-style-background-color="m"></div></div>
			<span class="sharp-text gm-centred" id="result" data-style-font-size="result_px + 'px'"
			      data-style-width="(190 * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{result_text}}</span>
		</div>

		<div data-if="page != 0">
			<div class="gm-btn gm-btn-small" id="btn_back" data-event-click="guild_make_button(1)">
				<span class="sharp-text gm-label" data-style-font-size="text_px + 'px'"
				      data-style-width="(64 * root_scale) + 'px'" data-style-top="label_top + 'px'"
				      data-style-line-height="label_line_px + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{back_text}}</span>
			</div>
			<div class="gm-btn gm-btn-small" id="btn_next" data-event-click="guild_make_button(2)">
				<span class="sharp-text gm-label" data-style-font-size="text_px + 'px'"
				      data-style-width="(64 * root_scale) + 'px'" data-style-top="label_top + 'px'"
				      data-style-line-height="label_line_px + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{next_text}}</span>
			</div>
		</div>

		<!-- The name field, outside the page blocks so it keeps its element (and its typed value)
		     across page changes; shown on page 1 only. -->
		<input id="name_field" type="text" class="text-field sharp-text" maxlength="8" data-class-shown="page == 1"
		       data-style-font-size="text_px + 'px'" data-style-width="(200 * root_scale) + 'px'"
		       data-style-height="(14 * root_scale) + 'px'" data-style-line-height="(14 * root_scale) + 'px'"
		       data-style-transform="'scale(' + (1 / root_scale) + ')'"/>
	</div>
</body>
</rml>
