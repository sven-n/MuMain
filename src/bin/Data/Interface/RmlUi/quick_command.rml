<rml>
<head>
	<title>Quick Command</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="quick_command.rcss"/>
</head>
<body>
	<!-- The quick command menu (CQuickCommandWindow): opened on a player at the pointer, the
	     player's name and five actions. C++ places it (m_Pos, the pointer's position when it opened)
	     and keeps the hover index, the clicks and every request; this document only draws them, so
	     it takes no pointer events. Dialog layout: root_x/root_y/root_scale come from the Dialog
	     transform, everything inside is reference px, and the text is a .sharp-text layer at the
	     native size, counter-scaled out of the panel. -->
	<div id="panel" data-model="quick_command" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div id="back"></div>
		<div id="frame_up"></div>
		<div class="frame-middle frame-middle-1"></div>
		<div class="frame-middle frame-middle-2"></div>
		<div class="frame-middle frame-middle-3"></div>
		<div class="frame-middle frame-middle-short frame-middle-4"></div>
		<div id="frame_down"></div>
		<div class="line line-1"></div>
		<div class="line line-2"></div>
		<div class="line line-3"></div>
		<div class="line line-4"></div>

		<span class="sharp-text" id="name" data-style-font-size="bold_text_px + 'px'"
		      data-style-width="(112 * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{target_name}}</span>

		<div id="rows">
			<div class="quick-row" data-for="row : rows" data-class-selected="row.selected">
				<span class="sharp-text quick-label" data-style-font-size="text_px + 'px'"
				      data-style-width="(112 * root_scale) + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{row.label}}</span>
				<div class="arrow arrow-left"></div>
				<div class="arrow arrow-right"></div>
			</div>
		</div>
	</div>
</body>
</rml>
