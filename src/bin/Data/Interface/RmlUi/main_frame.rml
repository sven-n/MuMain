<rml>
<head>
	<title>Main Frame</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="skill_icons.rcss"/>
	<link type="text/rcss" href="master_skill_icons.rcss"/>
	<link type="text/rcss" href="main_frame.rcss"/>
</head>
<body data-model="main_frame">
	<!-- CMainFrameWindow's HUD, shared by every theme. #hud_layout is the one unit the workspace
	     places (its main_hud slot); its size is the theme's, in main_frame.rcss. Each .hud-part is
	     one piece the theme places inside it, with the part's contents laid out from its own
	     corner: the strip backing, the two gauge groups, EXP, the corner buttons, the item hotkeys,
	     the skill row and the skill list. A part may overflow the unit (the skill list does), but
	     only the unit's box is kept clear of windows. A theme styles or hides each part, and
	     anything only one theme uses is noted where it appears. -->
	<div id="hud_layout">
	<!-- The strip's backing: the original menu art (.frame-art), or flat zone and band fills under
	     #gauge_frame's border, which comes after them so their backgrounds don't cover it. -->
	<div id="hud_strip" class="hud-part">
		<div id="frame_left" class="frame-art"></div>
		<div id="frame_middle" class="frame-art"></div>
		<div id="frame_right" class="frame-art"></div>
		<div id="gauge_fill_left"></div>
		<div id="gauge_fill_right"></div>
		<div id="item_band_fill" class="slot-fill"></div>
		<div id="skill_band_fill" class="slot-fill"></div>
		<div id="gauge_frame"></div>
	</div>

	<!-- Each gauge carries its readout twice, current value (.value-current) and current/max
	     (.value-full); a theme shows one. -->
	<div id="gauges_left" class="hud-part">
		<div id="bar_hp" class="gauge-slot slot-frame slot-fill" data-attr-data-hint="hp_tooltip">
			<div id="bar_hp_fill" class="gauge-fill gauge-fill-hp gauge-fill-vertical" data-class-poisoned="poisoned" data-style-height="hp_fraction * 100 + '%'"></div>
			<div class="gauge-fill gauge-fill-hp gauge-fill-horizontal" data-class-poisoned="poisoned" data-style-width="hp_fraction * 100 + '%'"></div>
			<span class="gauge-num value-current">{{hp_current_text}}</span>
			<span class="gauge-num value-full">{{hp_text}}</span>
		</div>
		<div id="bar_sd" class="gauge-slot slot-frame slot-fill" data-attr-data-hint="sd_tooltip">
			<div class="gauge-fill gauge-fill-sd gauge-fill-vertical" data-style-height="sd_fraction * 100 + '%'"></div>
			<div class="gauge-fill gauge-fill-sd gauge-fill-horizontal" data-style-width="sd_fraction * 100 + '%'"></div>
			<span class="gauge-num value-current">{{sd_current_text}}</span>
			<span class="gauge-num value-full">{{sd_text}}</span>
		</div>
	</div>
	<div id="gauges_right" class="hud-part">
		<div id="bar_ag" class="gauge-slot slot-frame slot-fill" data-attr-data-hint="ag_tooltip">
			<div class="gauge-fill gauge-fill-ag gauge-fill-vertical" data-style-height="ag_fraction * 100 + '%'"></div>
			<div class="gauge-fill gauge-fill-ag gauge-fill-horizontal" data-style-width="ag_fraction * 100 + '%'"></div>
			<span class="gauge-num value-current">{{ag_current_text}}</span>
			<span class="gauge-num value-full">{{ag_text}}</span>
		</div>
		<div id="bar_mp" class="gauge-slot slot-frame slot-fill" data-attr-data-hint="mp_tooltip">
			<div class="gauge-fill gauge-fill-mp gauge-fill-vertical" data-style-height="mp_fraction * 100 + '%'"></div>
			<div class="gauge-fill gauge-fill-mp gauge-fill-horizontal" data-style-width="mp_fraction * 100 + '%'"></div>
			<span class="gauge-num value-current">{{mp_current_text}}</span>
			<span class="gauge-num value-full">{{mp_text}}</span>
		</div>
	</div>

	<!-- The original's bottom button row. A theme that puts these buttons elsewhere hides it (the
	     modern theme's are in main_frame_top.rml). -->
	<div id="buttons" class="hud-part">
		<div id="btn_cshop" class="frame-btn slot-frame slot-fill" data-class-open="cshop_open" data-event-click="mainframe_cshop_click" data-attr-data-hint="cshop_tooltip">
			<span class="btn-icon-label">SHOP</span>
		</div>
		<div id="btn_chainfo" class="frame-btn slot-frame slot-fill" data-class-open="chainfo_open" data-event-click="mainframe_chainfo_click" data-attr-data-hint="chainfo_tooltip">
			<span class="btn-icon-label">CHAR</span>
			<div class="alert-dot" data-class-hidden="!chainfo_alert"></div>
		</div>
		<div id="btn_myinven" class="frame-btn slot-frame slot-fill" data-class-open="myinven_open" data-event-click="mainframe_myinven_click" data-attr-data-hint="myinven_tooltip">
			<span class="btn-icon-label">INV</span>
		</div>
		<div id="btn_friend" class="frame-btn slot-frame slot-fill" data-class-open="friend_open" data-event-click="mainframe_friend_click" data-attr-data-hint="friend_tooltip">
			<span class="btn-icon-label">FRIEND</span>
			<div class="alert-dot" data-class-hidden="!friend_alert"></div>
		</div>
		<div id="btn_window" class="frame-btn slot-frame slot-fill" data-class-open="window_open" data-event-click="mainframe_window_click" data-attr-data-hint="window_tooltip">
			<span class="btn-icon-label">MENU</span>
		</div>
	</div>

	<!-- EXP bar, with the original art's bottom strip behind it (.exp-frame). exp_fraction is
	     progress within the current decile, not overall level. -->
	<div id="exp" class="hud-part" data-attr-data-hint="exp_tooltip">
		<div id="exp_frame_left" class="exp-frame"></div>
		<div id="exp_frame_middle" class="exp-frame"></div>
		<div id="exp_frame_right" class="exp-frame"></div>
		<div id="exp_track" class="slot-frame slot-fill">
			<div id="exp_fill" data-style-width="exp_fraction * 100 + '%'"></div>
		</div>
		<span id="exp_digit">{{exp_digit}}</span>
	</div>

	<!-- Item hotkeys: hover highlight, stack count, right-click-to-use, and the icon -- the item's
	     native 3D render, drawn into a render target .item-icon shows (CItemHotKey::SyncSlotIcons()),
	     so the theme's RCSS places it. -->
	<div id="item_slots" class="hud-part">
		<div id="item_slot_0" class="slot-frame" data-class-selected="item_slot_0_hovered" data-event-mouseover="item_hotkey_hover(0)" data-event-mouseout="item_hotkey_unhover" data-event-mouseup="item_hotkey_rightclick(0)"><img id="item_icon_0" class="item-icon"/><span class="slot-hotkey-label">Q</span><span class="item-stack-label">{{item_slot_0_count}}</span></div>
		<div id="item_slot_1" class="slot-frame" data-class-selected="item_slot_1_hovered" data-event-mouseover="item_hotkey_hover(1)" data-event-mouseout="item_hotkey_unhover" data-event-mouseup="item_hotkey_rightclick(1)"><img id="item_icon_1" class="item-icon"/><span class="slot-hotkey-label">W</span><span class="item-stack-label">{{item_slot_1_count}}</span></div>
		<div id="item_slot_2" class="slot-frame" data-class-selected="item_slot_2_hovered" data-event-mouseover="item_hotkey_hover(2)" data-event-mouseout="item_hotkey_unhover" data-event-mouseup="item_hotkey_rightclick(2)"><img id="item_icon_2" class="item-icon"/><span class="slot-hotkey-label">E</span><span class="item-stack-label">{{item_slot_2_count}}</span></div>
		<div id="item_slot_3" class="slot-frame" data-class-selected="item_slot_3_hovered" data-event-mouseover="item_hotkey_hover(3)" data-event-mouseout="item_hotkey_unhover" data-event-mouseup="item_hotkey_rightclick(3)"><img id="item_icon_3" class="item-icon"/><span class="slot-hotkey-label">R</span><span class="item-stack-label">{{item_slot_3_count}}</span></div>
	</div>
	<!-- The skill row: the upper-set highlight, then per slot the skill icon (a
	     skill_icons.rcss/master_skill_icons.rcss sprite bound by C++), its hotkey number and the
	     cooldown wipe. data-class-selected marks the slot holding the current skill. -->
	<div id="skill_slots" class="hud-part">
		<div id="skill_list_highlight" data-class-hidden="!skill_list_up"></div>
		<div id="skill_slot_0" class="slot-frame" data-class-selected="skill_slot_0_selected" data-event-click="skill_hotkey_click(0)" data-event-mouseover="skill_hotkey_hover(0)" data-event-mouseout="skill_unhover"><div class="skill-icon" data-style-decorator="skill_slot_0_icon"></div><span class="skill-hotkey-label">{{skill_slot_0_hotkey}}</span><div class="cooldown-wipe" data-style-height="skill_slot_0_cooldown * 100 + '%'"></div></div>
		<div id="skill_slot_1" class="slot-frame" data-class-selected="skill_slot_1_selected" data-event-click="skill_hotkey_click(1)" data-event-mouseover="skill_hotkey_hover(1)" data-event-mouseout="skill_unhover"><div class="skill-icon" data-style-decorator="skill_slot_1_icon"></div><span class="skill-hotkey-label">{{skill_slot_1_hotkey}}</span><div class="cooldown-wipe" data-style-height="skill_slot_1_cooldown * 100 + '%'"></div></div>
		<div id="skill_slot_2" class="slot-frame" data-class-selected="skill_slot_2_selected" data-event-click="skill_hotkey_click(2)" data-event-mouseover="skill_hotkey_hover(2)" data-event-mouseout="skill_unhover"><div class="skill-icon" data-style-decorator="skill_slot_2_icon"></div><span class="skill-hotkey-label">{{skill_slot_2_hotkey}}</span><div class="cooldown-wipe" data-style-height="skill_slot_2_cooldown * 100 + '%'"></div></div>
		<div id="skill_slot_3" class="slot-frame" data-class-selected="skill_slot_3_selected" data-event-click="skill_hotkey_click(3)" data-event-mouseover="skill_hotkey_hover(3)" data-event-mouseout="skill_unhover"><div class="skill-icon" data-style-decorator="skill_slot_3_icon"></div><span class="skill-hotkey-label">{{skill_slot_3_hotkey}}</span><div class="cooldown-wipe" data-style-height="skill_slot_3_cooldown * 100 + '%'"></div></div>
		<div id="skill_slot_4" class="slot-frame" data-class-selected="skill_slot_4_selected" data-event-click="skill_hotkey_click(4)" data-event-mouseover="skill_hotkey_hover(4)" data-event-mouseout="skill_unhover"><div class="skill-icon" data-style-decorator="skill_slot_4_icon"></div><span class="skill-hotkey-label">{{skill_slot_4_hotkey}}</span><div class="cooldown-wipe" data-style-height="skill_slot_4_cooldown * 100 + '%'"></div></div>
		<div id="current_skill_slot" class="slot-frame" data-event-click="skill_current_click" data-event-mouseover="skill_current_hover" data-event-mouseout="skill_unhover"><div class="skill-icon" data-style-decorator="current_skill_icon"></div><span class="skill-hotkey-label">{{current_skill_hotkey}}</span><div class="cooldown-wipe" data-style-height="current_skill_cooldown * 100 + '%'"></div></div>
	</div>

	<!-- The skill list the current-skill slot opens: the learned skills and the pet's commands.
	     The grid's cells fan out from the part's own box, which is where its first cell goes; each
	     carries its place in the list (--i) and the theme lays them out from there. -->
	<div id="skill_list" class="hud-part">
		<div id="skill_grid" data-class-hidden="!skill_grid_open">
			<div class="skill-cell" data-for="cell : skill_grid_cells"
			     data-style---i="it_index"
			     data-class-selected="cell.is_current"
			     data-event-click="skill_grid_click(cell.skill_index)"
			     data-event-mouseover="skill_grid_hover(cell.skill_index)"
			     data-event-mouseout="skill_unhover">
				<div class="skill-icon" data-style-decorator="cell.icon"></div>
				<span class="skill-hotkey-label">{{cell.hotkey}}</span>
				<div class="cooldown-wipe" data-style-height="cell.cooldown_fraction * 100 + '%'"></div>
			</div>
		</div>
		<div id="pet_skill_row" data-class-hidden="!skill_grid_open">
			<div class="skill-cell" data-for="cell : pet_skill_cells"
			     data-class-selected="cell.is_current"
			     data-event-click="skill_pet_click(cell.skill_index)"
			     data-event-mouseover="skill_pet_hover(cell.skill_index)"
			     data-event-mouseout="skill_unhover">
				<div class="skill-icon" data-style-decorator="cell.icon"></div>
				<span class="skill-hotkey-label">{{cell.hotkey}}</span>
				<div class="cooldown-wipe" data-style-height="cell.cooldown_fraction * 100 + '%'"></div>
			</div>
		</div>
	</div>
	</div>
</body>
</rml>
