<rml>
<head>
	<title>Guard NPC</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="guard_window.rcss"/>
</head>
<body>
	<!-- The castle guardsman (CGuardWindow), docked right: the heading and owner lines, the
	     Status / Register (Announce) / List tabs and the tab's page; on the List tab the guild
	     list's frame, backdrops, lines and scroll bar. The tabs, the list lines and the scroll
	     thumb are hit-tested natively, so #panel leaves the pointer alone outside the buttons.
	     root_x/root_y/root_scale come from the dock transform; every position and size below is
	     the theme's. A .sharp-text layer's own width and font size stay bound: it is laid out in
	     physical pixels and counter-scaled out of the panel (base.rcss). A button click is queued
	     with guard_button(n). -->
	<div id="panel" data-model="guard_window" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span id="heading" class="sharp-text gd-heading" data-style-width="(160 * root_scale) + 'px'"
		      data-style-font-size="title.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{title.text}}</span>
		<span id="owner_master" class="sharp-text gd-owner" data-style-width="(190 * root_scale) + 'px'"
		      data-style-font-size="owner_master.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{owner_master.text}}</span>
		<span id="owner_guild" class="sharp-text gd-owner" data-style-width="(190 * root_scale) + 'px'"
		      data-style-font-size="owner_guild.text_px + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{owner_guild.text}}</span>

		<div class="gd-tab" data-for="t, i : tabs" data-class-selected="t.selected" data-style-left="(12 + i * 57) + 'px'">
			<span class="sharp-text gd-tab-label" data-style-top="tab_label_top + 'px'"
			      data-style-width="(56 * root_scale) + 'px'"
			      data-style-font-size="text_px + 'px'" data-style-line-height="line_height_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.label}}</span>
		</div>

		<!-- One page per tab. Each line is named and placed by the theme; C++ fills only the page
		     on screen, so a hidden page's lines keep whatever they last said. -->
		<div class="gd-page" data-if="active_tab == 0">
			<span id="status_start" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="status_start.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{status_start.text}}</span>
			<span id="status_end" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="status_end.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{status_end.text}}</span>
			<span id="status_period" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="status_period.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{status_period.text}}</span>
			<span id="status_expected_label" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="status_expected_label.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{status_expected_label.text}}</span>
			<span id="status_expected_time" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="status_expected_time.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{status_expected_time.text}}</span>
			<span id="status_next_stage" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="status_next_stage.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{status_next_stage.text}}</span>
		</div>

		<div class="gd-page" data-if="active_tab == 1">
			<span id="register_message" class="sharp-text gd-line" data-class-bold="register_bold"
			      data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="register_message.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{register_message.text}}</span>
			<span id="register_message2" class="sharp-text gd-line" data-class-bold="register_bold"
			      data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="register_message2.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{register_message2.text}}</span>
			<span id="register_acquired" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="register_acquired.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{register_acquired.text}}</span>
			<span id="register_registered" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="register_registered.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{register_registered.text}}</span>
		</div>

		<div class="gd-page" data-if="active_tab == 2">
			<span id="list_message" class="sharp-text gd-line" data-style-width="(190 * root_scale) + 'px'"
			      data-style-font-size="list_message.text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{list_message.text}}</span>
		</div>

		<!-- The guild list's frame. One shape; `with-footer` shortens the main box and adds the
		     summary row's own box under it. Every edge is placed by the theme. -->
		<div class="gd-list-frame" data-if="list_shown" data-class-with-footer="list_has_footer">
			<div class="t-edge-left gd-list-edge-left"></div>
			<div class="t-edge-right gd-list-edge-right"></div>
			<div class="t-edge-top gd-list-edge-top"></div>
			<div class="t-edge-bottom gd-list-edge-bottom"></div>
			<div class="t-edge-left gd-foot-edge-left" data-if="list_has_footer"></div>
			<div class="t-edge-right gd-foot-edge-right" data-if="list_has_footer"></div>
			<div class="t-edge-top gd-foot-edge-top" data-if="list_has_footer"></div>
			<div class="t-edge-bottom gd-foot-edge-bottom" data-if="list_has_footer"></div>
		</div>

		<div class="gd-box" data-for="b : boxes" data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
		     data-style-width="b.width + 'px'" data-style-height="b.height + 'px'"
		     data-style-background-color="b.color"></div>

		<div data-if="scroll_shown">
			<div class="s-top" data-style-top="scroll_top + 'px'"></div>
			<div class="s-mid" data-style-top="(scroll_top + 3) + 'px'" data-style-height="(scroll_height - 6) + 'px'"></div>
			<div class="s-bottom" data-style-top="(scroll_top + scroll_height - 3) + 'px'"></div>
			<div class="thumb" data-class-dragged="thumb_dragged" data-style-top="thumb_top + 'px'"></div>
		</div>

		<span class="sharp-text gd-text" data-for="t : texts" data-class-bold="t.bold"
		      data-class-right="t.align == 2"
		      data-style-left="t.left + 'px'" data-style-top="t.top + 'px'" data-style-color="t.color"
		      data-style-font-size="t.text_px + 'px'"
		      data-style-width="t.width == 0 ? 'auto' : (t.width * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.text}}</span>

		<div id="btn_proclaim" class="gd-btn" data-if="proclaim_button.shown"
		     data-class-locked="proclaim_button.locked" data-event-click="guard_button(0)">
			<span class="sharp-text gd-label" data-style-font-size="text_px + 'px'" data-style-top="button_label_top + 'px'"
			      data-style-line-height="line_height_px + 'px'" data-style-width="(53 * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{proclaim_button.label}}</span>
		</div>
		<div id="btn_register" class="gd-btn" data-if="register_button.shown"
		     data-class-locked="register_button.locked" data-event-click="guard_button(1)">
			<span class="sharp-text gd-label" data-style-font-size="text_px + 'px'" data-style-top="button_label_top + 'px'"
			      data-style-line-height="line_height_px + 'px'" data-style-width="(53 * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{register_button.label}}</span>
		</div>
		<div id="btn_give_up" class="gd-btn" data-if="give_up_button.shown"
		     data-class-locked="give_up_button.locked" data-event-click="guard_button(2)">
			<span class="sharp-text gd-label" data-style-font-size="text_px + 'px'" data-style-top="button_label_top + 'px'"
			      data-style-line-height="line_height_px + 'px'" data-style-width="(53 * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{give_up_button.label}}</span>
		</div>

		<div id="btn_exit" data-event-click="guard_button(3)"></div>
		<span class="sharp-text tooltip tooltip-exit"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'"
		      data-style-width="(110 * root_scale) + 'px'"
		      data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'"><span class="tooltip-text" data-style-padding="'0 ' + (3 * root_scale) + 'px'">{{exit_tooltip}}</span></span>
	</div>
</body>
</rml>
