<rml>
<head>
    <title>Performance diagnostics</title>
    <link type="text/rcss" href="base.rcss"/>
    <link type="text/rcss" href="diagnostics.rcss"/>
</head>
<body data-model="diagnostics">
    <div id="panel">
        <div id="summary" class="section" data-if="details || fps_only" data-class-fps-only="!details">
            <div class="section-back"></div>
            <div class="title">FPS {{fps | fixed}}</div>
            <div data-if="details">
                <div class="metric"><span class="label">Average</span><span class="value">{{average_fps | fixed}}</span><span class="label">1% low</span><span class="value">{{low_fps | fixed}}</span></div>
                <div class="metric"><span class="label">Slowest</span><span class="value">{{slowest_fps | fixed}}</span></div>
                <div class="metric"><span class="label">Frame</span><span class="value">{{frame_ms | fixed}} ms</span><span class="label">CPU</span><span class="value">{{cpu | fixed}}%</span></div>
                <div class="metric"><span class="label">SDL GPU</span><span class="value">{{driver}}</span><span class="label">VSync</span><span class="value">{{vsync}}</span></div>
                <div class="heading">CPU time (ms)</div>
                <div class="metric"><span class="label">UI</span><span class="value pair">update {{ui_update | fixed}}</span><span class="value pair">render {{ui_render | fixed}}</span></div>
                <div class="metric"><span class="label">RmlUi</span><span class="value pair">update {{rml_update | fixed}}</span><span class="value pair">render {{rml_render | fixed}}</span></div>
                <div class="metric"><span class="label">Renderer</span><span class="value pair">begin {{renderer_begin | fixed}}</span><span class="value pair">end {{renderer_end | fixed}}</span></div>
                <div class="metric"><span class="label">End</span><span class="value pair">stage {{end_stage | fixed}}</span><span class="value pair">replay {{end_replay | fixed}}</span></div>
                <div class="metric"><span class="label"></span><span class="value pair">offscr {{end_offscreen | fixed}}</span><span class="value pair">post UI {{end_post_ui | fixed}}</span></div>
                <div class="metric"><span class="label">Submit</span><span class="value">{{submit | fixed}}</span></div>
                <div id="graph">
                    <progress data-for="sample : history" direction="top" max="33.3"
                        data-attr-value="sample" data-class-slow="sample &gt;= 25"
                        data-class-medium="sample &gt;= 16.67 &amp;&amp; sample &lt; 25"></progress>
                </div>
                <div class="note">Inclusive: a pass contains the passes it calls.</div>
                <div class="info-line" data-for="line : info">{{line}}</div>
            </div>
        </div>
        <div id="counters" class="section" data-if="counters">
            <div class="section-back"></div>
            <div class="title">SDL GPU: {{driver}}</div>
            <!-- The passes in two columns: the first half, then the rest. -->
            <div class="pass-columns">
                <div class="pass-column">
                    <div class="pass-row pass-head"><span>Pass</span><span>ms</span><span>Draw</span><span>Merge</span><span>KB</span></div>
                    <div class="pass-row pass-lines"><span>{{passes_left.names}}</span><span>{{passes_left.ms}}</span><span>{{passes_left.draws}}</span><span>{{passes_left.merged}}</span><span>{{passes_left.vertex_kb}}</span></div>
                </div>
                <div class="pass-column">
                    <div class="pass-row pass-head"><span>Pass</span><span>ms</span><span>Draw</span><span>Merge</span><span>KB</span></div>
                    <div class="pass-row pass-lines"><span>{{passes_right.names}}</span><span>{{passes_right.ms}}</span><span>{{passes_right.draws}}</span><span>{{passes_right.merged}}</span><span>{{passes_right.vertex_kb}}</span></div>
                </div>
            </div>
            <div class="metric"><span class="label">Draws</span><span class="value pair">requested {{requested}}</span><span class="value pair">submitted {{submitted}}</span><span class="value pair">commands {{commands}}</span></div>
            <div class="metric"><span class="label">Vertices</span><span class="value pair">{{frame_vertex_kb | fixed}} KB</span></div>
            <div class="metric"><span class="label">Uploads</span><span class="value pair">textures {{textures_uploaded}}</span><span class="value pair">glyphs {{glyphs_uploaded}}</span></div>
            <div class="metric"><span class="label">Binds</span><span class="value pair">pipeline {{pipeline_binds}}</span><span class="value pair">sampler {{sampler_binds}}</span></div>
            <div class="metric"><span class="label">Uniforms</span><span class="value pair">vertex {{vertex_uniforms}}</span><span class="value pair">fragment {{fragment_uniforms}}</span></div>
            <div class="metric"><span class="label">Batches</span><span class="value pair">draws {{batch_draws}}</span><span class="value pair">vtx/draw {{vertices_per_batch | fixed}}</span><span class="value pair">2D merged {{merged_2d}}</span></div>
            <div class="metric"><span class="label">Skinning</span><span class="value pair">GPU {{skin_gpu}}</span><span class="value pair">CPU only {{skin_cpu_ineligible}}</span><span class="value pair">failed {{skin_failed}}</span></div>
        </div>
    </div>
</body>
</rml>
