<rml>
<head>
	<title>Delgado's lucky coin exchange (CExchangeLuckyCoin)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="event_item_entry.rcss"/>
	<link type="text/rcss" href="lucky_coin.rcss"/>
</head>
<body>
	<!-- Delgado's lucky coin exchange (CExchangeLuckyCoin), docked right: its texts and buttons. The frame is lucky_coin_exchange_bg.rml in the
	     background context, under the other documents (UI/Events/EventItemEntryView.h).
	     root_x/root_y/root_scale come from the dock transform; everything inside is reference px;
	     text is .sharp-text at the native size, counter-scaled out of the panel. C++ keeps the
	     corner close, Escape, the locks and the requests; a click is queued with item_entry_press. -->
	<div id="panel" data-model="lucky_coin_exchange" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<span class="sharp-text entry-text" data-for="t : texts" data-class-bold="t.bold"
		      data-style-left="t.left + 'px'" data-style-top="t.top + 'px'" data-style-color="t.color"
		      data-style-font-size="t.text_px + 'px'" data-style-width="(t.width * root_scale) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.text}}</span>

		<div class="entry-btn coin-btn" data-for="b : buttons" data-class-locked="b.locked"
		     data-class-small="b.style == 'small'" data-class-wide="b.style == 'wide'"
		     data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
		     data-style-width="b.width + 'px'" data-style-height="b.height + 'px'"
		     data-event-click="item_entry_press(b.index)">
			<span class="sharp-text entry-label" data-class-bold="b.bold"
			      data-style-font-size="(b.bold ? bold_text_px : text_px) + 'px'"
			      data-style-width="(b.width * root_scale) + 'px'" data-style-top="b.label_top + 'px'"
			      data-style-line-height="b.label_line_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{b.label}}</span>
		</div>
	</div>
</body>
</rml>
