<rml>
<head>
	<title>Title Loading Bar</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="title_scene.rcss"/>
</head>
<body>
	<!-- Replaces TitleSceneUI.cpp's CGaugeBar (the last CGaugeBar consumer) with RmlUi's own
	     built-in <progress> element (Factory.cpp registers it in Core, no extra setup needed) --
	     SetValue()/SetMax() are called directly from C++ on this element, no data-model binding
	     needed, the same imperative shape CGaugeBar::SetValue() always had. -->
	<progress id="gauge_fill" class="gauge-fill" direction="right" value="0" max="1"/>
</body>
</rml>
