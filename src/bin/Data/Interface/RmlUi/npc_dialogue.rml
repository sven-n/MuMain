<rml>
<head>
	<title>NPC Dialogue</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="npc_dialogue.rcss"/>
</head>
<!-- CNPCDialogue's own document -- the first window a quest-giving NPC opens (server packets
     ReceiveQuestByNPCEPList/ReceiveQuestByEtcEPList/generic NPC talk); only after picking a quest
     step from its sel-text list does the server push the PMSG_QUEST_STEP_INFO that opens the
     already-ported CQuestProgress/CQuestProgressByEtc. Two independently paginated lists share this
     one document: npc_lines (top) and answers (bottom, sourced from either GetNPCDlgAnswer() or
     quest-list-mode's quest subjects -- see NPCDialogueRmlModel.h's own comment). #panel/frame
     sprites/exit button/tooltip shape come from docked_panel_frame.rcss, same family as
     character_info/my_quest_info/pet_info/party_info/quest_progress. -->
<body>
	<div id="panel" data-model="npc_dialogue" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'"
	     data-style-font-size="(text_px / root_scale) + 'px'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span id="title" class="sharp-text" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(190 * root_scale) + 'px'">{{npc_name}}</span>
		<div class="nd-contribute sharp-text" data-class-hidden="!show_contribute"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(168 * root_scale) + 'px'" data-style-line-height="(18 * root_scale) + 'px'">{{contribute_text}}</div>

		<!-- id read live by NPCDialogue.cpp's ResolveDialogueWrapGeometry() -- its own resolved
		     width plus the vertical gap to #btn_npc_next below replace hardcoded wrap-width/
		     lines-per-page constants, so a theme resizing this area doesn't need a C++ change. -->
		<div id="npc_lines_container" class="nd-npc-lines sharp-text"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(160 * root_scale) + 'px'" data-style-line-height="(15 * root_scale) + 'px'">
			<span class="nd-line" data-for="l : npc_lines">{{l.text}}</span>
		</div>

		<div id="btn_npc_prev" class="nd-btn-l nd-btn-npc" data-class-locked="!npc_prev_enabled"
		     data-event-click="npcdialogue_npc_prev_page"></div>
		<div id="btn_npc_next" class="nd-btn-r nd-btn-npc" data-class-locked="!npc_next_enabled"
		     data-event-click="npcdialogue_npc_next_page"></div>

		<div class="nd-divider"></div>

		<!-- id read live by NPCDialogue.cpp's ResolveDialogueWrapGeometry() -- same reasoning as
		     #npc_lines_container above, using #btn_ans_next as this area's lower boundary. -->
		<div id="answers_container" class="nd-answers sharp-text" data-class-hidden="!show_answers"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(160 * root_scale) + 'px'" data-style-line-height="(15 * root_scale) + 'px'">
			<div class="nd-answer-row" data-for="a : answers"
			     data-event-click="npcdialogue_select_answer(a.index)">{{a.text}}</div>
		</div>

		<!-- Rendered/clickable regardless of show_answers, matching the native Render() call which
		     always drew these two buttons -- only the answer text itself was gated by m_eLowerView. -->
		<div id="btn_ans_prev" class="nd-btn-l nd-btn-ans" data-class-locked="!ans_prev_enabled"
		     data-event-click="npcdialogue_ans_prev_page"></div>
		<div id="btn_ans_next" class="nd-btn-r nd-btn-ans" data-class-locked="!ans_next_enabled"
		     data-event-click="npcdialogue_ans_next_page"></div>

		<div id="btn_exit" data-event-click="npcdialogue_click_close">
			<span class="btn-exit-label">×</span>
		</div>
		<span class="tooltip tooltip-exit">{{exit_tooltip}}</span>
	</div>
</body>
</rml>
