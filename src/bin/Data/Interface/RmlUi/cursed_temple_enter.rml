<rml>
<head>
	<title>Illusion Temple</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="cursed_temple_enter.rcss"/>
</head>
<body>
	<!-- The Illusion Temple entry window (CCursedTempleEnter): a message-box frame with the
	     question, the hero's temple, the six level bands (the hero's on a red text box), the
	     current members and the Enter / Close buttons. Without a level band none of that is shown,
	     only the minimum-level notice. Dialog layout: root_x/root_y/root_scale come from the Dialog
	     transform; everything inside is reference px; text is .sharp-text at the native size,
	     counter-scaled out of the panel. C++ keeps the level check, Escape and the entry request;
	     a click is queued with temple_enter / temple_close. -->
	<div id="panel" data-model="cursed_temple_enter" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'" data-style---root-scale="root_scale">
		<div id="back"></div>
		<div id="frame_top"></div>
		<div class="frame-middles"><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div><div class="frame-middle"></div></div>
		<div id="frame_bottom"></div>
		<div id="line"></div>

		<span class="sharp-text" id="title" data-style-font-size="bold_text_px + 'px'">{{title}}</span>

		<span id="ct_temple" class="sharp-text temple-line" data-if="eligible"
		      data-style-font-size="temple_line.text_px + 'px'">{{temple_line.text}}</span>

		<!-- The level bands, 15 units apart; the theme puts each on its own row and marks the
		     hero's. -->
		<div class="temple-bands" data-if="eligible">
			<div class="temple-band" data-for="b : bands">
				<div class="band-hero" data-if="b.hero" data-style-height="(line_height_px / root_scale) + 'px'"></div>
				<span class="sharp-text temple-line" data-style-font-size="b.text_px + 'px'">{{b.text}}</span>
			</div>
		</div>

		<span id="ct_members" class="sharp-text temple-line red" data-if="eligible"
		      data-style-font-size="members_line.text_px + 'px'">{{members_line.text}}</span>
		<span id="ct_notice" class="sharp-text temple-line red" data-if="!eligible"
		      data-style-font-size="notice.text_px + 'px'">{{notice.text}}</span>

		<div class="temple-btn" id="btn_enter" data-event-click="temple_enter">
			<span class="sharp-text sharp-middle temple-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="label_line_px + 'px'">{{enter_text}}</span>
		</div>
		<div class="temple-btn" id="btn_close" data-event-click="temple_close">
			<span class="sharp-text sharp-middle temple-label" data-style-font-size="text_px + 'px'"
			      data-style-line-height="label_line_px + 'px'">{{close_text}}</span>
		</div>
	</div>
</body>
</rml>
