<rml>
<head>
	<title>Jerint's Imperial Guardian entry (CEmpireGuardianNPC)</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="event_item_entry.rcss"/>
	<link type="text/rcss" href="empire_guardian_enter_rows.rcss"/>
</head>
<body>
	<!-- Jerint's Imperial Guardian entry window (CEmpireGuardianNPC), docked right: its texts and buttons. The frame is
	     empire_guardian_enter_bg.rml in the background context, under the native 3D preview of the entry item
	     (UI/Events/EventItemEntryView.h). root_x/root_y/root_scale come from the dock transform;
	     everything inside is reference px; text is .sharp-text at the native size, counter-scaled
	     out of the panel. C++ keeps the corner close, Escape and the requests; a click is queued
	     with item_entry_press. -->
	<div id="panel" data-model="empire_guardian_enter" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<!-- The rows these land on are the theme's: this document's own _rows.rcss gives one
		     :nth-child rule per line and per button. Each repeated set has its own container so
		     the count starts at the first one. -->
		<div class="entry-texts">
			<span class="sharp-text entry-text" data-for="t : texts"
			      data-style-font-size="t.text_px + 'px'" data-style-width="(t.width * root_scale) + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{t.text}}</span>
		</div>

		<div class="entry-buttons">
			<div class="entry-btn" data-for="b, i : buttons" data-class-locked="b.locked"
			     data-event-click="item_entry_press(i)">
				<span class="sharp-text entry-label" data-if="b.label != ''"
				      data-style-font-size="(b.bold ? bold_text_px : text_px) + 'px'"
				      data-style-width="(b.width * root_scale) + 'px'" data-style-top="b.label_top + 'px'"
				      data-style-line-height="b.label_line_px + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{b.label}}</span>
			</div>
		</div>
	</div>
</body>
</rml>
