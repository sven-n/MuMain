<rml>
<head>
	<title>Quest Progress</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="quest_progress.rcss"/>
</head>
<!-- CQuestProgress's own document -- shares quest_progress.rcss with CQuestProgressByEtc's own
     quest_progress_etc.rml (see that file and quest_progress.rcss's own header comment for why two
     .rml files instead of one: RmlUi binds one data-model name per document, so two independent
     C++ owners can't share a literal single .rml). Unlike quest_progress_etc.rml, this file
     includes an NPC-name/player-name preamble -- a structural difference from that sibling
     document, not a data-driven toggle (see QuestProgressRmlModel.h's own comment). -->
<body>
	<!-- Movable, non-HUD window: root_x/root_y/root_scale come from
	     UI::Scaling::GetActiveTransform(), same convention as my_quest_info.rml's #panel. -->
	<div id="panel" data-model="quest_progress" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'"
	     data-style-font-size="(text_px / root_scale) + 'px'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<span class="sharp-text" id="title"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(190 * root_scale) + 'px'">Quest</span>
		<div class="sharp-text qp-subject"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(190 * root_scale) + 'px'">{{subject}}</div>

		<div class="sharp-text qp-npc-name"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(164 * root_scale) + 'px'">{{npc_name}}</div>
		<div class="sharp-text qp-npc-lines"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(164 * root_scale) + 'px'" data-style-line-height="(15 * root_scale) + 'px'">
			<span class="qp-line" data-for="l : npc_lines">{{l.text}}</span>
		</div>

		<div id="btn_prev" class="qp-btn-l" data-class-locked="!prev_enabled"
		     data-event-click="questprogress_prev_page"></div>
		<div id="btn_next" class="qp-btn-r" data-class-locked="!next_enabled"
		     data-event-click="questprogress_next_page"></div>

		<div class="qp-divider"></div>

		<!-- Shown for both NON_PLAYER_WORDS_MODE (active_view 0, still paging NPC text) and
		     PLAYER_WORDS_MODE (1) -- hidden only once the reward view (2) is reached. Matches the
		     original's own `if (REQUEST_REWARD_MODE != m_eLowerView)` guard on this exact line. -->
		<div class="sharp-text qp-player-name" data-class-hidden="active_view == 2"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(164 * root_scale) + 'px'">{{player_name}}</div>

		<div class="sharp-text qp-answers" data-class-hidden="active_view != 1"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(164 * root_scale) + 'px'" data-style-line-height="(15 * root_scale) + 'px'">
			<div class="qp-player-words" data-style-margin-bottom="(15 * root_scale) + 'px'">{{player_words_text}}</div>
			<div class="qp-answer-row" data-for="a : answers"
			     data-event-click="questprogress_select_answer(a.index)">{{a.text}}</div>
		</div>

		<div class="qp-reward" data-class-hidden="active_view != 2">
			<div class="sharp-text qp-reward-list"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(174 * root_scale) + 'px'" data-style-height="(150 * root_scale) + 'px'">
				<span class="qp-reward-row" data-for="r : reward_rows" data-class-bold="r.bold"
				      data-style-padding="(1 * root_scale) + 'px ' + (4 * root_scale) + 'px'"
				      data-class-clickable="r.clickable"
				      data-class-row-heading="r.style == 'heading'"
				      data-class-row-requirement="r.style == 'requirement'"
				      data-class-row-requirement-unmet="r.style == 'requirement-unmet'"
				      data-class-row-reward="r.style == 'reward'"
				      data-class-row-random-reward="r.style == 'random-reward'"
				      data-event-click="questprogress_select_reward(r.index)">{{r.text}}</span>
			</div>
			<!-- Zero-size marker read live by QuestProgress.cpp's Render() -- where the selected
			     reward-item's native info-tooltip popup anchors, replacing a hardcoded m_Pos+95,+360
			     offset. .qp-reward has zero left/top of its own, so this resolves to the same
			     panel-relative coordinates the old offset did. -->
			<div id="reward_popup_anchor" class="qp-popup-anchor"></div>
			<div id="btn_complete" class="sharp-text qp-btn-complete" data-class-disabled="!request_complete" data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(108 * root_scale) + 'px'" data-style-height="(29 * root_scale) + 'px'" data-style-line-height="(29 * root_scale) + 'px'"
			     data-event-click="questprogress_complete">{{ok_label}}</div>
		</div>

		<div id="btn_exit" class="qp-btn-exit" data-event-click="questprogress_click_close">
			<span class="btn-exit-label">×</span>
		</div>
		<span class="sharp-text tooltip tooltip-exit"
		     data-style-transform="'scale(' + (1 / root_scale) + ')'" data-style-font-size="text_px + 'px'" data-style-width="(110 * root_scale) + 'px'" data-style-padding="(2 * root_scale) + 'px ' + (4 * root_scale) + 'px'">{{exit_tooltip}}</span>
	</div>
</body>
</rml>
