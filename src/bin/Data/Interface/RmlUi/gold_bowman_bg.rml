<rml>
<head>
	<title>Golden Archer's lucky number registration (CGoldBowmanWindow) background</title>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="gold_bowman_bg.rcss"/>
</head>
<body>
	<!-- Background-context document of gold_bowman.rml: the docked frame and the number field's
	     back, painted before the native windows, as the original's RenderFrame() drew them under its
	     texts. Never interactive. -->
	<div id="panel" data-model="gold_bowman_bg" data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>
		<div id="serial_back"></div>
	</div>
</body>
</rml>
