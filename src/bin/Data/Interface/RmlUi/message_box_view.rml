<rml>
<head>
	<title>Message Box</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="message_box_view.rcss"/>
</head>
<body>
	<!-- A native message box drawn by RmlUi (UI/Dialogs/MessageBoxView.h): the box art, its text
	     lines, its buttons or its progress bar. The box keeps its callbacks; a click is queued with
	     message_box_button(n). root_x/root_y/root_scale come from the message box manager's
	     layout; everything inside is reference px; text is .sharp-text at the native size,
	     counter-scaled out of the panel. -->
	<!-- With a list the box lets the pointer through outside its buttons (list-shown), so the
	     list's native hit tests and the message box manager get the clicks, as in the original. -->
	<div id="panel" data-model="message_box_view" data-class-list-shown="list_shown"
	     data-style-left="root_x + 'px'" data-style-top="root_y + 'px'"
	     data-style-transform="'scale(' + root_scale + ')'">
		<div id="back" data-style-height="back_height + 'px'"></div>
		<div id="box_top"></div>
		<div class="box-middle" data-for="m : middles" data-style-top="m + 'px'"></div>
		<div id="box_divider" data-if="divider_top >= 0" data-style-top="divider_top + 'px'"></div>
		<div id="box_bottom" data-style-top="bottom_top + 'px'"></div>
		<div class="box-separator" data-for="s : separators" data-style-top="s + 'px'"></div>

		<div id="progress_back" data-if="progress_shown" data-style-top="progress_top + 'px'"></div>
		<div id="progress_bar" data-if="progress_shown" data-style-top="(progress_top + 5) + 'px'"
		     data-style-width="progress_width + 'px'"></div>

		<span class="sharp-text box-line" data-for="l : lines" data-class-bold="l.bold"
		      data-style-left="l.left + 'px'" data-style-top="l.top + 'px'" data-style-color="l.color"
		      data-style-font-size="(l.text_px > 0 ? l.text_px : (l.bold ? bold_text_px : text_px)) + 'px'"
		      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{l.text}}</span>

		<div class="box-btn" data-for="b : buttons" data-class-disabled="!b.enabled" data-class-ok-art="b.ok_art"
		     data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
		     data-style-width="b.width + 'px'" data-style-height="b.height + 'px'"
		     data-event-click="message_box_button(b.index)">
			<span class="sharp-text box-label" data-style-left="b.label_left + 'px'" data-style-top="b.label_top + 'px'"
			      data-style-font-size="text_px + 'px'"
			      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{b.label}}</span>
		</div>

		<!-- A list inside the box (CUIUnmixgemList), drawn after everything else as the original
		     did. Hit-tested natively: it takes no pointer input here. -->
		<div id="list" data-if="list_shown" data-style-left="list_left + 'px'" data-style-top="list_top + 'px'"
		     data-style-width="list_width + 'px'" data-style-height="list_height + 'px'">
			<div id="list_box" data-style-width="(list_width + 1) + 'px'" data-style-height="(list_height + 2) + 'px'"></div>
			<div class="list-scroll-up" data-class-pressed="list_up_pressed" data-style-left="(list_width - 12) + 'px'"></div>
			<div class="list-scroll-down" data-class-pressed="list_down_pressed" data-style-left="(list_width - 12) + 'px'"
			     data-style-top="(list_height - 12) + 'px'"></div>
			<div class="list-track" data-style-left="(list_width - 12) + 'px'" data-style-top="list_track_top + 'px'"
			     data-style-height="list_track_height + 'px'"></div>
			<div class="list-track" data-style-left="list_width + 'px'" data-style-top="list_track_top + 'px'"
			     data-style-height="list_track_height + 'px'"></div>
			<div class="list-thumb" data-style-left="(list_width - 11) + 'px'" data-style-top="list_thumb_top + 'px'"
			     data-style-height="list_thumb_height + 'px'"></div>
			<div class="list-thumb-top" data-style-left="(list_width - 11) + 'px'" data-style-top="list_thumb_top + 'px'"></div>
			<div class="list-thumb-bottom" data-style-left="(list_width - 11) + 'px'" data-style-top="list_thumb_bottom_top + 'px'"></div>
			<div class="list-row" data-for="r : list_rows" data-class-selected="r.selected"
			     data-style-top="r.top + 'px'" data-style-width="(list_width - 12) + 'px'">
				<span class="sharp-text list-row-text" data-style-font-size="text_px + 'px'"
				      data-style-transform="'scale(' + (1 / root_scale) + ')'">{{r.text}}</span>
			</div>
		</div>
	</div>
</body>
</rml>
