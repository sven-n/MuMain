<rml>
<head>
	<title>Message Box</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="message_box_view.rcss"/>
</head>
<body>
	<!-- A native message box drawn by RmlUi (UI/Dialogs/MessageBoxView.h): the box art, its text
	     lines, its buttons or its progress bar. The box keeps its callbacks; a click is queued with
	     message_box_button(n). #panel carries the box's kind as a class, for a theme that places a
	     kind's own buttons (placed_buttons); the rest arrive with their box. The box stands where the
	     original drew it on the 640x480 stage (PlaceOnStage()); everything inside is reference px;
	     text is .sharp-text at the native size, counter-scaled out of the panel. -->
	<div id="panel" data-model="message_box_view" data-class-guild-appoint="kind == 'guild-appoint'">
		<div id="back" data-style-height="back_height + 'px'"></div>
		<!-- The frame's strips stack in flow inside #frame; only their order comes from C++. -->
		<div id="frame">
			<div id="box_top"></div>
			<div data-for="p : strips" data-attr-class="'box-strip box-strip--' + p.kind"></div>
			<div id="box_bottom"></div>
		</div>
		<div class="box-separator" data-for="s : separators" data-style-top="s + 'px'"></div>

		<div id="progress_back" data-if="progress_shown" data-style-top="progress_top + 'px'"></div>
		<div id="progress_bar" data-if="progress_shown" data-style-top="(progress_top + 5) + 'px'"
		     data-style-width="progress_width + 'px'"></div>

		<span class="sharp-text box-line" data-for="l : lines" data-class-bold="l.bold"
		      data-style-left="l.left + 'px'" data-style-top="l.top + 'px'" data-style-color="l.color"
		      data-style-font-size="(l.text_px > 0 ? l.text_px : (l.bold ? bold_text_px : text_px)) + 'px'">{{l.text}}</span>

		<div class="box-btn" data-for="b : buttons" data-class-disabled="!b.enabled" data-class-ok-art="b.ok_art"
		     data-style-left="b.left + 'px'" data-style-top="b.top + 'px'"
		     data-style-width="b.width + 'px'" data-style-height="b.height + 'px'"
		     data-event-click="message_box_button(b.index)">
			<span class="sharp-text sharp-middle sharp-centre box-label" data-style-font-size="text_px + 'px'">{{b.label}}</span>
		</div>
		<div class="box-placed">
			<div class="box-btn" data-for="b : placed_buttons" data-class-disabled="!b.enabled"
			     data-event-click="message_box_button(b.index)">
				<span class="sharp-text sharp-middle sharp-centre box-label" data-style-font-size="text_px + 'px'">{{b.label}}</span>
			</div>
		</div>

        <div id="list_box" data-if="list_shown"></div>
        <div id="list" class="scroll-pane counter-scaled" data-if="list_shown"
             data-style-font-size="text_px + 'px'">
            <div class="list-row" data-for="r : list_rows" data-class-selected="r.selected"
                 data-event-click="message_box_list_row(r.index)">
                <div class="list-row-back"></div>
                <span class="list-row-text">{{r.text}}</span>
            </div>
        </div>
	</div>
</body>
</rml>
