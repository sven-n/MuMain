# Writes the git commit of the source tree into OUTPUT, for MuError.log (which
# client a bug report came from) and the control socket's `ping` (which client a
# test run tested), with the id of the data release that commit's data belongs
# to. Runs on every build, but writes only when the content changed, so an
# unchanged commit rebuilds nothing.
#
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P WriteGitCommit.cmake

set(commit "unknown")
set(changed 0)
# Empty when it can't be computed; the client says the data release is unknown.
set(data_asset_id "")
find_program(GIT_EXECUTABLE git)
if(GIT_EXECUTABLE)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE head
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE head_result
    ERROR_QUIET)
  if(head_result EQUAL 0 AND head)
    set(commit "${head}")
    # Tracked files that differ from the commit: the client is not exactly it.
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
      WORKING_DIRECTORY "${SOURCE_DIR}"
      OUTPUT_VARIABLE status
      RESULT_VARIABLE status_result
      ERROR_QUIET)
    if(status_result EQUAL 0 AND NOT status STREQUAL "")
      set(changed 1)
    endif()

    # The data release's id, as data-assets.yml and ci.yml compute it: the first 16 hex digits of the SHA-256 of
    # the Data and fonts tree hashes, one per line. rev-parse prints exactly those lines.
    # test_windows_workflow_contract.py pins the workflows' formula, test_write_git_commit.cmake this result.
    execute_process(
      COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD:src/bin/Data HEAD:src/bin/fonts
      WORKING_DIRECTORY "${SOURCE_DIR}"
      OUTPUT_VARIABLE trees
      RESULT_VARIABLE trees_result
      ERROR_QUIET)
    if(trees_result EQUAL 0)
      string(SHA256 trees_hash "${trees}")
      string(SUBSTRING "${trees_hash}" 0 16 data_id)
      set(data_asset_id "data-${data_id}")
    endif()
  endif()
endif()

set(content "#pragma once\n// Generated by cmake/WriteGitCommit.cmake on every build.\n#define MU_GIT_COMMIT \"${commit}\"\n#define MU_GIT_COMMIT_CHANGED ${changed}\n#define MU_DATA_ASSET_ID \"${data_asset_id}\"\n")
set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
